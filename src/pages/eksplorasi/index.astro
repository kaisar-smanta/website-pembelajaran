---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import ExplorationPanel from '@/components/interactive/ExplorationPanel.astro';
import ExplorationOverview from '@/components/interactive/ExplorationOverview.astro';
import { explorationsByGrade, orderedExplorations } from '@/data/explorations';
import { GRADES, GRADE_ORDER } from '@/data/curriculum';
import { url } from '@/utils/url';

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Eksplorasi' },
];

const groups = GRADE_ORDER.map((grade) => ({
  grade,
  meta: GRADES[grade],
  items: explorationsByGrade(grade),
})).filter((g) => g.items.length > 0);

const total = orderedExplorations().length;
---

<BaseLayout
  title="Eksplorasi Matematika Interaktif"
  description="Eksplorasi matematika interaktif: penggeser parameter fungsi, simulasi barisan, sebaran data, bunga majemuk, anuitas, peluang, peluang bersyarat, dan regresi linear. Belajar dengan memprediksi, mengamati, lalu menjelaskan."
>
  <PageHeader
    title="Ruang eksplorasi matematika"
    eyebrow="Laboratorium Matematika"
    lead="Sebelum menghafal rumus, coba utak-atik dulu: geser nilainya, amati apa yang berubah, tebak polanya, lalu jelaskan dengan bahasamu sendiri. Tiap eksplorasi memandu alur prediksi → amati → jelaskan."
    crumbs={crumbs}
    meta={[`${total} eksplorasi`]}
  />

  <section id="daftar-eksplorasi" class="section section-paper" aria-label="Peta eksplorasi">
    <div class="container">
      <ExplorationOverview groups={groups} total={total} />
    </div>
  </section>

  {
    groups.map((g, gi) => (
      <section
        class:list={[
          'section',
          gi % 2 === 0 ? 'section-alt' : 'section-paper',
          'grade-section',
        ]}
        aria-labelledby={`kelas-${g.grade}`}
        data-ex-section
        data-ex-grade={g.grade}
      >
        <div class="container">
          <div class="grade-band reveal" data-reveal>
            <span class="grade-num" aria-hidden="true">
              {g.grade}
            </span>
            <SectionHeading
              id={`kelas-${g.grade}`}
              eyebrow={g.meta.label}
              title={g.meta.name}
              lead={g.meta.description}
              reveal={false}
            />
          </div>
          {g.items.map((e, i) => (
            <div
              class="reveal"
              data-reveal
              data-ex-panel
              data-ex-grade={e.grade}
              data-ex-element={e.element}
              data-ex-level={e.level}
              data-ex-search={[e.title, e.description, ...(e.tags ?? [])].join(' ').toLowerCase()}
              style={`--reveal-delay:${i * 70}ms`}
            >
              <ExplorationPanel exploration={e} index={i + 1} />
            </div>
          ))}
        </div>
      </section>
    ))
  }

  <section class="section section-paper">
    <div class="container">
      <aside class="closing card card-accent reveal" data-reveal aria-label="Langkah selanjutnya">
        <p>
          Sudah menemukan polanya? Uji dugaanmu lewat <a href={url('/latihan')}>latihan berjenjang</a>,
          atau lanjut berkeliling di <a href={url('/peta-pembelajaran')}>peta pembelajaran</a>.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .grade-section :global(.section-heading h2) {
    color: var(--color-primary);
  }
  .grade-section :global(.eyebrow-badge) {
    border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
    background: color-mix(in srgb, var(--color-primary) 9%, var(--color-surface));
    color: color-mix(in srgb, var(--color-primary) 68%, var(--color-text));
  }

  .grade-band {
    position: relative;
    margin-bottom: 1.5rem;
  }
  .grade-num {
    position: absolute;
    right: 0.4rem;
    top: -1.1rem;
    font-family: var(--font-serif);
    font-size: clamp(3.25rem, 8vw, 5.25rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.1;
    pointer-events: none;
    user-select: none;
  }

  .closing {
    background: color-mix(in srgb, var(--color-primary) 6%, var(--color-surface));
    font-size: 0.95rem;
  }
  .closing p {
    margin: 0;
  }
  .closing a {
    display: inline-block;
    padding-block: 0.25rem;
  }

  @media print {
    .grade-section[hidden],
    [data-ex-panel][hidden] {
      display: block !important;
    }
  }
</style>
