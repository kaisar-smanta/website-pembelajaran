---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import ExplorationPanel from '@/components/interactive/ExplorationPanel.astro';
import { explorationsByGrade, orderedExplorations } from '@/data/explorations';
import { GRADES, GRADE_ORDER } from '@/data/curriculum';
import { url } from '@/utils/url';
import type { ElementId, Grade } from '@/types/content';

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Eksplorasi' },
];

const gradeElement: Record<Grade, ElementId> = {
  X: 'bilangan',
  XI: 'aljabar-fungsi',
  XII: 'geometri',
};

const groups = GRADE_ORDER.map((grade) => ({
  grade,
  meta: GRADES[grade],
  items: explorationsByGrade(grade),
})).filter((g) => g.items.length > 0);

const total = orderedExplorations().length;
---

<BaseLayout
  title="Media Pembelajaran Interaktif"
  description="Eksplorasi matematika interaktif: penggeser parameter fungsi, simulasi barisan, sebaran data, bunga majemuk, anuitas, peluang, peluang bersyarat, dan regresi linear. Belajar dengan memprediksi, mengamati, lalu menjelaskan."
>
  <PageHeader
    title="Media Pembelajaran Interaktif"
    eyebrow="Laboratorium Matematika"
    lead="Sebelum membaca rumus, cobalah mengubah-ubah nilainya. Amati apa yang berubah, ajukan dugaan, lalu hubungkan dengan konsep yang kamu pelajari. Setiap eksplorasi memandu kamu dengan alur prediksi → amati → jelaskan."
    crumbs={crumbs}
    meta={[`${total} eksplorasi`]}
  />

  <div class="container">
    <nav class="ex-index card reveal" id="daftar-eksplorasi" aria-label="Daftar eksplorasi">
      <h2 class="ex-index-title">Peta eksplorasi</h2>
      <div class="ex-index-groups">
        {
          groups.map((g) => (
            <div class:list={['ex-index-group', `accent-${gradeElement[g.grade]}`]}>
              <a class="ex-index-grade hover-lift" href={`#kelas-${g.grade}`}>
                {g.meta.name}
                <span class="ex-index-count">{g.items.length}</span>
              </a>
              <ul>
                {g.items.map((e) => (
                  <li>
                    <a class="hover-lift" href={`#ex-${e.id}`}>
                      {e.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </nav>

    {
      groups.map((g) => (
        <section
          class:list={['grade-section', `accent-${gradeElement[g.grade]}`]}
          aria-labelledby={`kelas-${g.grade}`}
        >
          <div class="grade-head reveal">
            <SectionHeading
              id={`kelas-${g.grade}`}
              eyebrow={g.meta.label}
              title={g.meta.name}
              lead={g.meta.description}
              reveal={false}
            />
          </div>
          {g.items.map((e) => (
            <div class="reveal">
              <ExplorationPanel exploration={e} />
            </div>
          ))}
        </section>
      ))
    }

    <aside class="closing card card-accent reveal" aria-label="Langkah selanjutnya">
      <p>
        Sudah menemukan polanya? Uji pemahamanmu lewat <a href={url('/latihan')}>latihan berjenjang</a>,
        atau lanjutkan menelusuri <a href={url('/peta-pembelajaran')}>peta pembelajaran</a>.
      </p>
    </aside>
  </div>
</BaseLayout>

<style>
  .container {
    padding-block: 1rem 2.5rem;
  }

  .ex-index {
    margin-bottom: 1.75rem;
  }
  .ex-index-title {
    margin: 0 0 0.75rem;
    font-size: 1rem;
  }
  .ex-index-groups {
    display: grid;
    gap: 1rem 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .ex-index-grade {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--color-text);
    border-radius: var(--radius);
  }
  .ex-index-grade:hover {
    color: color-mix(in srgb, var(--accent, var(--color-primary)) 68%, var(--color-text));
  }
  .ex-index-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.4rem;
    height: 1.4rem;
    padding-inline: 0.35rem;
    border-radius: 999px;
    font-size: 0.75rem;
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 14%, var(--color-surface-2));
    color: color-mix(in srgb, var(--accent, var(--color-primary)) 68%, var(--color-text));
    border: 1px solid color-mix(in srgb, var(--accent, var(--color-primary)) 26%, var(--color-border));
  }
  .ex-index-group ul {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
    font-size: 0.88rem;
  }
  .ex-index-group ul a {
    display: inline-block;
    padding-block: 0.22rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .ex-index-group ul a:hover {
    color: color-mix(in srgb, var(--accent, var(--color-primary)) 68%, var(--color-text));
    text-decoration: underline;
  }

  .grade-section {
    padding-top: 1rem;
    margin-bottom: 2rem;
  }
  .grade-section + .grade-section {
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
  }
  .grade-section :global(.section-heading h2) {
    color: var(--accent, var(--color-primary));
  }
  .grade-section :global(.eyebrow-badge) {
    border-color: color-mix(in srgb, var(--accent, var(--color-primary)) 35%, var(--color-border));
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 9%, var(--color-surface));
    color: color-mix(in srgb, var(--accent, var(--color-primary)) 68%, var(--color-text));
  }

  .closing {
    margin-top: 2rem;
    background: color-mix(in srgb, var(--color-primary) 6%, var(--color-surface));
    font-size: 0.95rem;
  }
  .closing p {
    margin: 0;
  }
  .closing a {
    display: inline-block;
    padding-block: 0.25rem;
  }
</style>
