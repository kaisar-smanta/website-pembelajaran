---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import MapQuickNav from '@/components/content/MapQuickNav.astro';
import LearningPath from '@/components/content/LearningPath.astro';
import ElementCoverage from '@/components/content/ElementCoverage.astro';
import CpCoverage from '@/components/content/CpCoverage.astro';
import MapLegend from '@/components/content/MapLegend.astro';
import PrerequisiteGraph from '@/components/content/PrerequisiteGraph.astro';
import CtaCard from '@/components/ui/CtaCard.astro';
import {
  ALL_ELEMENT_ORDER,
  ELEMENTS,
  GRADES,
  GRADE_ORDER,
  SUBJECTS,
  SUBJECT_ORDER,
  gradesFor,
} from '@/data/curriculum';
import { topics, plannedTopics } from '@/data/topics';
import { learningPaths } from '@/data/learning-paths';
import { buildDashboardEntries } from '@/lib/dashboard';
import {
  applications,
  applicationCategories,
  applicationCategoryOrder,
} from '@/data/applications';
import { url } from '@/utils/url';

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Peta Pembelajaran' },
];

const meta = [
  `${topics.length} topik lengkap`,
  ...(plannedTopics.length > 0 ? [`${plannedTopics.length} topik segera hadir`] : []),
  `${learningPaths.length} jalur konsep`,
  `${applications.length} studi kasus`,
];

const pathGroups = SUBJECT_ORDER.map((subject) => ({
  id: subject,
  name: SUBJECTS[subject].name,
  paths: learningPaths.filter((path) => (path.subject ?? 'matematika') === subject),
})).filter((group) => group.paths.length > 0);

// Metadata per topik yang dipakai skrip kemajuan di peramban (id soal, tautan
// materi/latihan). Diserialkan sebagai JSON agar skrip tidak mengimpor data
// materi (yang akan menggandakan bundel).
const dashboardEntries = buildDashboardEntries();
const dashboardJson = JSON.stringify(dashboardEntries).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Peta Pembelajaran"
  description="Peta kurikulum Matematika dan Matematika Tingkat Lanjut SMA: hubungan antar konsep, prasyarat, dan jalur belajar dari bilangan, aljabar, geometri, kalkulus, hingga data dan peluang."
>
  <PageHeader
    title="Peta Pembelajaran"
    eyebrow="Kurikulum"
    lead="Materi tidak berdiri sendiri. Peta ini memperlihatkan bagaimana satu konsep menjadi prasyarat bagi konsep lain, sehingga belajar menjadi runtut."
    crumbs={crumbs}
    meta={meta}
  />

  <div class="container quicknav-slot">
    <MapQuickNav />
  </div>

  <div class="container">
    <section id="jalur" aria-labelledby="jalur-heading" class="block">
      <SectionHeading
        id="jalur-heading"
        eyebrow="Alur belajar"
        title="Jalur Konsep"
        lead={`${learningPaths.length} rute pada Matematika dan Matematika Tingkat Lanjut yang saling bertumpu: setiap tahap menyiapkan tahap berikutnya.`}
      />
      {
        pathGroups.map((group) => (
          <div class="path-group">
            <h3 class="path-group-title">{group.name}</h3>
            <div class="chain-grid">
              {group.paths.map((path, i) => (
                <LearningPath path={path} delay={i * 80} />
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </div>

  <section id="peta-lengkap" aria-labelledby="peta-lengkap-heading" class="block map-panel section-paper">
    <div class="container">
      <SectionHeading
        id="peta-lengkap-heading"
        eyebrow="Cakupan materi"
        title="Peta Kurikulum Lengkap"
        lead={
          plannedTopics.length > 0
            ? 'Seluruh topik tersusun per kelas dan elemen, lengkap dengan penanda materi yang masih direncanakan.'
            : 'Seluruh topik tersusun per kelas dan elemen, lengkap dengan cakupan tiap elemen.'
        }
      />

      <MapLegend />

      <div class="applications-strip card reveal" data-reveal>
        <span class="strip-label">Penerapan</span>
        {
          ALL_ELEMENT_ORDER.map((id) => {
            const category = applicationCategoryOrder.find(
              (cat) => applicationCategories[cat].element === id,
            );
            const count = applications.filter((a) => a.element === id).length;
            if (count === 0) return null;
            return (
              <a
                class:list={['strip-item', `accent-${id}`]}
                href={category ? `${url('/aplikasi')}#c-${category}` : url('/aplikasi')}
                aria-label={`${count} studi kasus ${ELEMENTS[id].name}`}
              >
                <span class="strip-count">{count}</span>
                {ELEMENTS[id].short}
              </a>
            );
          })
        }
      </div>

      <div class="map-continue card" data-map-continue hidden>
        <span class="map-continue-label" data-map-continue-label>Lanjutkan dari sini</span>
        <a class="map-continue-link" data-map-continue-link href="#">
          <span class="map-continue-title" data-map-continue-title></span>
          <span class="map-continue-meta text-soft" data-map-continue-meta></span>
        </a>
      </div>

      <div class="map-toolbar" data-map-toolbar>
        <div class="map-filters">
          <div class="map-filter-group">
            <span class="map-filter-label">Mapel</span>
            <div
              class="map-chip-row"
              data-map-subject-chips
              role="group"
              aria-label="Saring topik menurut mata pelajaran"
            >
              <button type="button" class="topic-chip is-active" data-map-subject="all" aria-pressed="true">
                Semua
              </button>
              {SUBJECT_ORDER.map((subject) => (
                <button type="button" class="topic-chip" data-map-subject={subject} aria-pressed="false">
                  {SUBJECTS[subject].short}
                </button>
              ))}
            </div>
          </div>
          <div class="map-filter-group">
            <span class="map-filter-label">Kelas</span>
            <div
              class="map-chip-row"
              data-map-grade-chips
              role="group"
              aria-label="Saring topik menurut kelas"
            >
              <button type="button" class="topic-chip is-active" data-map-grade="all" aria-pressed="true">
                Semua
              </button>
              {GRADE_ORDER.map((grade) => (
                <button type="button" class="topic-chip" data-map-grade={grade} aria-pressed="false">
                  {GRADES[grade].name}
                </button>
              ))}
            </div>
          </div>
          <div class="map-filter-group">
            <span class="map-filter-label">Elemen</span>
            <div class="map-chip-row map-chips" role="group" aria-label="Saring topik menurut elemen">
              <button type="button" class="topic-chip is-active" data-map-filter="all" aria-pressed="true">
                Semua
              </button>
              {ALL_ELEMENT_ORDER.map((id) => (
                <button type="button" class="topic-chip" data-map-filter={id} aria-pressed="false">
                  {ELEMENTS[id].short}
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="map-toolbar-aside">
          <div class="map-search">
            <label class="visually-hidden" for="peta-search">Cari topik</label>
            <input
              id="peta-search"
              type="search"
              class="map-search-input"
              data-map-search
              placeholder="Cari topik atau kata kunci"
              autocomplete="off"
            />
          </div>
          {
            plannedTopics.length > 0 && (
              <button
                type="button"
                class="btn btn-secondary btn-sm"
                data-map-toggle
                aria-pressed="false"
              >
                Sembunyikan "Segera hadir"
              </button>
            )
          }
        </div>
      </div>
      <p class="map-status text-soft" aria-live="polite" data-map-status></p>

      {
        SUBJECT_ORDER.map((subject) => (
          <div class="subject-coverage" data-subject={subject}>
            <h3 class="subject-coverage-title">{SUBJECTS[subject].name}</h3>
            {gradesFor(subject).map((grade, gi) => (
              <ElementCoverage grade={grade} subject={subject} delay={gi * 60} />
            ))}
          </div>
        ))
      }

      <script type="application/json" data-map-data is:inline set:html={dashboardJson}></script>
    </div>
  </section>

  <div class="container">
    <section id="cakupan-cp" aria-labelledby="cakupan-cp-heading" class="block">
      <SectionHeading
        id="cakupan-cp-heading"
        eyebrow="Acuan kurikulum"
        title="Cakupan Capaian Pembelajaran"
        lead="Setiap pernyataan Capaian Pembelajaran dan topik yang memenuhinya, dikelompokkan per fase dan elemen."
      />
      <CpCoverage compact />
    </section>

    <section id="prasyarat" aria-labelledby="prasyarat-heading" class="block">
      <SectionHeading
        id="prasyarat-heading"
        eyebrow="Hubungan konsep"
        title="Peta Prasyarat"
        lead="Lihat bagaimana topik saling bertumpu. Sorot sebuah topik untuk menelusuri prasyarat dan lanjutannya."
      />
      <PrerequisiteGraph />
    </section>
  </div>

  <section class="section-alt cta-section">
    <div class="container">
      <CtaCard
        eyebrow="Langkah berikutnya"
        title="Siap menelusuri peta ini?"
        text="Mulai dari kelas X dan ikuti alurnya, atau uji pemahamanmu lewat latihan berjenjang."
        accentClass="accent-aljabar-fungsi"
        reveal
        actions={[
          { label: 'Mulai dari Kelas X', href: url('/matematika/kelas/X'), variant: 'primary' },
          { label: 'Latihan berjenjang', href: url('/latihan'), variant: 'secondary' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

<script>
  import { normalizeText } from '@/lib/filter';
  import { setupFilterPage, type FilterPageGroup, type FilterPageHandle } from '@/lib/filter-dom';
  import { loadProgress } from '@/lib/progress';
  import { loadCompletions, loadPredictions, loadReflections } from '@/lib/learner';
  import { safeStorage } from '@/lib/storage';
  import {
    buildOverview,
    continueLearning,
    suggestedStart,
    type TopicEntry,
  } from '@/lib/progress-overview';

  const toolbar = document.querySelector<HTMLElement>('[data-map-toolbar]');

  if (toolbar) {
    const subjectGroup = toolbar.querySelector<HTMLElement>('[data-map-subject-chips]');
    const gradeGroup = toolbar.querySelector<HTMLElement>('[data-map-grade-chips]');
    const chipGroup = toolbar.querySelector<HTMLElement>('.map-chips');
    const searchInput = toolbar.querySelector<HTMLInputElement>('[data-map-search]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-map-toggle]');
    const status = document.querySelector<HTMLElement>('[data-map-status]');
    const cols = Array.from(document.querySelectorAll<HTMLElement>('.elem-col'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('.topic-item'));
    const gradeBlocks = Array.from(document.querySelectorAll<HTMLElement>('.grade-block'));
    const subjectBlocks = Array.from(document.querySelectorAll<HTMLElement>('.subject-coverage'));
    const pendings = Array.from(document.querySelectorAll<HTMLElement>('[data-pending]'));
    const strips = Array.from(document.querySelectorAll<HTMLElement>('[data-pending-strip]'));

    let hidePlanned = false;
    let page: FilterPageHandle | null = null;

    // Label chip dibaca dari DOM agar skrip tidak perlu mengimpor data kurikulum.
    function chipLabels(group: HTMLElement | null, attr: string): Record<string, string> {
      const labels: Record<string, string> = {};
      group?.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((chip) => {
        const value = chip.getAttribute(attr);
        if (value) labels[value] = (chip.textContent ?? '').trim();
      });
      return labels;
    }

    const subjectLabels = chipLabels(subjectGroup, 'data-map-subject');
    const gradeLabels = chipLabels(gradeGroup, 'data-map-grade');
    const elementLabels = chipLabels(chipGroup, 'data-map-filter');

    const blockOf = (el: HTMLElement): HTMLElement | null =>
      el.closest<HTMLElement>('.grade-block');

    function itemVisible(
      item: HTMLElement,
      element: string,
      subject: string,
      grade: string,
      q: string,
    ): boolean {
      if (element !== 'all' && item.getAttribute('data-element') !== element) return false;
      const block = blockOf(item);
      if (subject !== 'all' && block?.getAttribute('data-subject') !== subject) return false;
      if (grade !== 'all' && block?.getAttribute('data-grade') !== grade) return false;
      if (item.getAttribute('data-status') === 'rencana' && hidePlanned) return false;
      if (q && !(item.getAttribute('data-search') ?? '').includes(q)) return false;
      return true;
    }

    function render(values: Record<string, string>, query: string): void {
      const element = values.elemen || 'all';
      const subject = values.mapel || 'all';
      const grade = values.kelas || 'all';
      const q = normalizeText(query);

      let visibleTopics = 0;
      for (const item of items) {
        const show = itemVisible(item, element, subject, grade, q);
        item.classList.toggle('is-hidden', !show);
        if (show) visibleTopics += 1;
      }

      for (const col of cols) {
        const own = Array.from(col.querySelectorAll<HTMLElement>('.topic-item'));
        const anyVisible = own.some((item) => !item.classList.contains('is-hidden'));
        col.classList.toggle('is-hidden', !anyVisible);
      }

      // Chip "segera disusun" mengikuti saringan elemen/kelas/mapel, tetapi
      // disembunyikan saat ada kata kunci karena tidak punya judul untuk dicari.
      for (const pending of pendings) {
        const block = blockOf(pending);
        const show =
          !q &&
          (element === 'all' || pending.getAttribute('data-element') === element) &&
          (subject === 'all' || block?.getAttribute('data-subject') === subject) &&
          (grade === 'all' || block?.getAttribute('data-grade') === grade);
        pending.classList.toggle('is-hidden', !show);
      }
      for (const strip of strips) {
        const own = Array.from(strip.querySelectorAll<HTMLElement>('[data-pending]'));
        const anyVisible = own.some((pending) => !pending.classList.contains('is-hidden'));
        strip.classList.toggle('is-hidden', own.length > 0 && !anyVisible);
      }

      // Sembunyikan blok yang tidak punya isi tampak agar judul kelas/mapel
      // yatim tidak tertinggal.
      for (const block of gradeBlocks) {
        const hasTopic = block.querySelector<HTMLElement>('.topic-item:not(.is-hidden)') !== null;
        const hasPending =
          block.querySelector<HTMLElement>('[data-pending]:not(.is-hidden)') !== null;
        block.classList.toggle('is-hidden', !hasTopic && !hasPending);
      }
      for (const block of subjectBlocks) {
        const anyGrade = block.querySelector<HTMLElement>('.grade-block:not(.is-hidden)') !== null;
        block.classList.toggle('is-hidden', !anyGrade);
      }

      if (status) {
        if (visibleTopics === 0) {
          status.textContent = 'Tidak ada topik yang cocok dengan saringan ini. Coba kata kunci lain.';
          return;
        }
        const parts: string[] = [];
        if (subject !== 'all') parts.push(subjectLabels[subject] ?? subject);
        if (grade !== 'all') parts.push(gradeLabels[grade] ?? `Kelas ${grade}`);
        if (element !== 'all') parts.push(elementLabels[element] ?? element);
        const suffix = parts.length ? ` · ${parts.join(', ')}` : '';
        const qText = query.trim() ? ` untuk "${query.trim()}"` : '';
        status.textContent = `Menampilkan ${visibleTopics} topik${qText}${suffix}.`;
      }
    }

    function updateToggleLabel(): void {
      if (!toggle) return;
      toggle.textContent = hidePlanned ? 'Tampilkan "Segera hadir"' : 'Sembunyikan "Segera hadir"';
      toggle.setAttribute('aria-pressed', hidePlanned ? 'true' : 'false');
    }

    try {
      toolbar.classList.add('is-ready');

      const groups: FilterPageGroup[] = [];
      if (subjectGroup) {
        groups.push({
          key: 'mapel',
          group: subjectGroup,
          chipSelector: '[data-map-subject]',
          valueAttr: 'data-map-subject',
          activeClass: 'is-active',
          allValue: 'all',
        });
      }
      if (gradeGroup) {
        groups.push({
          key: 'kelas',
          group: gradeGroup,
          chipSelector: '[data-map-grade]',
          valueAttr: 'data-map-grade',
          activeClass: 'is-active',
          allValue: 'all',
        });
      }
      if (chipGroup) {
        groups.push({
          key: 'elemen',
          group: chipGroup,
          chipSelector: '[data-map-filter]',
          valueAttr: 'data-map-filter',
          activeClass: 'is-active',
          allValue: 'all',
        });
      }

      page = setupFilterPage({
        groups,
        searchInput,
        queryKey: 'q',
        syncUrl: true,
        apply: render,
      });

      updateToggleLabel();
      if (toggle) {
        toggle.addEventListener('click', () => {
          hidePlanned = !hidePlanned;
          updateToggleLabel();
          page?.refresh();
        });
      }
    } catch {
      /* tanpa JS seluruh peta tetap tampil */
    }
  }

  // ---- Kemajuan latihan per topik -------------------------------------------
  const continueBox = document.querySelector<HTMLElement>('[data-map-continue]');
  const continueLink = document.querySelector<HTMLElement>('[data-map-continue-link]');
  const continueLabel = document.querySelector<HTMLElement>('[data-map-continue-label]');
  const continueTitle = document.querySelector<HTMLElement>('[data-map-continue-title]');
  const continueMeta = document.querySelector<HTMLElement>('[data-map-continue-meta]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-topic-id]'));

  let entries: TopicEntry[] = [];
  const dataEl = document.querySelector<HTMLScriptElement>('[data-map-data]');
  if (dataEl) {
    try {
      const parsed: unknown = JSON.parse(dataEl.textContent ?? '[]');
      if (Array.isArray(parsed)) entries = parsed as TopicEntry[];
    } catch {
      entries = [];
    }
  }

  function updateProgress(): void {
    const storage = safeStorage();
    const overview = buildOverview(
      entries,
      loadProgress(storage),
      loadPredictions(storage),
      loadReflections(storage),
      loadCompletions(storage),
    );
    const byId = new Map(overview.topics.map((topic) => [topic.id, topic]));

    for (const link of links) {
      const id = link.getAttribute('data-topic-id');
      const topic = id ? byId.get(id) : undefined;
      if (!topic) continue;
      link.classList.toggle('is-started', topic.started && !topic.completed);
      link.classList.toggle('is-completed', topic.completed);
      if (topic.completed) link.title = 'Latihan sudah tuntas';
      else if (topic.started) link.title = 'Sudah dimulai, belum tuntas';
      else link.removeAttribute('title');
    }

    if (!continueBox || !continueLink || !continueTitle || !continueMeta) return;
    // Utamakan melanjutkan topik yang sudah dimulai; bila belum ada, tawarkan
    // titik awal yang sadar prasyarat.
    const resume = continueLearning(overview, 1)[0];
    const next = resume ?? suggestedStart(overview, 1)[0];
    if (!next) {
      continueBox.hidden = true;
      return;
    }
    continueLink.setAttribute('href', next.practiceHref);
    continueTitle.textContent = next.title;
    continueMeta.textContent = `${next.gradeName} · ${next.elementName}`;
    if (continueLabel) continueLabel.textContent = resume ? 'Lanjutkan dari sini' : 'Mulai dari sini';
    continueBox.hidden = false;
  }

  if (links.length) {
    updateProgress();
    window.addEventListener('mtk:progress', updateProgress);
    window.addEventListener('pageshow', updateProgress);
    window.addEventListener('storage', updateProgress);
  }
</script>

<style>
  .quicknav-slot {
    padding-top: 1.5rem;
  }
  .block {
    padding-block: 2.25rem;
  }
  .block + .block {
    border-top: 1px solid var(--color-border);
  }
  .map-panel {
    background-color: var(--color-bg-alt);
    border-block: 1px solid var(--color-border);
  }
  .path-group + .path-group {
    margin-top: 2rem;
  }
  .path-group-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.9rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .path-group-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }
  .chain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
  }
  .map-toolbar {
    display: none;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.9rem 1.25rem;
    margin-top: 1.1rem;
  }
  .map-toolbar.is-ready {
    display: flex;
  }
  .map-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.5rem;
    min-width: 0;
  }
  .map-filter-group {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }
  .map-filter-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .map-chip-row,
  .map-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .map-toolbar-aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.75rem;
  }
  .map-search {
    flex: 1 1 15rem;
    max-width: 22rem;
    min-width: 0;
  }
  .map-search-input {
    width: 100%;
    appearance: none;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: 999px;
    padding: 0.5rem 1rem;
    font: inherit;
    font-size: 0.9rem;
    line-height: 1.3;
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .map-search-input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-color: var(--color-primary);
  }
  .map-continue {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.85rem;
    margin-top: 1rem;
    padding: 0.7rem 1rem;
    border-left: 4px solid var(--color-primary);
  }
  .map-continue[hidden] {
    display: none;
  }
  .map-continue-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .map-continue-link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    min-width: 0;
    text-decoration: none;
    color: var(--color-text);
  }
  .map-continue-link:hover .map-continue-title,
  .map-continue-link:focus-visible .map-continue-title {
    text-decoration: underline;
  }
  .map-continue-title {
    font-weight: 700;
  }
  .map-continue-meta {
    font-size: 0.82rem;
  }
  .topic-chip {
    appearance: none;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
