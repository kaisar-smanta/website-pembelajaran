---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import ElementIcon from '@/components/content/ElementIcon.astro';
import { ELEMENTS, ELEMENT_ORDER, GRADES, GRADE_ORDER } from '@/data/curriculum';
import { topicsByGradeElement, plannedTopics, topics } from '@/data/topics';
import { url, topicUrl } from '@/utils/url';

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Peta Pembelajaran' },
];

const chains: {
  title: string;
  note: string;
  nodes: { label: string; id?: string; grade?: string; element?: string; planned?: boolean }[];
}[] = [
  {
    title: 'Jalur Bilangan: dari eksponen ke keputusan keuangan',
    note: 'Setiap tahap bertumpu pada tahap sebelumnya.',
    nodes: [
      { label: 'Eksponen', id: 'eksponen', grade: 'X', element: 'bilangan' },
      { label: 'Fungsi Eksponensial', id: 'fungsi-eksponensial', grade: 'X', element: 'aljabar-fungsi' },
      { label: 'Barisan & Deret', id: 'barisan-deret', grade: 'X', element: 'bilangan' },
      { label: 'Bunga Majemuk', id: 'bunga-majemuk', grade: 'XI', element: 'bilangan' },
      { label: 'Anuitas', id: 'anuitas', grade: 'XI', element: 'bilangan' },
      { label: 'Pinjaman & Investasi', planned: true },
    ],
  },
  {
    title: 'Jalur Fungsi: dari hubungan ke pemodelan data',
    note: 'Fungsi menghubungkan aljabar, data, dan pengambilan keputusan.',
    nodes: [
      { label: 'Fungsi Kuadrat', id: 'fungsi-kuadrat', grade: 'X', element: 'aljabar-fungsi' },
      { label: 'Fungsi Invers', id: 'fungsi-invers', grade: 'XI', element: 'aljabar-fungsi' },
      { label: 'Komposisi Fungsi', id: 'komposisi-fungsi', grade: 'XI', element: 'aljabar-fungsi' },
      { label: 'Data Bivariat', id: 'data-bivariat', grade: 'XI', element: 'data-peluang' },
      { label: 'Regresi', id: 'regresi', grade: 'XI', element: 'data-peluang' },
    ],
  },
  {
    title: 'Jalur Peluang: dari data ke kesimpulan yang sahih',
    note: 'Asosiasi bukan berarti kausalitas.',
    nodes: [
      { label: 'Analisis Data', id: 'analisis-distribusi-data', grade: 'X', element: 'data-peluang' },
      { label: 'Data Bivariat', id: 'data-bivariat', grade: 'XI', element: 'data-peluang' },
      { label: 'Regresi', id: 'regresi', grade: 'XI', element: 'data-peluang' },
      { label: 'Asosiasi & Kausalitas', id: 'asosiasi-kausalitas', grade: 'XII', element: 'data-peluang' },
      { label: 'Peluang Bersyarat', id: 'peluang-bersyarat', grade: 'XII', element: 'data-peluang' },
    ],
  },
];

const chainAccents = ['bilangan', 'aljabar-fungsi', 'data-peluang'] as const;
const revealStyle = (i: number) => `--reveal-delay:${i * 80}ms`;
const meta = [
  `${topics.length} topik lengkap`,
  `${plannedTopics.length} topik segera hadir`,
  `${chains.length} jalur konsep`,
];
---

<BaseLayout
  title="Peta Pembelajaran"
  description="Peta kurikulum Matematika SMA: hubungan antar konsep, prasyarat, dan jalur belajar dari bilangan, aljabar, geometri, hingga data dan peluang."
>
  <PageHeader
    title="Peta Pembelajaran"
    eyebrow="Kurikulum"
    lead="Materi tidak berdiri sendiri. Peta ini memperlihatkan bagaimana satu konsep menjadi prasyarat bagi konsep lain, sehingga belajar menjadi runtut."
    crumbs={crumbs}
    meta={meta}
  />

  <div class="container">
    <section aria-labelledby="jalur" class="block">
      <SectionHeading
        id="jalur"
        eyebrow="Alur belajar"
        title="Jalur Konsep"
        lead="Tiga rute yang saling bertumpu: setiap tahap menyiapkan tahap berikutnya."
      />
      <div class="chain-grid">
        {
          chains.map((chain, i) => (
            <article
              class={`chain-card card-accent hover-lift reveal accent-${chainAccents[i]}`}
              style={revealStyle(i)}
              data-reveal
            >
              <h3>{chain.title}</h3>
              <p class="text-muted chain-note">{chain.note}</p>
              <ol class="chain">
                {chain.nodes.map((n) => (
                  <li class="chain-node">
                    {n.id && n.grade && n.element ? (
                      <a href={topicUrl(n.grade, n.element, n.id)}>{n.label}</a>
                    ) : (
                      <span>
                        {n.label}
                        {n.planned && <span class="badge badge-rencana chain-badge">Segera hadir</span>}
                      </span>
                    )}
                  </li>
                ))}
              </ol>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="peta-lengkap" class="block">
      <SectionHeading
        id="peta-lengkap"
        eyebrow="Cakupan materi"
        title="Peta Kurikulum Lengkap"
        lead="Seluruh topik tersusun per kelas dan elemen, lengkap dengan penanda materi yang masih direncanakan."
      />
      <p class="text-muted">
        Materi bertanda <span class="badge badge-rencana">Segera hadir</span> sudah tercantum dalam
        roadmap dan akan dilengkapi tanpa mengubah struktur situs.
      </p>

      {
        GRADE_ORDER.map((grade, gi) => (
          <div class="grade-block reveal" style={revealStyle(gi)} data-reveal>
            <h3 class="grade-title">
              {GRADES[grade].name} <span class="badge">{GRADES[grade].label}</span>
            </h3>
            <div class="grade-columns">
              {ELEMENT_ORDER.map((elementId) => {
                const complete = topicsByGradeElement(grade, elementId);
                const planned = plannedTopics.filter((p) => p.grade === grade && p.element === elementId);
                const empty = complete.length === 0 && planned.length === 0;
                return (
                  <div class={`elem-col card-accent hover-lift accent-${elementId}${empty ? ' is-empty' : ''}`}>
                    <h4>
                      <span class="icon-tile elem-icon" aria-hidden="true">
                        <ElementIcon element={elementId} size={14} />
                      </span>
                      <span>{ELEMENTS[elementId].short}</span>
                    </h4>
                    {empty ? (
                      <p class="elem-empty text-soft">Belum ada topik pada jenjang ini.</p>
                    ) : (
                      <ul>
                        {complete.map((t) => (
                          <li>
                            <a href={topicUrl(t.grade, t.element, t.slug)}>{t.title}</a>
                          </li>
                        ))}
                        {planned.map((t) => (
                          <li class="planned-item">
                            <span>{t.title}</span>
                            <span class="badge badge-rencana">Segera hadir</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        ))
      }
    </section>
  </div>

  <section class="section-alt cta-section">
    <div class="container">
      <div class="card cta-card card-accent accent-aljabar-fungsi hover-lift reveal">
        <div class="cta-copy">
          <p class="eyebrow-badge">Langkah berikutnya</p>
          <h2>Siap menelusuri peta ini?</h2>
          <p class="text-muted">
            Mulai dari kelas X dan ikuti alurnya, atau uji pemahamanmu lewat latihan berjenjang.
          </p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href={url('/kelas/X')}>Mulai dari Kelas X</a>
          <a class="btn btn-secondary" href={url('/latihan')}>Latihan berjenjang</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .block {
    padding-block: 2rem;
  }
  .block + .block {
    border-top: 1px solid var(--color-border);
  }
  .chain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
  }
  .chain-card {
    background: var(--color-surface);
    border-inline: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.1rem;
  }
  .chain-card h3 {
    font-size: 1.05rem;
  }
  .chain-note {
    font-size: 0.86rem;
    margin-top: -0.3rem;
  }
  .chain {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .chain-node {
    position: relative;
    padding: 0.5rem 0 0.5rem 1.5rem;
    border-left: 2px solid color-mix(in srgb, var(--accent) 30%, var(--color-border));
  }
  .chain-node::before {
    content: '';
    position: absolute;
    left: -0.42rem;
    top: 0.9rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .chain-node a {
    display: inline-block;
    padding-block: 0.15rem;
    font-weight: 600;
    text-decoration: none;
  }
  .chain-node a:hover {
    text-decoration: underline;
  }
  .grade-block {
    margin-top: 1.5rem;
  }
  .grade-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.4rem;
  }
  .grade-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .elem-col {
    background: var(--color-surface);
    border-inline: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.85rem 1rem;
  }
  .elem-col.is-empty {
    border-top-color: var(--color-border);
  }
  .elem-empty {
    margin: 0.25rem 0 0;
    font-size: 0.86rem;
  }
  .elem-col h4 {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
  .elem-icon {
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 8px;
  }
  .elem-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .elem-col li {
    font-size: 0.9rem;
  }
  .elem-col a {
    display: inline-block;
    padding-block: 0.15rem;
    text-decoration: none;
  }
  .elem-col a:hover {
    text-decoration: underline;
  }
  .planned-item {
    color: var(--color-text-soft);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .planned-item .badge {
    margin-left: 0;
    vertical-align: middle;
  }
  .chain-badge {
    margin-left: 0.4rem;
  }
  .cta-section {
    padding-block: 2.5rem;
  }
  .cta-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cta-copy {
    max-width: 46ch;
  }
  .cta-copy .eyebrow-badge {
    margin-bottom: 0.6rem;
  }
  .cta-copy h2 {
    margin-bottom: 0.35rem;
  }
  .cta-copy p {
    margin: 0;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
