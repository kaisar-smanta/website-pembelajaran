---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import MapQuickNav from '@/components/content/MapQuickNav.astro';
import LearningPath from '@/components/content/LearningPath.astro';
import ElementCoverage from '@/components/content/ElementCoverage.astro';
import CpCoverage from '@/components/content/CpCoverage.astro';
import MapLegend from '@/components/content/MapLegend.astro';
import PrerequisiteGraph from '@/components/content/PrerequisiteGraph.astro';
import CtaCard from '@/components/ui/CtaCard.astro';
import {
  ALL_ELEMENT_ORDER,
  ELEMENTS,
  GRADES,
  GRADE_ORDER,
  SUBJECTS,
  SUBJECT_ORDER,
  gradesFor,
} from '@/data/curriculum';
import { topics, plannedTopics } from '@/data/topics';
import { learningPaths } from '@/data/learning-paths';
import { buildDashboardEntries } from '@/lib/dashboard';
import {
  applications,
  applicationCategories,
  applicationCategoryOrder,
} from '@/data/applications';
import { url } from '@/utils/url';

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Peta Pembelajaran' },
];

const meta = [
  `${topics.length} topik lengkap`,
  ...(plannedTopics.length > 0 ? [`${plannedTopics.length} topik segera hadir`] : []),
  `${learningPaths.length} jalur konsep`,
  `${applications.length} studi kasus`,
];

const pathGroups = SUBJECT_ORDER.map((subject) => ({
  id: subject,
  name: SUBJECTS[subject].name,
  paths: learningPaths.filter((path) => (path.subject ?? 'matematika') === subject),
})).filter((group) => group.paths.length > 0);

// Metadata per topik yang dipakai skrip kemajuan di peramban (id soal, tautan
// materi/latihan). Diserialkan sebagai JSON agar skrip tidak mengimpor data
// materi (yang akan menggandakan bundel).
const dashboardEntries = buildDashboardEntries();
const dashboardJson = JSON.stringify(dashboardEntries).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Peta Pembelajaran"
  description="Peta kurikulum Matematika dan Matematika Tingkat Lanjut SMA: hubungan antar konsep, prasyarat, dan jalur belajar dari bilangan, aljabar, geometri, kalkulus, hingga data dan peluang."
>
  <PageHeader
    title="Peta Pembelajaran"
    eyebrow="Kurikulum"
    lead="Materi tidak berdiri sendiri. Peta ini memperlihatkan bagaimana satu konsep menjadi prasyarat bagi konsep lain, sehingga belajar menjadi runtut."
    crumbs={crumbs}
    meta={meta}
  />

  <div class="container quicknav-slot">
    <MapQuickNav />
  </div>

  <div class="container">
    <section id="jalur" aria-labelledby="jalur-heading" class="block">
      <SectionHeading
        id="jalur-heading"
        eyebrow="Alur belajar"
        title="Jalur Konsep"
        lead={`${learningPaths.length} rute pada Matematika dan Matematika Tingkat Lanjut yang saling bertumpu: setiap tahap menyiapkan tahap berikutnya.`}
      />
      {
        pathGroups.map((group) => (
          <div class="path-group">
            <h3 class="path-group-title">{group.name}</h3>
            <div class="chain-grid">
              {group.paths.map((path, i) => (
                <LearningPath path={path} delay={i * 80} />
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </div>

  <section id="peta-lengkap" aria-labelledby="peta-lengkap-heading" class="block map-panel section-paper">
    <div class="container">
      <SectionHeading
        id="peta-lengkap-heading"
        eyebrow="Cakupan materi"
        title="Peta Kurikulum Lengkap"
        lead={
          plannedTopics.length > 0
            ? 'Seluruh topik tersusun per kelas dan elemen, lengkap dengan penanda materi yang masih direncanakan.'
            : 'Seluruh topik tersusun per kelas dan elemen, lengkap dengan cakupan tiap elemen.'
        }
      />

      <MapLegend />

      <div class="applications-strip card reveal" data-reveal>
        <span class="strip-label">Penerapan</span>
        {
          ALL_ELEMENT_ORDER.map((id) => {
            const category = applicationCategoryOrder.find(
              (cat) => applicationCategories[cat].element === id,
            );
            const count = applications.filter((a) => a.element === id).length;
            if (count === 0) return null;
            return (
              <a
                class:list={['strip-item', `accent-${id}`]}
                href={category ? `${url('/aplikasi')}#c-${category}` : url('/aplikasi')}
                aria-label={`${count} studi kasus ${ELEMENTS[id].name}`}
              >
                <span class="strip-count">{count}</span>
                {ELEMENTS[id].short}
              </a>
            );
          })
        }
      </div>

      <div class="map-continue card" data-map-continue hidden>
        <span class="map-continue-label" data-map-continue-label>Lanjutkan dari sini</span>
        <a class="map-continue-link" data-map-continue-link href="#">
          <span class="map-continue-title" data-map-continue-title></span>
          <span class="map-continue-meta text-soft" data-map-continue-meta></span>
        </a>
      </div>

      <div class="map-toolbar" data-map-toolbar>
        <div class="map-filters">
          <div class="map-filter-group">
            <span class="map-filter-label">Mapel</span>
            <div
              class="map-chip-row"
              data-map-subject-chips
              role="group"
              aria-label="Saring topik menurut mata pelajaran"
            >
              <button type="button" class="topic-chip is-active" data-map-subject="all" aria-pressed="true">
                Semua
              </button>
              {SUBJECT_ORDER.map((subject) => (
                <button type="button" class="topic-chip" data-map-subject={subject} aria-pressed="false">
                  {SUBJECTS[subject].short}
                </button>
              ))}
            </div>
          </div>
          <div class="map-filter-group">
            <span class="map-filter-label">Kelas</span>
            <div
              class="map-chip-row"
              data-map-grade-chips
              role="group"
              aria-label="Saring topik menurut kelas"
            >
              <button type="button" class="topic-chip is-active" data-map-grade="all" aria-pressed="true">
                Semua
              </button>
              {GRADE_ORDER.map((grade) => (
                <button type="button" class="topic-chip" data-map-grade={grade} aria-pressed="false">
                  {GRADES[grade].name}
                </button>
              ))}
            </div>
          </div>
          <div class="map-filter-group">
            <span class="map-filter-label">Elemen</span>
            <div class="map-chip-row map-chips" role="group" aria-label="Saring topik menurut elemen">
              <button type="button" class="topic-chip is-active" data-map-filter="all" aria-pressed="true">
                Semua
              </button>
              {ALL_ELEMENT_ORDER.map((id) => (
                <button type="button" class="topic-chip" data-map-filter={id} aria-pressed="false">
                  {ELEMENTS[id].short}
                </button>
              ))}
            </div>
          </div>
          <div class="map-filter-group">
            <span class="map-filter-label">Pengayaan</span>
            <div
              class="map-chip-row"
              data-map-pengayaan-chips
              role="group"
              aria-label="Saring topik pengayaan"
            >
              <button type="button" class="topic-chip is-active" data-map-pengayaan="all" aria-pressed="true">
                Semua
              </button>
              <button type="button" class="topic-chip" data-map-pengayaan="ya" aria-pressed="false">
                Hanya pengayaan
              </button>
            </div>
          </div>
        </div>

        <div class="map-toolbar-aside">
          <div class="map-search">
            <label class="visually-hidden" for="peta-search">Cari topik</label>
            <input
              id="peta-search"
              type="search"
              class="map-search-input"
              data-map-search
              placeholder="Cari topik atau kata kunci"
              autocomplete="off"
            />
          </div>
          {
            plannedTopics.length > 0 && (
              <button
                type="button"
                class="btn btn-secondary btn-sm"
                data-map-toggle
                aria-pressed="false"
              >
                Sembunyikan "Segera hadir"
              </button>
            )
          }
        </div>
      </div>
      <p class="map-status text-soft" aria-live="polite" data-map-status></p>

      {
        SUBJECT_ORDER.map((subject) => (
          <div class="subject-coverage" data-subject={subject}>
            <h3 class="subject-coverage-title">{SUBJECTS[subject].name}</h3>
            {gradesFor(subject).map((grade, gi) => (
              <ElementCoverage grade={grade} subject={subject} delay={gi * 60} />
            ))}
          </div>
        ))
      }

      <script type="application/json" data-map-data is:inline set:html={dashboardJson}></script>
    </div>
  </section>

  <div class="container">
    <section id="cakupan-cp" aria-labelledby="cakupan-cp-heading" class="block">
      <SectionHeading
        id="cakupan-cp-heading"
        eyebrow="Acuan kurikulum"
        title="Cakupan Capaian Pembelajaran"
        lead="Setiap pernyataan Capaian Pembelajaran dan topik yang memenuhinya, dikelompokkan per fase dan elemen."
      />
      <CpCoverage compact />
    </section>

    <section id="prasyarat" aria-labelledby="prasyarat-heading" class="block">
      <SectionHeading
        id="prasyarat-heading"
        eyebrow="Hubungan konsep"
        title="Peta Prasyarat"
        lead="Lihat bagaimana topik saling bertumpu. Sorot sebuah topik untuk menelusuri prasyarat dan lanjutannya."
      />
      <PrerequisiteGraph />
    </section>
  </div>

  <section class="section-alt cta-section">
    <div class="container">
      <CtaCard
        eyebrow="Langkah berikutnya"
        title="Siap menelusuri peta ini?"
        text="Mulai dari kelas X dan ikuti alurnya, atau uji pemahamanmu lewat latihan berjenjang."
        accentClass="accent-aljabar-fungsi"
        reveal
        actions={[
          { label: 'Mulai dari Kelas X', href: url('/matematika/kelas/X'), variant: 'primary' },
          { label: 'Latihan berjenjang', href: url('/latihan'), variant: 'secondary' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

<script>
  import { setupLearningMap } from '@/lib/map-client';

  const start = () => setupLearningMap();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start, { once: true });
  } else {
    start();
  }
</script>

<style>
  .quicknav-slot {
    padding-top: 1.5rem;
  }
  .block {
    padding-block: 2.25rem;
  }
  .block + .block {
    border-top: 1px solid var(--color-border);
  }
  .map-panel {
    background-color: var(--color-bg-alt);
    border-block: 1px solid var(--color-border);
  }
  .path-group + .path-group {
    margin-top: 2rem;
  }
  .path-group-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.9rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .path-group-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }
  .chain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
  }
  .map-toolbar {
    display: none;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.9rem 1.25rem;
    margin-top: 1.1rem;
  }
  .map-toolbar.is-ready {
    display: flex;
  }
  .map-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem 1.5rem;
    min-width: 0;
  }
  .map-filter-group {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }
  .map-filter-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .map-chip-row,
  .map-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .map-toolbar-aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.75rem;
  }
  .map-search {
    flex: 1 1 15rem;
    max-width: 22rem;
    min-width: 0;
  }
  .map-search-input {
    width: 100%;
    appearance: none;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: var(--radius-pill);
    padding: 0.5rem 1rem;
    font: inherit;
    font-size: 0.9rem;
    line-height: 1.3;
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .map-search-input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-color: var(--color-primary);
  }
  .map-continue {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.85rem;
    margin-top: 1rem;
    padding: 0.7rem 1rem;
    border-left: 4px solid var(--color-primary);
  }
  .map-continue[hidden] {
    display: none;
  }
  .map-continue-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .map-continue-link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
    min-width: 0;
    text-decoration: none;
    color: var(--color-text);
  }
  .map-continue-link:hover .map-continue-title,
  .map-continue-link:focus-visible .map-continue-title {
    text-decoration: underline;
  }
  .map-continue-title {
    font-weight: 700;
  }
  .map-continue-meta {
    font-size: 0.82rem;
  }
  .topic-chip {
    appearance: none;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    border-radius: var(--radius-pill);
    padding: 0.4rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .topic-chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .topic-chip:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .topic-chip.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .topic-chip.is-active:hover {
    color: var(--color-on-primary);
  }
  .map-status {
    min-height: 1.2rem;
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
  }
  .applications-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
    margin-top: 1rem;
    padding: 0.85rem 1.1rem;
  }
  .strip-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .strip-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.7rem;
    border-radius: var(--radius-pill);
    border: 1px solid color-mix(in srgb, var(--accent, var(--color-primary)) 28%, var(--color-border));
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 9%, var(--color-surface));
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 0.15s,
      background 0.15s;
  }
  .strip-item:hover,
  .strip-item:focus-visible {
    border-color: var(--accent, var(--color-primary));
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 15%, var(--color-surface));
  }
  .strip-count {
    display: inline-grid;
    place-items: center;
    min-width: 1.3rem;
    height: 1.3rem;
    padding-inline: 0.35rem;
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-on-primary);
    background: var(--accent, var(--color-primary));
  }
  .cta-section {
    padding-block: 2.5rem;
  }

  .subject-coverage + .subject-coverage {
    margin-top: 2.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .subject-coverage-title {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }

  .block,
  :global(.grade-block),
  :global(.learning-path) {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  :global(.elem-col.is-hidden),
  :global(.topic-item.is-hidden),
  :global(.grade-block.is-hidden),
  :global(.subject-coverage.is-hidden) {
    display: none !important;
  }

  @media (max-width: 30rem) {
    .map-toolbar-aside {
      width: 100%;
    }
    .map-search {
      flex-basis: 100%;
      max-width: none;
    }
  }
</style>
