---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import MapQuickNav from '@/components/content/MapQuickNav.astro';
import LearningPath from '@/components/content/LearningPath.astro';
import ElementCoverage from '@/components/content/ElementCoverage.astro';
import CpCoverage from '@/components/content/CpCoverage.astro';
import MapLegend from '@/components/content/MapLegend.astro';
import PrerequisiteGraph from '@/components/content/PrerequisiteGraph.astro';
import CtaCard from '@/components/ui/CtaCard.astro';
import {
  ALL_ELEMENT_ORDER,
  ELEMENTS,
  SUBJECTS,
  SUBJECT_ORDER,
  gradesFor,
} from '@/data/curriculum';
import { topics, plannedTopics } from '@/data/topics';
import { learningPaths } from '@/data/learning-paths';
import {
  applications,
  applicationCategories,
  applicationCategoryOrder,
} from '@/data/applications';
import { url } from '@/utils/url';

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Peta Pembelajaran' },
];

const meta = [
  `${topics.length} topik lengkap`,
  ...(plannedTopics.length > 0 ? [`${plannedTopics.length} topik segera hadir`] : []),
  `${learningPaths.length} jalur konsep`,
  `${applications.length} studi kasus`,
];

const pathGroups = SUBJECT_ORDER.map((subject) => ({
  id: subject,
  name: SUBJECTS[subject].name,
  paths: learningPaths.filter((path) => (path.subject ?? 'matematika') === subject),
})).filter((group) => group.paths.length > 0);
---

<BaseLayout
  title="Peta Pembelajaran"
  description="Peta kurikulum Matematika SMA: hubungan antar konsep, prasyarat, dan jalur belajar dari bilangan, aljabar, geometri, hingga data dan peluang."
>
  <PageHeader
    title="Peta Pembelajaran"
    eyebrow="Kurikulum"
    lead="Materi tidak berdiri sendiri. Peta ini memperlihatkan bagaimana satu konsep menjadi prasyarat bagi konsep lain, sehingga belajar menjadi runtut."
    crumbs={crumbs}
    meta={meta}
  />

  <div class="container quicknav-slot">
    <MapQuickNav />
  </div>

  <div class="container">
    <section id="jalur" aria-labelledby="jalur-heading" class="block">
      <SectionHeading
        id="jalur-heading"
        eyebrow="Alur belajar"
        title="Jalur Konsep"
        lead={`${learningPaths.length} rute pada Matematika dan Matematika Tingkat Lanjut yang saling bertumpu: setiap tahap menyiapkan tahap berikutnya.`}
      />
      {
        pathGroups.map((group) => (
          <div class="path-group">
            <h3 class="path-group-title">{group.name}</h3>
            <div class="chain-grid">
              {group.paths.map((path, i) => (
                <LearningPath path={path} delay={i * 80} />
              ))}
            </div>
          </div>
        ))
      }
    </section>
  </div>

  <section id="peta-lengkap" aria-labelledby="peta-lengkap-heading" class="block map-panel section-paper">
    <div class="container">
      <SectionHeading
        id="peta-lengkap-heading"
        eyebrow="Cakupan materi"
        title="Peta Kurikulum Lengkap"
        lead={
          plannedTopics.length > 0
            ? 'Seluruh topik tersusun per kelas dan elemen, lengkap dengan penanda materi yang masih direncanakan.'
            : 'Seluruh topik tersusun per kelas dan elemen, lengkap dengan cakupan tiap elemen.'
        }
      />

      <MapLegend />

      <div class="applications-strip card reveal" data-reveal>
        <span class="strip-label">Penerapan</span>
        {
          ALL_ELEMENT_ORDER.map((id) => {
            const category = applicationCategoryOrder.find(
              (cat) => applicationCategories[cat].element === id,
            );
            const count = applications.filter((a) => a.element === id).length;
            if (count === 0) return null;
            return (
              <a
                class:list={['strip-item', `accent-${id}`]}
                href={category ? `${url('/aplikasi')}#c-${category}` : url('/aplikasi')}
                aria-label={`${count} studi kasus ${ELEMENTS[id].name}`}
              >
                <span class="strip-count">{count}</span>
                {ELEMENTS[id].short}
              </a>
            );
          })
        }
      </div>

      <div class="map-toolbar" data-map-toolbar>
        <div class="map-chips" role="group" aria-label="Saring topik menurut elemen">
          <button type="button" class="topic-chip is-active" data-map-filter="all" aria-pressed="true">
            Semua
          </button>
          {
            ALL_ELEMENT_ORDER.map((id) => (
              <button type="button" class="topic-chip" data-map-filter={id} aria-pressed="false">
                {ELEMENTS[id].short}
              </button>
            ))
          }
        </div>
        {
          plannedTopics.length > 0 && (
            <button
              type="button"
              class="btn btn-secondary btn-sm"
              data-map-toggle
              aria-pressed="false"
            >
              Sembunyikan "Segera hadir"
            </button>
          )
        }
      </div>
      <p class="map-status text-soft" aria-live="polite" data-map-status></p>

      {
        SUBJECT_ORDER.map((subject) => (
          <div class="subject-coverage">
            <h3 class="subject-coverage-title">{SUBJECTS[subject].name}</h3>
            {gradesFor(subject).map((grade, gi) => (
              <ElementCoverage grade={grade} subject={subject} delay={gi * 60} />
            ))}
          </div>
        ))
      }
    </div>
  </section>

  <div class="container">
    <section id="cakupan-cp" aria-labelledby="cakupan-cp-heading" class="block">
      <SectionHeading
        id="cakupan-cp-heading"
        eyebrow="Acuan kurikulum"
        title="Cakupan Capaian Pembelajaran"
        lead="Setiap pernyataan Capaian Pembelajaran dan topik yang memenuhinya, dikelompokkan per fase dan elemen."
      />
      <CpCoverage compact />
    </section>

    <section id="prasyarat" aria-labelledby="prasyarat-heading" class="block">
      <SectionHeading
        id="prasyarat-heading"
        eyebrow="Hubungan konsep"
        title="Peta Prasyarat"
        lead="Lihat bagaimana topik saling bertumpu. Sorot sebuah topik untuk menelusuri prasyarat dan lanjutannya."
      />
      <PrerequisiteGraph />
    </section>
  </div>

  <section class="section-alt cta-section">
    <div class="container">
      <CtaCard
        eyebrow="Langkah berikutnya"
        title="Siap menelusuri peta ini?"
        text="Mulai dari kelas X dan ikuti alurnya, atau uji pemahamanmu lewat latihan berjenjang."
        accentClass="accent-aljabar-fungsi"
        reveal
        actions={[
          { label: 'Mulai dari Kelas X', href: url('/matematika/kelas/X'), variant: 'primary' },
          { label: 'Latihan berjenjang', href: url('/latihan'), variant: 'secondary' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

<script>
  import { setupFilterPage, type FilterPageHandle } from '@/lib/filter-dom';

  const toolbar = document.querySelector<HTMLElement>('[data-map-toolbar]');

  if (toolbar) {
    const chipGroup = toolbar.querySelector<HTMLElement>('.map-chips');
    const toggle = document.querySelector<HTMLButtonElement>('[data-map-toggle]');
    const status = document.querySelector<HTMLElement>('[data-map-status]');
    const cols = Array.from(document.querySelectorAll<HTMLElement>('.elem-col'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('.topic-item'));
    const pendings = Array.from(document.querySelectorAll<HTMLElement>('[data-pending]'));
    const strips = Array.from(document.querySelectorAll<HTMLElement>('[data-pending-strip]'));

    let hidePlanned = false;
    let page: FilterPageHandle | null = null;

    function render(values: Record<string, string>): void {
      const filter = values.element || 'all';
      for (const col of cols) {
        const element = col.getAttribute('data-element');
        col.classList.toggle('is-hidden', !(filter === 'all' || element === filter));
      }
      for (const item of items) {
        const planned = item.getAttribute('data-status') === 'rencana';
        item.classList.toggle('is-hidden', planned && hidePlanned);
      }
      for (const col of cols) {
        if (col.classList.contains('is-hidden')) continue;
        const own = Array.from(col.querySelectorAll<HTMLElement>('.topic-item'));
        if (!own.length) continue;
        const anyVisible = own.some((item) => !item.classList.contains('is-hidden'));
        col.classList.toggle('is-hidden', !anyVisible);
      }
      for (const pending of pendings) {
        const element = pending.getAttribute('data-element');
        pending.classList.toggle('is-hidden', !(filter === 'all' || element === filter));
      }
      for (const strip of strips) {
        const own = Array.from(strip.querySelectorAll<HTMLElement>('[data-pending]'));
        const anyVisible = own.some((pending) => !pending.classList.contains('is-hidden'));
        strip.classList.toggle('is-hidden', own.length > 0 && !anyVisible);
      }
      if (status) {
        if (filter === 'all') {
          status.textContent = `${cols.length} kelompok elemen tersedia.`;
        } else {
          const shown = cols.filter((col) => !col.classList.contains('is-hidden')).length;
          status.textContent = `Menampilkan ${shown} dari ${cols.length} kelompok elemen.`;
        }
      }
    }

    try {
      toolbar.classList.add('is-ready');

      if (chipGroup) {
        page = setupFilterPage({
          groups: [
            {
              key: 'element',
              group: chipGroup,
              chipSelector: '[data-map-filter]',
              valueAttr: 'data-map-filter',
              activeClass: 'is-active',
              allValue: 'all',
            },
          ],
          apply: render,
        });
      } else {
        render({ element: 'all' });
      }

      if (toggle) {
        toggle.addEventListener('click', () => {
          hidePlanned = !hidePlanned;
          toggle.setAttribute('aria-pressed', hidePlanned ? 'true' : 'false');
          page?.refresh();
        });
      }
    } catch {
      /* tanpa JS seluruh peta tetap tampil */
    }
  }
</script>

<style>
  .quicknav-slot {
    padding-top: 1.5rem;
  }
  .block {
    padding-block: 2.25rem;
  }
  .block + .block {
    border-top: 1px solid var(--color-border);
  }
  .map-panel {
    background-color: var(--color-bg-alt);
    border-block: 1px solid var(--color-border);
  }
  .path-group + .path-group {
    margin-top: 2rem;
  }
  .path-group-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.9rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .path-group-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }
  .chain-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1.25rem;
  }
  .map-toolbar {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.1rem;
  }
  .map-toolbar.is-ready {
    display: flex;
  }
  .map-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .topic-chip {
    appearance: none;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  .topic-chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .topic-chip:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .topic-chip.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .topic-chip.is-active:hover {
    color: var(--color-on-primary);
  }
  .map-status {
    min-height: 1.2rem;
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
  }
  .applications-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
    margin-top: 1rem;
    padding: 0.85rem 1.1rem;
  }
  .strip-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .strip-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent, var(--color-primary)) 28%, var(--color-border));
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 9%, var(--color-surface));
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 0.15s,
      background 0.15s;
  }
  .strip-item:hover,
  .strip-item:focus-visible {
    border-color: var(--accent, var(--color-primary));
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 15%, var(--color-surface));
  }
  .strip-count {
    display: inline-grid;
    place-items: center;
    min-width: 1.3rem;
    height: 1.3rem;
    padding-inline: 0.35rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-on-primary);
    background: var(--accent, var(--color-primary));
  }
  .cta-section {
    padding-block: 2.5rem;
  }

  .subject-coverage + .subject-coverage {
    margin-top: 2.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .subject-coverage-title {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
  }

  .block,
  :global(.grade-block),
  :global(.learning-path) {
    scroll-margin-top: 5.25rem;
  }

  :global(.elem-col.is-hidden),
  :global(.topic-item.is-hidden) {
    display: none !important;
  }
</style>
