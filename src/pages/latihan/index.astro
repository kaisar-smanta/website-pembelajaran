---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import PracticeCard from '@/components/exercises/PracticeCard.astro';
import CtaCard from '@/components/ui/CtaCard.astro';
import { topics, topicSubject } from '@/data/topics';
import { questions, questionsByTopic, practiceCounts, topicIdsWithQuestions } from '@/data/questions';
import {
  ELEMENTS,
  ALL_ELEMENT_ORDER,
  GRADES,
  GRADE_ORDER,
  SUBJECTS,
  SUBJECT_ORDER,
  elementOrderFor,
  gradesFor,
} from '@/data/curriculum';
import { DIFFICULTY_LABELS, DIFFICULTY_ORDER } from '@/data/display';
import { difficultyCounts } from '@/lib/practice';
import { url } from '@/utils/url';
import type { Difficulty } from '@/types/content';

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Latihan & Asesmen' },
];

const total = questions.length;
const byDifficulty = difficultyCounts(questions);

const levelMeta: Record<Difficulty, { badge: string; accent: string; text: string }> = {
  dasar: {
    badge: 'badge-dasar',
    accent: 'var(--color-success)',
    text: 'Memahami istilah, membaca representasi, mengenali pola, dan prosedur sederhana.',
  },
  cakap: {
    badge: 'badge-cakap',
    accent: 'var(--color-primary)',
    text: 'Menerapkan konsep pada masalah multi-langkah, pemodelan, dan interpretasi.',
  },
  mahir: {
    badge: 'badge-mahir',
    accent: 'var(--color-warning)',
    text: 'Soal nonrutin, memilih strategi, menyusun argumentasi, dan mengevaluasi model.',
  },
};

const levels = DIFFICULTY_ORDER.map((value) => ({
  value,
  name: DIFFICULTY_LABELS[value],
  count: byDifficulty[value],
  ...levelMeta[value],
}));

const withQuestions = new Set(topicIdsWithQuestions());
const practiceTopics = topics.filter((t) => withQuestions.has(t.id));

const groups = SUBJECT_ORDER.map((subject) => ({
  subject,
  label: SUBJECTS[subject].name,
  grades: gradesFor(subject)
    .map((grade) => ({
      grade,
      label: GRADES[grade].name,
      elements: elementOrderFor(subject)
        .map((element) => ({
          element,
          label: ELEMENTS[element].name,
          topics: practiceTopics.filter(
            (t) => topicSubject(t) === subject && t.grade === grade && t.element === element,
          ),
        }))
        .filter((group) => group.topics.length > 0),
    }))
    .filter((group) => group.elements.length > 0),
})).filter((group) => group.grades.length > 0);

const meta = [
  `${total} soal pada ${practiceTopics.length} topik`,
  `${byDifficulty.dasar} dasar · ${byDifficulty.cakap} cakap · ${byDifficulty.mahir} mahir`,
];

const revealStyle = (i: number) => `--reveal-delay:${Math.min(i, 6) * 70}ms`;
---

<BaseLayout
  title="Latihan & Asesmen"
  description="Bank latihan matematika SMA berjenjang: saring berdasarkan kelas, elemen, dan tingkat kesulitan, lalu pantau kemajuanmu."
>
  <PageHeader
    title="Latihan & Asesmen"
    eyebrow="Asesmen"
    lead="Soal dikelompokkan menurut tingkat kesulitan Dasar, Cakap, dan Mahir. Kesulitan tidak ditentukan oleh besarnya angka, melainkan oleh tuntutan penalaran, pemodelan, dan pemilihan strategi."
    crumbs={crumbs}
    meta={meta}
  />

  <div class="container" data-latihan-root>
    <section aria-labelledby="jenjang" class="block">
      <SectionHeading
        id="jenjang"
        eyebrow="Tiga jenjang"
        title="Tingkat Kesulitan"
        lead="Setiap soal menantang kemampuan berpikir yang berbeda. Mulai dari yang paling akrab, lalu naik perlahan."
      />
      <div class="grid grid-3">
        {
          levels.map((lv, i) => (
            <div
              class="card card-accent level-card hover-lift reveal"
              style={`--accent: ${lv.accent}; ${revealStyle(i)}`}
              data-reveal
            >
              <span class="level-num" aria-hidden="true">{i + 1}</span>
              <h3>
                <span class={`badge ${lv.badge}`}>{lv.name}</span>
              </h3>
              <p>{lv.text}</p>
              <p class="level-count text-soft">{lv.count} soal</p>
            </div>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="saring" class="block">
      <SectionHeading
        id="saring"
        eyebrow="Saring"
        title="Temukan Latihan"
        lead="Saring daftar latihan menurut kelas, elemen kurikulum, dan tingkat kesulitan. Pilihanmu tersimpan di alamat halaman sehingga bisa dibagikan."
      />
      <div class="filter-bar" data-filter-bar>
        <div class="filter-group" role="group" aria-labelledby="filter-kelas-label">
          <span class="filter-label" id="filter-kelas-label">Kelas</span>
          <div class="filter-options">
            <button type="button" class="filter-btn" data-filter="kelas" data-value="" aria-pressed="true">Semua</button>
            {
              GRADE_ORDER.map((grade) => (
                <button type="button" class="filter-btn" data-filter="kelas" data-value={grade} aria-pressed="false">
                  Kelas {grade}
                </button>
              ))
            }
          </div>
        </div>
        <div class="filter-group" role="group" aria-labelledby="filter-elemen-label">
          <span class="filter-label" id="filter-elemen-label">Elemen</span>
          <div class="filter-options">
            <button type="button" class="filter-btn" data-filter="elemen" data-value="" aria-pressed="true">Semua</button>
            {
              ALL_ELEMENT_ORDER.map((element) => (
                <button
                  type="button"
                  class="filter-btn"
                  data-filter="elemen"
                  data-value={element}
                  aria-pressed="false"
                >
                  {ELEMENTS[element].short}
                </button>
              ))
            }
          </div>
        </div>
        <div class="filter-group" role="group" aria-labelledby="filter-tingkat-label">
          <span class="filter-label" id="filter-tingkat-label">Tingkat</span>
          <div class="filter-options">
            <button type="button" class="filter-btn" data-filter="tingkat" data-value="" aria-pressed="true">Semua</button>
            {
              levels.map((lv) => (
                <button type="button" class="filter-btn" data-filter="tingkat" data-value={lv.value} aria-pressed="false">
                  {lv.name}
                </button>
              ))
            }
          </div>
        </div>
      </div>
      <p class="filter-result" data-result-count aria-live="polite"></p>
    </section>

    <section aria-labelledby="topik" class="block">
      <SectionHeading
        id="topik"
        eyebrow="Mulai berlatih"
        title="Latihan per Topik"
        lead="Daftar dikelompokkan per mata pelajaran, kelas, lalu elemen. Progres ditandai otomatis dari soal yang pernah kamu kerjakan di peramban ini."
      />
      {
        groups.map((subjectGroup) => (
          <section
            class="subject-group"
            data-subject-group
            aria-labelledby={`mapel-${subjectGroup.subject}`}
          >
            <h3 class="subject-title" id={`mapel-${subjectGroup.subject}`}>
              {subjectGroup.label}
            </h3>
            {subjectGroup.grades.map((group) => (
              <section
                class="grade-group"
                data-grade-group
                aria-labelledby={`kelas-${subjectGroup.subject}-${group.grade}`}
              >
                <h4 class="grade-title" id={`kelas-${subjectGroup.subject}-${group.grade}`}>
                  {group.label}
                </h4>
                {group.elements.map((elementGroup) => (
                  <div
                    class="element-group"
                    data-practice-group
                    aria-labelledby={`elemen-${subjectGroup.subject}-${group.grade}-${elementGroup.element}`}
                  >
                    <h5
                      class:list={['element-title', `accent-${elementGroup.element}`]}
                      id={`elemen-${subjectGroup.subject}-${group.grade}-${elementGroup.element}`}
                    >
                      <span class="element-dot" aria-hidden="true"></span>
                      {elementGroup.label}
                    </h5>
                    <div class="grid grid-3">
                      {elementGroup.topics.map((topic) => (
                        <PracticeCard
                          title={topic.title}
                          summary={topic.summary}
                          grade={topic.grade}
                          element={topic.element}
                          slug={topic.slug}
                          subject={topicSubject(topic)}
                          counts={practiceCounts(topic.id)}
                          questionIds={questionsByTopic(topic.id).map((q) => q.id)}
                        />
                      ))}
                    </div>
                  </div>
                ))}
              </section>
            ))}
          </section>
        ))
      }
      <p class="empty-state card" data-empty hidden>
        <strong>Belum ada latihan yang cocok.</strong>
        <span class="text-muted">Coba ubah atau reset filter untuk melihat topik lain.</span>
      </p>
    </section>
  </div>

  <section class="section-alt cta-section">
    <div class="container">
      <CtaCard
        eyebrow="Langkah berikutnya"
        title="Sudah selesai berlatih?"
        text="Lihat bagaimana topik-topik saling terhubung, atau coba sendiri konsepnya lewat eksplorasi interaktif."
        accentClass="accent-aljabar-fungsi"
        reveal
        dataReveal
        actions={[
          { label: 'Lihat peta pembelajaran', href: url('/peta-pembelajaran'), variant: 'primary' },
          { label: 'Coba eksplorasi', href: url('/eksplorasi'), variant: 'secondary' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .block {
    padding-block: 2rem;
  }
  .block + .block {
    border-top: 1px solid var(--color-border);
  }
  .level-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .level-card h3 {
    margin: 0;
  }
  .level-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.93rem;
  }
  .level-count {
    margin-top: auto;
    padding-top: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .level-num {
    position: absolute;
    right: 0.6rem;
    top: -0.6rem;
    font-family: var(--font-serif);
    font-size: 5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--accent, var(--color-primary));
    opacity: 0.1;
    pointer-events: none;
    user-select: none;
  }
  .filter-bar {
    display: grid;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .filter-group {
    display: grid;
    gap: 0.5rem;
  }
  .filter-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .filter-btn {
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text);
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-surface);
    cursor: pointer;
    transition:
      background-color var(--dur-fast),
      border-color var(--dur-fast),
      color var(--dur-fast),
      transform var(--dur-fast) var(--ease-bounce);
  }
  .filter-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    transform: translateY(-1px);
  }
  .filter-btn[aria-pressed='true'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .filter-btn:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }
  .filter-result {
    margin: 0.85rem 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .subject-group + .subject-group {
    margin-top: 2.75rem;
  }
  .subject-title {
    margin: 0 0 1.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--color-border-strong);
    font-size: 1.65rem;
  }
  .grade-group + .grade-group {
    margin-top: 2rem;
  }
  .grade-title {
    margin: 0 0 1rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid var(--color-border);
    font-size: 1.4rem;
  }
  .element-group + .element-group {
    margin-top: 1.5rem;
  }
  .element-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.85rem;
    font-size: 1.02rem;
    font-family: var(--font-sans);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--color-text-muted);
  }
  .element-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--accent, var(--color-primary));
  }
  .empty-state {
    display: grid;
    gap: 0.2rem;
    padding: 1.6rem 1rem;
    text-align: center;
    border-style: dashed;
    color: var(--color-text);
  }
  .cta-section {
    padding-block: 2.5rem;
  }
</style>

<script>
  import { loadProgress, summarize, type ProgressMap } from '@/lib/progress';
  import { matchesAny } from '@/lib/filter';
  import { setupFilterPage } from '@/lib/filter-dom';

  const root = document.querySelector<HTMLElement>('[data-latihan-root]');

  if (root) {
    const KEYS = ['kelas', 'elemen', 'tingkat'] as const;

    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-practice-card]'));
    const countEl = root.querySelector<HTMLElement>('[data-result-count]');
    const emptyEl = root.querySelector<HTMLElement>('[data-empty]');
    const groupEls = Array.from(root.querySelectorAll<HTMLElement>('[data-practice-group]'));
    const gradeEls = Array.from(root.querySelectorAll<HTMLElement>('[data-grade-group]'));
    const subjectEls = Array.from(root.querySelectorAll<HTMLElement>('[data-subject-group]'));

    let progress: ProgressMap = {};
    try {
      progress = loadProgress(window.localStorage);
    } catch {
      progress = {};
    }

    function questionIdsOf(card: HTMLElement): string[] {
      const raw = card.getAttribute('data-question-ids');
      if (!raw) return [];
      try {
        const parsed: unknown = JSON.parse(raw);
        if (Array.isArray(parsed)) return parsed.filter((id): id is string => typeof id === 'string');
      } catch {
        return [];
      }
      return [];
    }

    function updateProgress(): void {
      for (const card of cards) {
        const chip = card.querySelector<HTMLElement>('[data-progress-chip]');
        if (!chip) continue;
        const { answered, total } = summarize(progress, questionIdsOf(card));
        chip.textContent = `${answered}/${total} dikerjakan`;
        chip.classList.toggle('is-started', answered > 0 && answered < total);
        chip.classList.toggle('is-complete', total > 0 && answered === total);
      }
    }

    function refreshProgress(): void {
      try {
        progress = loadProgress(window.localStorage);
      } catch {
        progress = {};
      }
      updateProgress();
    }

    const selected = (value: string | undefined): Set<string> =>
      value ? new Set([value]) : new Set();

    function matches(card: HTMLElement, values: Record<string, string>): boolean {
      if (!matchesAny(selected(values.kelas), [card.getAttribute('data-kelas') ?? ''])) return false;
      if (!matchesAny(selected(values.elemen), [card.getAttribute('data-elemen') ?? ''])) return false;
      const levels = (card.getAttribute('data-levels') ?? '').split(/\s+/).filter(Boolean);
      return matchesAny(selected(values.tingkat), levels);
    }

    function apply(values: Record<string, string>): void {
      let visible = 0;
      for (const card of cards) {
        const show = matches(card, values);
        card.hidden = !show;
        if (show) visible += 1;
      }

      for (const group of groupEls) {
        group.hidden = group.querySelector<HTMLElement>('[data-practice-card]:not([hidden])') === null;
      }
      for (const grade of gradeEls) {
        grade.hidden = grade.querySelector<HTMLElement>('[data-practice-group]:not([hidden])') === null;
      }
      for (const subject of subjectEls) {
        subject.hidden = subject.querySelector<HTMLElement>('[data-grade-group]:not([hidden])') === null;
      }

      if (emptyEl) emptyEl.hidden = visible !== 0;
      if (countEl) {
        countEl.textContent =
          visible === 0
            ? 'Tidak ada latihan yang cocok dengan filter ini.'
            : `Menampilkan ${visible} dari ${cards.length} topik latihan.`;
      }
    }

    const groups = Array.from(root.querySelectorAll<HTMLElement>('.filter-group'))
      .map((group) => ({
        key: group.querySelector<HTMLElement>('[data-filter]')?.getAttribute('data-filter') ?? '',
        group,
        chipSelector: '[data-filter]',
        valueAttr: 'data-value',
        allValue: '',
      }))
      .filter((spec) => (KEYS as readonly string[]).includes(spec.key));

    setupFilterPage({ groups, apply, syncUrl: true });

    updateProgress();

    window.addEventListener('mtk:progress', refreshProgress);
    window.addEventListener('pageshow', refreshProgress);
    window.addEventListener('storage', refreshProgress);
  }
</script>
