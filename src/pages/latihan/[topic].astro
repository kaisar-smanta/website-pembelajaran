---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import QuestionCard from '@/components/exercises/QuestionCard.astro';
import { getTopic, resolveTopics, topicSubject } from '@/data/topics';
import { assessmentCategories, questionsByTopic, topicIdsWithQuestions } from '@/data/questions';
import { ELEMENTS } from '@/data/curriculum';
import { DIFFICULTY_LABELS, DIFFICULTY_ORDER } from '@/data/display';
import { difficultyCounts, groupByDifficulty } from '@/lib/practice';
import { buildReviewEntries } from '@/lib/review-entries';
import { url, topicUrl } from '@/utils/url';
import { renderInlineMarkdown } from '@/utils/markdown';
import type { Difficulty } from '@/types/content';

export function getStaticPaths() {
  const ids = topicIdsWithQuestions();
  return ids
    .map((id) => getTopic(id))
    .filter((t): t is NonNullable<typeof t> => Boolean(t))
    .map((topic) => ({ params: { topic: topic.slug }, props: { topicId: topic.id } }));
}

interface Props {
  topicId: string;
}
const { topicId } = Astro.props;
const topic = getTopic(topicId);
const all = questionsByTopic(topicId);
const allQuestionIds = all.map((q) => q.id);
const levelLead: Record<Difficulty, string> = {
  dasar: 'Pemanasan untuk memastikan istilah dan prosedur dasar sudah melekat.',
  cakap: 'Terapkan konsep pada masalah berlapis, lengkap dengan pemodelan dan interpretasi.',
  mahir: 'Soal nonrutin yang menuntut pemilihan strategi, argumen, dan evaluasi.',
};
const levelAccent: Record<Difficulty, string> = {
  dasar: 'var(--color-success)',
  cakap: 'var(--color-primary)',
  mahir: 'var(--color-warning)',
};
const counts = difficultyCounts(all);
const byDifficulty = groupByDifficulty(all);
const reviewEntries = buildReviewEntries(all);
const prerequisites = resolveTopics(topic?.prerequisites);
const related = resolveTopics(topic?.relatedTopics);
const objectives = topic?.objectives ?? [];
const leadHtml = topic ? renderInlineMarkdown(topic.summary) : undefined;
const materialUrl = topic
  ? topicUrl(topic.grade, topic.element, topic.slug, topicSubject(topic))
  : url('/latihan');
const elementName = topic ? ELEMENTS[topic.element].name : 'Latihan';
const accentClass = topic ? `accent-${topic.element}` : '';
const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Latihan & Asesmen', href: url('/latihan') },
  { label: topic?.title ?? topicId },
];
const meta = [
  `${all.length} soal`,
  `${counts.dasar} dasar · ${counts.cakap} cakap · ${counts.mahir} mahir`,
];
const revealStyle = (i: number) => `--reveal-delay:${Math.min(i, 6) * 60}ms`;

// Faset kategori hanya menampilkan kategori yang benar-benar ada di topik ini.
const presentCategories = assessmentCategories
  .filter((category) => all.some((q) => q.category === category.id))
  .map((category) => ({
    ...category,
    count: all.filter((q) => q.category === category.id).length,
  }));
---

<BaseLayout title={`Latihan ${topic?.title ?? ''}`} description={`Latihan soal ${topic?.title} berjenjang.`}>
  <PageHeader
    title={topic?.title ?? topicId}
    eyebrow={elementName}
    leadHtml={leadHtml}
    crumbs={crumbs}
    element={topic?.element}
    icon
    watermark
    narrow
    meta={meta}
  />

  <div class:list={['container', 'container-narrow', accentClass]}>
    {
      topic && (
        <section class="context" aria-labelledby="konteks-topik">
          <SectionHeading
            id="konteks-topik"
            eyebrow="Sebelum berlatih"
            title="Konteks topik"
            lead="Pahami kaitan topik ini dengan materi yang sudah dan akan kamu pelajari."
          />

          <div class="context-grid">
            {objectives.length > 0 && (
              <div class="context-card card card-accent">
                <h3>Tujuan Pembelajaran</h3>
                <ul class="objective-list">
                  {objectives.map((o) => (
                    <li set:html={renderInlineMarkdown(o.text)} />
                  ))}
                </ul>
              </div>
            )}

            {prerequisites.length > 0 && (
              <nav class="context-card card" aria-label="Topik prasyarat">
                <h3>Prasyarat</h3>
                <p class="text-muted">Kuasai dulu topik berikut agar latihan terasa lebih mudah.</p>
                <ul class="topic-links">
                  {prerequisites.map((t) => (
                    <li>
                      <a href={topicUrl(t.grade, t.element, t.slug, topicSubject(t))}>{t.title}</a>
                      <span class="badge">Kelas {t.grade}</span>
                    </li>
                  ))}
                </ul>
              </nav>
            )}

            {related.length > 0 && (
              <nav class="context-card card" aria-label="Topik terkait">
                <h3>Topik Terkait</h3>
                <p class="text-muted">Perluas pemahaman lewat topik yang masih satu keluarga.</p>
                <ul class="topic-links">
                  {related.map((t) => (
                    <li>
                      <a href={topicUrl(t.grade, t.element, t.slug, topicSubject(t))}>{t.title}</a>
                      <span class="badge">Kelas {t.grade}</span>
                    </li>
                  ))}
                </ul>
              </nav>
            )}
          </div>

          <a class="btn btn-primary context-material" href={materialUrl}>
            Baca materi {topic.title}
          </a>
        </section>
      )
    }

    <aside
      class="progress card card-accent"
      data-question-ids={JSON.stringify(allQuestionIds)}
      aria-label="Ringkasan kemajuan latihan"
    >
      <div class="progress-head">
        <div>
          <p class="eyebrow-badge">Kemajuanmu</p>
          <h2>Ringkasan latihan</h2>
        </div>
        <p class="progress-intro text-muted">
          Hitungan bertambah otomatis setiap kali kamu menjawab soal di halaman ini.
        </p>
      </div>

      <dl class="progress-stats">
        <div class="progress-stat">
          <dt>Dijawab</dt>
          <dd data-stat-answered>{`0/${all.length}`}</dd>
        </div>
        <div class="progress-stat">
          <dt>Benar</dt>
          <dd data-stat-correct>0</dd>
        </div>
        <div class="progress-stat">
          <dt>Ketepatan</dt>
          <dd data-stat-accuracy>0%</dd>
        </div>
      </dl>

      <div
        class="progress-track"
        data-progress-track
        role="progressbar"
        aria-label="Kemajuan menjawab soal"
        aria-valuemin="0"
        aria-valuemax={all.length}
        aria-valuenow="0"
        aria-valuetext={`0 dari ${all.length} soal dijawab`}
      >
        <span class="progress-bar" data-progress-bar style="width: 0%"></span>
      </div>

      <p class="progress-note text-soft" data-progress-note aria-live="polite">
        Belum ada soal yang dijawab. Mulai dari tingkat Dasar.
      </p>

      <div class="progress-review" data-review hidden>
        <a class="btn btn-secondary btn-sm" data-review-link href="#">
          Tinjau soal yang belum tepat
        </a>
        <ul class="review-list" data-review-list aria-label="Daftar soal yang belum tepat" hidden>
          {
            reviewEntries.map((entry) => (
              <li class="review-item" data-review-item={entry.id} hidden>
                <a class="review-item-link" href={`#q-${entry.id}`}>
                  <span class="review-num" aria-hidden="true">{entry.number}</span>
                  <span class="review-text">{entry.snippet}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>

    <section class="filter-block" data-practice-filter aria-labelledby="saring-soal">
      <SectionHeading
        id="saring-soal"
        eyebrow="Saring"
        title="Temukan soal"
        lead="Saring soal menurut tingkat, kategori, atau status pengerjaanmu, lalu telusuri tiap halaman."
      />
      <div class="filter-bar">
        <div class="filter-group" role="group" aria-labelledby="filter-tingkat-label">
          <span class="filter-label" id="filter-tingkat-label">Tingkat</span>
          <div class="filter-options">
            <button type="button" class="filter-btn" data-filter="tingkat" data-value="" aria-pressed="true">
              Semua
            </button>
            {
              DIFFICULTY_ORDER.filter((d) => counts[d] > 0).map((d) => (
                <button
                  type="button"
                  class="filter-btn"
                  data-filter="tingkat"
                  data-value={d}
                  aria-pressed="false"
                >
                  {DIFFICULTY_LABELS[d]}
                </button>
              ))
            }
          </div>
        </div>
        {
          presentCategories.length > 0 && (
            <div class="filter-group" role="group" aria-labelledby="filter-kategori-label">
              <span class="filter-label" id="filter-kategori-label">
                Kategori
              </span>
              <div class="filter-options">
                <button
                  type="button"
                  class="filter-btn"
                  data-filter="kategori"
                  data-value=""
                  aria-pressed="true"
                >
                  Semua
                </button>
                {presentCategories.map((category) => (
                  <button
                    type="button"
                    class="filter-btn"
                    data-filter="kategori"
                    data-value={category.id}
                    aria-pressed="false"
                    title={category.description}
                  >
                    {category.name}
                    <span class="filter-count">{category.count}</span>
                  </button>
                ))}
              </div>
            </div>
          )
        }
        <div class="filter-group" role="group" aria-labelledby="filter-tinjau-label">
          <span class="filter-label" id="filter-tinjau-label">
            Tinjau ulang
          </span>
          <div class="filter-options">
            <button type="button" class="filter-btn" data-filter="tinjau" data-value="" aria-pressed="true">
              Semua
            </button>
            <button
              type="button"
              class="filter-btn"
              data-filter="tinjau"
              data-value="missed"
              aria-pressed="false"
            >
              Belum tepat
            </button>
            <button
              type="button"
              class="filter-btn"
              data-filter="tinjau"
              data-value="unanswered"
              aria-pressed="false"
            >
              Belum dicoba
            </button>
            <button
              type="button"
              class="filter-btn"
              data-filter="tinjau"
              data-value="both"
              aria-pressed="false"
            >
              Keduanya
            </button>
          </div>
        </div>
      </div>
      <p class="filter-result" data-filter-count aria-live="polite"></p>
      <div class="quick-drill">
        <button type="button" class="btn btn-primary btn-sm" data-quick-drill aria-pressed="false">
          Latihan kilat · 5 soal acak
        </button>
        <p class="quick-status text-soft" data-quick-status aria-live="polite"></p>
      </div>
    </section>

    {
      DIFFICULTY_ORDER.map((d, di) => {
        const items = byDifficulty[d];
        if (!items.length) return null;
        return (
          <section
            class="level-section reveal"
            style={`--accent: ${levelAccent[d]}; ${revealStyle(di)}`}
            data-reveal
            aria-labelledby={`lv-${d}`}
          >
            <div class="level-head">
              <SectionHeading id={`lv-${d}`} title={DIFFICULTY_LABELS[d]} lead={levelLead[d]} reveal={false} />
              <span class={`badge badge-${d}`}>{items.length} soal</span>
            </div>
            <div class="level-cards">
              {items.map((q, i) => (
                <div
                  id={`q-${q.id}`}
                  class="q-item hover-lift reveal"
                  style={revealStyle(i)}
                  data-reveal
                  data-question-row={q.id}
                  data-difficulty={q.difficulty}
                  data-category={q.category ?? ''}
                >
                  <QuestionCard question={q} index={i} />
                </div>
              ))}
            </div>
          </section>
        );
      })
    }

    <nav class="pagination" data-pagination hidden aria-label="Navigasi halaman soal">
      <button type="button" class="btn btn-secondary btn-sm" data-page-prev>
        Sebelumnya
      </button>
      <span class="pagination-status" data-page-status aria-live="polite"></span>
      <button type="button" class="btn btn-secondary btn-sm" data-page-next>
        Berikutnya
      </button>
    </nav>

    <aside
      class={`topic-cta card card-accent hover-lift reveal${topic ? ` accent-${topic.element}` : ''}`}
      data-reveal
      aria-label="Langkah selanjutnya"
    >
      <div class="cta-copy">
        <p class="eyebrow-badge">Langkah selanjutnya</p>
        <h2>Selesai berlatih topik ini?</h2>
        <p class="text-muted">
          Ulangi materinya bila masih ada yang mengganjal, atau jelajahi topik lain di bank latihan.
        </p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-secondary" href={url('/latihan')}>← Semua latihan</a>
        {
          topic && (
            <a class="btn btn-secondary" href={url(`/latihan?elemen=${topic.element}`)}>
              Latihan elemen ini
            </a>
          )
        }
        {
          topic && (
            <a class="btn btn-primary" href={materialUrl}>
              Baca materi {topic.title}
            </a>
          )
        }
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .context {
    padding-block: 1.75rem 1rem;
  }
  .context :global(.section-heading) {
    margin-bottom: 1rem;
  }
  .context-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .context-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .context-card h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .context-card p {
    margin: 0;
    font-size: 0.9rem;
  }
  .objective-list,
  .topic-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .objective-list li {
    position: relative;
    padding-left: 1.15rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
  .objective-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent, var(--color-primary));
  }
  .topic-links li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .topic-links a {
    font-weight: 600;
  }
  .context-material {
    margin-top: 1.25rem;
  }

  .progress {
    margin-block: 0.5rem 1.5rem;
  }
  .progress-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
  }
  .progress-head .eyebrow-badge {
    margin-bottom: 0.6rem;
  }
  .progress-head h2 {
    margin: 0;
  }
  .progress-intro {
    margin: 0;
    max-width: 40ch;
    font-size: 0.9rem;
  }
  .progress-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.75rem;
    margin: 1.1rem 0 1rem;
  }
  .progress-stat {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface-2);
  }
  .progress-stat dt {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .progress-stat dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--color-primary);
  }
  .progress-track {
    height: 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
    overflow: hidden;
  }
  .progress-bar {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--accent, var(--color-primary));
    transition: width var(--dur) var(--ease-out-soft);
  }
  .progress-note {
    margin: 0.6rem 0 0;
    font-size: 0.88rem;
  }
  .progress-review {
    margin-top: 0.85rem;
  }
  .review-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .review-item-link {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface-2);
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.4;
    text-decoration: none;
  }
  .review-item-link:hover,
  .review-item-link:focus-visible {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .review-num {
    display: grid;
    place-items: center;
    flex: none;
    min-width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .review-text {
    min-width: 0;
  }

  .level-section {
    padding-block: 1.5rem;
  }
  .level-section + .level-section {
    border-top: 1px solid var(--color-border);
  }
  .level-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-bottom: 1.25rem;
    padding-left: 0.9rem;
    border-left: 3px solid var(--accent, var(--color-primary));
  }
  .level-head :global(.section-heading) {
    margin-bottom: 0;
  }
  .level-head :global(.section-heading h2) {
    margin-bottom: 0.2rem;
  }
  .level-cards {
    display: block;
  }
  .q-item {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .q-item :global(.question-card) {
    margin-bottom: 1rem;
  }
  .topic-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .cta-copy {
    max-width: 46ch;
  }
  .cta-copy .eyebrow-badge {
    margin-bottom: 0.6rem;
  }
  .cta-copy h2 {
    margin-bottom: 0.35rem;
  }
  .cta-copy p {
    margin: 0;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .filter-block {
    padding-block: 1.5rem;
  }
  .filter-block :global(.section-heading) {
    margin-bottom: 1rem;
  }
  .filter-bar {
    display: grid;
    gap: 1rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .filter-group {
    display: grid;
    gap: 0.5rem;
  }
  .filter-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .filter-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .filter-btn {
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text);
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-surface);
    cursor: pointer;
    transition:
      background-color var(--dur-fast),
      border-color var(--dur-fast),
      color var(--dur-fast);
  }
  .filter-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .filter-btn[aria-pressed='true'] {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .filter-btn:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }
  .filter-btn .filter-count {
    display: inline-grid;
    place-items: center;
    min-width: 1.2rem;
    height: 1.2rem;
    margin-left: 0.3rem;
    padding-inline: 0.3rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    background: color-mix(in srgb, var(--color-text) 10%, transparent);
    vertical-align: middle;
  }
  .filter-btn[aria-pressed='true'] .filter-count {
    background: color-mix(in srgb, var(--color-on-primary) 24%, transparent);
  }
  .filter-result {
    margin: 0.85rem 0 0;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .quick-drill {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--color-border);
  }
  .quick-status {
    margin: 0;
    font-size: 0.88rem;
  }
  .q-item[hidden],
  .level-section[hidden] {
    display: none !important;
  }
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .pagination[hidden] {
    display: none;
  }
  .pagination-status {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  import { setupPracticePage } from '@/lib/practice-runner';
  setupPracticePage();
</script>
