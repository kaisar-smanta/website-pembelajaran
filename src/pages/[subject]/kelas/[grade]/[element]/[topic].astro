---
import type { Application, Topic } from '@/types/content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import SectionBlock from '@/components/content/SectionBlock.astro';
import TopicApplications from '@/components/content/TopicApplications.astro';
import TopicProgress from '@/components/content/TopicProgress.astro';
import ElementIcon from '@/components/content/ElementIcon.astro';
import { ELEMENTS, GRADES, SUBJECTS, elementOrderFor } from '@/data/curriculum';
import { cpForTopic } from '@/data/curriculum/cp';
import { topicsBySubjectGradeElement, topicSubject, topics, resolveTopics } from '@/data/topics';
import { topicIdsWithQuestions } from '@/data/questions';
import { elementColor } from '@/data/display';
import { applicationsForTopic, getApplication } from '@/data/applications';
import { renderInlineMarkdown, stripMarkdown } from '@/utils/markdown';
import { url, subjectUrl, gradeUrl, elementUrl, topicUrl } from '@/utils/url';

export function getStaticPaths() {
  return topics
    .filter((t) => t.status !== 'rencana')
    .map((topic) => ({
      params: {
        subject: topicSubject(topic),
        grade: topic.grade,
        element: topic.element,
        topic: topic.slug,
      },
      props: { topic },
    }));
}

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
const subject = topicSubject(topic);
const subjectMeta = SUBJECTS[subject];
const elementMeta = ELEMENTS[topic.element];
const gradeMeta = GRADES[topic.grade];

const accent = elementColor(topic.element);

const gradeTopics = elementOrderFor(subject).flatMap((element) =>
  topicsBySubjectGradeElement(subject, topic.grade, element),
);
const currentIndex = gradeTopics.findIndex((t) => t.id === topic.id);
const prev = currentIndex > 0 ? gradeTopics[currentIndex - 1] : undefined;
const next =
  currentIndex >= 0 && currentIndex < gradeTopics.length - 1
    ? gradeTopics[currentIndex + 1]
    : undefined;

const practiceTopicIds = new Set(topicIdsWithQuestions());
const hasPractice = practiceTopicIds.has(topic.id);

const prerequisiteTopics = resolveTopics(topic.prerequisites);
const related = resolveTopics(topic.relatedTopics);

const curatedApplications = (topic.applications ?? [])
  .map((id) => getApplication(id))
  .filter((a): a is Application => a !== undefined);
const relatedApplications = Array.from(
  new Map(
    [...curatedApplications, ...applicationsForTopic(topic.id)].map((a) => [a.id, a]),
  ).values(),
);

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: subjectMeta.name, href: subjectUrl(subject) },
  { label: gradeMeta.name, href: gradeUrl(topic.grade, subject) },
  { label: elementMeta.name, href: elementUrl(topic.grade, topic.element, subject) },
  { label: topic.title },
];

const sectionList = topic.sections.filter((s) => s.kind !== 'catatan');
const description = stripMarkdown(topic.summary);

const cpCodes = cpForTopic(topic.id).map((s) => s.id);
---

<BaseLayout title={`${topic.title} — ${gradeMeta.name}`} description={description} ogType="article">
  <div class="topic-wrap container" style={`--accent: ${accent}`}>
    <Breadcrumbs items={crumbs} />

    <header class={`topic-header accent-${topic.element}`}>
      <span class="topic-watermark" aria-hidden="true">
        <ElementIcon element={topic.element} size={160} />
      </span>
      <div class="topic-header-inner">
        <div class="topic-head-top">
          <span class="element-chip">
            <ElementIcon element={topic.element} size={18} />
            {elementMeta.name}
          </span>
          <span class="badge badge-grade">{gradeMeta.name} · {gradeMeta.label}</span>
        </div>
        <h1>{topic.title}</h1>
        {topic.subtitle && <p class="subtitle">{topic.subtitle}</p>}
        <p class="topic-desc" set:html={renderInlineMarkdown(topic.description)}></p>
        <ul class="topic-facts">
          <li><strong>{sectionList.length}</strong> bagian materi</li>
          {topic.estimatedMinutes && <li>≈ <strong>{topic.estimatedMinutes}</strong> menit belajar</li>}
          {prerequisiteTopics.length > 0 && (
            <li><strong>{prerequisiteTopics.length}</strong> topik prasyarat</li>
          )}
          {related.length > 0 && <li><strong>{related.length}</strong> topik terkait</li>}
        </ul>
        {
          (cpCodes.length > 0 || topic.supplementary) && (
            <div class="cp-chips">
              <span class="cp-chips-label">Capaian Pembelajaran</span>
              {cpCodes.map((code) => (
                <span class="badge cp-chip">CP {code}</span>
              ))}
              {topic.supplementary && <span class="badge badge-pengayaan">Pengayaan</span>}
            </div>
          )
        }
        {topic.cpNote && <p class="cp-note text-soft" set:html={renderInlineMarkdown(topic.cpNote)} />}
      </div>
    </header>

    <div class="topic-layout">
      <article class="topic-main">
        {sectionList.map((section, index) => <SectionBlock section={section} index={index} topicId={topic.id} />)}

        <TopicApplications applications={relatedApplications} />

        <nav class="topic-pager no-print" aria-label="Navigasi topik">
          {
            prev ? (
              <a
                class="pager-link pager-prev hover-lift"
                rel="prev"
                href={topicUrl(topic.grade, prev.element, prev.slug, subject)}
              >
                <span class="pager-label">Sebelumnya</span>
                <span class="pager-title">← {prev.title}</span>
              </a>
            ) : (
              <a
                class="pager-link pager-prev pager-boundary hover-lift"
                href={elementUrl(topic.grade, topic.element, subject)}
              >
                <span class="pager-label">Kembali ke elemen</span>
                <span class="pager-title">← {elementMeta.name}</span>
              </a>
            )
          }
          {
            next ? (
              <a
                class="pager-link pager-next hover-lift"
                rel="next"
                href={topicUrl(topic.grade, next.element, next.slug, subject)}
              >
                <span class="pager-label">Selanjutnya</span>
                <span class="pager-title">{next.title} →</span>
              </a>
            ) : (
              <a
                class="pager-link pager-next pager-boundary hover-lift"
                href={gradeUrl(topic.grade, subject)}
              >
                <span class="pager-label">Lihat semua topik</span>
                <span class="pager-title">{gradeMeta.name} →</span>
              </a>
            )
          }
        </nav>
      </article>

      <aside class="topic-aside no-print" aria-label="Informasi topik">
        <div class="aside-primary">
          <div class="aside-card">
            <details class="outline-disclosure" data-outline-disclosure>
              <summary class="outline-summary">
                <h2 class="aside-heading">Isi Halaman</h2>
                <span class="outline-chevron" aria-hidden="true"></span>
              </summary>
              <ol class="outline" data-outline>
                {
                  sectionList.map((s) => (
                    <li>
                      <a href={`#${s.id}`}>{s.title ?? s.id}</a>
                    </li>
                  ))
                }
                {
                  relatedApplications.length > 0 && (
                    <li>
                      <a href="#penerapan">Penerapan di Dunia Nyata</a>
                    </li>
                  )
                }
              </ol>
            </details>
          </div>

          <TopicProgress />
        </div>

        <div class="aside-secondary">
          <div class="aside-card review-card" data-topic-review hidden>
            <h2 class="aside-heading">Ulas kesalahan</h2>
            <p class="review-lead" data-review-lead>
              Tinjau kembali soal yang belum tepat.
            </p>
            <ul class="aside-links review-list" data-review-list></ul>
          </div>

          {
            prerequisiteTopics.length ? (
              <div class="aside-card">
                <h2 class="aside-heading">Prasyarat</h2>
                <ul class="aside-links">
                  {prerequisiteTopics.map((t) => (
                    <li>
                      <a href={topicUrl(t.grade, t.element, t.slug, topicSubject(t))}>
                        <ElementIcon element={t.element} size={16} />
                        {t.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }

          {
            related.length ? (
              <div class="aside-card">
                <h2 class="aside-heading">Topik Terkait</h2>
                <ul class="aside-links">
                  {related.map((t) => (
                    <li>
                      <a href={topicUrl(t.grade, t.element, t.slug, topicSubject(t))}>
                        <ElementIcon element={t.element} size={16} />
                        {t.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }

          {
            relatedApplications.length ? (
              <div class="aside-card">
                <h2 class="aside-heading">Penerapan Nyata</h2>
                <ul class="aside-links">
                  {relatedApplications.map((a) => (
                    <li>
                      <a href={url(`/aplikasi/${a.id}`)}>{a.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : null
          }

          <div class="aside-card">
            <h2 class="aside-heading">Aksi</h2>
            <div class="aside-actions">
              {
                hasPractice && (
                  <a class="btn btn-secondary btn-sm" href={url(`/latihan/${topic.slug}`)}>
                    Latihan topik ini
                  </a>
                )
              }
              <button type="button" class="btn btn-ghost btn-sm" data-print>Cetak halaman</button>
              <button type="button" class="btn btn-secondary btn-sm" data-print-worksheet>
                Cetak lembar kerja
              </button>
              <label class="print-key" for="print-key-toggle">
                <input type="checkbox" id="print-key-toggle" data-print-key />
                <span>Sertakan kunci jawaban</span>
              </label>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var disclosure = document.querySelector('[data-outline-disclosure]');
    if (disclosure && window.matchMedia('(min-width: 62rem)').matches) {
      disclosure.open = true;
    }
  })();
</script>

<script>
  import { loadProgress, missedQuestionIds, type ProgressMap } from '@/lib/progress';

  const body = document.body;
  const keyToggle = document.querySelector<HTMLInputElement>('[data-print-key]');

  function clearPrintMode() {
    body.classList.remove('print-worksheet', 'print-with-key');
  }

  document.querySelector('[data-print]')?.addEventListener('click', () => {
    clearPrintMode();
    window.print();
  });

  document.querySelector('[data-print-worksheet]')?.addEventListener('click', () => {
    clearPrintMode();
    body.classList.add('print-worksheet');
    if (keyToggle?.checked) body.classList.add('print-with-key');
    window.addEventListener('afterprint', clearPrintMode, { once: true });
    window.print();
  });

  const disclosure = document.querySelector<HTMLDetailsElement>('[data-outline-disclosure]');
  if (disclosure) {
    const desktop = window.matchMedia('(min-width: 62rem)');
    const syncDisclosure = () => {
      disclosure.open = desktop.matches;
    };
    desktop.addEventListener('change', syncDisclosure);
    disclosure.addEventListener('toggle', () => {
      if (desktop.matches && !disclosure.open) disclosure.open = true;
    });
  }

  const outline = document.querySelector('[data-outline]');
  if (outline && 'IntersectionObserver' in window) {
    const links = Array.from(outline.querySelectorAll<HTMLAnchorElement>('a'));
    const sections = links
      .map((link) => {
        const id = link.getAttribute('href')?.slice(1) ?? '';
        const el = id ? document.getElementById(id) : null;
        return el ? { link, el } : null;
      })
      .filter((entry): entry is { link: HTMLAnchorElement; el: HTMLElement } => entry !== null);

    if (sections.length) {
      const setActive = (el: HTMLElement) => {
        sections.forEach((entry) => {
          const active = entry.el === el;
          entry.link.classList.toggle('is-active', active);
          if (active) entry.link.setAttribute('aria-current', 'true');
          else entry.link.removeAttribute('aria-current');
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]) setActive(visible[0].target as HTMLElement);
        },
        { rootMargin: '-18% 0px -68% 0px', threshold: 0 },
      );
      sections.forEach((entry) => observer.observe(entry.el));
    }
  }

  // Daftar "Ulas kesalahan": menautkan langsung ke setiap soal yang belum tepat
  // di halaman ini, bukan hanya yang pertama.
  function setupTopicReview() {
    const wrap = document.querySelector<HTMLElement>('[data-topic-review]');
    const list = wrap?.querySelector<HTMLElement>('[data-review-list]');
    const lead = wrap?.querySelector<HTMLElement>('[data-review-lead]');
    if (!wrap || !list) return;

    const cards = Array.from(
      document.querySelectorAll<HTMLElement>('.topic-main [data-question]'),
    );
    const byId = new Map<string, HTMLElement>();
    for (const card of cards) {
      const id = card.getAttribute('data-question-id');
      if (!id) continue;
      card.style.scrollMarginTop = 'calc(var(--header-h) + 1rem)';
      if (byId.has(id)) continue;
      if (!card.id) card.id = `q-${id}`;
      byId.set(id, card);
    }
    const ids = Array.from(byId.keys());
    if (!ids.length) return;

    let storage: Storage | undefined;
    try {
      storage = window.localStorage;
    } catch {
      storage = undefined;
    }

    let reduceMotion = false;
    try {
      reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch {
      reduceMotion = false;
    }

    const labelFor = (id: string): string => {
      const card = byId.get(id);
      const prompt = card?.querySelector('.q-prompt');
      const text = (prompt?.textContent ?? '').replace(/\s+/g, ' ').trim();
      if (!text) return `Soal ${id}`;
      return text.length > 68 ? `${text.slice(0, 68)}…` : text;
    };

    const render = () => {
      let attempts: ProgressMap = {};
      try {
        attempts = loadProgress(storage);
      } catch {
        attempts = {};
      }
      const missed = missedQuestionIds(attempts, ids);
      list.innerHTML = '';
      if (!missed.length) {
        wrap.hidden = true;
        return;
      }
      wrap.hidden = false;
      if (lead) {
        lead.textContent =
          missed.length === 1
            ? 'Satu soal belum tepat. Tinjau lagi langkahmu.'
            : `${missed.length} soal belum tepat. Tinjau lagi langkahmu.`;
      }
      for (const id of missed) {
        const card = byId.get(id);
        if (!card) continue;
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `#${card.id}`;
        link.textContent = labelFor(id);
        link.addEventListener('click', (event) => {
          event.preventDefault();
          card.scrollIntoView({
            behavior: reduceMotion ? 'auto' : 'smooth',
            block: 'start',
          });
          if (window.history.replaceState) {
            window.history.replaceState(null, '', `#${card.id}`);
          }
        });
        item.appendChild(link);
        list.appendChild(item);
      }
    };

    render();
    window.addEventListener('mtk:progress', render);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTopicReview);
  } else {
    setupTopicReview();
  }
</script>

<style>
  .topic-header {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 1.6rem clamp(1rem, 3vw, 1.6rem);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--accent, var(--color-primary));
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 92% 8%, color-mix(in srgb, var(--accent) 15%, transparent), transparent 46%),
      var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .topic-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
    -webkit-mask-image: radial-gradient(circle at 82% 4%, #000, transparent 72%);
    mask-image: radial-gradient(circle at 82% 4%, #000, transparent 72%);
    opacity: 0.6;
    pointer-events: none;
  }
  .topic-header-inner {
    position: relative;
    z-index: 1;
  }
  .topic-watermark {
    position: absolute;
    z-index: 0;
    right: -1.5rem;
    bottom: -3rem;
    width: 11rem;
    height: 11rem;
    color: var(--accent);
    opacity: 0.08;
    pointer-events: none;
  }
  .topic-watermark :global(svg) {
    width: 100%;
    height: 100%;
  }
  .topic-head-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .element-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 42%, var(--color-border));
    background: color-mix(in srgb, var(--accent) 10%, var(--color-surface));
    color: color-mix(in srgb, var(--accent) 68%, var(--color-text));
    font-weight: 700;
    font-size: 0.82rem;
  }
  .subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-top: -0.3rem;
  }
  .topic-desc {
    max-width: 70ch;
    color: var(--color-text-muted);
  }
  .topic-facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1rem 0 0;
  }
  .topic-facts li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--color-border));
    background: color-mix(in srgb, var(--accent) 7%, var(--color-surface-2));
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
  .topic-facts strong {
    color: var(--color-text);
  }
  .cp-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }
  .cp-chips-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-text-soft);
    margin-right: 0.15rem;
  }
  .cp-chip {
    font-family: var(--font-mono);
    color: color-mix(in srgb, var(--accent) 70%, var(--color-text));
    background: color-mix(in srgb, var(--accent) 10%, var(--color-surface));
    border-color: color-mix(in srgb, var(--accent) 30%, var(--color-border));
  }
  .cp-note {
    margin: 0.5rem 0 0;
    max-width: 60ch;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .topic-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 2.5rem;
    align-items: start;
    padding-top: 1.5rem;
    padding-bottom: 2rem;
  }
  .topic-main {
    min-width: 0;
  }

  .topic-aside {
    position: sticky;
    top: calc(var(--header-h) + 1.25rem);
    display: grid;
    gap: 1rem;
  }
  .aside-primary,
  .aside-secondary {
    display: grid;
    gap: 1rem;
  }
  .aside-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid color-mix(in srgb, var(--accent) 72%, var(--color-border));
    border-radius: var(--radius-lg);
    padding: 1rem;
  }
  .aside-heading {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-soft);
    margin-bottom: 0.6rem;
  }
  .aside-heading::before {
    content: '';
    flex: 0 0 auto;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .outline-disclosure {
    display: block;
  }
  .outline-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 1.5rem;
    cursor: pointer;
    list-style: none;
  }
  .outline-summary::-webkit-details-marker {
    display: none;
  }
  .outline-summary::marker {
    content: '';
  }
  .outline-summary .aside-heading {
    flex: 1 1 auto;
    margin-bottom: 0;
  }
  .outline-chevron {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.15rem;
    border-right: 2px solid var(--color-text-soft);
    border-bottom: 2px solid var(--color-text-soft);
    transform: rotate(45deg);
    transition: transform var(--dur-fast) var(--ease-out-soft);
  }
  .outline-disclosure[open] .outline-chevron {
    transform: rotate(225deg);
  }
  .outline {
    list-style: none;
    counter-reset: outline;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .outline li {
    counter-increment: outline;
  }
  .outline a::before {
    content: counter(outline) '. ';
    color: var(--color-text-soft);
    font-variant-numeric: tabular-nums;
  }
  .outline a {
    display: block;
    padding: 0.3rem 0.45rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.88rem;
    border-left: 2px solid transparent;
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast),
      border-color var(--dur-fast);
  }
  .outline a:hover {
    background: var(--color-surface-2);
    color: var(--color-primary);
  }
  .outline a.is-active {
    background: color-mix(in srgb, var(--accent) 12%, var(--color-surface));
    color: var(--color-text);
    font-weight: 600;
    border-left-color: var(--accent);
  }
  .aside-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .aside-links a {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    padding: 0.25rem 0;
  }
  .aside-links a:hover {
    color: var(--color-primary);
  }
  .aside-actions {
    display: grid;
    gap: 0.5rem;
  }
  .aside-actions .btn {
    justify-content: center;
  }
  .print-key {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .print-key input {
