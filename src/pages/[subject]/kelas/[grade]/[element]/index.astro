---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import TopicCard from '@/components/content/TopicCard.astro';
import ElementIcon from '@/components/content/ElementIcon.astro';
import MathMascot from '@/components/content/MathMascot.astro';
import CtaCard from '@/components/ui/CtaCard.astro';
import { site } from '@/data/site';
import {
  ELEMENTS,
  GRADES,
  SUBJECTS,
  elementOrderFor,
} from '@/data/curriculum';
import { topicsBySubjectGradeElement, plannedTopics } from '@/data/topics';
import { topicIdsWithQuestions } from '@/data/questions';
import { allGradeElementCombos, subjectsWithContent } from '@/lib/routes';
import { url, subjectUrl, gradeUrl, elementUrl } from '@/utils/url';
import type { ElementId, Grade, SubjectId } from '@/types/content';

export function getStaticPaths() {
  const paths: {
    params: { subject: SubjectId; grade: Grade; element: ElementId };
    props: { subject: SubjectId; grade: Grade; element: ElementId };
  }[] = [];
  for (const subject of subjectsWithContent()) {
    for (const { grade, element } of allGradeElementCombos(subject)) {
      paths.push({ params: { subject, grade, element }, props: { subject, grade, element } });
    }
  }
  return paths;
}

interface Props {
  grade: Grade;
  element: ElementId;
  subject: SubjectId;
}
const { grade, element, subject } = Astro.props;
const subjectMeta = SUBJECTS[subject];
const gradeMeta = GRADES[grade];
const elementMeta = ELEMENTS[element];

const complete = topicsBySubjectGradeElement(subject, grade, element);
const planned =
  subject === 'matematika'
    ? plannedTopics.filter((p) => p.grade === grade && p.element === element)
    : [];
const otherElements = elementOrderFor(subject).filter((e) => e !== element);

const practiceTopicIds = new Set(topicIdsWithQuestions());
const hasPractice = complete.some((t) => practiceTopicIds.has(t.id));
// Halaman hanya berisi penanda "Segera hadir" bila belum ada materi maupun
// rencana; jangan indeks halaman kosong semacam itu.
const hasContent = complete.length > 0 || planned.length > 0;

type CtaAction = { label: string; href: string; variant?: 'primary' | 'secondary' };
const nextActions: CtaAction[] = hasPractice
  ? [
      {
        label: 'Latihan materi ini',
        href: url(`/latihan?kelas=${grade}&elemen=${element}`),
        variant: 'primary',
      },
      { label: 'Semua latihan', href: url('/latihan'), variant: 'secondary' },
      { label: 'Peta pembelajaran', href: url('/peta-pembelajaran'), variant: 'secondary' },
    ]
  : [
      { label: 'Latihan soal', href: url('/latihan'), variant: 'primary' },
      { label: 'Peta pembelajaran', href: url('/peta-pembelajaran'), variant: 'secondary' },
    ];

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: subjectMeta.name, href: subjectUrl(subject) },
  { label: gradeMeta.name, href: gradeUrl(grade, subject) },
  { label: elementMeta.name },
];
// Judul halaman elemen sama antar mata pelajaran; bedakan yang tingkat lanjut.
const subjectTag = subject === 'matematika-lanjut' ? ' · Matematika Tingkat Lanjut' : '';
---

<BaseLayout
  title={`${elementMeta.name} · ${gradeMeta.name}${subjectTag}`}
  description={`${elementMeta.description} Materi ${elementMeta.name} untuk ${gradeMeta.name}${subjectTag}.`}
  noindex={!hasContent}
>
  <PageHeader
    title={elementMeta.name}
    eyebrow={`${gradeMeta.name} · ${gradeMeta.label}`}
    lead={elementMeta.description}
    crumbs={crumbs}
    element={element}
    icon
    watermark
  />

  <div class="container">
    <div class="element-switch no-print" aria-label="Elemen lain">
      <span class="text-soft">Elemen:</span>
      {
        otherElements.map((e) => (
          <a class="btn btn-secondary btn-sm" href={elementUrl(grade, e, subject)}>
            {ELEMENTS[e].name}
          </a>
        ))
      }
    </div>

    {
      complete.length > 0 && (
        <section class="topic-section reveal" aria-labelledby="materi-lengkap">
          <SectionHeading
            id="materi-lengkap"
            eyebrow="Siap dipelajari"
            title="Materi Tersedia"
            lead={`${complete.length} topik ${elementMeta.short} untuk ${gradeMeta.name}.`}
          />
          <div class="grid grid-3">
            {complete.map((t, i) => (
              <TopicCard
                title={t.title}
                summary={t.summary}
                grade={t.grade}
                element={t.element}
                slug={t.slug}
                subject={subject}
                supplementary={t.supplementary}
                showElementName={false}
                delay={i * 60}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      planned.length > 0 && (
        <section
          class="topic-section planned-section reveal"
          aria-labelledby="materi-rencana"
        >
          <SectionHeading
            id="materi-rencana"
            eyebrow="Peta kurikulum"
            title="Dalam Pengembangan"
            lead="Topik berikut sudah masuk peta kurikulum dan akan dilengkapi secara bertahap. Arsitektur konten memungkinkan penambahan tanpa mengubah aplikasi."
          />
          <div class="grid grid-3">
            {planned.map((t, i) => (
              <TopicCard
                title={t.title}
                summary={t.summary}
                grade={t.grade}
                element={t.element}
                slug={t.slug}
                subject={subject}
                status="rencana"
                showElementName={false}
                delay={i * 60}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      complete.length === 0 && planned.length === 0 && (
        <section class="empty-section reveal" aria-labelledby="materi-kosong">
          <div class:list={['card', 'empty-card', `accent-${element}`]}>
            <span class="icon-tile" aria-hidden="true">
              <ElementIcon element={element} size={24} />
            </span>
            <MathMascot
              size={6}
              state="oops"
              label={`${site.mascot.name} belum menemukan topik di sini`}
            />
            <p class="eyebrow-badge">Segera hadir</p>
            <h2 id="materi-kosong">Belum ada topik di sini</h2>
            <p class="text-muted">
              Materi {elementMeta.short} untuk {gradeMeta.name} sedang disiapkan. Sementara itu,
              jelajahi elemen lain di jenjang yang sama.
            </p>
            <div class="empty-links">
              {otherElements.map((e) => (
                <a class="btn btn-secondary btn-sm" href={elementUrl(grade, e, subject)}>
                  {ELEMENTS[e].name}
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <section class="next-step reveal no-print" aria-labelledby="langkah-berikutnya">
      <CtaCard
        eyebrow="Langkah berikutnya"
        title="Latih dan jelajahi lebih jauh"
        titleId="langkah-berikutnya"
        text="Uji pemahamanmu lewat latihan berjenjang, atau lihat bagaimana elemen ini tersusun lintas kelas pada peta pembelajaran."
        actions={nextActions}
      />
    </section>
  </div>
</BaseLayout>

<style>
  .element-switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1.75rem 0 2.25rem;
    padding: 0.85rem 1rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .topic-section {
    padding-bottom: 2rem;
  }
  .planned-section {
    border-top: 1px dashed var(--color-border);
    padding-top: 1.75rem;
  }
  .empty-section {
    padding-bottom: 2rem;
  }
  .empty-card {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    max-width: 46rem;
    padding: 1.75rem;
  }
  .empty-card h2,
  .empty-card p {
    margin: 0;
  }
  .empty-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .next-step {
    margin-bottom: 3rem;
  }
</style>
