---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import TopicCard from '@/components/content/TopicCard.astro';
import {
  ELEMENTS,
  GRADES,
  SUBJECTS,
  SUBJECT_ORDER,
  elementOrderFor,
  gradesFor,
} from '@/data/curriculum';
import { topicsBySubjectGradeElement, plannedTopics } from '@/data/topics';
import { topicIdsWithQuestions } from '@/data/questions';
import { url, subjectUrl, gradeUrl } from '@/utils/url';
import type { Grade, SubjectId } from '@/types/content';

export function getStaticPaths() {
  const paths: { params: { subject: SubjectId; grade: Grade }; props: { subject: SubjectId; grade: Grade } }[] =
    [];
  for (const subject of SUBJECT_ORDER) {
    for (const grade of gradesFor(subject)) {
      paths.push({ params: { subject, grade }, props: { subject, grade } });
    }
  }
  return paths;
}

interface Props {
  grade: Grade;
  subject: SubjectId;
}
const { grade, subject } = Astro.props;
const subjectMeta = SUBJECTS[subject];
const gradeMeta = GRADES[grade];
const gradeDescription = subjectMeta.gradeDescriptions?.[grade] ?? gradeMeta.description;

const otherGrades = gradesFor(subject).filter((g) => g !== grade);

const elementData = elementOrderFor(subject)
  .map((elementId) => {
    const element = ELEMENTS[elementId];
    const complete = topicsBySubjectGradeElement(subject, grade, elementId);
    const planned =
      subject === 'matematika'
        ? plannedTopics.filter((p) => p.grade === grade && p.element === elementId)
        : [];
    return { elementId, element, complete, planned };
  })
  .filter((entry) => entry.complete.length + entry.planned.length > 0);

const completeTotal = elementData.reduce((sum, entry) => sum + entry.complete.length, 0);
const plannedTotal = elementData.reduce((sum, entry) => sum + entry.planned.length, 0);

const practiceTopicIds = new Set(topicIdsWithQuestions());
const hasPractice = elementData.some((entry) =>
  entry.complete.some((t) => practiceTopicIds.has(t.id)),
);

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: subjectMeta.name, href: subjectUrl(subject) },
  { label: gradeMeta.name },
];
---

<BaseLayout
  title={`${gradeMeta.name} — ${subjectMeta.name}`}
  description={`Materi ${subjectMeta.name} ${gradeMeta.name} (${gradeMeta.label}) menurut elemen ${elementOrderFor(subject).map((e) => ELEMENTS[e].name.toLowerCase()).join(', ')}.`}
>
  <PageHeader
    title={gradeMeta.name}
    eyebrow={`${gradeMeta.label} · ${subjectMeta.short}`}
    lead={gradeDescription}
    crumbs={crumbs}
    meta={[`${completeTotal} topik`, ...(plannedTotal > 0 ? [`${plannedTotal} rencana`] : [])]}
  />

  <div class="container">
    <div class="grade-switch no-print">
      <span class="text-soft">Kelas lain:</span>
      {
        otherGrades.map((g) => (
          <a class="btn btn-secondary btn-sm" href={gradeUrl(g, subject)}>
            {GRADES[g].name}
          </a>
        ))
      }
    </div>

    <div class="element-list">
      {
        elementData.map(({ elementId, element, complete, planned }) => (
          <section
            class:list={['element-section', 'card-accent', `accent-${elementId}`, 'reveal']}
            aria-labelledby={`el-${elementId}`}
          >
            <SectionHeading
              title={element.name}
              id={`el-${elementId}`}
              eyebrow={element.short}
              lead={element.description}
            />
            <p class="element-count">
              {complete.length} materi{planned.length > 0 && (<> <span aria-hidden="true">·</span> {planned.length} rencana</>)}
            </p>
            <div class="grid grid-3">
              {complete.map((t, i) => (
                <TopicCard
                  title={t.title}
                  summary={t.summary}
                  grade={t.grade}
                  element={t.element}
                  slug={t.slug}
                  subject={subject}
                  showBadge={false}
                  delay={i * 60}
                />
              ))}
              {planned.map((t, i) => (
                <TopicCard
                  title={t.title}
                  summary={t.summary}
                  grade={t.grade}
                  element={t.element}
                  slug={t.slug}
                  subject={subject}
                  status="rencana"
                  showBadge={false}
                  delay={(complete.length + i) * 60}
                />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <section class="next-step reveal no-print" aria-labelledby="langkah-berikutnya">
      <div class="card next-step-inner">
        <div>
          <p class="eyebrow-badge">Langkah berikutnya</p>
          <h2 id="langkah-berikutnya">Uji pemahaman {gradeMeta.name}</h2>
          <p class="text-muted">
            Kerjakan latihan berjenjang atau lihat kembali peta pembelajaran untuk merencanakan
            urutan belajarmu.
          </p>
        </div>
        <div class="next-step-actions">
          {
            hasPractice ? (
              <>
                <a class="btn btn-primary" href={url(`/latihan?kelas=${grade}`)}>
                  Latihan kelas ini
                </a>
                <a class="btn btn-secondary" href={url('/latihan')}>
                  Semua latihan
                </a>
              </>
            ) : (
              <a class="btn btn-primary" href={url('/latihan')}>
                Latihan soal
              </a>
            )
          }
          <a class="btn btn-secondary" href={url('/peta-pembelajaran')}>Peta pembelajaran</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .grade-switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 1.75rem 0 2.25rem;
    padding: 0.85rem 1rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .element-list {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 1rem;
  }
  .element-section {
    padding-top: 1.25rem;
  }
  .element-count {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: -0.5rem 0 1.25rem;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    border: 1px solid
      color-mix(in srgb, var(--accent, var(--color-primary)) 24%, var(--color-border));
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 8%, var(--color-surface));
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }
  .next-step {
    margin-bottom: 3rem;
  }
  .next-step-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    border-top: 3px solid var(--color-primary);
  }
  .next-step-inner h2 {
    margin-bottom: 0.25rem;
  }
  .next-step-inner p {
    margin: 0;
    max-width: 46ch;
  }
  .next-step .eyebrow-badge {
    margin-bottom: 0.6rem;
  }
  .next-step-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
