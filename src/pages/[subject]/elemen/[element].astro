---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import TopicCard from '@/components/content/TopicCard.astro';
import MathMascot from '@/components/content/MathMascot.astro';
import CtaCard from '@/components/ui/CtaCard.astro';
import { site } from '@/data/site';
import {
  ELEMENTS,
  GRADES,
  SUBJECTS,
  elementOrderFor,
  gradesFor,
} from '@/data/curriculum';
import { topicsBySubjectGradeElement, topicsBySubjectElement, plannedTopics } from '@/data/topics';
import { topicIdsWithQuestions } from '@/data/questions';
import { subjectsWithContent } from '@/lib/routes';
import { url, subjectUrl } from '@/utils/url';
import type { ElementId, SubjectId } from '@/types/content';

export function getStaticPaths() {
  const paths: { params: { subject: SubjectId; element: ElementId } }[] = [];
  for (const subject of subjectsWithContent()) {
    for (const element of elementOrderFor(subject)) {
      paths.push({ params: { subject, element } });
    }
  }
  return paths;
}

const subject = Astro.params.subject as SubjectId;
const element = Astro.params.element as ElementId;
const subjectMeta = SUBJECTS[subject];
const meta = ELEMENTS[element];

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: subjectMeta.name, href: subjectUrl(subject) },
  { label: 'Elemen', href: subjectUrl(subject, '#subject-elements') },
  { label: meta.name },
];

const grades = gradesFor(subject)
  .map((grade) => {
    const complete = topicsBySubjectGradeElement(subject, grade, element).map((t) => ({
      ...t,
      status: 'lengkap' as const,
    }));
    const planned =
      subject === 'matematika'
        ? plannedTopics
            .filter((p) => p.grade === grade && p.element === element)
            .map((t) => ({ ...t, status: 'rencana' as const }))
        : [];
    return { grade, entries: [...complete, ...planned] };
  })
  .filter((g) => g.entries.length > 0);

const total = grades.reduce((sum, g) => sum + g.entries.length, 0);

const practiceTopicIds = new Set(topicIdsWithQuestions());
const hasPractice = topicsBySubjectElement(subject, element).some((t) =>
  practiceTopicIds.has(t.id),
);
// Judul halaman elemen sama antar mata pelajaran; bedakan yang tingkat lanjut.
const subjectTag = subject === 'matematika-lanjut' ? ' · Matematika Tingkat Lanjut' : '';
---

<BaseLayout title={`Elemen ${meta.name}${subjectTag}`} description={meta.description}>
  <PageHeader
    title={meta.name}
    eyebrow="Elemen"
    lead={meta.description}
    crumbs={crumbs}
    element={element}
    icon
  />

  <div class="container">
    <p class="text-muted element-note">
      Halaman ini menghimpun seluruh materi {meta.name} pada {subjectMeta.name} dalam satu
      tempat.
    </p>

    {
      grades.map(({ grade, entries }) => (
        <section class="section grade-section" aria-labelledby={`grade-${grade}`}>
          <h2 id={`grade-${grade}`}>{GRADES[grade].name}</h2>
          <div class="grid grid-3">
            {entries.map((t, i) => (
              <TopicCard
                title={t.title}
                summary={t.summary}
                grade={t.grade}
                element={t.element}
                slug={t.slug}
                subject={subject}
                status={t.status}
                supplementary={'supplementary' in t && t.supplementary === true}
                showMeta={true}
                delay={i * 60}
              />
            ))}
          </div>
        </section>
      ))
    }

    {
      total === 0 && (
        <p class="text-muted element-empty">
          <MathMascot
            size={6}
            state="oops"
            label={`${site.mascot.name} belum menemukan topik untuk elemen ini`}
          />
          <span>Belum ada topik untuk elemen ini.</span>
        </p>
      )
    }

    {
      hasPractice && (
        <section class="section practice-cta no-print" aria-labelledby="latihan-elemen">
          <CtaCard
            eyebrow="Latihan"
            title="Latihan semua topik elemen ini"
            titleId="latihan-elemen"
            text={`Uji pemahamanmu pada seluruh topik ${meta.name} dengan soal berjenjang dasar, cakap, dan mahir.`}
            actions={[
              { label: 'Mulai latihan', href: url(`/latihan?elemen=${element}`), variant: 'primary' },
              { label: 'Kemajuan belajar', href: url('/kemajuan'), variant: 'secondary' },
              { label: 'Tinjauan berkala', href: url('/review'), variant: 'secondary' },
            ]}
          />
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .element-note {
    max-width: 68ch;
    margin: 1.25rem 0 1.5rem;
    font-size: 0.92rem;
  }
  .element-empty {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    font-size: 0.92rem;
  }
  .element-empty :global(.mascot) {
    flex: 0 0 auto;
    width: 4rem;
  }
  .grade-section {
    padding-bottom: 2rem;
  }
  .grade-section h2 {
    margin-bottom: 1rem;
  }
  .practice-cta {
    padding-bottom: 3rem;
  }
</style>
