---
import RedirectPage from '@/components/layout/RedirectPage.astro';
import { ELEMENT_ORDER, GRADE_ORDER } from '@/data/curriculum';
import { url } from '@/utils/url';

export function getStaticPaths() {
  const paths: { params: { grade: string; element: string } }[] = [];
  for (const grade of GRADE_ORDER) {
    for (const element of ELEMENT_ORDER) {
      paths.push({ params: { grade, element } });
    }
  }
  return paths;
}

const { grade, element } = Astro.params;
const to = url(`matematika/kelas/${grade}/${element}`);
---

<RedirectPage to={to} title={`Pindah ke ${element} kelas ${grade}`} />
