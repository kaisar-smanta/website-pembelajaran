---
import RedirectPage from '@/components/layout/RedirectPage.astro';
import { legacyCombos } from '@/lib/routes';
import { elementUrl } from '@/utils/url';

export function getStaticPaths() {
  return legacyCombos().map(({ grade, element }) => ({ params: { grade, element } }));
}

const { grade, element } = Astro.params as { grade: string; element: string };
const to = elementUrl(grade, element);
---

<RedirectPage to={to} title={`Pindah ke ${element} kelas ${grade}`} />
