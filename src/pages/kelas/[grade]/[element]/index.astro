---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import TopicCard from '@/components/content/TopicCard.astro';
import ElementIcon from '@/components/content/ElementIcon.astro';
import { ELEMENTS, ELEMENT_ORDER, GRADES, GRADE_ORDER } from '@/data/curriculum';
import { topicsByGradeElement, plannedTopics } from '@/data/topics';
import { url, gradeUrl, elementUrl } from '@/utils/url';
import type { ElementId, Grade } from '@/types/content';

export function getStaticPaths() {
  const paths: { params: { grade: Grade; element: ElementId }; props: { grade: Grade; element: ElementId } }[] = [];
  for (const grade of GRADE_ORDER) {
    for (const element of ELEMENT_ORDER) {
      paths.push({ params: { grade, element }, props: { grade, element } });
    }
  }
  return paths;
}

interface Props {
  grade: Grade;
  element: ElementId;
}
const { grade, element } = Astro.props;
const gradeMeta = GRADES[grade];
const elementMeta = ELEMENTS[element];

const complete = topicsByGradeElement(grade, element);
const planned = plannedTopics.filter((p) => p.grade === grade && p.element === element);

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: gradeMeta.name, href: gradeUrl(grade) },
  { label: elementMeta.name },
];
---

<BaseLayout
  title={`${elementMeta.name} — ${gradeMeta.name}`}
  description={`${elementMeta.description} Materi ${elementMeta.name} untuk ${gradeMeta.name}.`}
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <header class={`page-head accent-${element}`}>
      <span class="element-icon" aria-hidden="true">
        <ElementIcon element={element} size={26} />
      </span>
      <div>
        <p class="eyebrow">{gradeMeta.name} · {gradeMeta.label}</p>
        <h1>{elementMeta.name}</h1>
        <p class="lead">{elementMeta.description}</p>
      </div>
    </header>

    <div class="element-switch no-print" aria-label="Elemen lain">
      <span class="text-soft">Elemen:</span>
      {
        ELEMENT_ORDER.filter((e) => e !== element).map((e) => (
          <a class="btn btn-secondary btn-sm" href={elementUrl(grade, e)}>{ELEMENTS[e].name}</a>
        ))
      }
    </div>

    {
      complete.length > 0 && (
        <section aria-labelledby="materi-lengkap">
          <h2 id="materi-lengkap">Materi Tersedia</h2>
          <div class="grid grid-3">
            {complete.map((t) => (
              <TopicCard title={t.title} summary={t.summary} grade={t.grade} element={t.element} slug={t.slug} showMeta={false} />
            ))}
          </div>
        </section>
      )
    }

    {
      planned.length > 0 && (
        <section aria-labelledby="materi-rencana" class="planned-section">
          <h2 id="materi-rencana">Dalam Pengembangan</h2>
          <p class="text-muted">
            Topik berikut sudah masuk peta kurikulum dan akan dilengkapi secara bertahap. Arsitektur
            konten memungkinkan penambahan tanpa mengubah aplikasi.
          </p>
          <div class="grid grid-3">
            {planned.map((t) => (
              <TopicCard
                title={t.title}
                summary={t.summary}
                grade={t.grade}
                element={t.element}
                slug={t.slug}
                status="rencana"
                showMeta={false}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      complete.length === 0 && planned.length === 0 && (
        <p class="text-muted">Belum ada topik untuk elemen ini pada {gradeMeta.name}.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
    padding-block: 0.5rem 1rem;
  }
  .page-head h1 {
    margin-bottom: 0.2rem;
  }
  .lead {
    max-width: 68ch;
    color: var(--color-text-muted);
    margin: 0;
  }
  .element-icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 14px;
    background: var(--color-surface-2);
    color: var(--color-primary);
  }
  .accent-bilangan .element-icon {
    color: var(--color-number);
  }
  .accent-aljabar-fungsi .element-icon {
    color: var(--color-algebra);
  }
  .accent-geometri .element-icon {
    color: var(--color-geometry);
  }
  .accent-data-peluang .element-icon {
    color: var(--color-data);
  }
  .element-switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 1.5rem;
  }
  section {
    padding-bottom: 2rem;
  }
  .planned-section {
    border-top: 1px dashed var(--color-border);
    padding-top: 1.5rem;
  }
</style>
