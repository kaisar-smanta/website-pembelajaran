---
import type { Topic } from '@/types/content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import SectionBlock from '@/components/content/SectionBlock.astro';
import ElementIcon from '@/components/content/ElementIcon.astro';
import { ELEMENTS, GRADES } from '@/data/curriculum';
import { topicsByGradeElement, topics, resolveTopics } from '@/data/topics';
import { applicationsForTopic } from '@/data/applications';
import { renderInlineMarkdown, stripMarkdown } from '@/utils/markdown';
import { url, gradeUrl, elementUrl, topicUrl } from '@/utils/url';

export function getStaticPaths() {
  return topics
    .filter((t) => t.status !== 'rencana')
    .map((topic) => ({
      params: { grade: topic.grade, element: topic.element, topic: topic.slug },
      props: { topic },
    }));
}

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;
const elementMeta = ELEMENTS[topic.element];
const gradeMeta = GRADES[topic.grade];

const siblings = topicsByGradeElement(topic.grade, topic.element);
const currentIndex = siblings.findIndex((t) => t.id === topic.id);
const prev = currentIndex > 0 ? siblings[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < siblings.length - 1 ? siblings[currentIndex + 1] : undefined;

const prerequisiteTopics = resolveTopics(topic.prerequisites);
const related = resolveTopics(topic.relatedTopics);
const relatedApplications = applicationsForTopic(topic.id);

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: gradeMeta.name, href: gradeUrl(topic.grade) },
  { label: elementMeta.name, href: elementUrl(topic.grade, topic.element) },
  { label: topic.title },
];

const sectionList = topic.sections.filter((s) => s.kind !== 'catatan');
const description = stripMarkdown(topic.summary);
---

<BaseLayout title={`${topic.title} — ${gradeMeta.name}`} description={description} ogType="article">
  <div class="topic-wrap container">
    <Breadcrumbs items={crumbs} />

    <header class={`topic-header accent-${topic.element}`}>
      <div class="topic-head-top">
        <span class="element-chip">
          <ElementIcon element={topic.element} size={18} />
          {elementMeta.name}
        </span>
        <span class="badge badge-grade">{gradeMeta.name} · {gradeMeta.label}</span>
      </div>
      <h1>{topic.title}</h1>
      {topic.subtitle && <p class="subtitle">{topic.subtitle}</p>}
      <p class="topic-desc" set:html={renderInlineMarkdown(topic.description)}></p>
      <ul class="topic-facts">
        <li><strong>{sectionList.length}</strong> bagian materi</li>
        {topic.estimatedMinutes && <li>≈ <strong>{topic.estimatedMinutes}</strong> menit belajar</li>}
        {prerequisiteTopics.length > 0 && (
          <li><strong>{prerequisiteTopics.length}</strong> topik prasyarat</li>
        )}
        {related.length > 0 && <li><strong>{related.length}</strong> topik terkait</li>}
      </ul>
    </header>

    <div class="topic-layout">
      <article class="topic-main">
        {sectionList.map((section, index) => <SectionBlock section={section} index={index} />)}

        {(prev || next) && (
          <nav class="topic-pager no-print" aria-label="Navigasi topik">
            {
              prev ? (
                <a class="pager-link pager-prev" href={topicUrl(prev.grade, prev.element, prev.slug)}>
                  <span class="pager-label">Sebelumnya</span>
                  <span class="pager-title">← {prev.title}</span>
                </a>
              ) : (
                <span />
              )
            }
            {
              next ? (
                <a class="pager-link pager-next" href={topicUrl(next.grade, next.element, next.slug)}>
                  <span class="pager-label">Selanjutnya</span>
                  <span class="pager-title">{next.title} →</span>
                </a>
              ) : (
                <span />
              )
            }
          </nav>
        )}
      </article>

      <aside class="topic-aside no-print" aria-label="Informasi topik">
        <div class="aside-card">
          <h2 class="aside-heading">Isi Halaman</h2>
          <ol class="outline">
            {
              sectionList.map((s) => (
                <li>
                  <a href={`#${s.id}`}>{s.title ?? s.id}</a>
                </li>
              ))
            }
          </ol>
        </div>

        {
          prerequisiteTopics.length ? (
            <div class="aside-card">
              <h2 class="aside-heading">Prasyarat</h2>
              <ul class="aside-links">
                {prerequisiteTopics.map((t) => (
                  <li>
                    <a href={topicUrl(t.grade, t.element, t.slug)}>
                      <ElementIcon element={t.element} size={16} />
                      {t.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : null
        }

        {
          related.length ? (
            <div class="aside-card">
              <h2 class="aside-heading">Topik Terkait</h2>
              <ul class="aside-links">
                {related.map((t) => (
                  <li>
                    <a href={topicUrl(t.grade, t.element, t.slug)}>
                      <ElementIcon element={t.element} size={16} />
                      {t.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : null
        }

        {
          relatedApplications.length ? (
            <div class="aside-card">
              <h2 class="aside-heading">Penerapan Nyata</h2>
              <ul class="aside-links">
                {relatedApplications.map((a) => (
                  <li>
                    <a href={url(`/aplikasi/${a.id}`)}>{a.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          ) : null
        }

        <div class="aside-card">
          <h2 class="aside-heading">Aksi</h2>
          <div class="aside-actions">
            <a class="btn btn-secondary btn-sm" href={url('/latihan')}>Latihan topik ini</a>
            <button type="button" class="btn btn-ghost btn-sm" data-print>Cetak halaman</button>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .topic-header {
    padding: 1.5rem 0 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .topic-header.accent-bilangan {
    border-top: 3px solid var(--color-number);
  }
  .topic-header.accent-aljabar-fungsi {
    border-top: 3px solid var(--color-algebra);
  }
  .topic-header.accent-geometri {
    border-top: 3px solid var(--color-geometry);
  }
  .topic-header.accent-data-peluang {
    border-top: 3px solid var(--color-data);
  }
  .topic-head-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .element-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-top: -0.3rem;
  }
  .topic-desc {
    max-width: 70ch;
    color: var(--color-text-muted);
  }
  .topic-facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0;
    margin: 0.75rem 0 0;
    font-size: 0.88rem;
    color: var(--color-text-soft);
  }
  .topic-facts strong {
    color: var(--color-text);
  }

  .topic-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    gap: 2.5rem;
    align-items: start;
    padding-bottom: 2rem;
  }
  .topic-main {
    min-width: 0;
  }

  .topic-aside {
    position: sticky;
    top: calc(var(--header-h) + 1.25rem);
    display: grid;
    gap: 1rem;
  }
  .aside-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1rem;
  }
  .aside-heading {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-text-soft);
    margin-bottom: 0.6rem;
  }
  .outline {
    list-style: none;
    counter-reset: outline;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .outline li {
    counter-increment: outline;
  }
  .outline a::before {
    content: counter(outline) '. ';
    color: var(--color-text-soft);
    font-variant-numeric: tabular-nums;
  }
  .outline a {
    display: block;
    padding: 0.3rem 0.4rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.88rem;
  }
  .outline a:hover {
    background: var(--color-surface-2);
    color: var(--color-primary);
  }
  .aside-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }
  .aside-links a {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    padding: 0.25rem 0;
  }
  .aside-links a:hover {
    color: var(--color-primary);
  }
  .aside-actions {
    display: grid;
    gap: 0.5rem;
  }
  .aside-actions .btn {
    justify-content: center;
  }

  .topic-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    max-width: 48%;
  }
  .pager-link:hover {
    border-color: var(--color-primary);
  }
  .pager-next {
    text-align: right;
    margin-left: auto;
  }
  .pager-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-soft);
  }
  .pager-title {
    font-weight: 600;
    color: var(--color-text);
  }

  @media (max-width: 62rem) {
    .topic-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .topic-aside {
      position: static;
      order: -1;
    }
  }
  @media (min-width: 62rem) {
    .outline {
      max-height: 55vh;
      overflow-y: auto;
    }
  }
</style>
