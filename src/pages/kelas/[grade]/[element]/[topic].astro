---
import RedirectPage from '@/components/layout/RedirectPage.astro';
import { topics, topicSubject } from '@/data/topics';
import { topicUrl } from '@/utils/url';

export function getStaticPaths() {
  return topics
    .filter((t) => topicSubject(t) === 'matematika' && t.status !== 'rencana')
    .map((topic) => ({
      params: { grade: topic.grade, element: topic.element, topic: topic.slug },
      props: { topic },
    }));
}

const { topic } = Astro.props;
const to = topicUrl(topic.grade, topic.element, topic.slug, 'matematika');
---

<RedirectPage to={to} title={`Pindah ke ${topic.title}`} />
