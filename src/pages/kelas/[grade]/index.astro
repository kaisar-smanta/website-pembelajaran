---
import RedirectPage from '@/components/layout/RedirectPage.astro';
import { legacyGrades } from '@/lib/routes';
import { gradeUrl } from '@/utils/url';

export function getStaticPaths() {
  return legacyGrades().map((grade) => ({ params: { grade } }));
}

const { grade } = Astro.params as { grade: string };
const to = gradeUrl(grade);
---

<RedirectPage to={to} title={`Pindah ke Kelas ${grade}`} />
