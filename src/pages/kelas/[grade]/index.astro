---
import RedirectPage from '@/components/layout/RedirectPage.astro';
import { GRADE_ORDER } from '@/data/curriculum';
import { url } from '@/utils/url';

export function getStaticPaths() {
  return GRADE_ORDER.map((grade) => ({ params: { grade } }));
}

const { grade } = Astro.params;
const to = url(`matematika/kelas/${grade}`);
---

<RedirectPage to={to} title={`Pindah ke Kelas ${grade}`} />
