---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import QuestionCard from '@/components/exercises/QuestionCard.astro';
import CtaCard from '@/components/ui/CtaCard.astro';
import MathMascot from '@/components/content/MathMascot.astro';
import { topics, topicSubject } from '@/data/topics';
import { questions, questionsByTopic } from '@/data/questions';
import { ELEMENTS, GRADES } from '@/data/curriculum';
import { url, topicUrl } from '@/utils/url';

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Latihan & Asesmen', href: url('/latihan') },
  { label: 'Tinjauan lintas topik' },
];

/**
 * Ukuran sesi tinjauan. Menyematkan seluruh bank soal (ratusan kartu beserta
 * kunci jawaban dan pembahasan) membuat halaman tumbuh belasan megabita dan
 * berat di ponsel, padahal halaman ini adalah *satu sesi*. Kandidat dibatasi
 * dua soal per topik (44 topik x 2 = 88 kartu), lalu disaring lebih lanjut
 * oleh antrean berbasis kemajuan di peramban. Tiap topik juga menyediakan
 * tautan ke sesi tinjau penuh topik itu, sehingga soal yang belum tepat di
 * satu topik tidak terpotong batas ini.
 */
const SESSION_SIZE = 88;

/** Menyebar `n` soal secara bergilir antar topik agar tiap topik terwakili. */
function spreadByTopic<T extends { topicId: string }>(list: T[], n: number): T[] {
  const buckets = new Map<string, T[]>();
  for (const item of list) {
    const bucket = buckets.get(item.topicId) ?? [];
    bucket.push(item);
    buckets.set(item.topicId, bucket);
  }
  const queues = [...buckets.values()];
  const out: T[] = [];
  let i = 0;
  while (out.length < n && queues.some((queue) => queue.length > 0)) {
    const next = queues[i % queues.length].shift();
    if (next) out.push(next);
    i += 1;
  }
  return out;
}

const sessionIds = new Set(spreadByTopic(questions, SESSION_SIZE).map((q) => q.id));

const topicEntries = topics
  .map((topic) => {
    const subject = topicSubject(topic);
    return {
      id: topic.id,
      title: topic.title,
      gradeName: GRADES[topic.grade].name,
      elementName: ELEMENTS[topic.element].name,
      element: topic.element,
      practiceHref: url(`/latihan/${topic.slug}`),
      reviewHref: url(`/latihan/${topic.slug}?tinjau=missed`),
      materialHref: topicUrl(topic.grade, topic.element, topic.slug, subject),
      questions: questionsByTopic(topic.id).filter((q) => sessionIds.has(q.id)),
    };
  })
  .filter((entry) => entry.questions.length > 0);

const allQuestionIds = topicEntries.flatMap((entry) => entry.questions.map((q) => q.id));
const questionIndex = new Map<string, number>();
allQuestionIds.forEach((id, i) => questionIndex.set(id, i));
const totalQuestions = allQuestionIds.length;
const idsJson = JSON.stringify(allQuestionIds).replace(/</g, '\\u003c');

const meta = [
  `${totalQuestions} soal`,
  `${topicEntries.length} topik`,
  'Tersimpan lokal',
];
---

<BaseLayout
  title="Tinjauan lintas topik"
  description="Sesi tinjauan yang menghimpun soal yang belum tepat atau belum dicoba dari lintas topik, diurutkan menurut jadwal pengulangan. Tersimpan lokal di peramban, tanpa akun."
>
  <PageHeader
    title="Tinjauan lintas topik"
    eyebrow="Tinjau"
    lead="Satu sesi berisi soal dari berbagai topik yang pernah kamu jawab belum tepat atau belum sempat dicoba. Antreannya mengikuti jadwal pengulangan sederhana agar yang paling mendesak muncul lebih dulu; sesi dibatasi jumlahnya dan menyebar antar topik. Untuk menjelajah seluruh bank soal, buka Latihan."
    crumbs={crumbs}
    meta={meta}
  />

  <div class="container container-narrow review" data-review-root>
    <p class="notice">
      Antrean di halaman ini dihitung dari data <strong>yang tersimpan di peramban</strong> ini.
      Tidak ada akun maupun server. Jawabanmu langsung tersimpan, dan ringkasan di atas
      bertambah setiap kali kamu menjawab soal.
    </p>

    <section class="empty card" data-review-empty aria-labelledby="review-kosong">
      <MathMascot size={6} state="sleep" label="Maskot menunggu soal untuk ditinjau" />
      <h2 id="review-kosong" data-empty-title>Belum ada soal untuk ditinjau</h2>
      <p class="text-muted" data-empty-text>
        Kerjakan beberapa latihan dulu, lalu kembali ke sini untuk meninjau soal yang belum
        tepat atau belum dicoba secara lintas topik.
      </p>
      <div class="row">
        <a class="btn btn-primary" href={url('/latihan')}>Mulai berlatih</a>
        <a class="btn btn-secondary" href={url('/kemajuan')}>Lihat kemajuan</a>
      </div>
      <p class="text-soft empty-note">
        Catatan: halaman ini memerlukan JavaScript karena membaca data dari perambanmu. Tanpa
        JavaScript, datanya tetap aman tersimpan, hanya antreannya belum dapat dihitung.
      </p>
    </section>

    <div data-review-body hidden>
      <section class="review-summary" data-review-summary aria-labelledby="review-ringkasan">
        <SectionHeading
          id="review-ringkasan"
          eyebrow="Antrean"
          title="Ringkasan tinjauan"
          lead="Angka-angka ini diperbarui setiap kali kamu menjawab soal di halaman ini."
          reveal={false}
        />
        <dl class="stats">
          <div class="stat">
            <dt>Soal dalam antrean</dt>
            <dd data-review-total>0</dd>
          </div>
          <div class="stat">
            <dt>Sudah tepat</dt>
            <dd data-review-done>0/0</dd>
          </div>
          <div class="stat">
            <dt>Ketepatan</dt>
            <dd data-review-accuracy>0%</dd>
          </div>
        </dl>
        <div
          class="track"
          data-review-track
          role="progressbar"
          aria-label="Kemajuan tinjauan"
          aria-valuemin="0"
          aria-valuemax="0"
          aria-valuenow="0"
          aria-valuetext="Belum ada soal yang tepat"
        >
          <span class="bar" data-review-bar style="width: 0%"></span>
        </div>
        <p class="review-note text-soft" data-review-note aria-live="polite"></p>
      </section>

      <div class="review-groups" data-review-groups>
        {
          topicEntries.map((entry) => (
            <section
              class:list={['review-topic', `accent-${entry.element}`]}
              data-review-topic
              data-topic-id={entry.id}
              hidden
              aria-labelledby={`review-topic-${entry.id}`}
            >
              <div class="review-topic-head">
                <div class="review-topic-copy">
                  <h2 id={`review-topic-${entry.id}`}>
                    <a href={entry.practiceHref}>{entry.title}</a>
                  </h2>
                  <p class="review-topic-meta text-muted">
                    {entry.gradeName} · {entry.elementName} ·{' '}
                    <a href={entry.materialHref}>Baca materi</a> ·{' '}
                    <a href={entry.reviewHref}>Tinjau semua soal topik ini</a>
                  </p>
                </div>
                <span class="review-topic-count badge" data-topic-count>
                  {entry.questions.length} soal
                </span>
              </div>
              <div class="review-list">
                {entry.questions.map((question) => (
                  <div
                    class="review-q"
                    data-review-item={question.id}
                    data-topic-id={entry.id}
                    hidden
                  >
                    <p class="review-due" data-review-due></p>
                    <QuestionCard
                      question={question}
                      index={questionIndex.get(question.id) ?? 0}
                      showTopic
                    />
                  </div>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>

    <script type="application/json" id="review-ids" is:inline set:html={idsJson}></script>
  </div>

  <section class="section-alt cta-section">
    <div class="container">
      <CtaCard
        eyebrow="Langkah berikutnya"
        title="Antrean sudah tuntas?"
        text="Kunjungi dasbor kemajuan untuk melihat capaianmu, atau tantang dirimu dengan soal tingkat mahir dan topik pengayaan."
        reveal
        actions={[
          { label: 'Lihat kemajuan', href: url('/kemajuan'), variant: 'primary' },
          { label: 'Buka tantangan', href: url('/tantangan'), variant: 'secondary' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .review {
    padding-block: 1rem 2.5rem;
    display: grid;
    /* Kolom tunggal yang boleh menyusut: tanpa ini trek `auto` mengikuti lebar
       max-content anak (mis. dl.stats) sehingga halaman meluap di ponsel. */
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }
  .notice {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
    padding: 0.9rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-primary) 26%, var(--color-border));
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-primary) 6%, var(--color-surface));
    font-size: 0.92rem;
  }
  .empty {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    text-align: left;
  }
  .empty h2 {
    margin: 0;
  }
  .empty-note {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
  }
  .review-summary {
    display: grid;
    min-width: 0;
    gap: 1rem;
  }
  .review-summary :global(.section-heading) {
    margin-bottom: 0;
  }
  .stats {
    display: grid;
    /* `min()` menjaga trek tetap muat di layar sempit; sebelumnya `8.5rem`
       memaksa lebar max-content dan meluap pada viewport ponsel. */
    grid-template-columns: repeat(auto-fit, minmax(min(8.5rem, 100%), 1fr));
    min-width: 0;
    gap: 0.85rem;
    margin: 0;
  }
  .stat {
    min-width: 0;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface-2);
  }
  .stat dt {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .stat dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--color-primary);
  }
  .track {
    height: 0.65rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
    overflow: hidden;
  }
  .bar {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-primary), var(--color-geometry));
    transition: width var(--dur) var(--ease-out-soft);
  }
  .review-note {
    margin: 0;
    font-size: 0.9rem;
  }
  .review-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }
  .review-topic {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 3px solid var(--accent, var(--color-primary));
  }
  /* Seluruh rantai grid harus boleh menyusut agar kartu soal yang memuat
     rumus lebar tidak memperluas trek dan membuat halaman meluap. */
  .review-topic-head,
  .review-topic-copy,
  .review-list,
  .review-q {
    min-width: 0;
  }
  .review-topic-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }
  .review-topic-copy {
    min-width: 0;
    display: grid;
    gap: 0.2rem;
  }
  .review-topic-head h2 {
    margin: 0;
    font-size: 1.35rem;
  }
  .review-topic-head h2 a {
    color: inherit;
  }
  .review-topic-head h2 a:hover {
    color: var(--accent, var(--color-primary));
  }
  .review-topic-meta {
    margin: 0;
    font-size: 0.88rem;
  }
  .review-topic-count {
    align-self: flex-start;
    flex: 0 0 auto;
  }
  .review-list {
    display: grid;
    gap: 0.75rem;
  }
  .review-q {
    display: grid;
    gap: 0.3rem;
  }
  .review-due {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }
  .review-q.is-resolved .review-due {
    color: var(--color-success);
  }
  .review-q :global(.question-card) {
    margin-bottom: 0;
  }
  .review-topic[hidden],
  .review-q[hidden],
  [data-review-body][hidden],
  [data-review-empty][hidden] {
    display: none !important;
  }
  .cta-section {
    padding-block: 2.5rem;
  }
</style>

<script>
  import { bootReview } from '@/lib/review-client';
  bootReview();
</script>
