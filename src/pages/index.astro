---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroPlayground from '@/components/content/HeroPlayground.astro';
import ElementIcon from '@/components/content/ElementIcon.astro';
import ExplorationPreviewCard from '@/components/content/ExplorationPreviewCard.astro';
import TopikShowcase from '@/components/content/TopikShowcase.astro';
import QuickDemo from '@/components/interactive/QuickDemo.astro';
import QuizTeaser from '@/components/exercises/QuizTeaser.astro';
import { ELEMENTS, ELEMENT_ORDER, GRADES, GRADE_ORDER } from '@/data/curriculum';
import { resolveTopics, topics } from '@/data/topics';
import { explorations } from '@/data/explorations';
import { applications, applicationCategories } from '@/data/applications';
import { questions } from '@/data/questions';
import { site } from '@/data/site';
import { url, gradeUrl, elementOverviewUrl, absoluteUrl } from '@/utils/url';

const featuredIds = [
  'eksponen',
  'fungsi-kuadrat',
  'trigonometri',
  'bunga-majemuk',
  'data-bivariat',
  'peluang',
];
const featured = resolveTopics(featuredIds);
const featuredList = {
  '@type': 'ItemList',
  name: 'Topik pilihan Matematika SMA',
  itemListElement: featured.map((topic, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: topic.title,
    url: absoluteUrl(`kelas/${topic.grade}/${topic.element}/${topic.slug}`),
  })),
};
const featuredExplorations = explorations.filter((e) => e.featured);
const showcaseExplorations = (featuredExplorations.length ? featuredExplorations : explorations).slice(0, 3);
const stats = [
  { value: topics.length, label: 'topik materi' },
  { value: questions.length, label: 'soal latihan' },
  { value: applications.length, label: 'studi kasus nyata' },
  { value: explorations.length, label: 'eksplorasi interaktif' },
];
const audience = [
  {
    title: 'Untuk siswa',
    text: 'Belajar mandiri dengan eksplorasi interaktif, latihan berjenjang, dan pembahasan setiap jawaban.',
    href: url('/peta-pembelajaran'),
    link: 'Lihat alur belajar',
  },
  {
    title: 'Untuk guru',
    text: 'Materi, simulasi, dan bank soal siap dipakai sebagai pendamping pembelajaran di kelas.',
    href: url('/latihan'),
    link: 'Buka bank soal',
  },
  {
    title: 'Untuk orang tua',
    text: 'Pahami alur belajar dan dampingi anak dengan sumber yang jelas, gratis, dan tanpa iklan.',
    href: url('/tentang'),
    link: 'Kenali sumbernya',
  },
];
const philosophy = [
  { title: 'Pahami', text: 'Mulai dari konteks dan pertanyaan, bukan langsung rumus.' },
  { title: 'Eksplorasi', text: 'Ubah parameter pada simulasi, amati pola, ajukan dugaan.' },
  { title: 'Terapkan', text: 'Kerjakan latihan berjenjang: dasar, cakap, lalu mahir.' },
  { title: 'Analisis', text: 'Tafsirkan hasil dan nilai apakah modelnya masuk akal.' },
  { title: 'Refleksi', text: 'Kenali kesalahan umum, lalu rangkum pemahamanmu.' },
];
const trustPoints: Array<{ title: string; text: string; href?: string; link?: string }> = [
  {
    title: 'Gratis & tanpa akun',
    text: 'Semua materi bisa dibuka langsung, tanpa pendaftaran, biaya, atau iklan.',
  },
  {
    title: 'Mengikuti CP Kurikulum Merdeka',
    text: 'Disusun sebagai tafsir instruksional, bukan salinan buku teks resmi.',
    href: url('/referensi'),
    link: 'Lihat referensi',
  },
  {
    title: 'Jujur soal batasannya',
    text: 'Setiap model punya asumsi dan keterbatasan; kesalahan umum dibahas terbuka.',
  },
  {
    title: 'Peta yang apa adanya',
    text: 'Topik yang materinya belum lengkap ditandai “segera hadir”, bukan ditutupi.',
    href: url('/peta-pembelajaran'),
    link: 'Lihat status topik',
  },
];
const revealStyle = (i: number) => `--reveal-delay:${i * 70}ms`;
const gradeAccent: Record<string, string> = { X: 'number', XI: 'algebra', XII: 'geometry' };
---

<BaseLayout
  title="Pahami Konsep Matematika SMA, Bukan Hafal Rumus"
  description="Pusat belajar Matematika SMA kelas X–XII sesuai Kurikulum Merdeka: eksplorasi interaktif, latihan berjenjang, dan studi kasus nyata. Gratis, tanpa akun."
  structuredData={featuredList}
>
  <section class="hero">
    <span class="hero-mesh" aria-hidden="true"></span>
    <div class="hero-grid container">
      <div class="hero-copy">
        <p class="eyebrow-badge">Kurikulum Merdeka · Kelas X–XII</p>
        <h1>Pahami <span class="marker">konsep</span> matematika SMA, bukan sekadar hafal rumus</h1>
        <p class="hero-lead">
          Matematika bukan sekadar menghitung. Di sini kamu belajar{' '}
          <strong>memahami pola</strong>, <strong>membuat model</strong>,{' '}
          <strong>menalar</strong>, dan <strong>mengambil keputusan</strong> lewat eksplorasi
          interaktif, latihan berjenjang, dan contoh nyata.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={url('/peta-pembelajaran')}>Mulai belajar</a>
          <a class="btn btn-secondary" href={url('/eksplorasi')}>Coba eksplorasi</a>
        </div>
        <ul class="hero-stats" role="list">
          {
            stats.map((stat) => (
              <li>
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </li>
            ))
          }
        </ul>
        <p class="hero-byline">
          <span class="byline-logo" aria-hidden="true">
            <img src={url(site.school.logo)} alt="" width="30" height="30" />
          </span>
          <span>
            Disusun oleh{' '}
            <a href={url('/tentang')}>
              <strong>{site.author.name}</strong>
            </a>{' '}
            <span class="byline-sep" aria-hidden="true">
              ·
            </span>{' '}
            <a href={site.school.url} target="_blank" rel="noopener noreferrer">
              {site.school.name}
            </a>
          </span>
        </p>
      </div>
      <div class="hero-visual">
        <HeroPlayground />
      </div>
    </div>
    <span class="hero-dots" aria-hidden="true"></span>
  </section>

  <div class="section section-paper">
    <div class="container">
      <section class="audience-section" aria-labelledby="audience">
        <div class="section-heading reveal" data-reveal>
          <p class="eyebrow-badge">Untuk siapa</p>
          <h2 id="audience">Satu sumber, tiga peran</h2>
          <p class="text-muted">Materi yang sama, dipakai dengan cara berbeda.</p>
        </div>
        <ul class="audience-grid" role="list">
          {
            audience.map((item, i) => (
              <li class="audience-item hover-lift reveal" style={revealStyle(i)} data-reveal>
                <a class="audience-card" href={item.href}>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                  <span class="cta">{item.link} →</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="pedagogy-section" aria-labelledby="cara-belajar">
        <div class="section-heading reveal" data-reveal>
          <h2 id="cara-belajar">Cara kamu belajar di sini</h2>
          <p class="text-muted">Lima kebiasaan berpikir yang dilatih di setiap topik.</p>
        </div>
        <ol class="philosophy">
          {
            philosophy.map((step, i) => (
              <li class="philosophy-step hover-lift reveal" style={revealStyle(i)} data-reveal>
                <span class="philosophy-num">{i + 1}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>

  <section class="section section-alt" aria-labelledby="play">
    <div class="container">
      <div class="section-heading reveal" data-reveal>
        <p class="eyebrow-badge">Interaktif</p>
        <h2 id="play">Coba dulu, baru teori</h2>
        <p class="text-muted">Geser, jawab, dan lihat hasilnya seketika. Tanpa akun.</p>
      </div>
      <div class="play-grid">
        <div class="reveal" data-reveal>
          <QuickDemo />
        </div>
        <div class="reveal" data-reveal style="--reveal-delay:90ms">
          <QuizTeaser />
        </div>
      </div>
    </div>
  </section>

  <section class="section container browse" aria-labelledby="browse">
    <div class="section-heading reveal" data-reveal>
      <p class="eyebrow-badge">Baru di sini?</p>
      <h2 id="browse">Pilih pintu masukmu</h2>
      <p class="text-muted">Telusuri menurut kelas atau elemen, lalu buka topik yang ingin kamu pelajari.</p>
    </div>
    <div class="browse-toggle" role="group" aria-label="Pilih cara menelusuri materi">
      <button type="button" class="browse-chip is-active" data-browse-target="grade" aria-pressed="true">
        Menurut kelas
      </button>
      <button type="button" class="browse-chip" data-browse-target="element" aria-pressed="false">
        Menurut elemen
      </button>
    </div>
    <div class="browse-panel" data-browse-panel="grade">
      <div class="grid grid-3">
        {
          GRADE_ORDER.map((grade, i) => (
            <a
              class={`card card-link grade-card hover-lift accent-${gradeAccent[grade]} reveal`}
              href={gradeUrl(grade)}
              style={revealStyle(i)}
              data-reveal
            >
              <span class="grade-num" aria-hidden="true">{grade}</span>
              <span class="badge badge-grade">Fase {GRADES[grade].phase}</span>
              <h3>{GRADES[grade].name}</h3>
              <p>{GRADES[grade].description}</p>
              <span class="cta">Buka kelas →</span>
            </a>
          ))
        }
      </div>
    </div>
    <div class="browse-panel" data-browse-panel="element">
      <div class="grid grid-4">
        {
          ELEMENT_ORDER.map((elementId, i) => (
            <a
              class={`card card-link element-card hover-lift wiggle-on-hover accent-${elementId} reveal`}
              href={elementOverviewUrl(elementId)}
              style={revealStyle(i)}
              data-reveal
            >
              <span class="element-icon wiggle-target" aria-hidden="true">
                <ElementIcon element={elementId} size={24} />
              </span>
              <h3>{ELEMENTS[elementId].name}</h3>
              <p>{ELEMENTS[elementId].description}</p>
              <span class="cta">Semua kelas →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <TopikShowcase topics={featured} />

  <section class="section section-alt" aria-labelledby="explorations">
    <div class="container">
      <div class="section-heading reveal" data-reveal>
        <p class="eyebrow-badge">Laboratorium mini</p>
        <h2 id="explorations">Eksplorasi interaktif</h2>
        <p class="text-muted">Ubah parameter, amati perubahan, lalu temukan polanya sendiri.</p>
      </div>
      <div class="grid grid-3">
        {
          showcaseExplorations.map((e, i) => (
            <ExplorationPreviewCard exploration={e} delay={i * 70} />
          ))
        }
      </div>
      <p class="section-more reveal" data-reveal>
        <a class="btn btn-secondary" href={url('/eksplorasi')}>Semua eksplorasi</a>
      </p>
    </div>
  </section>

  <section class="section container" aria-labelledby="real-world">
    <div class="section-heading reveal" data-reveal>
      <p class="eyebrow-badge">Dunia nyata</p>
      <h2 id="real-world">Matematika dalam kehidupan</h2>
      <p class="text-muted">Konsep matematika muncul dalam keputusan nyata.</p>
    </div>
    <div class="grid grid-2 apps-grid">
      {
        (Object.keys(applicationCategories) as Array<keyof typeof applicationCategories>).map((cat, i) => {
          const apps = applications.filter((a) => a.category === cat);
          return (
            <div class="card hover-lift reveal" style={revealStyle(i)} data-reveal>
              <h3>{applicationCategories[cat].name}</h3>
              <p class="text-muted">{applicationCategories[cat].description}</p>
              <ul class="app-list">
                {apps.slice(0, 3).map((a) => (
                  <li>
                    <a href={url(`/aplikasi/${a.id}`)}>{a.title}</a>
                  </li>
                ))}
              </ul>
              <p class="app-more">
                <a href={url('/aplikasi') + `#c-${cat}`}>
                  {apps.length} studi kasus <span aria-hidden="true">→</span>
                </a>
              </p>
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="section container" aria-labelledby="trust">
    <div class="section-heading reveal" data-reveal>
      <p class="eyebrow-badge">Sebelum mulai</p>
      <h2 id="trust">Belajar dengan tenang &amp; jujur</h2>
    </div>
    <ul class="trust-grid" role="list">
      {
        trustPoints.map((point, i) => (
          <li class="trust-item hover-lift reveal" style={revealStyle(i)} data-reveal>
            <h3>{point.title}</h3>
            <p>{point.text}</p>
            {point.href && (
              <p class="trust-link">
                <a href={point.href}>
                  {point.link} <span aria-hidden="true">→</span>
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ul>
    <p class="section-more reveal" data-reveal>
      <a class="btn btn-secondary" href={url('/tentang')}>Baca tentang situs &amp; sumbernya</a>
    </p>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    try {
      var root = document.querySelector('.browse');
      if (!root) return;
      var buttons = Array.prototype.slice.call(root.querySelectorAll('.browse-chip'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('.browse-panel'));
      if (!buttons.length || !panels.length) return;

      function show(target) {
        for (var i = 0; i < panels.length; i++) {
          var match = panels[i].getAttribute('data-browse-panel') === target;
          panels[i].classList.toggle('is-hidden', !match);
        }
        for (var j = 0; j < buttons.length; j++) {
          var active = buttons[j].getAttribute('data-browse-target') === target;
          buttons[j].classList.toggle('is-active', active);
          buttons[j].setAttribute('aria-pressed', active ? 'true' : 'false');
        }
      }

      for (var k = 0; k < buttons.length; k++) {
        buttons[k].addEventListener('click', function (event) {
          var target = event.currentTarget.getAttribute('data-browse-target') || 'grade';
          show(target);
        });
      }

      root.classList.add('js-ready');
      show('grade');
    } catch (e) {
      root && root.classList.remove('js-ready');
    }
  })();
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 24%, color-mix(in srgb, var(--color-algebra) 16%, transparent), transparent 44%),
      radial-gradient(circle at 10% 82%, color-mix(in srgb, var(--color-geometry) 14%, transparent), transparent 46%),
      linear-gradient(180deg, var(--color-bg-alt), var(--color-bg));
    border-bottom: 1px solid var(--color-border);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
    -webkit-mask-image: radial-gradient(circle at 34% 34%, #000, transparent 72%);
    mask-image: radial-gradient(circle at 34% 34%, #000, transparent 72%);
    opacity: 0.7;
    pointer-events: none;
  }
  .hero-mesh {
    position: absolute;
    z-index: 0;
    top: -6rem;
    right: -4rem;
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    background: radial-gradient(
      circle at 40% 40%,
      color-mix(in srgb, var(--color-primary) 22%, transparent),
      transparent 68%
    );
    filter: blur(8px);
    pointer-events: none;
  }
  .hero-dots {
    position: absolute;
    z-index: 0;
    left: 8%;
    bottom: 1.5rem;
    width: 9rem;
    height: 5rem;
    background-image: radial-gradient(color-mix(in srgb, var(--color-primary) 40%, transparent) 1.4px, transparent 1.5px);
    background-size: 1.1rem 1.1rem;
    opacity: 0.5;
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    align-items: center;
    padding-block: clamp(1.75rem, 5vw, 3.25rem);
  }
  .hero-copy > * {
    animation: rise-in var(--dur-slow) var(--ease-out-soft) both;
  }
  .hero-copy > *:nth-child(1) {
    animation-delay: 40ms;
  }
  .hero-copy > *:nth-child(2) {
    animation-delay: 110ms;
  }
  .hero-copy > *:nth-child(3) {
    animation-delay: 180ms;
  }
  .hero-copy > *:nth-child(4) {
    animation-delay: 250ms;
  }
  .hero-copy > *:nth-child(5),
  .hero-copy > *:nth-child(6),
  .hero-copy > *:nth-child(7) {
    animation-delay: 320ms;
  }
  .hero-copy .eyebrow-badge {
    margin-bottom: 0.85rem;
  }
  .hero-copy h1 {
    font-size: clamp(2.1rem, 1.4rem + 3.2vw, 3.35rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin-bottom: 0.55rem;
  }
  .hero-lead {
    font-size: clamp(1.1rem, 1rem + 0.7vw, 1.45rem);
    line-height: 1.5;
    max-width: 46ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px dashed var(--color-border-strong);
  }
  .hero-stats li {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .hero-stats strong {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.7rem);
    color: var(--color-primary);
  }
  .hero-stats span {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .hero-byline {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    max-width: 100%;
    margin: 1.15rem 0 0;
    padding: 0.4rem 0.95rem 0.4rem 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .hero-byline a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding-block: 0.1rem;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }
  .hero-byline a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .hero-byline strong {
    font-weight: 700;
  }
  .byline-logo {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0.15rem;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--color-border);
  }
  .byline-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
  }
  .byline-sep {
    color: var(--color-border-strong);
  }
  .hero-visual {
    display: grid;
    place-items: center;
    width: 100%;
  }
  .play-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  .section-alt {
    background: var(--color-bg-alt);
    border-block: 1px solid var(--color-border);
  }
  .section-paper {
    position: relative;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
  }
  .section-more {
    margin-top: 1.5rem;
  }

  .section-heading .eyebrow-badge {
    margin-bottom: 0.6rem;
  }

  .audience-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.75rem;
  }
  .audience-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    border-top: 3px solid var(--color-primary);
  }
  .audience-item:nth-child(2) {
    border-top-color: var(--color-algebra);
  }
  .audience-item:nth-child(3) {
    border-top-color: var(--color-geometry);
  }
  .audience-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: 0.9rem 1rem;
    color: inherit;
    text-decoration: none;
  }
  .audience-card h3 {
    margin: 0;
    font-size: 1rem;
  }
  .audience-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .audience-card .cta {
    margin-top: 0.35rem;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .audience-card:hover .cta,
  .audience-card:focus-visible .cta {
    text-decoration: underline;
  }
  .pedagogy-section {
    margin-top: 2rem;
  }

  .browse-toggle {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.25rem;
    margin-bottom: 1.25rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: 999px;
  }
  .browse-chip {
    appearance: none;
    border: 1px solid transparent;
    background: transparent;
    color: var(--color-text);
    border-radius: 999px;
    padding: 0.42rem 1rem;
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
