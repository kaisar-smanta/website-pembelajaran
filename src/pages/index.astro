---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import ContinueLearning from '@/components/progress/ContinueLearning.astro';
import MethodSection from '@/components/home/MethodSection.astro';
import PracticeSection from '@/components/home/PracticeSection.astro';
import BrowseSection from '@/components/home/BrowseSection.astro';
import SubjectDoors from '@/components/home/SubjectDoors.astro';
import TopicsSection from '@/components/home/TopicsSection.astro';
import RealWorldSection from '@/components/home/RealWorldSection.astro';
import TrustSection from '@/components/home/TrustSection.astro';
import FinalCta from '@/components/home/FinalCta.astro';
import CtaCard from '@/components/ui/CtaCard.astro';
import { topics, topicSubject } from '@/data/topics';
import { absoluteUrl, url } from '@/utils/url';

const featured = topics.filter((topic) => topic.featured);
const featuredList = {
  '@type': 'ItemList',
  name: 'Topik pilihan Matematika dan Matematika Tingkat Lanjut SMA',
  itemListElement: featured.map((topic, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: topic.title,
    url: absoluteUrl(`${topicSubject(topic)}/kelas/${topic.grade}/${topic.element}/${topic.slug}`),
  })),
};
---

<BaseLayout
  title="Pahami Konsep Matematika SMA, Bukan Hafal Rumus"
  description="Pusat belajar Matematika dan Matematika Tingkat Lanjut SMA kelas X–XII sesuai Kurikulum Merdeka: eksplorasi interaktif, latihan berjenjang, dan studi kasus nyata. Gratis, tanpa akun."
  structuredData={featuredList}
>
  <Hero />
  <ContinueLearning />
  <section class="home-insights no-print">
    <div class="container">
      <CtaCard
        eyebrow="Kemajuan & tinjauan"
        title="Pantau kemajuanmu dan ulangi tepat waktu"
        text="Lihat ringkasan belajar dan jadwalkan tinjauan berkala agar materi tetap melekat."
        reveal
        dataReveal
        actions={[
          { label: 'Lihat kemajuan', href: url('/kemajuan'), variant: 'primary' },
          { label: 'Mulai tinjauan', href: url('/review'), variant: 'secondary' },
        ]}
      />
    </div>
  </section>
  <div class="home-topics-mobile-hide"><TopicsSection /></div>
  <SubjectDoors />
  <BrowseSection />
  <PracticeSection />
  <MethodSection />
  <RealWorldSection />
  <TrustSection />
  <FinalCta />
</BaseLayout>

<style>
  .home-insights {
    padding-block: 0.5rem 1rem;
  }
  @media (max-width: 40rem) {
    .home-topics-mobile-hide {
      display: none;
    }
  }
</style>
