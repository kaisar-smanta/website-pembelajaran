---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroPlayground from '@/components/content/HeroPlayground.astro';
import ElementIcon from '@/components/content/ElementIcon.astro';
import ExplorationPreviewCard from '@/components/content/ExplorationPreviewCard.astro';
import TopikShowcase from '@/components/content/TopikShowcase.astro';
import QuickDemo from '@/components/interactive/QuickDemo.astro';
import QuizTeaser from '@/components/exercises/QuizTeaser.astro';
import { ELEMENTS, ELEMENT_ORDER, GRADES, GRADE_ORDER } from '@/data/curriculum';
import { featuredTopics, topics } from '@/data/topics';
import { explorations } from '@/data/explorations';
import { applications, applicationCategories } from '@/data/applications';
import { questions } from '@/data/questions';
import { featuredTools } from '@/data/tools';
import { site } from '@/data/site';
import { url, gradeUrl, elementOverviewUrl } from '@/utils/url';

const featured = featuredTopics().length ? featuredTopics() : topics.slice(0, 6);
const featuredExplorations = explorations.filter((e) => e.featured);
const showcaseExplorations = (featuredExplorations.length ? featuredExplorations : explorations).slice(0, 3);
const stats = [
  { value: topics.length, label: 'topik materi' },
  { value: questions.length, label: 'soal latihan' },
  { value: applications.length, label: 'studi kasus nyata' },
  { value: explorations.length, label: 'eksplorasi interaktif' },
];
const philosophy = [
  { title: 'Pahami', text: 'Mulai dari konteks dan pertanyaan, bukan langsung rumus.' },
  { title: 'Eksplorasi', text: 'Ubah parameter pada simulasi, amati pola, ajukan dugaan.' },
  { title: 'Terapkan', text: 'Kerjakan latihan berjenjang: dasar, cakap, lalu mahir.' },
  { title: 'Analisis', text: 'Tafsirkan hasil dan nilai apakah modelnya masuk akal.' },
  { title: 'Refleksi', text: 'Kenali kesalahan umum, lalu rangkum pemahamanmu.' },
];
const trustPoints = [
  {
    title: 'Gratis & tanpa akun',
    text: 'Semua materi dapat dibuka langsung, tanpa pendaftaran atau biaya.',
  },
  {
    title: 'Mengikuti CP Kurikulum Merdeka',
    text: 'Disusun sebagai tafsir instruksional, bukan salinan buku teks resmi.',
  },
  {
    title: 'Untuk siswa, guru, dan orang tua',
    text: 'Cocok untuk belajar mandiri maupun mendampingi pembelajaran di kelas.',
  },
];
const revealStyle = (i: number) => `--reveal-delay:${i * 70}ms`;
const gradeAccent: Record<string, string> = { X: 'number', XI: 'algebra', XII: 'geometry' };
---

<BaseLayout
  title="Paham Konsep, Bukan Sekadar Hafal Rumus"
  description="Pusat pembelajaran Matematika SMA kelas X–XII sesuai Kurikulum Merdeka: eksplorasi interaktif, latihan berjenjang, dan studi kasus nyata. Gratis, tanpa akun."
>
  <section class="hero">
    <span class="hero-mesh" aria-hidden="true"></span>
    <div class="hero-grid container">
      <div class="hero-copy">
        <p class="eyebrow-badge">Kurikulum Merdeka · Kelas X–XII</p>
        <h1>Paham <span class="marker">konsep</span>, bukan sekadar hafal rumus</h1>
        <p class="hero-lead">
          Matematika bukan sekadar menghitung. Di sini kamu belajar{' '}
          <strong>memahami pola</strong>, <strong>membuat model</strong>,{' '}
          <strong>menalar</strong>, dan <strong>mengambil keputusan</strong> lewat eksplorasi
          interaktif, latihan berjenjang, dan contoh nyata.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={url('/kelas/X')}>Mulai belajar</a>
          <a class="btn btn-secondary" href={url('/peta-pembelajaran')}>Lihat peta belajar</a>
        </div>
        <p class="hero-note">Gratis · tanpa akun · untuk siswa, guru, dan orang tua</p>
        <ul class="hero-stats" role="list">
          {
            stats.map((stat) => (
              <li>
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </li>
            ))
          }
        </ul>
        <p class="hero-byline">
          <span class="byline-logo" aria-hidden="true">
            <img src={url(site.school.logo)} alt="" width="30" height="30" />
          </span>
          <span>
            Disusun oleh{' '}
            <a href={url('/tentang')}>
              <strong>{site.author.name}</strong>
            </a>{' '}
            <span class="byline-sep" aria-hidden="true">
              ·
            </span>{' '}
            <a href={site.school.url} target="_blank" rel="noopener noreferrer">
              {site.school.name}
            </a>
          </span>
        </p>
      </div>
      <div class="hero-visual">
        <HeroPlayground />
      </div>
    </div>
    <span class="hero-dots" aria-hidden="true"></span>
  </section>

  <section class="section section-alt" aria-labelledby="play">
    <div class="container">
      <div class="section-heading reveal" data-reveal>
        <p class="eyebrow-badge">Interaktif</p>
        <h2 id="play">Coba dulu, baru teori</h2>
        <p class="text-muted">Geser, jawab, dan lihat hasilnya seketika. Tanpa akun.</p>
      </div>
      <div class="play-grid">
        <div class="reveal" data-reveal>
          <QuickDemo />
        </div>
        <div class="reveal" data-reveal style="--reveal-delay:90ms">
          <QuizTeaser />
        </div>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="explore-grade">
    <div class="section-heading reveal" data-reveal>
      <p class="eyebrow-badge">Per jenjang</p>
      <h2 id="explore-grade">Jelajahi Berdasarkan Kelas</h2>
      <p class="text-muted">Materi disusun menurut fase dan elemen matematika.</p>
    </div>
    <div class="grid grid-3">
      {
        GRADE_ORDER.map((grade, i) => (
          <a
            class={`card card-link grade-card hover-lift accent-${gradeAccent[grade]} reveal`}
            href={gradeUrl(grade)}
            style={revealStyle(i)}
            data-reveal
          >
            <span class="grade-num" aria-hidden="true">{grade}</span>
            <span class="badge badge-grade">Fase {GRADES[grade].phase}</span>
            <h3>{GRADES[grade].name}</h3>
            <p>{GRADES[grade].description}</p>
            <span class="cta">Buka kelas →</span>
          </a>
        ))
      }
    </div>
  </section>

  <TopikShowcase topics={featured} />

  <section class="section container" aria-labelledby="explore-element">
    <div class="section-heading reveal" data-reveal>
      <p class="eyebrow-badge">Empat elemen</p>
      <h2 id="explore-element">Jelajahi Menurut Elemen</h2>
      <p class="text-muted">Empat elemen CP yang saling terhubung, lintas Kelas X–XII.</p>
    </div>
    <div class="grid grid-4">
      {
        ELEMENT_ORDER.map((elementId, i) => (
          <a
            class={`card card-link element-card hover-lift wiggle-on-hover accent-${elementId} reveal`}
            href={elementOverviewUrl(elementId)}
            style={revealStyle(i)}
            data-reveal
          >
            <span class="element-icon wiggle-target" aria-hidden="true">
              <ElementIcon element={elementId} size={24} />
            </span>
            <h3>{ELEMENTS[elementId].name}</h3>
            <p>{ELEMENTS[elementId].description}</p>
            <span class="cta">Semua kelas →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="explorations">
    <div class="container">
      <div class="section-heading reveal" data-reveal>
        <p class="eyebrow-badge">Laboratorium mini</p>
        <h2 id="explorations">Eksplorasi Interaktif</h2>
        <p class="text-muted">Ubah parameter, amati perubahan, lalu temukan polanya sendiri.</p>
      </div>
      <div class="grid grid-3">
        {
          showcaseExplorations.map((e, i) => (
            <ExplorationPreviewCard exploration={e} delay={i * 70} />
          ))
        }
      </div>
      <p class="section-more reveal" data-reveal>
        <a class="btn btn-secondary" href={url('/eksplorasi')}>Semua eksplorasi</a>
      </p>
    </div>
  </section>

  <section class="section container" aria-labelledby="real-world">
    <div class="section-heading reveal" data-reveal>
      <p class="eyebrow-badge">Dunia nyata</p>
      <h2 id="real-world">Matematika dalam Kehidupan</h2>
      <p class="text-muted">Konsep matematika muncul dalam keputusan nyata.</p>
    </div>
    <div class="grid grid-2 apps-grid">
      {
        (Object.keys(applicationCategories) as Array<keyof typeof applicationCategories>).map((cat, i) => {
          const apps = applications.filter((a) => a.category === cat);
          return (
            <div class="card hover-lift reveal" style={revealStyle(i)} data-reveal>
              <h3>{applicationCategories[cat].name}</h3>
              <p class="text-muted">{applicationCategories[cat].description}</p>
              <ul class="app-list">
                {apps.slice(0, 3).map((a) => (
                  <li>
                    <a href={url(`/aplikasi/${a.id}`)}>{a.title}</a>
                  </li>
                ))}
              </ul>
              <p class="app-more">
                <a href={url('/aplikasi') + `#c-${cat}`}>
                  {apps.length} studi kasus <span aria-hidden="true">→</span>
                </a>
              </p>
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="section section-paper" aria-labelledby="philosophy">
    <div class="container">
      <div class="section-heading reveal" data-reveal>
        <p class="eyebrow-badge">Alur belajar</p>
        <h2 id="philosophy">Cara Kamu Belajar di Sini</h2>
        <p class="text-muted">Lima kebiasaan berpikir yang dilatih di setiap topik.</p>
      </div>
      <ol class="philosophy">
        {
          philosophy.map((step, i) => (
            <li class="philosophy-step hover-lift reveal" style={revealStyle(i)} data-reveal>
              <span class="philosophy-num">{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="tools">
    <div class="container">
      <div class="section-heading reveal" data-reveal>
        <p class="eyebrow-badge">Perangkat</p>
        <h2 id="tools">Alat Matematika</h2>
        <p class="text-muted">Alat bantu untuk mengeksplorasi dan memeriksa pekerjaanmu.</p>
      </div>
      <div class="tool-row">
        {
          featuredTools.map((tool, i) => (
            <a
              class="tool-card hover-lift reveal"
              href={tool.url}
              target="_blank"
              rel="noopener noreferrer"
              style={revealStyle(i)}
              data-reveal
            >
              <span class="tool-name">
                {tool.name} <span aria-hidden="true">↗</span>
              </span>
              <span class="tool-note">{tool.note}</span>
            </a>
          ))
        }
      </div>
      <p class="section-more reveal" data-reveal>
        <a class="btn btn-secondary" href={url('/alat')}>Semua alat & panduan</a>
      </p>
    </div>
  </section>

  <section class="section container" aria-labelledby="trust">
    <div class="section-heading reveal" data-reveal>
      <p class="eyebrow-badge">Sebelum mulai</p>
      <h2 id="trust">Belajar dengan tenang &amp; jujur</h2>
    </div>
    <ul class="trust-grid" role="list">
      {
        trustPoints.map((point, i) => (
          <li class="trust-item hover-lift reveal" style={revealStyle(i)} data-reveal>
            <h3>{point.title}</h3>
            <p>{point.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="section-more reveal" data-reveal>
      <a class="btn btn-secondary" href={url('/tentang')}>Baca tentang situs &amp; sumbernya</a>
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 24%, color-mix(in srgb, var(--color-algebra) 16%, transparent), transparent 44%),
      radial-gradient(circle at 10% 82%, color-mix(in srgb, var(--color-geometry) 14%, transparent), transparent 46%),
      linear-gradient(180deg, var(--color-bg-alt), var(--color-bg));
    border-bottom: 1px solid var(--color-border);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
    -webkit-mask-image: radial-gradient(circle at 34% 34%, #000, transparent 72%);
    mask-image: radial-gradient(circle at 34% 34%, #000, transparent 72%);
    opacity: 0.7;
    pointer-events: none;
  }
  .hero-mesh {
    position: absolute;
    z-index: 0;
    top: -6rem;
    right: -4rem;
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    background: radial-gradient(
      circle at 40% 40%,
      color-mix(in srgb, var(--color-primary) 22%, transparent),
      transparent 68%
    );
    filter: blur(8px);
    pointer-events: none;
  }
  .hero-dots {
    position: absolute;
    z-index: 0;
    left: 8%;
    bottom: 1.5rem;
    width: 9rem;
    height: 5rem;
    background-image: radial-gradient(color-mix(in srgb, var(--color-primary) 40%, transparent) 1.4px, transparent 1.5px);
    background-size: 1.1rem 1.1rem;
    opacity: 0.5;
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 2rem;
    align-items: center;
    padding-block: clamp(1.75rem, 5vw, 3.25rem);
  }
  .hero-copy > * {
    animation: rise-in var(--dur-slow) var(--ease-out-soft) both;
  }
  .hero-copy > *:nth-child(1) {
    animation-delay: 40ms;
  }
  .hero-copy > *:nth-child(2) {
    animation-delay: 110ms;
  }
  .hero-copy > *:nth-child(3) {
    animation-delay: 180ms;
  }
  .hero-copy > *:nth-child(4) {
    animation-delay: 250ms;
  }
  .hero-copy > *:nth-child(5),
  .hero-copy > *:nth-child(6),
  .hero-copy > *:nth-child(7) {
    animation-delay: 320ms;
  }
  .hero-copy .eyebrow-badge {
    margin-bottom: 0.85rem;
  }
  .hero-copy h1 {
    font-size: clamp(2.1rem, 1.4rem + 3.2vw, 3.35rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin-bottom: 0.55rem;
  }
  .hero-lead {
    font-size: clamp(1.1rem, 1rem + 0.7vw, 1.45rem);
    line-height: 1.5;
    max-width: 46ch;
  }
  .hero-note {
    margin: 0.9rem 0 0;
    color: var(--color-text-soft);
    font-size: 0.85rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px dashed var(--color-border-strong);
  }
  .hero-stats li {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .hero-stats strong {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.7rem);
    color: var(--color-primary);
  }
  .hero-stats span {
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }
  .hero-byline {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    max-width: 100%;
    margin: 1.15rem 0 0;
    padding: 0.4rem 0.95rem 0.4rem 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .hero-byline a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding-block: 0.1rem;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
  }
  .hero-byline a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .hero-byline strong {
    font-weight: 700;
  }
  .byline-logo {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0.15rem;
    border-radius: 50%;
    background: #fff;
    border: 1px solid var(--color-border);
  }
  .byline-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 50%;
  }
  .byline-sep {
    color: var(--color-border-strong);
  }
  .hero-visual {
    display: grid;
    place-items: center;
    width: 100%;
  }
  .play-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: 1fr;
  }
  .section-alt {
    background: var(--color-bg-alt);
    border-block: 1px solid var(--color-border);
  }
  .section-paper {
    position: relative;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
  }
  .section-more {
    margin-top: 1.5rem;
  }

  .section-heading .eyebrow-badge {
    margin-bottom: 0.6rem;
  }

  .grade-card,
  .element-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow: hidden;
  }
  .grade-card > .badge {
    align-self: flex-start;
  }
  .grade-card h3,
  .element-card h3 {
    margin: 0;
  }
  .grade-card p,
  .element-card p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.93rem;
  }
  .grade-card .cta,
  .element-card .cta {
    margin-top: auto;
    color: var(--color-primary);
    font-weight: 600;
  }
  .grade-num {
    position: absolute;
    right: 0.4rem;
    top: -0.6rem;
    font-family: var(--font-serif);
    font-size: 5.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.08;
    pointer-events: none;
    user-select: none;
  }
  .accent-number {
    border-top: 3px solid var(--color-number);
  }
  .accent-number .grade-num {
    color: var(--color-number);
  }
  .accent-algebra {
    border-top: 3px solid var(--color-algebra);
  }
  .accent-algebra .grade-num {
    color: var(--color-algebra);
  }
  .accent-geometry {
    border-top: 3px solid var(--color-geometry);
  }
  .accent-geometry .grade-num {
    color: var(--color-geometry);
  }
  .accent-bilangan {
    border-top: 3px solid var(--color-number);
  }
  .accent-aljabar-fungsi {
    border-top: 3px solid var(--color-algebra);
  }
  .accent-geometri {
    border-top: 3px solid var(--color-geometry);
  }
  .accent-data-peluang {
    border-top: 3px solid var(--color-data);
  }
  .element-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 12px;
    background: var(--color-surface-2);
    color: var(--color-primary);
  }
  .accent-bilangan .element-icon {
    color: var(--color-number);
    background: color-mix(in srgb, var(--color-number) 12%, var(--color-surface-2));
  }
  .accent-aljabar-fungsi .element-icon {
    color: var(--color-algebra);
    background: color-mix(in srgb, var(--color-algebra) 12%, var(--color-surface-2));
  }
  .accent-geometri .element-icon {
    color: var(--color-geometry);
    background: color-mix(in srgb, var(--color-geometry) 12%, var(--color-surface-2));
  }
  .accent-data-peluang .element-icon {
    color: var(--color-data);
    background: color-mix(in srgb, var(--color-data) 12%, var(--color-surface-2));
  }
  .philosophy {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 0.6rem;
  }
  .philosophy-step {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 0.45rem;
    row-gap: 0.1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    border-top: 3px solid var(--color-primary);
    padding: 0.55rem 0.7rem;
  }
  .philosophy-step:nth-child(2) {
    border-top-color: var(--color-number);
  }
  .philosophy-step:nth-child(3) {
    border-top-color: var(--color-algebra);
  }
  .philosophy-step:nth-child(4) {
    border-top-color: var(--color-geometry);
  }
  .philosophy-step:nth-child(5) {
    border-top-color: var(--color-data);
  }
  .philosophy-num {
    grid-column: 1;
    grid-row: 1;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.82rem;
  }
  .philosophy-step h3 {
    grid-column: 2;
    grid-row: 1;
    font-size: 0.98rem;
    margin: 0;
  }
  .philosophy-step p {
    grid-column: 1 / -1;
    grid-row: 2;
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }
  .app-list {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.35rem;
  }
  .apps-grid .card {
