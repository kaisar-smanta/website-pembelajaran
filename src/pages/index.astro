---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import MethodSection from '@/components/home/MethodSection.astro';
import PracticeSection from '@/components/home/PracticeSection.astro';
import BrowseSection from '@/components/home/BrowseSection.astro';
import SubjectDoors from '@/components/home/SubjectDoors.astro';
import TopicsSection from '@/components/home/TopicsSection.astro';
import ExplorationSection from '@/components/home/ExplorationSection.astro';
import RealWorldSection from '@/components/home/RealWorldSection.astro';
import TrustSection from '@/components/home/TrustSection.astro';
import FinalCta from '@/components/home/FinalCta.astro';
import { resolveTopics, topicSubject } from '@/data/topics';
import { absoluteUrl } from '@/utils/url';

const featuredIds = [
  'eksponen',
  'fungsi-kuadrat',
  'trigonometri',
  'bunga-majemuk',
  'data-bivariat',
  'peluang',
];
const featured = resolveTopics(featuredIds);
const featuredList = {
  '@type': 'ItemList',
  name: 'Topik pilihan Matematika SMA',
  itemListElement: featured.map((topic, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: topic.title,
    url: absoluteUrl(`${topicSubject(topic)}/kelas/${topic.grade}/${topic.element}/${topic.slug}`),
  })),
};
---

<BaseLayout
  title="Pahami Konsep Matematika SMA, Bukan Hafal Rumus"
  description="Pusat belajar Matematika SMA kelas X–XII sesuai Kurikulum Merdeka: eksplorasi interaktif, latihan berjenjang, dan studi kasus nyata. Gratis, tanpa akun."
  structuredData={featuredList}
>
  <Hero />
  <MethodSection />
  <SubjectDoors />
  <PracticeSection />
  <BrowseSection />
  <TopicsSection />
  <ExplorationSection />
  <RealWorldSection />
  <TrustSection />
  <FinalCta />
</BaseLayout>
