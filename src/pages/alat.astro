---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import SectionHeading from '@/components/content/SectionHeading.astro';
import Callout from '@/components/content/Callout.astro';
import ElementIcon from '@/components/content/ElementIcon.astro';
import CtaCard from '@/components/ui/CtaCard.astro';
import { url } from '@/utils/url';
import { toolGroups } from '@/data/tools';
import { ALL_ELEMENT_ORDER } from '@/data/curriculum';

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Alat Matematika' },
];

const accentElements = ALL_ELEMENT_ORDER;
const totalTools = toolGroups.reduce((sum, group) => sum + group.tools.length, 0);
const meta = [`${totalTools} alat`, `${toolGroups.length} kategori`];
---

<BaseLayout
  title="Alat Matematika"
  description="Kumpulan alat matematika daring untuk memvisualkan fungsi, memeriksa perhitungan, dan menganalisis data."
>
  <PageHeader
    title="Alat Matematika"
    eyebrow="Perangkat"
    lead="Kumpulan alat bantu untuk memvisualkan fungsi, memeriksa perhitungan, dan menganalisis data."
    crumbs={crumbs}
    meta={meta}
  />

  <div class="container tools">
    <div class="tools-advisory reveal">
      <Callout
        variant="info"
        text="**Alat membantu mengeksplorasi dan memeriksa**, tetapi tidak menggantikan pemahaman. Biasakan: kerjakan dengan tangan → periksa dengan alat → jelaskan mengapa hasilnya masuk akal."
      />
    </div>

    {
      toolGroups.map((group, gi) => {
        const elementId = accentElements[gi % accentElements.length];
        return (
          <section class:list={['block', `accent-${elementId}`]} aria-labelledby={`g-${group.heading}`}>
            <SectionHeading
              id={`g-${group.heading}`}
              eyebrow={`Kelompok ${gi + 1}`}
              title={group.heading}
              lead={group.intro}
            />
            <div class="grid grid-2">
              {group.tools.map((tool, ti) => (
                <article
                  class="card tool hover-lift reveal card-accent"
                  style={`--reveal-delay:${ti * 70}ms`}
                >
                  <span class="icon-tile tool-icon" aria-hidden="true">
                    <ElementIcon element={elementId} size={22} />
                  </span>
                  <h3>
                    <a href={tool.url} target="_blank" rel="noopener noreferrer">
                      {tool.name} <span aria-hidden="true">↗</span>
                    </a>
                  </h3>
                  <p class="text-soft">{tool.note}</p>
                  <p>{tool.use}</p>
                </article>
              ))}
            </div>
          </section>
        );
      })
    }
  </div>

  <section class="section-alt cta-section">
    <div class="container">
      <CtaCard
        eyebrow="Langkah berikutnya"
        title="Pakai alat untuk memahami, bukan menggantikannya"
        text="Coba modelkan sebuah konsep di laboratorium interaktif, atau mulai menelusuri materi dari kelas X."
        accentClass="accent-aljabar-fungsi"
        reveal
        actions={[
          { label: 'Jelajahi eksplorasi', href: url('/eksplorasi'), variant: 'primary' },
          { label: 'Mulai dari Kelas X', href: url('/matematika/kelas/X'), variant: 'secondary' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .tools {
    padding-block: 1rem 2.5rem;
  }
  .tools-advisory {
    max-width: 70ch;
    margin-bottom: 0.5rem;
  }
  .block {
    padding-block: 2rem;
  }
  .block + .block {
    border-top: 1px solid var(--color-border);
  }
  .block :global(.section-heading h2) {
    color: var(--accent, var(--color-primary));
  }
  .block :global(.eyebrow-badge) {
    border-color: color-mix(in srgb, var(--accent, var(--color-primary)) 35%, var(--color-border));
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 9%, var(--color-surface));
    color: color-mix(in srgb, var(--accent, var(--color-primary)) 68%, var(--color-text));
  }
  .tool {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .tool-icon {
    margin-bottom: 0.45rem;
  }
  .tool h3 {
    font-size: 1.1rem;
    margin-bottom: 0.15rem;
  }
  .tool h3 a {
    display: inline-block;
    padding-block: 0.2rem;
    text-decoration: none;
  }
  .tool h3 a:hover {
    text-decoration: underline;
  }
  .tool p {
    margin: 0;
    font-size: 0.93rem;
  }
  .tool p + p {
    margin-top: 0.35rem;
  }
  .cta-section {
    padding-block: 2.5rem;
  }
</style>
