---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import { url } from '@/utils/url';
import { toolGroups } from '@/data/tools';

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Alat Matematika' },
];

---

<BaseLayout
  title="Alat Matematika"
  description="Kumpulan alat matematika daring untuk memvisualkan fungsi, memeriksa perhitungan, dan menganalisis data."
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <header class="page-head">
      <p class="eyebrow">Perangkat</p>
      <h1>Alat Matematika</h1>
      <p class="lead">Kumpulan alat bantu untuk memvisualkan fungsi, memeriksa perhitungan, dan menganalisis data.</p>
      <blockquote class="callout callout-info" role="note">
        <strong>Alat membantu mengeksplorasi dan memeriksa</strong>, tetapi tidak menggantikan
        pemahaman. Biasakan: kerjakan dengan tangan → periksa dengan alat → jelaskan mengapa
        hasilnya masuk akal.
      </blockquote>
    </header>

    {
      toolGroups.map((group) => (
        <section class="block" aria-labelledby={`g-${group.heading}`}>
          <h2 id={`g-${group.heading}`}>{group.heading}</h2>
          <p class="text-muted">{group.intro}</p>
          <div class="grid grid-2">
            {group.tools.map((tool) => (
              <article class="card tool">
                <h3>
                  <a href={tool.url} target="_blank" rel="noopener noreferrer">
                    {tool.name} <span aria-hidden="true">↗</span>
                  </a>
                </h3>
                <p class="text-soft">{tool.note}</p>
                <p>{tool.use}</p>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: 0.5rem 1.5rem;
  }
  .lead {
    max-width: 70ch;
    color: var(--color-text-muted);
    font-size: 1.08rem;
  }
  .callout {
    padding: 0.75rem 1rem;
    border-left: 4px solid var(--color-primary);
    background: var(--color-info-soft);
    border-radius: var(--radius);
    max-width: 70ch;
  }
  .block {
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .tool h3 {
    font-size: 1.1rem;
  }
  .tool h3 a {
    display: inline-block;
    padding-block: 0.2rem;
    text-decoration: none;
  }
  .tool h3 a:hover {
    text-decoration: underline;
  }
  .tool p {
    margin: 0.3rem 0 0;
    font-size: 0.93rem;
  }
</style>
