---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/navigation/Breadcrumbs.astro';
import { applications, applicationCategories } from '@/data/applications';
import { url } from '@/utils/url';
import type { ApplicationCategory } from '@/types/content';

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Matematika dalam Kehidupan' },
];
const order: ApplicationCategory[] = ['keuangan', 'data', 'pertumbuhan', 'pengukuran'];
---

<BaseLayout
  title="Matematika dalam Kehidupan"
  description="Penerapan matematika pada keuangan, data, pertumbuhan, dan pengukuran dengan studi kasus kontekstual."
>
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <header class="page-head">
      <p class="eyebrow">Aplikasi</p>
      <h1>Matematika dalam Kehidupan</h1>
      <p class="lead">
        Matematika berguna ketika membantu kita memahami situasi nyata dan mengambil keputusan.
        Setiap studi kasus di bawah menghubungkan kembali ke konsep yang mendasarinya.
      </p>
    </header>

    {
      order.map((cat) => {
        const apps = applications.filter((a) => a.category === cat);
        if (!apps.length) return null;
        return (
          <section class="block" aria-labelledby={`c-${cat}`}>
            <h2 id={`c-${cat}`}>{applicationCategories[cat].name}</h2>
            <p class="text-muted">{applicationCategories[cat].description}</p>
            <div class="grid grid-2">
              {apps.map((a) => (
                <a class="card card-link" href={url(`/aplikasi/${a.id}`)}>
                  <h3>{a.title}</h3>
                  <p class="text-muted">{a.summary}</p>
                  <span class="cta">Baca studi kasus →</span>
                </a>
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: 0.5rem 1.5rem;
  }
  .lead {
    max-width: 70ch;
    color: var(--color-text-muted);
    font-size: 1.08rem;
  }
  .block {
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .card h3 {
    margin-bottom: 0.3rem;
  }
  .card p {
    font-size: 0.93rem;
  }
  .cta {
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.9rem;
  }
</style>
