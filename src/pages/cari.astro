---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import CtaCard from '@/components/ui/CtaCard.astro';
import MathMascot from '@/components/content/MathMascot.astro';
import { url } from '@/utils/url';
import { ALL_ELEMENT_ORDER, GRADE_ORDER, ELEMENTS } from '@/data/curriculum';

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Cari' },
];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const meta = [
  `${ALL_ELEMENT_ORDER.length} elemen kurikulum`,
  `${GRADE_ORDER.length} jenjang kelas`,
  'Tanpa server · tanpa akun',
];
---

<BaseLayout title="Cari Materi" description="Cari topik, konsep, dan studi kasus di seluruh situs Matematika SMA.">
  <PageHeader
    narrow
    title="Cari Materi"
    eyebrow="Pencarian"
    lead="Telusuri topik, istilah, dan studi kasus. Pencarian berjalan di peramban tanpa server."
    crumbs={crumbs}
    meta={meta}
  />

  <div class="container container-narrow search-body" data-search-root data-base={base}>
    <form class="search-form reveal" role="search" data-search-form>
      <label class="visually-hidden" for="search-input">Kata kunci pencarian</label>
      <input
        id="search-input"
        type="search"
        class="search-input"
        placeholder="Contoh: bunga majemuk, eksponen, kuartil…"
        autocomplete="off"
        data-search-input
      />
      <div class="filters">
        <label>
          <span class="visually-hidden">Filter kelas</span>
          <select data-filter-grade>
            <option value="">Semua kelas</option>
            {GRADE_ORDER.map((g) => <option value={g}>Kelas {g}</option>)}
          </select>
        </label>
        <label>
          <span class="visually-hidden">Filter elemen</span>
          <select data-filter-element>
            <option value="">Semua elemen</option>
            {ALL_ELEMENT_ORDER.map((e) => <option value={e}>{ELEMENTS[e].name}</option>)}
          </select>
        </label>
        <label>
          <span class="visually-hidden">Filter jenis hasil</span>
          <select data-filter-type>
            <option value="">Semua jenis</option>
            <option value="topik">Topik</option>
            <option value="latihan">Latihan</option>
            <option value="eksplorasi">Eksplorasi</option>
            <option value="aplikasi">Aplikasi</option>
            <option value="istilah">Istilah</option>
            <option value="rumus">Rumus</option>
            <option value="halaman">Halaman</option>
          </select>
        </label>
      </div>
    </form>

    <p class="search-status" data-search-status aria-live="polite"></p>
    <p class="search-hint" data-search-hint aria-live="polite" hidden></p>

    <noscript>
      <div class="search-noscript card">
        <p class="search-noscript-lead">
          Pencarian berjalan di peramban dan memerlukan JavaScript. Sementara itu, jelajahi halaman
          berikut:
        </p>
        <ul class="search-noscript-list">
          <li><a href={url('/peta-pembelajaran')}>Peta Pembelajaran</a></li>
          <li><a href={url('/latihan')}>Latihan</a></li>
          <li><a href={url('/glosarium')}>Glosarium</a></li>
          <li><a href={url('/rumus')}>Kumpulan Rumus</a></li>
        </ul>
      </div>
    </noscript>

    <ol class="search-results" data-search-results>
      <li class="result-empty card" data-search-empty hidden>
        <MathMascot size={6} state="oops" label="Maskot tidak menemukan hasil pencarian" />
        <p class="result-empty-text" data-search-empty-text></p>
      </li>
    </ol>

    <p class="search-more" data-search-more hidden>
      <button type="button" class="search-more-btn" data-search-more-btn>Tampilkan semua hasil</button>
    </p>
  </div>

  <section class="section-alt cta-section">
    <div class="container">
      <CtaCard
        eyebrow="Belum menemukan?"
        title="Jelajahi lewat jalur belajar"
        text="Mulai dari kelas X, ikuti peta konsep antar materi, atau uji pemahamanmu lewat latihan berjenjang."
        accentClass="accent-bilangan"
        reveal
        actions={[
          { label: 'Mulai dari Kelas X', href: url('/matematika/kelas/X'), variant: 'primary' },
          { label: 'Peta pembelajaran', href: url('/peta-pembelajaran'), variant: 'secondary' },
          { label: 'Latihan berjenjang', href: url('/latihan'), variant: 'secondary' },
        ]}
      />
    </div>
  </section>
</BaseLayout>

<style>
  .search-body {
    padding-block: clamp(1.5rem, 4vw, 2.5rem) 3rem;
  }
  .search-form {
    display: grid;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
    padding: 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .search-input {
    width: 100%;
    padding: 0.95rem 1.1rem;
    font: inherit;
    font-size: 1.12rem;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    transition:
      border-color var(--dur) var(--ease-out-soft),
      box-shadow var(--dur) var(--ease-out-soft),
      background-color var(--dur);
  }
  .search-input::placeholder {
    color: var(--color-text-soft);
  }
  .search-input:hover {
    border-color: var(--color-primary);
  }
  .search-input:focus-visible {
    border-color: var(--color-primary);
    background: var(--color-surface);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary) 16%, transparent);
  }
  .filters {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .filters label {
    flex: 1 1 12rem;
    min-width: 0;
  }
  .filters select {
    width: 100%;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    color: var(--color-text);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--dur-fast),
      background-color var(--dur-fast),
      color var(--dur-fast);
  }
  .filters select:hover,
  .filters select:focus-visible {
    border-color: var(--color-primary);
    background: var(--color-surface);
  }
  .search-status {
    margin: 0 0 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }
  .search-status:not(:empty) {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface-2);
  }
  .search-status:not(:empty)::before {
    content: '';
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-primary);
  }
  .search-hint {
    margin: -0.35rem 0 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }
  .search-hint[hidden] {
    display: none;
  }
  .search-hint-btn {
    appearance: none;
    border: 0;
    background: none;
    padding: 0;
    font: inherit;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: underline;
    cursor: pointer;
  }
  .search-hint-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .search-noscript {
    display: grid;
    gap: 0.6rem;
    padding: 1.1rem;
    margin-bottom: 1.25rem;
    border-style: dashed;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .search-noscript-lead {
    margin: 0;
  }
  .search-noscript-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .search-noscript-list a {
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: underline;
  }
  .search-more {
    margin: 0.9rem 0 0;
    text-align: center;
  }
  .search-more[hidden] {
    display: none;
  }
  .search-more-btn {
    appearance: none;
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--dur-fast),
      background-color var(--dur-fast),
      color var(--dur-fast);
  }
  .search-more-btn:hover,
  .search-more-btn:focus-visible {
    border-color: var(--color-primary);
    background: var(--color-surface);
    color: var(--color-primary);
  }
  .search-more-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .result-empty {
    display: grid;
    gap: 0.35rem;
    justify-items: center;
    padding: 1.6rem 1rem;
    border-style: dashed;
    text-align: center;
    color: var(--color-text-muted);
  }
  .result-empty[hidden] {
    display: none;
  }
  .result-empty-text {
    margin: 0;
  }
  .result-empty :global(.mascot) {
    margin-inline: auto;
  }
  .cta-section {
    padding-block: 2.5rem;
  }
</style>

<script>
  import { setupSearchPage } from '@/lib/search-page';

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSearchPage);
  } else {
    setupSearchPage();
  }
</script>
