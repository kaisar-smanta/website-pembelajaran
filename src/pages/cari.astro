---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import { url } from '@/utils/url';
import { ALL_ELEMENT_ORDER, GRADE_ORDER, ELEMENTS } from '@/data/curriculum';

const crumbs = [
  { label: 'Beranda', href: url('/') },
  { label: 'Cari' },
];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const meta = [
  `${ALL_ELEMENT_ORDER.length} elemen kurikulum`,
  `${GRADE_ORDER.length} jenjang kelas`,
  'Tanpa server · tanpa akun',
];
---

<BaseLayout title="Cari Materi" description="Cari topik, konsep, dan studi kasus di seluruh situs Matematika SMA.">
  <PageHeader
    narrow
    title="Cari Materi"
    eyebrow="Pencarian"
    lead="Telusuri topik, istilah, dan studi kasus. Pencarian berjalan di peramban tanpa server."
    crumbs={crumbs}
    meta={meta}
  />

  <div class="container container-narrow search-body" data-search-root data-base={base}>
    <form class="search-form reveal" role="search" data-search-form>
      <label class="visually-hidden" for="search-input">Kata kunci pencarian</label>
      <input
        id="search-input"
        type="search"
        class="search-input"
        placeholder="Contoh: bunga majemuk, eksponen, kuartil…"
        autocomplete="off"
        data-search-input
      />
      <div class="filters">
        <label>
          <span class="visually-hidden">Filter kelas</span>
          <select data-filter-grade>
            <option value="">Semua kelas</option>
            {GRADE_ORDER.map((g) => <option value={g}>Kelas {g}</option>)}
          </select>
        </label>
        <label>
          <span class="visually-hidden">Filter elemen</span>
          <select data-filter-element>
            <option value="">Semua elemen</option>
            {ALL_ELEMENT_ORDER.map((e) => <option value={e}>{ELEMENTS[e].name}</option>)}
          </select>
        </label>
      </div>
    </form>

    <p class="search-status" data-search-status aria-live="polite"></p>
    <ol class="search-results" data-search-results></ol>
  </div>

  <section class="section-alt cta-section">
    <div class="container">
      <div class="card cta-card card-accent accent-bilangan hover-lift reveal">
        <div class="cta-copy">
          <p class="eyebrow-badge">Belum menemukan?</p>
          <h2>Jelajahi lewat jalur belajar</h2>
          <p class="text-muted">
            Mulai dari kelas X, ikuti peta konsep antar materi, atau uji pemahamanmu lewat latihan
            berjenjang.
          </p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href={url('/matematika/kelas/X')}>Mulai dari Kelas X</a>
          <a class="btn btn-secondary" href={url('/peta-pembelajaran')}>Peta pembelajaran</a>
          <a class="btn btn-secondary" href={url('/latihan')}>Latihan berjenjang</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .search-body {
    padding-block: clamp(1.5rem, 4vw, 2.5rem) 3rem;
  }
  .search-form {
    display: grid;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
    padding: 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  .search-input {
    width: 100%;
    padding: 0.95rem 1.1rem;
    font: inherit;
    font-size: 1.12rem;
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    transition:
      border-color var(--dur) var(--ease-out-soft),
      box-shadow var(--dur) var(--ease-out-soft),
      background-color var(--dur);
  }
  .search-input::placeholder {
    color: var(--color-text-soft);
  }
  .search-input:hover {
    border-color: var(--color-primary);
  }
  .search-input:focus-visible {
    border-color: var(--color-primary);
    background: var(--color-surface);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary) 16%, transparent);
  }
  .filters {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .filters label {
    flex: 1 1 12rem;
    min-width: 0;
  }
  .filters select {
    width: 100%;
    padding: 0.6rem 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-text);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--dur-fast),
      background-color var(--dur-fast),
      color var(--dur-fast);
  }
  .filters select:hover,
  .filters select:focus-visible {
    border-color: var(--color-primary);
    background: var(--color-surface);
  }
  .search-status {
    margin: 0 0 0.9rem;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }
  .search-status:not(:empty) {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface-2);
  }
  .search-status:not(:empty)::before {
    content: '';
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-primary);
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .cta-section {
    padding-block: 2.5rem;
  }
  .cta-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cta-copy {
    max-width: 46ch;
  }
  .cta-copy .eyebrow-badge {
    margin-bottom: 0.6rem;
  }
  .cta-copy h2 {
    margin-bottom: 0.35rem;
  }
  .cta-copy p {
    margin: 0;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>

<script>
  interface Item {
    title: string;
    summary: string;
    url: string;
    type: string;
    grade?: string;
    element?: string;
    keywords: string;
    text: string;
  }

  function setupSearch(root: Element) {
    const base = root.getAttribute('data-base') || '/';
    const input = root.querySelector('[data-search-input]') as HTMLInputElement;
    const gradeFilter = root.querySelector('[data-filter-grade]') as HTMLSelectElement;
    const elementFilter = root.querySelector('[data-filter-element]') as HTMLSelectElement;
    const results = root.querySelector('[data-search-results]') as HTMLElement;
    const status = root.querySelector('[data-search-status]') as HTMLElement;

    let items: Item[] = [];

    const accentMap: Record<string, string> = {
      bilangan: 'var(--color-number)',
      'aljabar-fungsi': 'var(--color-algebra)',
      geometri: 'var(--color-geometry)',
      kalkulus: 'var(--color-calculus)',
      'data-peluang': 'var(--color-data)',
    };

    const markStyle = 'background:var(--highlight);color:inherit;padding:0 0.1em;border-radius:3px';

    const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');

    function score(item: Item, q: string): number {
      const title = norm(item.title);
      const keywords = norm(item.keywords);
      const summary = norm(item.summary);
      const text = norm(item.text);
      let s = 0;
      if (title === q) s += 100;
      if (title.includes(q)) s += 50;
      if (keywords.includes(q)) s += 25;
      if (summary.includes(q)) s += 12;
      if (text.includes(q)) s += 6;
      return s;
    }

    function escapeHtml(text: string): string {
      return text.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c] as string));
    }

    function highlight(text: string, q: string, raw: string): string {
      const safe = escapeHtml(text);
      if (!raw) return safe;
      const pattern = raw.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      const re = new RegExp(pattern, 'gi');
      if (re.test(safe)) return safe.replace(re, (m) => `<mark style="${markStyle}">${m}</mark>`);
      const idx = norm(safe).indexOf(q);
      if (idx < 0) return safe;
      return (
        safe.slice(0, idx) +
        `<mark style="${markStyle}">` +
        safe.slice(idx, idx + q.length) +
        '</mark>' +
        safe.slice(idx + q.length)
      );
    }

    function snippetOf(item: Item, q: string, raw: string): string {
      if (!raw || norm(item.summary).includes(q)) return highlight(item.summary, q, raw);
      const haystack = item.text || '';
      const idx = norm(haystack).indexOf(q);
      if (idx < 0) return highlight(item.summary, q, raw);
      const start = Math.max(0, idx - 50);
      const chunk = haystack.slice(start, start + 150).trim();
      return (start > 0 ? '… ' : '') + highlight(chunk, q, raw) + ' …';
    }

    function render() {
      const raw = input.value.trim();
      const q = norm(raw);
      const g = gradeFilter.value;
      const e = elementFilter.value;

      let filtered = items;
      if (g) filtered = filtered.filter((it) => it.grade === g || it.type === 'halaman');
      if (e) filtered = filtered.filter((it) => it.element === e || it.type === 'halaman');

      let out: (Item & { score: number })[];
      if (q.length === 0) {
        out = filtered.map((it) => ({ ...it, score: 0 })).slice(0, 12);
      } else {
        out = filtered
          .map((it) => ({ ...it, score: score(it, q) }))
          .filter((it) => it.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 40);
      }

      results.innerHTML = '';
      if (q.length === 0) {
        status.textContent = `Menampilkan ${out.length} entri. Ketik untuk menyaring.`;
      } else if (out.length === 0) {
        status.textContent = `Tidak ada hasil untuk "${raw}".`;
      } else {
        status.textContent = `${out.length} hasil untuk "${raw}".`;
      }

      if (out.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'result-empty card';
        empty.setAttribute(
          'style',
          'text-align:center;color:var(--color-text-muted);padding:1.6rem 1rem;border-style:dashed;display:grid;gap:0.35rem;justify-items:center',
        );
        empty.textContent =
          q.length === 0
            ? 'Belum ada entri untuk filter ini.'
            : 'Tidak ada hasil. Coba kata kunci lain atau ubah filter.';
        results.appendChild(empty);
        return;
      }

      for (const item of out) {
        const li = document.createElement('li');
        li.className = 'result-item card hover-lift';
        const accent = (item.element && accentMap[item.element]) || 'var(--color-primary)';
        li.setAttribute('style', `--accent:${accent};border-left:4px solid var(--accent)`);
        const gradeLabel = item.grade ? `Kelas ${item.grade}` : '';
        li.innerHTML = `
          <a href="${base.replace(/\/$/, '')}${item.url}" style="display:block;color:inherit;text-decoration:none">
            <div class="result-meta" style="display:flex;flex-wrap:wrap;align-items:center;gap:0.4rem;margin-bottom:0.4rem">
              <span class="badge">${item.type}</span>
              ${gradeLabel ? `<span class="badge badge-grade" style="background:var(--color-primary-soft);color:var(--color-primary);border-color:transparent">${gradeLabel}</span>` : ''}
            </div>
            <h3 style="margin:0 0 0.25rem;font-size:1.1rem">${highlight(item.title, q, raw)}</h3>
            <p class="text-muted" style="margin:0;font-size:0.92rem">${snippetOf(item, q, raw)}</p>
          </a>`;
        results.appendChild(li);
      }
    }

    fetch(`${base}search.json`)
      .then((r) => r.json())
      .then((data) => {
        items = data;
        const params = new URLSearchParams(location.search);
        const initial = params.get('q');
        if (initial) input.value = initial;
        render();
      })
      .catch(() => {
        status.textContent = 'Indeks pencarian gagal dimuat.';
      });

    input.addEventListener('input', render);
    gradeFilter.addEventListener('change', render);
    elementFilter.addEventListener('change', render);
  }

  document.querySelectorAll('[data-search-root]').forEach(setupSearch);
</script>
