---
import RedirectPage from '@/components/layout/RedirectPage.astro';
import { ELEMENT_ORDER } from '@/data/curriculum';
import { url } from '@/utils/url';

export function getStaticPaths() {
  return ELEMENT_ORDER.map((element) => ({ params: { element } }));
}

const { element } = Astro.params;
const to = url(`matematika/elemen/${element}`);
---

<RedirectPage to={to} title={`Pindah ke elemen ${element}`} />
