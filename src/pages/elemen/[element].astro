---
import RedirectPage from '@/components/layout/RedirectPage.astro';
import { legacyElements } from '@/lib/routes';
import { elementOverviewUrl } from '@/utils/url';

export function getStaticPaths() {
  return legacyElements().map((element) => ({ params: { element } }));
}

const { element } = Astro.params as { element: string };
const to = elementOverviewUrl(element);
---

<RedirectPage to={to} title={`Pindah ke elemen ${element}`} />
