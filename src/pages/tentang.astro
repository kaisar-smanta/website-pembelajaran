---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/content/PageHeader.astro';
import { site } from '@/data/site';
import { url } from '@/utils/url';

const crumbs = [{ label: 'Beranda', href: url('/') }, { label: 'Tentang' }];
---

<BaseLayout
  title="Tentang & Kredit"
  description="Profil penyusun, sekolah, dan catatan penggunaan materi Matematika SMA."
>
  <PageHeader
    narrow
    title="Tentang & Kredit"
    eyebrow="Tentang Situs"
    lead="Situs ini adalah pusat pembelajaran matematika SMA berbahasa Indonesia yang disusun untuk mendampingi pembelajaran di kelas maupun belajar mandiri."
    crumbs={crumbs}
  />

  <div class="container container-narrow">
    <section class="id-card card section-paper hover-lift reveal" aria-labelledby="penyusun">
      <span class="id-logo">
        <img src={url(site.school.logo)} alt={site.school.logoAlt} width="96" height="96" />
      </span>
      <div class="id-body">
        <p class="eyebrow">Disusun oleh</p>
        <h2 id="penyusun" class="id-name">{site.author.name}</h2>
        <p class="text-muted">{site.author.role} · {site.school.name}</p>
        <div class="row">
          <a class="btn btn-primary btn-sm" href={url('/peta-pembelajaran')}>Jelajahi materi</a>
          <a class="btn btn-secondary btn-sm" href={url('/referensi')}>Catatan referensi</a>
        </div>
      </div>
    </section>

    <div class="prose reveal">
      <h2>Pendekatan Penyusunan</h2>
      <p>
        Materi disusun agar peserta didik membangun konsep secara bertahap, bukan sekadar menghafal
        rumus. Setiap topik mengikuti alur memahami, mengeksplorasi, menerapkan, dan merefleksi.
      </p>

      <h2>Sekolah</h2>
      <p>
        Kredit penyusunan dan penyediaan materi berpusat pada {site.school.name}. Informasi resmi
        sekolah dapat diakses melalui tautan berikut.
      </p>
      <ul class="link-list">
        {
          site.links.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>

      <h2>Catatan Kurikulum</h2>
      <p>
        Susunan materi merupakan <em>tafsir instruksional</em> atas Capaian Pembelajaran (CP)
        Matematika SMA pada Keputusan Kepala BSKAP Kemendikdasmen Nomor 046/H/KR/2025
        (Lampiran II), berlaku 16 Juli 2025 dan menggantikan 032/H/KR/2024. Ini
        <strong>bukan</strong> salinan resmi dan bukan buku teks resmi. Guru dan sekolah tetap
        merujuk pada dokumen resmi yang berlaku. Penjelasan lengkap ada di halaman
        <a href={url('/referensi')}>Referensi</a>.
      </p>

      <h2>Untuk Guru</h2>
      <p>
        Materi dapat dipakai sebagai bahan ajar pendamping, sumber latihan tambahan, atau contoh
        penerapan konteks nyata. Setiap topik mengikuti alur belajar yang konsisten dan dilengkapi
        latihan berjenjang, kesalahan umum, serta refleksi. Silakan adaptasi sesuai kebutuhan kelas.
      </p>

      <h2>Penggunaan dan Lisensi</h2>
      <p>
        Materi disediakan untuk keperluan pendidikan. Kamu dapat menggunakannya untuk belajar,
        mengajar, atau menyusun latihan tambahan. Jika menemukan kekeliruan, mohon sampaikan agar
        dapat diperbaiki.
      </p>
    </div>
  </div>

  <section class="section-alt cta-section">
    <div class="container">
      <div class="card cta-card card-accent hover-lift reveal">
        <div class="cta-copy">
          <p class="eyebrow-badge">Langkah berikutnya</p>
          <h2>Mulai belajar atau coba eksplorasi</h2>
          <p class="text-muted">
            Materi siap dipakai. Pilih titik awal yang paling sesuai, lalu ikuti alurnya.
          </p>
        </div>
        <div class="cta-actions">
          <a class="btn btn-primary" href={url('/kelas/X')}>Mulai dari Kelas X</a>
          <a class="btn btn-secondary" href={url('/eksplorasi')}>Coba eksplorasi</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container-narrow {
    padding-block: 1rem 2.5rem;
  }
  .id-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    overflow: hidden;
    margin-block: 0 2rem;
  }
  .id-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: linear-gradient(180deg, var(--color-primary), var(--color-algebra));
  }
  .id-logo {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 6.5rem;
    height: 6.5rem;
    padding: 0.6rem;
    border-radius: var(--radius);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .id-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 6px;
  }
  .id-name {
    font-size: clamp(1.3rem, 1.1rem + 1vw, 1.8rem);
    margin: 0.1rem 0 0.35rem;
  }
  .id-body p {
    margin-bottom: 0.85rem;
  }
  .prose h2 {
    margin-top: 2.25rem;
    padding-left: 0.85rem;
    border-left: 3px solid var(--color-primary);
    line-height: 1.25;
  }
  .prose h2:first-child {
    margin-top: 0;
  }
  .link-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .link-list a {
    font-weight: 600;
    text-decoration: none;
  }
  .link-list a:hover {
    text-decoration: underline;
  }
  .cta-section {
    padding-block: 2.5rem;
  }
  .cta-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cta-copy {
    max-width: 46ch;
  }
  .cta-copy .eyebrow-badge {
    margin-bottom: 0.6rem;
  }
  .cta-copy h2 {
    margin-bottom: 0.35rem;
  }
  .cta-copy p {
    margin: 0;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 34rem) {
    .id-card {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
