---
import { renderMarkdown, renderMath, renderInlineMarkdown } from '@/utils/markdown';
import type { Block } from '@/types/content';

interface Props {
  block: Extract<Block, { kind: 'table' }>;
}
const { block } = Astro.props;

function cell(value: string): string {
  return block.math ? renderMath(value, false) : renderMarkdown(value);
}
---

<div class="table-scroll table-wrap">
  <table>
    {block.caption && <caption set:html={renderInlineMarkdown(block.caption)} />}
    <thead>
      <tr>
        {block.headers.map((h) => <th scope="col" set:html={cell(h)} />)}
      </tr>
    </thead>
    <tbody>
      {
        block.rows.map((row) => (
          <tr>
            {row.map((value) => (
              <td set:html={cell(value)} class={block.math ? 'math-cell' : undefined} />
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-wrap {
    margin: 1.1rem 0;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    background: var(--color-surface);
    font-variant-numeric: tabular-nums;
  }
  caption {
    caption-side: top;
    text-align: left;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding-bottom: 0.4rem;
  }
  th,
  td {
    border: 1px solid var(--color-border);
    padding: 0.5rem 0.7rem;
    text-align: left;
    vertical-align: middle;
  }
  th {
    background: var(--color-surface-2);
    font-weight: 700;
    white-space: nowrap;
  }
  tbody tr:nth-child(even) {
    background: color-mix(in srgb, var(--color-surface-2) 45%, transparent);
  }
</style>
