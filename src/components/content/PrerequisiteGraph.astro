---
import type { ElementId, Grade, SubjectId } from '@/types/content';
import { ALL_ELEMENT_ORDER, ELEMENTS, GRADES, GRADE_ORDER } from '@/data/curriculum';
import { topics, topicSubject } from '@/data/topics';
import { topicUrl } from '@/utils/url';

interface GraphNode {
  id: string;
  title: string;
  grade: Grade;
  element: ElementId;
  slug: string;
  subject: SubjectId;
  prereqs: string[];
}

interface LayoutNode {
  id: string;
  dummy: boolean;
  rank: number;
  seq: number;
  title: string;
  grade?: Grade;
  element?: ElementId;
  preds: LayoutNode[];
  succs: LayoutNode[];
  x: number;
  y: number;
}

interface GraphEdge {
  from: string;
  to: string;
  source: LayoutNode;
  target: LayoutNode;
  chain: LayoutNode[];
  primary: boolean;
  d: string;
}

const NODE_W = 176;
const NODE_H = 58;
const ROW_GAP = 16;
const PADDING = 24;
const CORNER = 10;
const TITLE_WRAP = 21;
const GAP_MIN = 52;
const GAP_MAX = 132;
const GAP_BASE = 44;
const GAP_PER_EDGE = 10;
const ARROW_ID = 'prereq-arrow';

const idSet = new Set(topics.map((t) => t.id));

const nodes: GraphNode[] = topics.map((t) => ({
  id: t.id,
  title: t.title,
  grade: t.grade,
  element: t.element,
  slug: t.slug,
  subject: topicSubject(t),
  prereqs: (t.prerequisites ?? []).filter((id) => idSet.has(id)),
}));

const nodeById = new Map<string, GraphNode>(nodes.map((n) => [n.id, n]));

const rankOf = new Map<string, number>();
const visiting = new Set<string>();

function computeRank(id: string): number {
  const cached = rankOf.get(id);
  if (cached !== undefined) return cached;
  if (visiting.has(id)) return -1;
  visiting.add(id);
  const node = nodeById.get(id);
  let best = -1;
  if (node) {
    for (const p of node.prereqs) {
      const r = computeRank(p);
      if (r > best) best = r;
    }
  }
  visiting.delete(id);
  const rank = best < 0 ? 0 : best + 1;
  rankOf.set(id, rank);
  return rank;
}

for (const n of nodes) computeRank(n.id);

const maxRank = nodes.length ? Math.max(...nodes.map((n) => rankOf.get(n.id) ?? 0)) : 0;

const layers: LayoutNode[][] = Array.from({ length: maxRank + 1 }, () => []);
const layoutById = new Map<string, LayoutNode>();
let seq = 0;

for (const n of nodes) {
  const rank = rankOf.get(n.id) ?? 0;
  const layout: LayoutNode = {
    id: n.id,
    dummy: false,
    rank,
    seq: seq++,
    title: n.title,
    grade: n.grade,
    element: n.element,
    preds: [],
    succs: [],
    x: 0,
    y: 0,
  };
  layoutById.set(n.id, layout);
  layers[rank].push(layout);
}

const edges: GraphEdge[] = [];

const primaryPrereqRank = new Map<string, number>();
for (const n of nodes) {
  let best = -1;
  for (const p of n.prereqs) {
    const r = rankOf.get(p);
    if (r !== undefined && r > best) best = r;
  }
  primaryPrereqRank.set(n.id, best);
}

for (const n of nodes) {
  const target = layoutById.get(n.id);
  if (!target) continue;
  for (const p of n.prereqs) {
    const source = layoutById.get(p);
    if (!source) continue;
    const primary = rankOf.get(p) === primaryPrereqRank.get(n.id);
    const chain: LayoutNode[] = [source];
    for (let r = source.rank + 1; r < target.rank; r++) {
      const dummy: LayoutNode = {
        id: `dummy-${p}-${n.id}-${r}`,
        dummy: true,
        rank: r,
        seq: seq++,
        title: '',
        preds: [],
        succs: [],
        x: 0,
        y: 0,
      };
      layers[r].push(dummy);
      chain.push(dummy);
    }
    chain.push(target);
    for (let i = 0; i < chain.length - 1; i++) {
      chain[i].succs.push(chain[i + 1]);
      chain[i + 1].preds.push(chain[i]);
    }
    edges.push({ from: p, to: n.id, source, target, chain, primary, d: '' });
  }
}

const elementIndex = new Map<ElementId, number>(ALL_ELEMENT_ORDER.map((e, i) => [e, i]));

for (const layer of layers) {
  layer.sort((a, b) => {
    if (a.dummy !== b.dummy) return a.dummy ? 1 : -1;
    if (!a.dummy && !b.dummy) {
      const ea = a.element ? elementIndex.get(a.element) ?? 0 : 0;
      const eb = b.element ? elementIndex.get(b.element) ?? 0 : 0;
      if (ea !== eb) return ea - eb;
      const byTitle = a.title.localeCompare(b.title, 'id');
      if (byTitle !== 0) return byTitle;
    }
    return a.seq - b.seq;
  });
}

function indexLayer(rank: number): Map<LayoutNode, number> {
  const index = new Map<LayoutNode, number>();
  layers[rank].forEach((node, i) => index.set(node, i));
  return index;
}

function sortByNeighbours(
  rank: number,
  neighboursOf: (node: LayoutNode) => LayoutNode[],
  reference: Map<LayoutNode, number>,
): void {
  const layer = layers[rank];
  const own = indexLayer(rank);
  const keyed = layer.map((node) => {
    const neighbours = neighboursOf(node);
    let value = own.get(node) ?? 0;
    if (neighbours.length) {
      let sum = 0;
      let count = 0;
      for (const neighbour of neighbours) {
        const idx = reference.get(neighbour);
        if (idx !== undefined) {
          sum += idx;
          count++;
        }
      }
      if (count) value = sum / count;
    }
    return { node, value };
  });
  keyed.sort((a, b) => a.value - b.value || a.node.seq - b.node.seq);
  layers[rank] = keyed.map((entry) => entry.node);
}

for (let pass = 0; pass < 4; pass++) {
  for (let r = 1; r <= maxRank; r++) {
    sortByNeighbours(r, (node) => node.preds, indexLayer(r - 1));
  }
  for (let r = maxRank - 1; r >= 0; r--) {
    sortByNeighbours(r, (node) => node.succs, indexLayer(r + 1));
  }
}

function countCrossings(): number {
  let total = 0;
  for (let r = 0; r < maxRank; r++) {
    const from = layers[r];
    const fromIndex = new Map<LayoutNode, number>();
    from.forEach((node, i) => fromIndex.set(node, i));
    const toIndex = new Map<LayoutNode, number>();
    layers[r + 1].forEach((node, i) => toIndex.set(node, i));
    const pairs: Array<[number, number]> = [];
    for (const node of from) {
      const a = fromIndex.get(node) ?? 0;
      for (const succ of node.succs) {
        const b = toIndex.get(succ);
        if (b !== undefined) pairs.push([a, b]);
      }
    }
    for (let i = 0; i < pairs.length; i++) {
      for (let j = i + 1; j < pairs.length; j++) {
        const p = pairs[i];
        const q = pairs[j];
        if (p[0] === q[0] || p[1] === q[1]) continue;
        if ((p[0] - q[0]) * (p[1] - q[1]) < 0) total++;
      }
    }
  }
  return total;
}

let bestCrossings = countCrossings();
for (let round = 0; round < 8; round++) {
  let improved = false;
  for (let r = 0; r <= maxRank; r++) {
    const layer = layers[r];
    for (let i = 0; i + 1 < layer.length; i++) {
      const first = layer[i];
      const second = layer[i + 1];
      layer[i] = second;
      layer[i + 1] = first;
      const next = countCrossings();
      if (next < bestCrossings) {
        bestCrossings = next;
        improved = true;
      } else {
        layer[i] = first;
        layer[i + 1] = second;
      }
    }
  }
  if (!improved) break;
}

const maxColumnCount = Math.max(1, ...layers.map((layer) => layer.length));

const corridorCount: number[] = new Array(Math.max(0, maxRank)).fill(0);
for (const edge of edges) {
  for (let r = edge.source.rank; r < edge.target.rank; r++) corridorCount[r]++;
}

function gapAfter(rank: number): number {
  const count = corridorCount[rank] ?? 0;
  return Math.min(GAP_MAX, Math.max(GAP_MIN, GAP_BASE + count * GAP_PER_EDGE));
}

const columnX: number[] = new Array(maxRank + 1);
let cursorX = PADDING;
for (let r = 0; r <= maxRank; r++) {
  columnX[r] = cursorX;
  if (r < maxRank) cursorX += NODE_W + gapAfter(r);
}
const width = columnX[maxRank] + NODE_W + PADDING;
const height = PADDING * 2 + maxColumnCount * (NODE_H + ROW_GAP);

for (let r = 0; r <= maxRank; r++) {
  const layer = layers[r];
  const offset = ((maxColumnCount - layer.length) * (NODE_H + ROW_GAP)) / 2;
  layer.forEach((node, i) => {
    node.x = columnX[r];
    node.y = PADDING + i * (NODE_H + ROW_GAP) + offset;
  });
}

const corridorUse = new Map<number, number[]>();
edges.forEach((edge, edgeIndex) => {
  for (let c = edge.source.rank; c <= edge.target.rank - 1; c++) {
    const list = corridorUse.get(c);
    if (list) list.push(edgeIndex);
    else corridorUse.set(c, [edgeIndex]);
  }
});

function roundedPath(rawPoints: Array<{ x: number; y: number }>): string {
  const pts = rawPoints.filter(
    (point, i) =>
      i === 0 ||
      Math.abs(point.x - rawPoints[i - 1].x) > 0.5 ||
      Math.abs(point.y - rawPoints[i - 1].y) > 0.5,
  );
  if (pts.length < 2) return '';
  if (pts.length === 2) return `M ${pts[0].x} ${pts[0].y} L ${pts[1].x} ${pts[1].y}`;
  let d = `M ${pts[0].x} ${pts[0].y}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const prev = pts[i - 1];
    const cur = pts[i];
    const next = pts[i + 1];
    const inDx = cur.x - prev.x;
    const inDy = cur.y - prev.y;
    const outDx = next.x - cur.x;
    const outDy = next.y - cur.y;
    const inLen = Math.hypot(inDx, inDy) || 1;
    const outLen = Math.hypot(outDx, outDy) || 1;
    const radius = Math.min(CORNER, inLen / 2, outLen / 2);
    const startX = cur.x - (inDx / inLen) * radius;
    const startY = cur.y - (inDy / inLen) * radius;
    const endX = cur.x + (outDx / outLen) * radius;
    const endY = cur.y + (outDy / outLen) * radius;
    d += ` L ${startX} ${startY} Q ${cur.x} ${cur.y} ${endX} ${endY}`;
  }
  const last = pts[pts.length - 1];
  d += ` L ${last.x} ${last.y}`;
  return d;
}

edges.forEach((edge, edgeIndex) => {
  const a = edge.source.rank;
  const b = edge.target.rank;
  const startY = edge.source.y + NODE_H / 2;
  const endY = edge.target.y + NODE_H / 2;

  if (b - a <= 1) {
    const startX = edge.source.x + NODE_W;
    const endX = edge.target.x;
    const dx = endX - startX;
    edge.d = `M ${startX} ${startY} C ${startX + dx / 2} ${startY}, ${endX - dx / 2} ${endY}, ${endX} ${endY}`;
    return;
  }

  const points: Array<{ x: number; y: number }> = [{ x: edge.source.x + NODE_W, y: startY }];
  let currentY = startY;
  for (let k = a + 1; k <= b; k++) {
    const node = edge.chain[k - a];
    if (!node) continue;
    const nextY = node.y + NODE_H / 2;
    const corridor = k - 1;
    const users = corridorUse.get(corridor) ?? [];
    const lane = users.indexOf(edgeIndex);
    const step = users.length > 0 && lane >= 0 ? (lane + 1) / (users.length + 1) : 0.5;
    const corridorStart = columnX[corridor] + NODE_W;
    const corridorEnd = columnX[corridor + 1];
    const corridorX = corridorStart + (corridorEnd - corridorStart) * step;
    points.push({ x: corridorX, y: currentY });
    points.push({ x: corridorX, y: nextY });
    currentY = nextY;
  }
  points.push({ x: edge.target.x, y: endY });
  edge.d = roundedPath(points);
});

function wrapTitle(value: string): string[] {
  const words = value.trim().split(/\s+/).filter(Boolean);
  const lines: string[] = [];
  let index = 0;
  while (index < words.length && lines.length < 2) {
    let line = words[index++];
    while (index < words.length && `${line} ${words[index]}`.length <= TITLE_WRAP) {
      line += ` ${words[index++]}`;
    }
    if (line.length > TITLE_WRAP) line = line.slice(0, TITLE_WRAP);
    lines.push(line);
  }
  if (index < words.length && lines.length === 2) {
    const second = lines[1];
    const clamped = second.length >= TITLE_WRAP ? second.slice(0, TITLE_WRAP - 1) : second;
    lines[1] = `${clamped.trimEnd()}…`;
  }
  return lines.length ? lines : [''];
}

const positioned = nodes
  .map((n) => {
    const layout = layoutById.get(n.id);
    return layout ? { ...n, x: layout.x, y: layout.y } : undefined;
  })
  .filter((n): n is GraphNode & { x: number; y: number } => Boolean(n));

const renderNodes = positioned.map((node) => {
  const lines = wrapTitle(node.title);
  return {
    ...node,
    lines,
    titleY: node.y + (lines.length > 1 ? 22 : 30),
    href: topicUrl(node.grade, node.element, node.slug, node.subject),
  };
});

const succById = new Map<string, string[]>();
for (const n of nodes) {
  for (const p of n.prereqs) {
    const list = succById.get(p);
    if (list) list.push(n.id);
    else succById.set(p, [n.id]);
  }
}

const listGroups = GRADE_ORDER.map((grade) => {
  const items = nodes
    .filter((n) => n.grade === grade)
    .sort((a, b) => {
      const ea = elementIndex.get(a.element) ?? 0;
      const eb = elementIndex.get(b.element) ?? 0;
      if (ea !== eb) return ea - eb;
      return a.title.localeCompare(b.title, 'id');
    });
  return { grade, items };
}).filter((group) => group.items.length > 0);
---

<div class="prereq-wrap card reveal" data-reveal>
  <div class="prereq-grade-toolbar" role="group" aria-label="Fokus kelas">
    <span class="prereq-grade-label">Fokus kelas</span>
    <div class="prereq-grade-chips">
      <button type="button" class="prereq-grade-chip is-active" data-grade-filter="all" aria-pressed="true">
        Semua
      </button>
      {
        GRADE_ORDER.map((grade) => (
          <button type="button" class="prereq-grade-chip" data-grade-filter={grade} aria-pressed="false">
            {GRADES[grade].name}
          </button>
        ))
      }
    </div>
  </div>

  <div class="prereq-desktop">
    <p class="prereq-hint text-soft">
      Peta menampilkan prasyarat utama tiap topik. Sorot atau fokuskan sebuah topik untuk menelusuri
      prasyarat dan lanjutannya; klik topik untuk membuka halaman materi.
    </p>

    <div class="prereq-scroll">
      <svg
        class="prereq-svg"
        width={width}
        height={height}
        viewBox={`0 0 ${width} ${height}`}
        role="group"
        aria-label="Grafik prasyarat antar topik"
      >
        <title>Grafik prasyarat antar topik</title>
        <defs>
          <marker
            id={ARROW_ID}
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="7"
            markerHeight="7"
            orient="auto"
          >
            <path d="M0 0 L10 5 L0 10 Z" fill="context-stroke"></path>
          </marker>
        </defs>

        <g class="prereq-edges">
          {
            edges.map((edge) => (
              <path
                class="prereq-edge"
                data-from={edge.from}
                data-to={edge.to}
                data-primary={edge.primary ? 'true' : 'false'}
                d={edge.d}
                marker-end={`url(#${ARROW_ID})`}
              />
            ))
          }
        </g>

        <g class="prereq-nodes">
          {
            renderNodes.map((node) => (
              <a
                class={`prereq-node accent-${node.element}`}
                data-id={node.id}
                data-grade={node.grade}
                href={node.href}
                aria-label={`${node.title}, ${GRADES[node.grade].name}`}
              >
                <rect x={node.x} y={node.y} width={NODE_W} height={NODE_H} rx="12" ry="12" />
                <text class="prereq-title" x={node.x + 14} y={node.titleY}>
                  {node.lines.map((line, i) => (
                    <tspan x={node.x + 14} dy={i === 0 ? 0 : 14}>
                      {line}
                    </tspan>
                  ))}
                </text>
                <text class="prereq-meta" x={node.x + 14} y={node.y + 50}>
                  {GRADES[node.grade].name}
                </text>
              </a>
            ))
          }
        </g>
      </svg>
    </div>
  </div>

  <div class="prereq-mobile">
    <p class="prereq-hint text-soft">
      Ketuk sebuah topik untuk melihat prasyarat dan lanjutannya, lalu ikuti tautan untuk membuka
      halaman materi.
    </p>

    <div class="prereq-groups">
      {
        listGroups.map((group) => (
          <section class="prereq-group" data-grade={group.grade}>
            <h3 class="prereq-group-title">{GRADES[group.grade].name}</h3>
            <ul class="prereq-list" role="list">
              {group.items.map((item) => (
                <li>
                  <details class={`prereq-item accent-${item.element}`}>
                    <summary class="prereq-item-summary">
                      <a
                        class="prereq-item-title"
                        href={topicUrl(item.grade, item.element, item.slug, item.subject)}
                      >
                        {item.title}
                      </a>
                      <span class="prereq-item-meta">{ELEMENTS[item.element].short}</span>
                    </summary>
                    <div class="prereq-item-body">
                      <div class="prereq-chip-group">
                        <p class="prereq-chips-label">Prasyarat</p>
                        {item.prereqs.length ? (
                          <ul class="prereq-chips" role="list">
                            {item.prereqs.map((id) => {
                              const target = nodeById.get(id);
                              return target ? (
                                <li>
                                  <a
                                    class={`prereq-chip accent-${target.element}`}
                                    href={topicUrl(
                                      target.grade,
                                      target.element,
                                      target.slug,
                                      target.subject,
                                    )}
                                  >
                                    {target.title}
                                  </a>
                                </li>
                              ) : null;
                            })}
                          </ul>
                        ) : (
                          <p class="prereq-empty">Tanpa prasyarat.</p>
                        )}
                      </div>
                      <div class="prereq-chip-group">
                        <p class="prereq-chips-label">Lanjutan</p>
                        {(succById.get(item.id) ?? []).length ? (
                          <ul class="prereq-chips" role="list">
                            {(succById.get(item.id) ?? []).map((id) => {
                              const target = nodeById.get(id);
                              return target ? (
                                <li>
                                  <a
                                    class={`prereq-chip accent-${target.element}`}
                                    href={topicUrl(
                                      target.grade,
                                      target.element,
                                      target.slug,
                                      target.subject,
                                    )}
                                  >
                                    {target.title}
                                  </a>
                                </li>
                              ) : null;
                            })}
                          </ul>
                        ) : (
                          <p class="prereq-empty">Belum ada lanjutan tercatat.</p>
                        )}
                      </div>
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    try {
      var wraps = document.querySelectorAll('.prereq-wrap');
      if (!wraps.length) return;

      function init(wrap) {
        var nodeEls = Array.prototype.slice.call(wrap.querySelectorAll('.prereq-node'));
        var edgeEls = Array.prototype.slice.call(wrap.querySelectorAll('.prereq-edge'));
        if (!nodeEls.length) return;
        wrap.classList.add('is-ready');

        var gradeChips = Array.prototype.slice.call(wrap.querySelectorAll('[data-grade-filter]'));
        var gradeGroups = Array.prototype.slice.call(wrap.querySelectorAll('.prereq-group[data-grade]'));
        var gradeMap = {};
        nodeEls.forEach(function (el) {
          gradeMap[el.getAttribute('data-id')] = el.getAttribute('data-grade');
        });
        var gradeFilter = 'all';

        var incoming = {};
        var outgoing = {};
        edgeEls.forEach(function (edge) {
          var from = edge.getAttribute('data-from');
          var to = edge.getAttribute('data-to');
          if (!from || !to) return;
          (outgoing[from] || (outgoing[from] = [])).push(to);
          (incoming[to] || (incoming[to] = [])).push(from);
        });

        function apply(active) {
          nodeEls.forEach(function (el) {
            var id = el.getAttribute('data-id');
            var on = !!(id && active[id]);
            el.classList.toggle('is-active', on);
            el.classList.toggle('is-dim', !on);
          });
          edgeEls.forEach(function (edge) {
            var from = edge.getAttribute('data-from');
            var to = edge.getAttribute('data-to');
            var on = !!(from && to && active[from] && active[to]);
            edge.classList.toggle('is-active', on);
            edge.classList.toggle('is-dim', !on);
          });
        }

        function clear() {
          nodeEls.forEach(function (el) {
            el.classList.remove('is-active');
            el.classList.remove('is-dim');
          });
          edgeEls.forEach(function (edge) {
            edge.classList.remove('is-active');
            edge.classList.remove('is-dim');
          });
        }

        function applyGrade() {
          nodeEls.forEach(function (el) {
            var id = el.getAttribute('data-id');
            var match = gradeFilter === 'all' || gradeMap[id] === gradeFilter;
            el.classList.toggle('is-grade-dim', !match);
          });
          edgeEls.forEach(function (edge) {
            var from = edge.getAttribute('data-from');
            var to = edge.getAttribute('data-to');
            var match =
              gradeFilter === 'all' ||
              gradeMap[from] === gradeFilter ||
              gradeMap[to] === gradeFilter;
            edge.classList.toggle('is-grade-dim', !match);
          });
          gradeGroups.forEach(function (group) {
            var match = gradeFilter === 'all' || group.getAttribute('data-grade') === gradeFilter;
            group.classList.toggle('is-grade-hidden', !match);
          });
          gradeChips.forEach(function (chip) {
            var active = chip.getAttribute('data-grade-filter') === gradeFilter;
            chip.classList.toggle('is-active', active);
            chip.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
        }

        function highlight(id) {
          var active = {};
          active[id] = true;

          var stack = [id];
          var seenIn = {};
          seenIn[id] = true;
          while (stack.length) {
            var cur = stack.pop();
            var inc = incoming[cur];
            if (inc) {
              for (var i = 0; i < inc.length; i++) {
                var a = inc[i];
                if (!seenIn[a]) {
                  seenIn[a] = true;
                  active[a] = true;
                  stack.push(a);
                }
              }
            }
          }

          stack = [id];
          var seenOut = {};
          seenOut[id] = true;
          while (stack.length) {
            var cur2 = stack.pop();
            var out = outgoing[cur2];
            if (out) {
              for (var j = 0; j < out.length; j++) {
                var d = out[j];
                if (!seenOut[d]) {
                  seenOut[d] = true;
                  active[d] = true;
                  stack.push(d);
                }
              }
            }
          }

          apply(active);
        }

        nodeEls.forEach(function (el) {
          var id = el.getAttribute('data-id');
          if (!id) return;
          el.addEventListener('mouseenter', function () {
            highlight(id);
          });
          el.addEventListener('focusin', function () {
            highlight(id);
          });
          el.addEventListener('mouseleave', clear);
          el.addEventListener('focusout', clear);
        });

        gradeChips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            gradeFilter = chip.getAttribute('data-grade-filter') || 'all';
            clear();
            applyGrade();
          });
        });
        applyGrade();
      }

      Array.prototype.forEach.call(wraps, init);
    } catch (e) {
      /* biarkan graf tetap tampil tanpa interaksi */
    }
  })();
</script>

