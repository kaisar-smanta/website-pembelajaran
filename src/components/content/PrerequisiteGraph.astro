---
import type { ElementId, Grade, SubjectId } from '@/types/content';
import { ALL_ELEMENT_ORDER, ELEMENTS, GRADES, GRADE_ORDER } from '@/data/curriculum';
import { topics, topicSubject } from '@/data/topics';
import { topicUrl } from '@/utils/url';
import { DEFAULT_NODE_HEIGHT, DEFAULT_NODE_WIDTH, layoutGraph } from '@/lib/graph/layout';

interface GraphNode {
  id: string;
  title: string;
  grade: Grade;
  element: ElementId;
  slug: string;
  subject: SubjectId;
  prereqs: string[];
}

const NODE_W = DEFAULT_NODE_WIDTH;
const NODE_H = DEFAULT_NODE_HEIGHT;
const ARROW_ID = 'prereq-arrow';

const idSet = new Set(topics.map((t) => t.id));

const nodes: GraphNode[] = topics.map((t) => ({
  id: t.id,
  title: t.title,
  grade: t.grade,
  element: t.element,
  slug: t.slug,
  subject: topicSubject(t),
  prereqs: (t.prerequisites ?? []).filter((id) => idSet.has(id)),
}));

const edgeInputs: Array<{ from: string; to: string }> = [];
for (const n of nodes) {
  for (const p of n.prereqs) edgeInputs.push({ from: p, to: n.id });
}

const layout = layoutGraph(nodes, edgeInputs, { elementOrder: ALL_ELEMENT_ORDER });
const { width, height } = layout;
const edges = layout.edges;

const renderNodes = layout.nodes.map((node) => ({
  ...node,
  href: topicUrl(node.grade, node.element, node.slug, node.subject),
}));

const nodeById = new Map(nodes.map((n) => [n.id, n]));

const succById = new Map<string, string[]>();
for (const n of nodes) {
  for (const p of n.prereqs) {
    const list = succById.get(p);
    if (list) list.push(n.id);
    else succById.set(p, [n.id]);
  }
}

const elementIndex = new Map<ElementId, number>(ALL_ELEMENT_ORDER.map((e, i) => [e, i]));

const listGroups = GRADE_ORDER.map((grade) => {
  const items = nodes
    .filter((n) => n.grade === grade)
    .sort((a, b) => {
      const ea = elementIndex.get(a.element) ?? 0;
      const eb = elementIndex.get(b.element) ?? 0;
      if (ea !== eb) return ea - eb;
      return a.title.localeCompare(b.title, 'id');
    });
  return { grade, items };
}).filter((group) => group.items.length > 0);
---

<div class="prereq-wrap card reveal" data-reveal>
  <div class="prereq-grade-toolbar" role="group" aria-label="Fokus kelas">
    <span class="prereq-grade-label">Fokus kelas</span>
    <div class="prereq-grade-chips">
      <button type="button" class="prereq-grade-chip is-active" data-grade-filter="all" aria-pressed="true">
        Semua
      </button>
      {
        GRADE_ORDER.map((grade) => (
          <button type="button" class="prereq-grade-chip" data-grade-filter={grade} aria-pressed="false">
            {GRADES[grade].name}
          </button>
        ))
      }
    </div>
  </div>

  <div class="prereq-desktop">
    <p class="prereq-hint text-soft">
      Peta menampilkan prasyarat utama tiap topik. Sorot atau fokuskan sebuah topik untuk menelusuri
      prasyarat dan lanjutannya; klik topik untuk membuka halaman materi.
    </p>

    <div class="prereq-scroll">
      <svg
        class="prereq-svg"
        width={width}
        height={height}
        viewBox={`0 0 ${width} ${height}`}
        role="group"
        aria-label="Grafik prasyarat antar topik"
      >
        <title>Grafik prasyarat antar topik</title>
        <defs>
          <marker
            id={ARROW_ID}
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="7"
            markerHeight="7"
            orient="auto"
          >
            <path d="M0 0 L10 5 L0 10 Z" fill="context-stroke"></path>
          </marker>
        </defs>

        <g class="prereq-edges">
          {
            edges.map((edge) => (
              <path
                class="prereq-edge"
                data-from={edge.from}
                data-to={edge.to}
                data-primary={edge.primary ? 'true' : 'false'}
                d={edge.d}
                marker-end={`url(#${ARROW_ID})`}
              />
            ))
          }
        </g>

        <g class="prereq-nodes">
          {
            renderNodes.map((node) => (
              <a
                class={`prereq-node accent-${node.element}`}
                data-id={node.id}
                data-grade={node.grade}
                href={node.href}
                aria-label={`${node.title}, ${GRADES[node.grade].name}`}
              >
                <rect x={node.x} y={node.y} width={NODE_W} height={NODE_H} rx="12" ry="12" />
                <text class="prereq-title" x={node.x + 14} y={node.titleY}>
                  {node.lines.map((line, i) => (
                    <tspan x={node.x + 14} dy={i === 0 ? 0 : 14}>
                      {line}
                    </tspan>
                  ))}
                </text>
                <text class="prereq-meta" x={node.x + 14} y={node.y + 50}>
                  {GRADES[node.grade].name}
                </text>
              </a>
            ))
          }
        </g>
      </svg>
    </div>
  </div>

  <div class="prereq-mobile">
    <p class="prereq-hint text-soft">
      Ketuk sebuah topik untuk melihat prasyarat dan lanjutannya, lalu ikuti tautan untuk membuka
      halaman materi.
    </p>

    <div class="prereq-groups">
      {
        listGroups.map((group) => (
          <section class="prereq-group" data-grade={group.grade}>
            <h3 class="prereq-group-title">{GRADES[group.grade].name}</h3>
            <ul class="prereq-list" role="list">
              {group.items.map((item) => (
                <li>
                  <details class={`prereq-item accent-${item.element}`}>
                    <summary class="prereq-item-summary">
                      <a
                        class="prereq-item-title"
                        href={topicUrl(item.grade, item.element, item.slug, item.subject)}
                      >
                        {item.title}
                      </a>
                      <span class="prereq-item-meta">{ELEMENTS[item.element].short}</span>
                    </summary>
                    <div class="prereq-item-body">
                      <div class="prereq-chip-group">
                        <p class="prereq-chips-label">Prasyarat</p>
                        {item.prereqs.length ? (
                          <ul class="prereq-chips" role="list">
                            {item.prereqs.map((id) => {
                              const target = nodeById.get(id);
                              return target ? (
                                <li>
                                  <a
                                    class={`prereq-chip accent-${target.element}`}
                                    href={topicUrl(
                                      target.grade,
                                      target.element,
                                      target.slug,
                                      target.subject,
                                    )}
                                  >
                                    {target.title}
                                  </a>
                                </li>
                              ) : null;
                            })}
                          </ul>
                        ) : (
                          <p class="prereq-empty">Tanpa prasyarat.</p>
                        )}
                      </div>
                      <div class="prereq-chip-group">
                        <p class="prereq-chips-label">Lanjutan</p>
                        {(succById.get(item.id) ?? []).length ? (
                          <ul class="prereq-chips" role="list">
                            {(succById.get(item.id) ?? []).map((id) => {
                              const target = nodeById.get(id);
                              return target ? (
                                <li>
                                  <a
                                    class={`prereq-chip accent-${target.element}`}
                                    href={topicUrl(
                                      target.grade,
                                      target.element,
                                      target.slug,
                                      target.subject,
                                    )}
                                  >
                                    {target.title}
                                  </a>
                                </li>
                              ) : null;
                            })}
                          </ul>
                        ) : (
                          <p class="prereq-empty">Belum ada lanjutan tercatat.</p>
                        )}
                      </div>
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    try {
      var wraps = document.querySelectorAll('.prereq-wrap');
      if (!wraps.length) return;

      function init(wrap) {
        var nodeEls = Array.prototype.slice.call(wrap.querySelectorAll('.prereq-node'));
        var edgeEls = Array.prototype.slice.call(wrap.querySelectorAll('.prereq-edge'));
        if (!nodeEls.length) return;
        wrap.classList.add('is-ready');

        var gradeChips = Array.prototype.slice.call(wrap.querySelectorAll('[data-grade-filter]'));
        var gradeGroups = Array.prototype.slice.call(wrap.querySelectorAll('.prereq-group[data-grade]'));
        var gradeMap = {};
        nodeEls.forEach(function (el) {
          gradeMap[el.getAttribute('data-id')] = el.getAttribute('data-grade');
        });
        var gradeFilter = 'all';

        var incoming = {};
        var outgoing = {};
        edgeEls.forEach(function (edge) {
          var from = edge.getAttribute('data-from');
          var to = edge.getAttribute('data-to');
          if (!from || !to) return;
          (outgoing[from] || (outgoing[from] = [])).push(to);
          (incoming[to] || (incoming[to] = [])).push(from);
        });

        function apply(active) {
          nodeEls.forEach(function (el) {
            var id = el.getAttribute('data-id');
            var on = !!(id && active[id]);
            el.classList.toggle('is-active', on);
            el.classList.toggle('is-dim', !on);
          });
          edgeEls.forEach(function (edge) {
            var from = edge.getAttribute('data-from');
            var to = edge.getAttribute('data-to');
            var on = !!(from && to && active[from] && active[to]);
            edge.classList.toggle('is-active', on);
            edge.classList.toggle('is-dim', !on);
          });
        }

        function clear() {
          nodeEls.forEach(function (el) {
            el.classList.remove('is-active');
            el.classList.remove('is-dim');
          });
          edgeEls.forEach(function (edge) {
            edge.classList.remove('is-active');
            edge.classList.remove('is-dim');
          });
        }

        function applyGrade() {
          nodeEls.forEach(function (el) {
            var id = el.getAttribute('data-id');
            var match = gradeFilter === 'all' || gradeMap[id] === gradeFilter;
            el.classList.toggle('is-grade-dim', !match);
          });
          edgeEls.forEach(function (edge) {
            var from = edge.getAttribute('data-from');
            var to = edge.getAttribute('data-to');
            var match =
              gradeFilter === 'all' ||
              gradeMap[from] === gradeFilter ||
              gradeMap[to] === gradeFilter;
            edge.classList.toggle('is-grade-dim', !match);
          });
          gradeGroups.forEach(function (group) {
            var match = gradeFilter === 'all' || group.getAttribute('data-grade') === gradeFilter;
            group.classList.toggle('is-grade-hidden', !match);
          });
          gradeChips.forEach(function (chip) {
            var active = chip.getAttribute('data-grade-filter') === gradeFilter;
            chip.classList.toggle('is-active', active);
            chip.setAttribute('aria-pressed', active ? 'true' : 'false');
          });
        }

        function highlight(id) {
          var active = {};
          active[id] = true;

          var stack = [id];
          var seenIn = {};
          seenIn[id] = true;
          while (stack.length) {
            var cur = stack.pop();
            var inc = incoming[cur];
            if (inc) {
              for (var i = 0; i < inc.length; i++) {
                var a = inc[i];
                if (!seenIn[a]) {
                  seenIn[a] = true;
                  active[a] = true;
                  stack.push(a);
                }
              }
            }
          }

          stack = [id];
          var seenOut = {};
          seenOut[id] = true;
          while (stack.length) {
            var cur2 = stack.pop();
            var out = outgoing[cur2];
            if (out) {
              for (var j = 0; j < out.length; j++) {
                var d = out[j];
                if (!seenOut[d]) {
                  seenOut[d] = true;
                  active[d] = true;
                  stack.push(d);
                }
              }
            }
          }

          apply(active);
        }

        nodeEls.forEach(function (el) {
          var id = el.getAttribute('data-id');
          if (!id) return;
          el.addEventListener('mouseenter', function () {
            highlight(id);
          });
          el.addEventListener('focusin', function () {
            highlight(id);
          });
          el.addEventListener('mouseleave', clear);
          el.addEventListener('focusout', clear);
        });

        gradeChips.forEach(function (chip) {
          chip.addEventListener('click', function () {
            gradeFilter = chip.getAttribute('data-grade-filter') || 'all';
            clear();
            applyGrade();
          });
        });
        applyGrade();
      }

      Array.prototype.forEach.call(wraps, init);
    } catch (e) {
      /* biarkan graf tetap tampil tanpa interaksi */
    }
  })();
</script>

<style>
  .prereq-wrap {
    display: grid;
    gap: 0.85rem;
  }
  .prereq-hint {
    margin: 0 0 0.85rem;
    font-size: 0.9rem;
  }
  .prereq-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--radius);
  }
  .prereq-svg {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .prereq-node {
    cursor: pointer;
    transition: opacity var(--dur) var(--ease-out-soft);
  }
  .prereq-node rect {
    fill: var(--color-surface);
    stroke: color-mix(in srgb, var(--accent, var(--color-primary)) 45%, var(--color-border));
    stroke-width: 1.5;
    transition:
      stroke var(--dur) var(--ease-out-soft),
      stroke-width var(--dur) var(--ease-out-soft),
      opacity var(--dur) var(--ease-out-soft);
  }
  .prereq-node.is-active rect {
    stroke: var(--accent, var(--color-primary));
  }
  .prereq-node.is-dim {
    opacity: 0.28;
  }
  .prereq-node:focus-visible {
    outline: none;
  }
  .prereq-node:focus-visible rect {
    stroke: var(--color-primary);
    stroke-width: 2.5;
  }
  .prereq-title {
    fill: var(--color-text);
    font-size: 12px;
    font-weight: 600;
  }
  .prereq-meta {
    fill: var(--color-text-soft);
    font-size: 10.5px;
  }
  .prereq-edge {
    fill: none;
    stroke: var(--color-border-strong);
    stroke-width: 1.6;
    transition:
      stroke var(--dur) var(--ease-out-soft),
      stroke-width var(--dur) var(--ease-out-soft),
      opacity var(--dur) var(--ease-out-soft);
  }
  .prereq-edge.is-active {
    stroke: var(--color-primary);
    stroke-width: 2.5;
  }
  .prereq-edge.is-dim {
    opacity: 0.2;
  }
  .prereq-wrap.is-ready .prereq-edge[data-primary='false'] {
    opacity: 0;
  }
  .prereq-wrap.is-ready .prereq-edge[data-primary='false'].is-active {
    opacity: 1;
  }
  .prereq-wrap.is-ready .prereq-edge[data-primary='false'].is-dim {
    opacity: 0;
  }
  .prereq-mobile {
    display: none;
  }
  .prereq-groups {
    display: grid;
    gap: 1.15rem;
  }
  .prereq-group-title {
    margin: 0 0 0.5rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-soft);
  }
  .prereq-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .prereq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface-2);
    overflow: hidden;
  }
  .prereq-item[open] {
    border-color: color-mix(in srgb, var(--accent, var(--color-primary)) 45%, var(--color-border));
  }
  .prereq-item-summary {
    cursor: pointer;
    padding: 0.6rem 0.75rem;
    min-height: 44px;
  }
  .prereq-item-title {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--accent, var(--color-primary)) 76%, var(--color-text));
    text-decoration: none;
  }
  .prereq-item-title:hover {
    text-decoration: underline;
  }
  .prereq-item-meta {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--color-text-soft);
  }
  .prereq-item-body {
    display: grid;
    gap: 0.65rem;
    padding: 0 0.75rem 0.8rem;
  }
  .prereq-chip-group {
    display: grid;
    gap: 0.3rem;
  }
  .prereq-chips-label {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-soft);
  }
  .prereq-chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .prereq-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.62rem;
    border-radius: var(--radius-pill);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 12%, var(--color-surface));
    color: color-mix(in srgb, var(--accent, var(--color-primary)) 72%, var(--color-text));
    border: 1px solid
      color-mix(in srgb, var(--accent, var(--color-primary)) 30%, var(--color-border));
    transition:
      border-color var(--dur) var(--ease-out-soft),
      background-color var(--dur) var(--ease-out-soft);
  }
  .prereq-chip:hover {
    border-color: var(--accent, var(--color-primary));
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 18%, var(--color-surface));
    text-decoration: underline;
  }
  .prereq-empty {
    margin: 0;
    font-size: 0.82rem;
    font-style: italic;
    color: var(--color-text-soft);
  }
  .prereq-grade-toolbar {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }
  .prereq-wrap.is-ready .prereq-grade-toolbar {
    display: flex;
  }
  .prereq-grade-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-soft);
  }
  .prereq-grade-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .prereq-grade-chip {
    appearance: none;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    border-radius: var(--radius-pill);
    padding: 0.32rem 0.8rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out-soft),
      background-color var(--dur-fast) var(--ease-out-soft),
      color var(--dur-fast) var(--ease-out-soft);
  }
  .prereq-grade-chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .prereq-grade-chip:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .prereq-grade-chip.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .prereq-node.is-grade-dim {
    opacity: 0.18;
  }
  .prereq-edge.is-grade-dim {
    opacity: 0.08;
  }
  .prereq-group.is-grade-hidden {
    display: none;
  }
  @media (max-width: 48rem) {
    .prereq-desktop {
      display: none;
    }
    .prereq-mobile {
      display: block;
    }
  }
</style>
