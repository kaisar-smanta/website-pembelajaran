---
import type { Exploration } from '@/types/content';
import { DIFFICULTY_LABELS, EXPLORATION_TYPE_LABELS, elementColorVar } from '@/data/display';
import { renderInlineMarkdown, stripMarkdown } from '@/utils/markdown';
import { url, topicUrl } from '@/utils/url';
import { getTopic, topicSubject } from '@/data/topics';

interface Props {
  exploration: Exploration;
  /** Jeda animasi reveal (ms) untuk efek berjenjang. */
  delay?: number;
  /** Tautan khusus; bila diisi, menggantikan tautan berbasis topik. */
  href?: string;
}
const { exploration, delay = 0, href: hrefProp } = Astro.props;

const label = EXPLORATION_TYPE_LABELS[exploration.type];

const topic = exploration.topicId ? getTopic(exploration.topicId) : undefined;
const linkHref =
  hrefProp ??
  (topic ? topicUrl(topic.grade, topic.element, topic.slug, topicSubject(topic)) : url('/eksplorasi'));

const accent = topic ? elementColorVar(topic.element) : '--color-primary';

const descHtml = renderInlineMarkdown(exploration.description);
const titleAttr = stripMarkdown(exploration.description);

const curves: Record<Exploration['type'], string> = {
  'function-slider': 'M6 58 C40 58 52 12 100 12 C148 12 160 58 194 58',
  'compound-interest': 'M6 56 C60 56 115 48 150 30 C170 20 185 12 194 8',
  probability: 'M6 58 C50 58 62 16 100 16 C138 16 150 58 194 58',
  'linear-regression': 'M6 50 L194 14',
  sequence: 'M6 58 L44 50 L82 38 L120 24 L158 14 L194 10',
  distribution: 'M10 58 H50 V40 H90 V20 H130 V42 H170 V58 H194',
  'conditional-probability': 'M6 12 L40 30 L74 30 L108 52 L142 52 L176 58',
  circle: 'M74 32 A26 26 0 1 1 126 32 A26 26 0 1 1 74 32',
  matrix: 'M40 12 H58 V52 H40 M142 12 H160 V52 H142 M70 22 H130 M70 42 H130',
  'linear-system': 'M10 58 L190 6 M10 6 L190 58',
  'function-composition': 'M6 58 C50 58 70 10 100 10 C130 10 150 58 194 58',
  'function-inverse': 'M6 6 L194 58 M6 46 C70 46 110 26 194 6',
  polynomial: 'M6 14 C40 58 60 58 100 20 C140 4 160 10 194 34',
  vector: 'M20 52 L150 16 M132 16 H150 V34',
  conic: 'M60 32 A40 22 0 1 1 140 32 A40 22 0 1 1 60 32',
  derivative: 'M6 58 C60 58 100 12 194 12 M40 46 L164 6',
  integral: 'M6 52 C60 52 80 14 120 14 C160 14 180 40 194 52 M6 52 H194',
  'random-variable': 'M10 58 H40 V34 H70 V20 H100 V44 H130 V30 H160 V58 H194',
  geogebra: 'M6 58 C45 58 60 14 100 14 C140 14 155 58 194 58',
};

const dots: Record<Exploration['type'], ReadonlyArray<readonly [number, number]>> = {
  'function-slider': [
    [6, 58],
    [100, 12],
    [194, 58],
  ],
  'compound-interest': [
    [6, 56],
    [150, 30],
    [194, 8],
  ],
  probability: [
    [50, 30],
    [70, 20],
    [100, 16],
    [130, 20],
    [150, 30],
  ],
  'linear-regression': [
    [30, 44],
    [62, 40],
    [86, 34],
    [112, 30],
    [142, 22],
    [172, 16],
  ],
  sequence: [
    [44, 50],
    [82, 38],
    [120, 24],
    [158, 14],
  ],
  distribution: [
    [50, 40],
    [90, 20],
    [130, 42],
  ],
  'conditional-probability': [
    [40, 30],
    [108, 52],
    [176, 58],
  ],
  circle: [
    [100, 32],
    [126, 32],
    [100, 6],
  ],
  matrix: [
    [50, 32],
    [150, 32],
  ],
  'linear-system': [[100, 32]],
  'function-composition': [
    [100, 10],
    [150, 58],
  ],
  'function-inverse': [
    [60, 40],
    [100, 32],
  ],
  polynomial: [
    [30, 42],
    [100, 20],
    [170, 20],
  ],
  vector: [
    [20, 52],
    [150, 16],
  ],
  conic: [
    [100, 10],
    [140, 32],
    [100, 54],
  ],
  derivative: [
    [46, 42],
    [118, 24],
  ],
  integral: [
    [60, 40],
    [120, 14],
    [170, 34],
  ],
  'random-variable': [
    [40, 34],
    [70, 20],
    [100, 44],
    [130, 30],
  ],
  geogebra: [
    [40, 40],
    [100, 14],
    [160, 40],
  ],
};
const curve = curves[exploration.type];
const points = dots[exploration.type];
---

<a
  class="exploration-card card-link hover-lift reveal"
  style={`--reveal-delay:${delay ?? 0}ms; --accent: var(${accent})`}
  href={linkHref}
  title={titleAttr}
>
  <div class="exploration-graph" aria-hidden="true">
    <svg viewBox="0 0 200 64" preserveAspectRatio="none" focusable="false">
      <path class="baseline" d="M0 58 H200"></path>
      <path class="curve" d={curve}></path>
      {points.map(([cx, cy]) => <circle class="dot" cx={cx} cy={cy} r="2.6"></circle>)}
    </svg>
  </div>
  <div class="exploration-badges">
    <span class="badge">{label}</span>
    {exploration.level && <span class="badge badge-level">{DIFFICULTY_LABELS[exploration.level]}</span>}
  </div>
  <h3 class="exploration-title">{exploration.title}</h3>
  <p class="exploration-desc" set:html={descHtml}></p>
  <span class="cta">Coba →</span>
</a>

<style>
  .exploration-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: 1rem 1rem 1.15rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .exploration-card:hover,
  .exploration-card:focus-within {
    border-color: var(--accent);
  }
  .exploration-graph {
    height: 64px;
    border-radius: var(--radius-lg);
    background: linear-gradient(
      135deg,
      var(--color-surface-2),
      color-mix(in srgb, var(--accent) 16%, var(--color-surface-2))
    );
    color: var(--accent);
    overflow: hidden;
  }
  .exploration-graph svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .baseline {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.22;
    vector-effect: non-scaling-stroke;
  }
  .curve {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .dot {
    fill: currentColor;
  }
  .exploration-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-self: flex-start;
  }
  .exploration-card .badge {
    background: color-mix(in srgb, var(--accent) 14%, var(--color-surface));
    color: color-mix(in srgb, var(--accent) 62%, var(--color-text));
    border-color: transparent;
  }
  .exploration-card .badge-level {
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    border-color: var(--color-border);
  }
  .exploration-title {
    margin: 0;
    font-size: clamp(1rem, 1.4vw + 0.7rem, 1.15rem);
    line-height: 1.3;
  }
  .exploration-desc {
    margin: 0;
    flex-grow: 1;
    color: var(--color-text-muted);
    font-size: 0.93rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @supports not ((-webkit-line-clamp: 3) or (line-clamp: 3)) {
    .exploration-desc {
      max-height: 4.5em;
    }
  }
  .cta {
    color: color-mix(in srgb, var(--accent) 72%, var(--color-text));
    font-weight: 600;
  }
</style>
