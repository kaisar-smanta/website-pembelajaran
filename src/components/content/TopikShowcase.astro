---
import type { Topic } from '@/types/content';
import { url } from '@/utils/url';
import TopicCard from './TopicCard.astro';

interface Props {
  topics: Topic[];
}
const { topics } = Astro.props;
---

<section class="section section-alt topik-showcase" aria-labelledby="featured">
  <div class="container">
    <div class="section-heading reveal" data-reveal>
      <p class="eyebrow-badge">Pilih dan pelajari</p>
      <h2 id="featured">Topik pilihan</h2>
      <p class="text-muted">Pilih topik yang ingin kamu pelajari.</p>
    </div>

    <div class="grid grid-3 topic-grid" id="topic-grid">
      {
        topics.map((t, i) => (
          <div class="topic-slot">
            <TopicCard
              title={t.title}
              summary={t.summary}
              grade={t.grade}
              element={t.element}
              slug={t.slug}
              delay={i * 60}
            />
          </div>
        ))
      }
    </div>

    <div class="topic-footer">
      <div class="topic-actions">
        <a class="btn btn-secondary" href={url('/peta-pembelajaran')}>Lihat semua topik</a>
      </div>
    </div>
  </div>
</section>

<style>
  section.topik-showcase {
    position: relative;
    background-color: var(--color-bg-alt);
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px),
      radial-gradient(
        circle at 15% 0%,
        color-mix(in srgb, var(--color-primary) 7%, transparent),
        transparent 46%
      );
    background-size: var(--grid-size) var(--grid-size), var(--grid-size) var(--grid-size), auto;
  }
  .topik-showcase .eyebrow-badge {
    margin-bottom: 0.55rem;
  }
  .topic-slot {
    display: flex;
    min-width: 0;
  }
  .topic-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .topic-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  @media (max-width: 34rem) {
    .topic-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
