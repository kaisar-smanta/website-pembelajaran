---
import type { ElementId, Grade, SubjectId } from '@/types/content';
import { ELEMENTS, SUBJECTS, elementOrderFor, GRADES } from '@/data/curriculum';
import { topics, topicSubject, topicsBySubjectGradeElement, plannedTopics } from '@/data/topics';
import { topicUrl } from '@/utils/url';
import ElementIcon from '@/components/content/ElementIcon.astro';

interface Props {
  grade: Grade;
  subject?: SubjectId;
  delay?: number;
}

const { grade, subject = 'matematika', delay = 0 } = Astro.props;
const subjectMeta = SUBJECTS[subject];
const subjectElements = elementOrderFor(subject);

// Peta elemen -> kelas tempat elemen itu benar-benar dipakai mata pelajaran ini,
// diambil dari data topik (bukan daftar statis). Dipakai agar elemen yang
// sengaja hanya dibuka di kelas lain — mis. Kalkulus/Data pada Matematika
// Tingkat Lanjut Kelas XI — tidak tampil sebagai "segera disusun" di kelas
// yang salah.
const elementGradesForSubject = new Map<ElementId, Set<Grade>>();
for (const t of topics) {
  if (topicSubject(t) !== subject) continue;
  const seen = elementGradesForSubject.get(t.element) ?? new Set<Grade>();
  seen.add(t.grade);
  elementGradesForSubject.set(t.element, seen);
}

// Elemen dianggap "milik kelas ini" bila dipakai di kelas ini, dipakai di lebih
// dari satu kelas (elemen lintas jenjang seperti pada Matematika wajib), atau
// belum punya data sama sekali (masih benar-benar kosong untuk semua kelas).
function isInScope(element: ElementId, grade: Grade): boolean {
  const seen = elementGradesForSubject.get(element);
  if (!seen || seen.size === 0) return true;
  return seen.has(grade) || seen.size > 1;
}

// Topik rencana lama tidak menyimpan mata pelajaran; entri tanpa penanda
// dianggap Matematika agar perilaku lama tetap terjaga.
function plannedBelongsTo(p: { element: ElementId; subject?: SubjectId }): boolean {
  return (p.subject ?? 'matematika') === subject;
}

const elements = subjectElements.filter((element) => isInScope(element, grade));

const groups = elements.map((element) => {
  const complete = topicsBySubjectGradeElement(subject, grade, element);
  const planned = plannedTopics.filter(
    (p) => p.grade === grade && p.element === element && plannedBelongsTo(p),
  );
  const count = complete.length + planned.length;
  return { element, complete, planned, count };
});

const totalCount = groups.reduce((sum, group) => sum + group.count, 0);
const withTopics = groups.filter((group) => group.count > 0);
const pending = groups.filter((group) => group.count === 0);
---

<div
  class="grade-block reveal"
  id={`kelas-${subject}-${grade}`}
  style={`--reveal-delay:${delay}ms`}
  data-reveal
>
  <div class="grade-head">
    <h3 class="grade-title">
      {GRADES[grade].name} <span class="badge">{GRADES[grade].label}</span>
      <span class="badge badge-subject">{subjectMeta.short}</span>
    </h3>
    <p class="grade-count text-soft">{totalCount} topik</p>
  </div>

  {
    withTopics.length > 0 && (
      <div class="grade-columns">
        {withTopics.map(({ element, complete, planned, count }) => (
          <div class={`elem-col card card-accent accent-${element}`} data-element={element}>
            <h4>
              <span class="icon-tile elem-icon" aria-hidden="true">
                <ElementIcon element={element} size={14} />
              </span>
              <span class="elem-name">{ELEMENTS[element].short}</span>
              <span class="elem-count">{count}</span>
            </h4>
            <p class="elem-desc text-soft">{ELEMENTS[element].description}</p>

            {count > complete.length && (
              <div
                class="coverage-bar"
                role="img"
                aria-label={`${complete.length} dari ${count} topik siap`}
              >
                <span
                  class="coverage-fill"
                  style={`width:${Math.round((complete.length / count) * 100)}%`}
                />
              </div>
            )}

            <ul class="elem-list">
              {complete.map((t) => (
                <li class="topic-item" data-status="lengkap" data-element={element}>
                  <a href={topicUrl(grade, element, t.slug, subject)}>{t.title}</a>
                  {t.supplementary && <span class="badge badge-pengayaan">Pengayaan</span>}
                </li>
              ))}
              {planned.map((t) => (
                <li class="topic-item planned-item" data-status="rencana" data-element={element}>
                  <span class="planned-label">{t.title}</span>
                  <span class="badge badge-rencana">Segera hadir</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )
  }

  {
    pending.length > 0 && (
      <div class="elem-pending" data-pending-strip>
        <span class="elem-pending-label">Segera disusun:</span>
        <ul class="elem-pending-list">
          {pending.map(({ element }) => (
            <li class={`pending-chip accent-${element}`} data-element={element} data-pending>
              <span class="icon-tile pending-icon" aria-hidden="true">
                <ElementIcon element={element} size={14} />
              </span>
              {ELEMENTS[element].short}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  .grade-block {
    margin-top: 1.5rem;
  }
  .grade-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.4rem;
  }
  .grade-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }
  .grade-title .badge {
    vertical-align: middle;
  }
  .grade-count {
    margin: 0;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .grade-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .elem-col {
    padding: 0.85rem 1rem;
    min-width: 0;
  }
  .elem-col h4 {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin: 0 0 0.35rem;
  }
  .elem-icon {
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 8px;
    flex: none;
  }
  .elem-name {
    min-width: 0;
  }
  .elem-count {
    margin-left: auto;
    display: inline-grid;
    place-items: center;
    min-width: 1.4rem;
    height: 1.4rem;
    padding-inline: 0.4rem;
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--accent, var(--color-primary));
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 14%, var(--color-surface-2));
  }
  .elem-desc {
    margin: 0 0 0.6rem;
    font-size: 0.8rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .coverage-bar {
    height: 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    overflow: hidden;
    margin-bottom: 0.65rem;
  }
  .coverage-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent, var(--color-primary));
    transition: width var(--dur) var(--ease-out-soft);
  }
  .elem-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .elem-col a {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding-block: 0.18rem;
    text-decoration: none;
  }
  .topic-item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .elem-col a:hover {
    text-decoration: underline;
  }
  .planned-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    color: var(--color-text-soft);
    font-size: 0.9rem;
  }
  .planned-label {
    line-height: 1.45;
  }
  .planned-item .badge {
    flex: none;
  }
  .elem-pending {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.85rem;
    margin-top: 1rem;
    padding: 0.6rem 0.9rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-surface-2) 55%, transparent);
  }
  .elem-pending-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .elem-pending-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pending-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.65rem 0.2rem 0.3rem;
    border-radius: var(--radius-pill);
    border: 1px solid
      color-mix(in srgb, var(--accent, var(--color-primary)) 26%, var(--color-border));
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .pending-icon {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    flex: none;
  }
  .pending-chip.is-hidden,
  .elem-pending.is-hidden {
    display: none !important;
  }

  @media (max-width: 30rem) {
    .grade-columns {
      grid-template-columns: 1fr;
    }
  }
</style>
