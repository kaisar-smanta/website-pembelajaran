---
import type { Application } from '@/types/content';
import { applicationCategories } from '@/data/applications';
import { url } from '@/utils/url';

interface Props {
  applications: Application[];
  title?: string;
  eyebrow?: string;
}

const {
  applications,
  title = 'Penerapan di Dunia Nyata',
  eyebrow = 'Koneksi',
} = Astro.props;

const levelLabel: Record<string, string> = {
  dasar: 'Dasar',
  cakap: 'Cakap',
  mahir: 'Mahir',
};

const items = applications.filter((a) => applicationCategories[a.category]);
---

{
  items.length > 0 && (
    <section
      id="penerapan"
      class="content-section topic-applications"
      aria-labelledby="heading-penerapan"
    >
      <div class="section-head">
        <p class="app-eyebrow">{eyebrow}</p>
        <h2 id="heading-penerapan" class="section-title">{title}</h2>
      </div>
      <p class="app-lead">
        Lihat bagaimana konsep pada topik ini dipakai untuk menjawab persoalan nyata, lengkap
        dengan analisis dan pertanyaan refleksinya.
      </p>
      <ul class="app-list" role="list">
        {items.map((a) => {
          const category = applicationCategories[a.category];
          return (
            <li>
              <a
                class="app-card card card-link card-accent hover-lift"
                href={url(`/aplikasi/${a.id}`)}
                style={`--accent: ${category.accent}`}
              >
                <span class="app-card-top">
                  <span class="app-category">{category.name}</span>
                  <span class={`badge badge-${a.level}`}>{levelLabel[a.level]}</span>
                </span>
                <span class="app-title">{a.title}</span>
                <span class="app-summary">{a.summary}</span>
                <span class="app-cta">
                  Baca studi kasus <span aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}

<style>
  .topic-applications {
    --sec: var(--accent, var(--color-primary));
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .section-head {
    margin-bottom: 0.9rem;
    padding-left: 0.85rem;
    border-left: 3px solid color-mix(in srgb, var(--sec) 72%, transparent);
  }
  .section-head::after {
    content: '';
    display: block;
    height: 2px;
    margin-top: 0.55rem;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--sec) 60%, transparent),
      transparent 62%
    );
  }
  .app-eyebrow {
    margin: 0 0 0.25rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sec) 68%, var(--color-text-muted));
  }
  .section-title {
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.014em;
  }
  .app-lead {
    margin: 0 0 1rem;
    max-width: 70ch;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .app-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 0.9rem;
  }
  .app-list li {
    display: flex;
  }
  .app-card {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    width: 100%;
    padding: 1rem 1.05rem;
    color: inherit;
  }
  .app-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .app-category {
    display: inline-flex;
    align-items: center;
    padding: 0.16rem 0.55rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent, var(--color-primary)) 72%, var(--color-text));
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 12%, var(--color-surface-2));
    border: 1px solid color-mix(in srgb, var(--accent, var(--color-primary)) 26%, var(--color-border));
  }
  .app-title {
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--color-text);
  }
  .app-summary {
    color: var(--color-text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .app-cta {
    margin-top: auto;
    padding-top: 0.5rem;
    color: color-mix(in srgb, var(--accent, var(--color-primary)) 68%, var(--color-text));
    font-weight: 600;
    font-size: 0.88rem;
  }
</style>
