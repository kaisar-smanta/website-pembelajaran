---
import { learningPaths } from '@/data/learning-paths';
import { GRADES, SUBJECTS, SUBJECT_ORDER, gradesFor } from '@/data/curriculum';
import { cpStatements } from '@/data/curriculum/cp';
import { topics, topicSubject, plannedTopics } from '@/data/topics';

const prereqCount = topics.reduce((sum, topic) => sum + (topic.prerequisites?.length ?? 0), 0);

const gradeTotals = SUBJECT_ORDER.flatMap((subject) =>
  gradesFor(subject).map((grade) => {
    const complete = topics.filter(
      (t) => t.grade === grade && topicSubject(t) === subject,
    ).length;
    const planned =
      subject === 'matematika'
        ? plannedTopics.filter((p) => p.grade === grade).length
        : 0;
    return {
      subject,
      grade,
      name: `${GRADES[grade].name}`,
      subjectName: SUBJECTS[subject].short,
      total: complete + planned,
      href: `#kelas-${subject}-${grade}`,
    };
  }),
);
---

<nav class="map-quicknav card reveal" aria-label="Navigasi peta pembelajaran" data-reveal>
  <h2 class="quicknav-title">Peta cepat</h2>
  <div class="quicknav-grid">
    <section class="quicknav-group">
      <h3 class="quicknav-heading">Jalur konsep</h3>
      <div class="quicknav-list">
        {
          learningPaths.map((p) => (
            <a class:list={['quick-link', `accent-${p.accent}`]} href={`#jalur-${p.id}`}>
              <span class="quick-dot" aria-hidden="true" />
              <span class="quick-text">{p.title}</span>
              <span class="quick-count">{p.nodes.length} tahap</span>
            </a>
          ))
        }
      </div>
    </section>
    <section class="quicknav-group">
      <h3 class="quicknav-heading">Per kelas</h3>
      <div class="quicknav-list">
        {
          gradeTotals.map((g) => (
            <a class="quick-link" href={g.href}>
              <span class="quick-text">
                {g.name} <span class="text-soft">· {g.subjectName}</span>
              </span>
              <span class="quick-count">{g.total} topik</span>
            </a>
          ))
        }
      </div>
    </section>
    <section class="quicknav-group">
      <h3 class="quicknav-heading">Kurikulum</h3>
      <div class="quicknav-list">
        <a class="quick-link" href="#cakupan-cp">
          <span class="quick-text">Cakupan Capaian Pembelajaran</span>
          <span class="quick-count">{cpStatements.length} pernyataan</span>
        </a>
        <a class="quick-link" href="#prasyarat">
          <span class="quick-text">Peta Prasyarat</span>
          <span class="quick-count">{prereqCount} relasi</span>
        </a>
      </div>
    </section>
  </div>
</nav>

<style>
  .map-quicknav {
    padding: 1.1rem 1.25rem 1.25rem;
  }
  .quicknav-title {
    margin: 0 0 0.85rem;
    font-size: 1rem;
  }
  .quicknav-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.75rem;
  }
  .quicknav-group {
    min-width: 0;
  }
  .quicknav-group:last-child {
    grid-column: 1 / -1;
  }
  .quicknav-group:last-child .quicknav-list {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
  }
  .quicknav-heading {
    margin: 0 0 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-soft);
  }
  .quicknav-list {
    display: grid;
    gap: 0.15rem;
  }
  .quick-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.88rem;
    line-height: 1.35;
    transition: background-color var(--dur-fast) var(--ease-out-soft);
  }
  .quick-link:hover,
  .quick-link:focus-visible {
    background: var(--color-surface-2);
  }
  .quick-link:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .quick-dot {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent, var(--color-primary));
  }
  .quick-text {
    min-width: 0;
  }
  .quick-count {
    margin-left: auto;
    flex-shrink: 0;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 30rem) {
    .quicknav-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
