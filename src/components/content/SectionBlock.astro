---
import type { Block, Difficulty, Question, Section, SectionKind } from '@/types/content';
import { renderMarkdown } from '@/utils/markdown';
import BlockRenderer from './BlockRenderer.astro';
import QuestionCard from '@/components/exercises/QuestionCard.astro';
import { getQuestion, questionsByTopicAndDifficulty } from '@/data/questions';

interface Props {
  section: Section;
  index: number;
  topicId?: string;
}
const { section, index, topicId } = Astro.props;

const practiceKinds: SectionKind[] = ['latihan-dasar', 'latihan-cakap', 'latihan-mahir'];
const practiceLevel: Difficulty | undefined = section.practiceLevel ?? section.level;

let practiceQuestions: Question[] = [];
if (section.questionIds?.length) {
  practiceQuestions = section.questionIds
    .map((id) => getQuestion(id))
    .filter((q): q is Question => q !== undefined);
} else if (practiceKinds.includes(section.kind) && topicId && practiceLevel) {
  practiceQuestions = questionsByTopicAndDifficulty(topicId, practiceLevel);
}

const kindTitles: Record<SectionKind, string> = {
  tujuan: 'Tujuan Pembelajaran',
  pemantik: 'Pertanyaan Pemantik',
  prasyarat: 'Prasyarat',
  konteks: 'Situasi dan Konteks',
  konsep: 'Konsep Inti',
  representasi: 'Representasi',
  eksplorasi: 'Eksplorasi',
  generalisasi: 'Generalisasi',
  rumus: 'Rumus dan Prosedur',
  contoh: 'Contoh Terbimbing',
  'latihan-dasar': 'Latihan Dasar',
  'latihan-cakap': 'Latihan Cakap',
  'latihan-mahir': 'Latihan Mahir',
  'dunia-nyata': 'Masalah Dunia Nyata',
  'kesalahan-umum': 'Kesalahan Umum',
  refleksi: 'Refleksi',
  rangkuman: 'Rangkuman',
  evaluasi: 'Evaluasi',
  catatan: 'Catatan',
};

const title = section.title ?? kindTitles[section.kind];
const bodyHtml = section.body ? renderMarkdown(section.body) : '';
const levelBadge: Record<string, string> = {
  dasar: 'Dasar',
  cakap: 'Cakap',
  mahir: 'Mahir',
};

function blockList(blocks: Block[] | undefined) {
  return blocks ?? [];
}

/** Id stabil untuk menyimpan interaksi siswa (dugaan, refleksi, dsb.). */
function blockStorageId(blockIndex: number): string {
  return `${topicId ?? 'umum'}:${section.id}:${blockIndex}`;
}
---

<section
  id={section.id}
  class:list={['content-section', `kind-${section.kind}`, section.collapsed && 'is-collapsible']}
  aria-labelledby={`heading-${section.id}`}
>
  {
    section.kind !== 'catatan' && (
      <div class="section-head">
        <h2 id={`heading-${section.id}`} class="section-title">
          <span class="section-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          {title}
          {section.level && <span class={`badge badge-${section.level}`}>{levelBadge[section.level]}</span>}
        </h2>
      </div>
    )
  }

  {
    practiceQuestions.length > 0 ? (
      <>
        <div class="practice-embed">
          <p class="practice-lead">
            Kerjakan langsung di sini. Jawaban dan pembahasannya diperiksa otomatis.
          </p>
          <div class="practice-list">
            {practiceQuestions.map((question, i) => (
              <QuestionCard question={question} index={i} />
            ))}
          </div>
        </div>

        {blockList(section.blocks).map((block, bi) =>
          block.kind === 'details' ? null : (
            <BlockRenderer block={block} storageId={blockStorageId(bi)} />
          ),
        )}

        {(bodyHtml || blockList(section.blocks).some((block) => block.kind === 'details')) && (
          <details class="practice-legacy">
            <summary>Latihan tambahan (uraian &amp; kunci)</summary>
            <div class="practice-legacy-body">
              {bodyHtml && <div class="prose section-body" set:html={bodyHtml} />}
              {blockList(section.blocks).map((block) => {
                if (block.kind === 'details') {
                  return (
                    <details class="details-block">
                      <summary>{block.summary}</summary>
                      <div class="prose details-body" set:html={renderMarkdown(block.text)} />
                    </details>
                  );
                }
                return null;
              })}
            </div>
          </details>
        )}
      </>
    ) : (
      <>
        {bodyHtml && <div class="prose section-body" set:html={bodyHtml} />}

        {blockList(section.blocks).map((block, bi) =>
          block.kind === 'details' ? null : (
            <BlockRenderer block={block} storageId={blockStorageId(bi)} />
          ),
        )}
      </>
    )
  }
</section>

<style>
  .content-section {
    --sec: var(--accent, var(--color-primary));
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .content-section:last-of-type {
    border-bottom: none;
  }

  /* Warna aksen per keluarga jenis bagian. */
  .kind-tujuan,
  .kind-pemantik,
  .kind-prasyarat,
  .kind-konteks {
    --sec: var(--color-number);
  }
  .kind-konsep,
  .kind-representasi,
  .kind-eksplorasi,
  .kind-generalisasi,
  .kind-rumus {
    --sec: var(--accent, var(--color-primary));
  }
  .kind-contoh,
  .kind-latihan-dasar,
  .kind-latihan-cakap {
    --sec: var(--color-success);
  }
  .kind-latihan-mahir {
    --sec: var(--color-warning);
  }
  .kind-dunia-nyata,
  .kind-refleksi,
  .kind-rangkuman {
    --sec: var(--color-data);
  }
  .kind-evaluasi {
    --sec: var(--color-primary);
  }
  .kind-kesalahan-umum {
    --sec: var(--color-danger);
  }

  .section-head {
    margin-bottom: 0.9rem;
    padding-left: 0.85rem;
    border-left: 3px solid color-mix(in srgb, var(--sec) 72%, transparent);
  }
  .section-head::after {
    content: '';
    display: block;
    height: 2px;
    margin-top: 0.55rem;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--sec) 60%, transparent),
      transparent 62%
    );
  }
  .section-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem 0.65rem;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.014em;
  }
  .section-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    padding: 0.32rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--sec) 70%, var(--color-text));
    background: color-mix(in srgb, var(--sec) 13%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--sec) 34%, var(--color-border));
    border-radius: 999px;
  }
  .section-title .badge {
    margin-left: auto;
  }
  .section-body {
    max-width: 70ch;
    min-width: 0;
  }

  .practice-embed {
    margin: 0.5rem 0 1.1rem;
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--sec) 24%, var(--color-border));
    border-left: 3px solid color-mix(in srgb, var(--sec) 70%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--sec) 6%, var(--color-surface));
  }
  .practice-lead {
    margin: 0 0 0.85rem;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }
  .practice-list {
    display: grid;
    gap: 0.9rem;
  }
  .practice-list :global(.question-card) {
    margin-bottom: 0;
  }

  .practice-legacy {
    margin: 1rem 0;
    border: 1px solid color-mix(in srgb, var(--sec) 22%, var(--color-border));
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease-out-soft);
  }
  .practice-legacy > summary {
    cursor: pointer;
    padding: 0.7rem 1rem;
    font-weight: 600;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: color-mix(in srgb, var(--sec) 72%, var(--color-text));
    transition:
      background-color var(--dur-fast) var(--ease-out-soft),
      color var(--dur-fast) var(--ease-out-soft);
  }
  .practice-legacy > summary::before {
    content: '+';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    font-family: var(--font-mono);
    font-weight: 700;
    line-height: 1;
    border-radius: 50%;
    color: var(--sec);
    background: color-mix(in srgb, var(--sec) 14%, transparent);
    transition:
      transform var(--dur) var(--ease-bounce),
      background-color var(--dur-fast) var(--ease-out-soft);
  }
  .practice-legacy[open] > summary::before {
    content: '−';
  }
  .practice-legacy > summary:hover {
    background: color-mix(in srgb, var(--sec) 8%, var(--color-surface-2));
  }
  .practice-legacy > summary:hover::before {
    transform: scale(1.12);
  }
  .practice-legacy > summary::-webkit-details-marker {
    display: none;
  }
  .practice-legacy[open] > summary {
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--sec) 7%, var(--color-surface-2));
  }
  .practice-legacy-body {
    padding: 0.9rem 1rem;
  }
  .practice-legacy-body :global(> *:last-child) {
    margin-bottom: 0;
  }
  .practice-legacy-body .details-block {
    margin-top: 0.9rem;
  }

  .details-block {
    margin: 1rem 0;
    border: 1px solid color-mix(in srgb, var(--sec) 22%, var(--color-border));
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease-out-soft);
  }
  .details-block > summary {
    cursor: pointer;
    padding: 0.7rem 1rem;
    font-weight: 600;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: color-mix(in srgb, var(--sec) 72%, var(--color-text));
    transition:
      background-color var(--dur-fast) var(--ease-out-soft),
      color var(--dur-fast) var(--ease-out-soft);
  }
  .details-block > summary::before {
    content: '+';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    font-family: var(--font-mono);
    font-weight: 700;
    line-height: 1;
    border-radius: 50%;
    color: var(--sec);
    background: color-mix(in srgb, var(--sec) 14%, transparent);
    transition:
      transform var(--dur) var(--ease-bounce),
      background-color var(--dur-fast) var(--ease-out-soft);
  }
  .details-block[open] > summary::before {
    content: '−';
  }
  .details-block > summary:hover {
    background: color-mix(in srgb, var(--sec) 8%, var(--color-surface-2));
  }
  .details-block > summary:hover::before {
    transform: scale(1.12);
  }
  .details-block > summary::-webkit-details-marker {
    display: none;
  }
  .details-block[open] > summary {
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--sec) 7%, var(--color-surface-2));
  }
  .details-body {
    padding: 0.9rem 1rem;
  }
  .details-body :global(> *:last-child) {
    margin-bottom: 0;
  }

  .kind-tujuan .section-body,
  .kind-konteks .section-body {
    color: var(--color-text-muted);
  }
  .kind-kesalahan-umum {
    background: color-mix(in srgb, var(--sec) 7%, transparent);
    border-radius: var(--radius);
    padding-inline: 1rem;
  }
  .kind-evaluasi {
    background: color-mix(in srgb, var(--sec) 6%, var(--color-surface));
    border-radius: var(--radius);
    padding-inline: 1rem;
  }
</style>
