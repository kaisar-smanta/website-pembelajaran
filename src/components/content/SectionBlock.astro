---
import type { Block, Difficulty, Section, SectionKind } from '@/types/content';
import { renderMarkdown, renderInlineMarkdown } from '@/utils/markdown';
import { sectionTitle } from '@/lib/content-text';
import { url } from '@/utils/url';
import BlockRenderer from './BlockRenderer.astro';
import PracticeSet from '@/components/exercises/PracticeSet.astro';

interface Props {
  section: Section;
  index: number;
  topicId?: string;
  next?: Section;
}
const { section, index, topicId, next } = Astro.props;

const practiceLevelByKind: Partial<Record<SectionKind, Difficulty>> = {
  'latihan-dasar': 'dasar',
  'latihan-cakap': 'cakap',
  'latihan-mahir': 'mahir',
};
const practiceLevel: Difficulty | undefined =
  section.practiceLevel ?? practiceLevelByKind[section.kind] ?? section.level;
const showPractice = Boolean(section.questionIds?.length || (topicId && practiceLevel));

const title = sectionTitle(section);
const showFormulaLink = section.kind === 'rumus' || section.kind === 'generalisasi';
const bodyHtml = section.body ? renderMarkdown(section.body) : '';
const levelBadge: Record<string, string> = {
  dasar: 'Dasar',
  cakap: 'Cakap',
  mahir: 'Mahir',
};

function blockList(blocks: Block[] | undefined) {
  return blocks ?? [];
}

/** Id stabil untuk menyimpan interaksi siswa (dugaan, refleksi, dsb.). */
function blockStorageId(blockIndex: number): string {
  return `${topicId ?? 'umum'}:${section.id}:${blockIndex}`;
}
---

<section
  id={section.id}
  class:list={['content-section', `kind-${section.kind}`]}
  data-section-progress
  aria-labelledby={`heading-${section.id}`}
>
  <div class="section-head">
    <h2 id={`heading-${section.id}`} class="section-title">
      <span class="section-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      <span class="section-title-text">{title}</span>
      <span class="section-check" aria-hidden="true"></span>
      {section.level && <span class={`badge badge-${section.level}`}>{levelBadge[section.level]}</span>}
    </h2>
  </div>

  {
    showPractice && topicId && (
      <PracticeSet topicId={topicId} level={practiceLevel ?? 'dasar'} questionIds={section.questionIds} />
    )
  }

  {bodyHtml && <div class="prose section-body" set:html={bodyHtml} />}

  {blockList(section.blocks).map((block, bi) =>
    block.kind === 'details' ? (
      <details class="details-block">
        <summary set:html={renderInlineMarkdown(block.summary)} />
        <div class="prose details-body" set:html={renderMarkdown(block.text)} />
      </details>
    ) : (
      <BlockRenderer block={block} storageId={blockStorageId(bi)} />
    ),
  )}

  {
    showFormulaLink && (
      <p class="section-ref no-print">
        <a class="section-ref-link" href={url('/rumus')}>
          Lihat di Kumpulan Rumus <span aria-hidden="true">→</span>
        </a>
      </p>
    )
  }

  {
    next && (
      <a class="section-next" href={`#${next.id}`}>
        <span class="section-next-label">Lanjut</span>
        <span class="section-next-title">{sectionTitle(next)}</span>
        <span class="section-next-arrow" aria-hidden="true">→</span>
      </a>
    )
  }
</section>

<script>
  import { loadProgress } from '@/lib/progress';
  import { loadCompletions, loadPredictions, loadReflections } from '@/lib/learner';
  import { safeStorage } from '@/lib/storage';

  /**
   * Menandai tiap bagian pada halaman materi sebagai "dikunjungi" (saat masuk
   * layar) dan "selesai" (saat seluruh soal/aktivitas di dalamnya rampung).
   * Kelas `is-visited`/`is-done` dikenakan pada bagian, judul bagian, serta
   * tautan daftar isi/bilah "Bagian" milik halaman. Tanpa JavaScript tidak ada
   * kelas yang ditambahkan sehingga tata letak tetap utuh.
   */
  function setupSectionProgress() {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>('[data-section-progress]'),
    );
    if (!sections.length) return;

    const storage = safeStorage();

    const linksById = new Map<string, HTMLAnchorElement[]>();
    document
      .querySelectorAll<HTMLAnchorElement>('[data-section-nav] a[href^="#"]')
      .forEach((link) => {
        const id = (link.getAttribute('href') ?? '').slice(1);
        if (!id) return;
        const list = linksById.get(id) ?? [];
        list.push(link);
        linksById.set(id, list);
      });

    const headings = new Map<HTMLElement, HTMLElement | null>();
    for (const section of sections) {
      headings.set(section, section.querySelector<HTMLElement>('.section-title'));
    }

    const markVisited = (section: HTMLElement) => {
      section.classList.add('is-visited');
      headings.get(section)?.classList.add('is-visited');
      (linksById.get(section.id) ?? []).forEach((link) => link.classList.add('is-visited'));
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) markVisited(entry.target as HTMLElement);
          }
        },
        { rootMargin: '-10% 0px -60% 0px', threshold: 0 },
      );
      sections.forEach((section) => observer.observe(section));
    }

    const renderDone = () => {
      const progress = loadProgress(storage);
      const predictions = loadPredictions(storage);
      const reflections = loadReflections(storage);
      const completions = loadCompletions(storage);

      for (const section of sections) {
        const questions = Array.from(
          section.querySelectorAll<HTMLElement>('[data-question-id]'),
        );
        const preds = Array.from(section.querySelectorAll<HTMLElement>('[data-prediction]'));
        const refls = Array.from(section.querySelectorAll<HTMLElement>('[data-reflection]'));
        const acts = Array.from(section.querySelectorAll<HTMLElement>('[data-activity]'));
        const total = questions.length + preds.length + refls.length + acts.length;
        if (!total) continue;

        let done = 0;
        for (const el of questions) {
          const id = el.getAttribute('data-question-id');
          if (id && progress[id]) done += 1;
        }
        for (const el of preds) {
          const id = el.getAttribute('data-storage-id');
          if (id && predictions[id]) done += 1;
        }
        for (const el of refls) {
          const id = el.getAttribute('data-storage-id');
          if (id && reflections[id]) done += 1;
        }
        for (const el of acts) {
          const id = el.getAttribute('data-storage-id');
          if (id && completions[id]) done += 1;
        }

        const isDone = done === total;
        section.classList.toggle('is-done', isDone);
        headings.get(section)?.classList.toggle('is-done', isDone);
        (linksById.get(section.id) ?? []).forEach((link) =>
          link.classList.toggle('is-done', isDone),
        );
      }
    };

    renderDone();
    window.addEventListener('mtk:progress', renderDone);
    window.addEventListener('mtk:interaction', renderDone);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSectionProgress);
  } else {
    setupSectionProgress();
  }
</script>

<style>
  .content-section {
    --sec: var(--accent, var(--color-primary));
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }
  .content-section:last-of-type {
    border-bottom: none;
  }

  /* Warna aksen per keluarga jenis bagian. */
  .kind-tujuan,
  .kind-pemantik,
  .kind-prasyarat,
  .kind-konteks {
    --sec: var(--color-number);
  }
  .kind-konsep,
  .kind-representasi,
  .kind-eksplorasi,
  .kind-generalisasi,
  .kind-rumus {
    --sec: var(--accent, var(--color-primary));
  }
  .kind-contoh,
  .kind-latihan-dasar,
  .kind-latihan-cakap {
    --sec: var(--color-success);
  }
  .kind-latihan-mahir {
    --sec: var(--color-warning);
  }
  .kind-dunia-nyata,
  .kind-refleksi,
  .kind-rangkuman {
    --sec: var(--color-data);
  }
  .kind-evaluasi {
    --sec: var(--color-primary);
  }
  .kind-sejarah {
    --sec: var(--color-text-muted);
  }
  .kind-tantangan {
    --sec: var(--color-warning);
  }
  .kind-kesalahan-umum {
    --sec: var(--color-danger);
  }

  .section-head {
    margin-bottom: 0.9rem;
    padding-left: 0.85rem;
    border-left: 3px solid color-mix(in srgb, var(--sec) 72%, transparent);
  }
  .section-head::after {
    content: '';
    display: block;
    height: 2px;
    margin-top: 0.55rem;
    border-radius: var(--radius-pill);
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--sec) 60%, transparent),
      transparent 62%
    );
  }
  .section-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem 0.65rem;
    margin: 0;
    line-height: 1.2;
    letter-spacing: -0.014em;
  }
  .section-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    padding: 0.32rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--sec) 70%, var(--color-text));
    background: color-mix(in srgb, var(--sec) 13%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--sec) 34%, var(--color-border));
    border-radius: var(--radius-pill);
  }
  .section-title .badge {
    margin-left: auto;
  }
  .section-title-text {
    min-width: 0;
  }

  /* Penanda kemajuan bagian: bulat kosong saat dikunjungi, centang saat selesai. */
  .section-check {
    display: none;
    flex: none;
    align-self: center;
    position: relative;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--sec) 38%, var(--color-border));
    background: color-mix(in srgb, var(--sec) 8%, var(--color-surface));
  }
  .content-section.is-visited .section-check,
  .content-section.is-done .section-check {
    display: inline-block;
  }
  .content-section.is-done .section-check {
    border-color: color-mix(in srgb, var(--color-success) 55%, var(--color-border));
    background: color-mix(in srgb, var(--color-success) 12%, var(--color-surface));
  }
  .section-check::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 46%;
    width: 0.3rem;
    height: 0.55rem;
    border-right: 2px solid var(--color-success);
    border-bottom: 2px solid var(--color-success);
    transform: translate(-50%, -50%) rotate(45deg);
    opacity: 0;
  }
  .content-section.is-done .section-check::after {
    opacity: 1;
  }

  /* Tautan rujukan rumus pada bagian rumus/generalisasi. */
  .section-ref {
    margin: 0.9rem 0 0;
  }
  .section-ref-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--sec) 68%, var(--color-text));
    text-underline-offset: 0.16em;
  }
  .section-ref-link:hover,
  .section-ref-link:focus-visible {
    color: var(--sec);
  }

  .section-body {
    max-width: 70ch;
    min-width: 0;
  }

  .details-block {
    margin: 1rem 0;
    border: 1px solid color-mix(in srgb, var(--sec) 22%, var(--color-border));
    border-radius: var(--radius);
    background: var(--color-surface);
    overflow: hidden;
    transition: border-color var(--dur-fast) var(--ease-out-soft);
  }
  .details-block > summary {
    cursor: pointer;
    padding: 0.7rem 1rem;
    font-weight: 600;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: color-mix(in srgb, var(--sec) 72%, var(--color-text));
    transition:
      background-color var(--dur-fast) var(--ease-out-soft),
      color var(--dur-fast) var(--ease-out-soft);
  }
  .details-block > summary::before {
    content: '+';
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    font-family: var(--font-mono);
    font-weight: 700;
    line-height: 1;
    border-radius: 50%;
    color: var(--sec);
    background: color-mix(in srgb, var(--sec) 14%, transparent);
    transition:
      transform var(--dur) var(--ease-bounce),
      background-color var(--dur-fast) var(--ease-out-soft);
  }
  .details-block[open] > summary::before {
    content: '−';
  }
  .details-block > summary:hover {
    background: color-mix(in srgb, var(--sec) 8%, var(--color-surface-2));
  }
  .details-block > summary:hover::before {
    transform: scale(1.12);
  }
  .details-block > summary::-webkit-details-marker {
    display: none;
  }
  .details-block[open] > summary {
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--sec) 7%, var(--color-surface-2));
  }
  .details-body {
    padding: 0.9rem 1rem;
  }
  .details-body :global(> *:last-child) {
    margin-bottom: 0;
  }

  .kind-tujuan .section-body,
  .kind-konteks .section-body {
    color: var(--color-text-muted);
  }
  .kind-kesalahan-umum {
    background: color-mix(in srgb, var(--sec) 7%, transparent);
    border-radius: var(--radius);
    padding-inline: 1rem;
  }
  .kind-evaluasi {
    background: color-mix(in srgb, var(--sec) 6%, var(--color-surface));
    border-radius: var(--radius);
    padding-inline: 1rem;
  }
  .kind-tantangan {
    background: color-mix(in srgb, var(--sec) 7%, var(--color-surface));
    border-radius: var(--radius);
    padding-inline: 1rem;
  }

  .section-next {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--color-border);
    border-left: 3px solid color-mix(in srgb, var(--sec) 60%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--sec) 6%, var(--color-surface));
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.88rem;
    transition:
      border-color var(--dur-fast) var(--ease-out-soft),
      background-color var(--dur-fast) var(--ease-out-soft);
  }
  .section-next:hover,
  .section-next:focus-visible {
    border-color: color-mix(in srgb, var(--sec) 50%, var(--color-border));
    background: color-mix(in srgb, var(--sec) 11%, var(--color-surface));
  }
  .section-next-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--sec) 68%, var(--color-text-muted));
  }
  .section-next-title {
    font-weight: 600;
  }
  .section-next-arrow {
    color: color-mix(in srgb, var(--sec) 68%, var(--color-text));
    font-weight: 700;
    transition: transform var(--dur-fast) var(--ease-out-soft);
  }
  .section-next:hover .section-next-arrow,
  .section-next:focus-visible .section-next-arrow {
    transform: translateX(2px);
  }
  /* Penanda pada daftar isi / bilah "Bagian" (milik halaman, bukan komponen). */
  :global([data-section-nav].outline a.is-visited) {
    border-left-color: color-mix(in srgb, var(--color-success) 55%, transparent);
  }
  :global(.section-jump-list a.is-visited::before) {
    content: '';
    display: inline-block;
    width: 0.34rem;
    height: 0.34rem;
    margin-right: 0.35rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-success) 62%, transparent);
    vertical-align: middle;
  }
  :global([data-section-nav] a.is-done) {
    color: color-mix(in srgb, var(--color-success) 68%, var(--color-text));
    font-weight: 600;
  }
  :global([data-section-nav] a.is-done::after) {
    content: '';
    display: inline-block;
    width: 0.3rem;
    height: 0.55rem;
    margin-left: 0.4rem;
    border-right: 1.5px solid var(--color-success);
    border-bottom: 1.5px solid var(--color-success);
    transform: rotate(45deg) translateY(-1px);
    vertical-align: middle;
  }

  @media (prefers-reduced-motion: reduce) {
    .section-next,
    .section-next-arrow {
      transition: none;
    }
    .section-next:hover .section-next-arrow,
    .section-next:focus-visible .section-next-arrow {
      transform: none;
    }
    .section-check::after {
      transition: none;
    }
  }
  /* Penanda kemajuan bagian tidak perlu ikut tercetak (mis. lembar kerja). */
  @media print {
    .section-check {
      display: none !important;
    }
  }
</style>
