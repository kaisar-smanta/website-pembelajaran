---
import type { Block } from '@/types/content';
import Callout from './Callout.astro';
import DataTable from './DataTable.astro';
import Figure from './Figure.astro';
import ExplorationEmbed from '@/components/interactive/ExplorationEmbed.astro';
import PredictionBlock from '@/components/interactive/PredictionBlock.astro';
import ReflectionBlock from '@/components/interactive/ReflectionBlock.astro';
import StepReveal from '@/components/interactive/StepReveal.astro';
import SpotMistake from '@/components/interactive/SpotMistake.astro';
import MatchBlock from '@/components/interactive/MatchBlock.astro';
import FlipCards from '@/components/interactive/FlipCards.astro';
import TabsBlock from '@/components/interactive/TabsBlock.astro';

interface Props {
  block: Block;
  storageId: string;
}
const { block, storageId } = Astro.props;

// Penjaga kelengkapan: menambah jenis `Block` baru tanpa menanganinya di sini
// akan menggagalkan `astro check`. `details` dirender `SectionBlock`, bukan di
// sini, tetapi tetap wajib terdaftar karena bagian dari union `Block`.
const RENDERED_BLOCK_KINDS: Record<Block['kind'], true> = {
  callout: true,
  table: true,
  figure: true,
  exploration: true,
  details: true,
  prediction: true,
  reflection: true,
  'step-reveal': true,
  'spot-mistake': true,
  match: true,
  'flip-cards': true,
  tabs: true,
};
void RENDERED_BLOCK_KINDS;
---

{
  block.kind === 'callout' && <Callout variant={block.variant} title={block.title} text={block.text} />
}
{block.kind === 'table' && <DataTable block={block} />}
{block.kind === 'figure' && <Figure block={block} />}
{block.kind === 'exploration' && <ExplorationEmbed explorationId={block.explorationId} />}
{block.kind === 'prediction' && <PredictionBlock block={block} storageId={storageId} />}
{block.kind === 'reflection' && <ReflectionBlock block={block} storageId={storageId} />}
{block.kind === 'step-reveal' && <StepReveal block={block} storageId={storageId} />}
{block.kind === 'spot-mistake' && <SpotMistake block={block} storageId={storageId} />}
{block.kind === 'match' && <MatchBlock block={block} storageId={storageId} />}
{block.kind === 'flip-cards' && <FlipCards block={block} storageId={storageId} />}
{block.kind === 'tabs' && <TabsBlock block={block} storageId={storageId} />}
