---
import { renderMarkdown } from '@/utils/markdown';

interface Props {
  variant: 'info' | 'warning' | 'tip' | 'concept';
  title?: string;
  text: string;
}
const { variant, title, text } = Astro.props;
const html = renderMarkdown(text);
const labels: Record<string, string> = {
  info: 'Info',
  warning: 'Perhatian',
  tip: 'Tips',
  concept: 'Konsep kunci',
};
---

<aside class={`callout callout-${variant}`} role="note">
  <div class="callout-head">
    <span class="callout-badge">{title ?? labels[variant]}</span>
  </div>
  <div class="callout-body prose" set:html={html} />
</aside>

<style>
  .callout {
    --callout-accent: var(--color-primary);
    --callout-soft: var(--color-info-soft);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--callout-accent);
    border-radius: var(--radius);
    padding: 0.95rem 1.05rem;
    margin: 1.15rem 0;
    background: var(--callout-soft);
    box-shadow: var(--shadow-sm);
  }
  .callout-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .callout-head::before {
    content: 'i';
    flex: none;
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1;
    color: var(--callout-accent);
    background: color-mix(in srgb, var(--callout-accent) 14%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--callout-accent) 34%, transparent);
  }
  .callout-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.22rem 0.62rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--callout-accent);
    background: color-mix(in srgb, var(--callout-accent) 10%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--callout-accent) 32%, var(--color-border));
  }
  .callout-body :global(> *:last-child) {
    margin-bottom: 0;
  }
  .callout-info {
    --callout-accent: var(--color-primary);
    --callout-soft: var(--color-info-soft);
  }
  .callout-warning {
    --callout-accent: var(--color-warning);
    --callout-soft: var(--color-warning-soft);
  }
  .callout-tip {
    --callout-accent: var(--color-success);
    --callout-soft: var(--color-success-soft);
  }
  .callout-concept {
    --callout-accent: var(--color-algebra);
    --callout-soft: var(--color-concept-soft);
  }
  .callout-info .callout-head::before {
    content: 'i';
  }
  .callout-warning .callout-head::before {
    content: '!';
  }
  .callout-tip .callout-head::before {
    content: '✓';
  }
  .callout-concept .callout-head::before {
    content: '*';
  }
</style>
