---
interface Props {
  title: string;
  id?: string;
  eyebrow?: string;
  lead?: string;
  /** Aktifkan animasi reveal saat masuk viewport. */
  reveal?: boolean;
}

const { title, id, eyebrow, lead, reveal = true } = Astro.props;
---

<div class:list={['section-heading', reveal && 'reveal']}>
  {eyebrow && <p class="eyebrow-badge">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead text-muted">{lead}</p>}
</div>

<style>
  .section-heading {
    margin-bottom: 1.25rem;
  }
  .section-heading .eyebrow-badge {
    margin-bottom: 0.6rem;
  }
  .section-heading h2 {
    margin-bottom: 0.3rem;
  }
  .section-heading .lead {
    margin: 0;
    max-width: 70ch;
  }
</style>
