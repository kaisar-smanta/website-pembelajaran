---
import ExplorationPreviewCard from '@/components/content/ExplorationPreviewCard.astro';
import { explorations } from '@/data/explorations';
import { url } from '@/utils/url';

const featured = explorations.filter((e) => e.featured);
const list = (featured.length ? featured : explorations).slice(0, 3);
---

<div class="exploration-block">
  <div class="exploration-head reveal" data-reveal>
    <h3 id="explorations" class="exploration-subtitle">Eksplorasi lainnya</h3>
    <a class="btn btn-secondary" href={url('/eksplorasi')}>Semua eksplorasi</a>
  </div>
  <div class="grid grid-3">
    {list.map((e, i) => <ExplorationPreviewCard exploration={e} delay={i * 70} />)}
  </div>
</div>

<style>
  .exploration-block {
    margin-top: clamp(2rem, 4vw, 2.75rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px dashed var(--color-border);
  }
  .exploration-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
  }
  .exploration-subtitle {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 1.15rem;
  }
  .exploration-subtitle::before {
    content: '';
    flex: 0 0 auto;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 3px;
    background: var(--color-algebra);
    transform: rotate(-8deg);
  }
  .exploration-block :global(.exploration-card .cta) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.15rem;
    color: color-mix(in srgb, var(--accent, var(--color-primary)) 78%, var(--color-text));
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent, var(--color-primary)) 35%, transparent);
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur) var(--ease-out-soft);
  }
  .exploration-block :global(.exploration-card:hover .cta),
  .exploration-block :global(.exploration-card:focus-visible .cta) {
    text-decoration-color: currentColor;
  }
  @media (max-width: 40rem) {
    .exploration-head {
      align-items: stretch;
    }
    .exploration-head .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
