---
import TopicCard from '@/components/content/TopicCard.astro';
import { resolveTopics, topicSubject } from '@/data/topics';
import { url } from '@/utils/url';

const featuredIds = [
  'eksponen',
  'fungsi-kuadrat',
  'trigonometri',
  'bunga-majemuk',
  'data-bivariat',
  'peluang',
];
const featured = resolveTopics(featuredIds);
---

<section class="section band-plain topics-section" aria-labelledby="home-topics-title">
  <div class="container">
    <div class="section-heading section-head--row reveal" data-reveal>
      <div class="heading-copy">
        <p class="eyebrow-badge">Pilih dan pelajari</p>
        <h2 id="home-topics-title">Topik pilihan</h2>
        <p class="text-muted">
          Pilih topik untuk mulai, lalu jelajahi peta lengkapnya.
        </p>
      </div>
      <a class="btn btn-secondary" href={url('/peta-pembelajaran')}>Lihat semua topik</a>
    </div>

    <div class="grid grid-3 topics-grid">
      {
        featured.map((topic, i) => (
          <div class="topics-slot">
            <TopicCard
              title={topic.title}
              summary={topic.summary}
              grade={topic.grade}
              element={topic.element}
              slug={topic.slug}
              subject={topicSubject(topic)}
              delay={i * 60}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .heading-copy {
    max-width: 46rem;
  }
  .heading-copy h2 {
    margin-bottom: 0.25rem;
  }
  .heading-copy .eyebrow-badge {
    margin-bottom: 0.55rem;
  }
  .heading-copy p {
    margin-bottom: 0;
  }
  .topics-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    align-items: stretch;
  }
  .topics-slot {
    display: flex;
    min-width: 0;
  }
</style>
