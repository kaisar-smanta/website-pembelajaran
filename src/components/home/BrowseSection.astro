---
import ElementIcon from '@/components/content/ElementIcon.astro';
import { ELEMENTS, GRADES, GRADE_ORDER, SUBJECTS, SUBJECT_ORDER, elementOrderFor } from '@/data/curriculum';
import { elementOverviewUrl, gradeUrl } from '@/utils/url';

const gradeAccent: Record<string, string> = {
  X: 'accent-bilangan',
  XI: 'accent-aljabar-fungsi',
  XII: 'accent-geometri',
};
const revealStyle = (i: number) => `--reveal-delay:${i * 70}ms`;
const elementSubjects = SUBJECT_ORDER.map((subject) => ({
  subject,
  name: SUBJECTS[subject].name,
  elements: elementOrderFor(subject),
}));
---

<section class="section band-plain entry-doors" aria-labelledby="entry-doors-title">
  <div class="container">
    <div class="section-heading section-head--row reveal" data-reveal>
      <div class="heading-copy">
        <p class="eyebrow-badge">Baru di sini?</p>
        <span class="tag heading-tag">Mulai dari sini</span>
        <h2 id="entry-doors-title">Pilih pintu masukmu</h2>
        <p class="text-muted">
          Belum tahu mulai dari mana? Telusuri menurut kelas atau elemen, lalu buka topik yang
          ingin kamu pelajari.
        </p>
      </div>
      <div class="entry-toggle" role="group" aria-label="Pilih cara menelusuri materi">
        <button
          type="button"
          class="entry-chip is-active"
          data-entry-target="grade"
          aria-controls="entry-panel-grade"
          aria-pressed="true"
        >
          Menurut kelas
        </button>
        <button
          type="button"
          class="entry-chip"
          data-entry-target="element"
          aria-controls="entry-panel-element"
          aria-pressed="false"
        >
          Menurut elemen
        </button>
      </div>
    </div>

    <div
      class="entry-panel"
      id="entry-panel-grade"
      data-entry-panel="grade"
      role="region"
      aria-label="Telusuri menurut kelas"
    >
      <ul class="entry-grade-grid" role="list">
        {
          GRADE_ORDER.map((grade, i) => (
            <li class="entry-slot reveal" style={revealStyle(i)} data-reveal>
              <a
                class={`entry-door ${gradeAccent[grade]}`}
                href={gradeUrl(grade)}
              >
                <span class="entry-num" aria-hidden="true">
                  {grade}
                </span>
                <span class="badge badge-grade">Fase {GRADES[grade].phase}</span>
                <h3>{GRADES[grade].name}</h3>
                <p>{GRADES[grade].description}</p>
                <span class="cta">Buka kelas →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="entry-panel"
      id="entry-panel-element"
      data-entry-panel="element"
      role="region"
      aria-label="Telusuri menurut elemen"
    >
      <ul class="entry-element-groups" role="list">
        {
          elementSubjects.map((group) => (
            <li class="entry-element-group">
              <p class="entry-element-subject">{group.name}</p>
              <ul class="entry-element-grid" role="list">
                {group.elements.map((elementId, i) => (
                  <li class="entry-slot reveal" style={revealStyle(i)} data-reveal>
                    <a
                      class={`entry-door entry-door--element wiggle-on-hover accent-${elementId}`}
                      href={elementOverviewUrl(elementId, group.subject)}
                    >
                      <span class="icon-tile wiggle-target" aria-hidden="true">
                        <ElementIcon element={elementId} size={22} />
                      </span>
                      <h3>{ELEMENTS[elementId].name}</h3>
                      <span class="cta">Semua kelas →</span>
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    try {
      var root = document.querySelector('.entry-doors');
      if (!root) return;
      var buttons = Array.prototype.slice.call(root.querySelectorAll('.entry-chip'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('.entry-panel'));
      if (!buttons.length || !panels.length) return;

      function show(target) {
        for (var i = 0; i < panels.length; i++) {
          var match = panels[i].getAttribute('data-entry-panel') === target;
          panels[i].classList.toggle('is-hidden', !match);
        }
        for (var j = 0; j < buttons.length; j++) {
          var active = buttons[j].getAttribute('data-entry-target') === target;
          buttons[j].classList.toggle('is-active', active);
          buttons[j].setAttribute('aria-pressed', active ? 'true' : 'false');
        }
      }

      for (var k = 0; k < buttons.length; k++) {
        buttons[k].addEventListener('click', function (event) {
          var target = event.currentTarget.getAttribute('data-entry-target') || 'grade';
          show(target);
        });
      }

      root.classList.add('js-ready');
      show('grade');
    } catch (e) {
      root && root.classList.remove('js-ready');
    }
  })();
</script>

<style>
  .entry-doors {
    position: relative;
  }
  .heading-copy {
    max-width: 46rem;
  }
  .heading-copy h2 {
    margin-bottom: 0.25rem;
  }
  .heading-copy .eyebrow-badge {
    margin-bottom: 0.55rem;
  }
  .heading-copy .heading-tag {
    margin-bottom: 0.55rem;
  }
  .heading-copy p {
    margin-bottom: 0;
  }
  .entry-toggle {
    display: inline-flex;
    flex-wrap: wrap;
    flex-shrink: 0;
    gap: 0.25rem;
    padding: 0.25rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
  }
  .entry-chip {
    appearance: none;
    min-height: 2rem;
    padding: 0.42rem 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition:
      background var(--dur-fast),
      border-color var(--dur-fast),
      color var(--dur-fast);
  }
  .entry-chip:hover {
    color: var(--color-primary);
  }
  .entry-chip:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .entry-chip.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-on-primary);
  }
  .entry-chip.is-active:hover {
    color: var(--color-on-primary);
  }
  .entry-doors.js-ready .entry-panel.is-hidden {
    display: none;
  }
  .entry-panel + .entry-panel {
    margin-top: 1.25rem;
  }

  .entry-grade-grid,
  .entry-element-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .entry-grade-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .entry-element-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11.5rem), 1fr));
  }
  .entry-element-groups {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.4rem;
  }
  .entry-element-subject {
    margin: 0 0 0.65rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
  .entry-slot {
    display: flex;
    min-width: 0;
  }
  .entry-door {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
    padding: 1rem 1.1rem 1.1rem 1.3rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition:
      transform var(--dur) var(--ease-out-soft),
      box-shadow var(--dur) var(--ease-out-soft),
      border-color var(--dur) var(--ease-out-soft);
  }
  .entry-door::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 0;
    width: 4px;
    background: var(--accent, var(--color-primary));
  }
  .entry-door:hover,
  .entry-door:focus-visible {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--accent, var(--color-primary));
  }
  .entry-door > .badge {
    align-self: flex-start;
  }
  .entry-door h3 {
    margin: 0;
    font-size: 1.15rem;
  }
  .entry-door p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .entry-door .cta {
    margin-top: auto;
    color: var(--accent, var(--color-primary));
    font-weight: 600;
    font-size: 0.9rem;
  }
  .entry-num {
    position: absolute;
    top: -0.5rem;
    right: 0.5rem;
    font-family: var(--font-serif);
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--accent, var(--color-primary));
    opacity: 0.1;
    pointer-events: none;
    user-select: none;
  }
  .entry-door--element {
    gap: 0.55rem;
    padding: 0.95rem 1rem 1rem 1.15rem;
  }
  .entry-door--element .icon-tile {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
  }
  .entry-door--element h3 {
    font-size: 1rem;
    line-height: 1.3;
  }
  .entry-door--element .cta {
    margin-top: 0.1rem;
    font-size: 0.88rem;
  }
</style>
