---
import MathMascot from '@/components/content/MathMascot.astro';
import { url } from '@/utils/url';
---

<section class="section band-deep final-cta" aria-labelledby="final-cta-title">
  <div class="final-cta__deco" aria-hidden="true">
    <span class="final-cta__grid"></span>
    <span class="final-cta__chip final-cta__chip--1 float-slow">&pi;</span>
    <span class="final-cta__chip final-cta__chip--2 drift">x&sup2;</span>
    <span class="final-cta__chip final-cta__chip--3 float-slow float-delayed">&radic;</span>
    <span class="final-cta__chip final-cta__chip--4 drift">&theta;</span>
    <span class="final-cta__chip final-cta__chip--5 float-slow">&sum;</span>
    <span class="final-cta__chip final-cta__chip--6 drift">&infin;</span>
    <span class="final-cta__mascot">
      <MathMascot size={6} />
    </span>
  </div>

  <div class="container final-cta__inner">
    <div class="section-heading section-head--center reveal" data-reveal>
      <p class="eyebrow-badge">Langkah berikutnya</p>
      <h2 id="final-cta-title">Saatnya mulai: pahami, bukan sekadar hafal</h2>
      <p class="final-cta__lead text-muted">
        Buka peta pembelajaran untuk melihat urutan Matematika dan Matematika Tingkat Lanjut,
        atau langsung uji pemahaman lewat latihan berjenjang.
      </p>
      <div class="final-cta__tags">
        <span class="tag" style="--accent: var(--color-geometry)">Gratis</span>
        <span class="tag" style="--accent: var(--color-algebra)">Tanpa akun</span>
      </div>
    </div>

    <div class="final-cta__actions reveal" data-reveal style="--reveal-delay:80ms">
      <a class="btn btn-primary" href={url('/peta-pembelajaran')}>
        Buka peta pembelajaran <span aria-hidden="true">&rarr;</span>
      </a>
      <a class="btn btn-secondary" href={url('/latihan')}>Coba latihan</a>
    </div>
  </div>
</section>

<style>
  .final-cta__inner {
    position: relative;
    z-index: 1;
  }

  .final-cta__deco {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .final-cta__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: var(--grid-size) var(--grid-size);
    -webkit-mask-image: radial-gradient(ellipse at center, #000 20%, transparent 78%);
    mask-image: radial-gradient(ellipse at center, #000 20%, transparent 78%);
    opacity: 0.7;
  }

  .final-cta__lead {
    max-width: 34rem;
    margin-inline: auto;
  }

  .final-cta__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.6rem;
  }

  .final-cta__chip {
    position: absolute;
    font-family: var(--font-serif);
    font-weight: 700;
    line-height: 1;
    color: var(--color-primary);
    opacity: 0.16;
    user-select: none;
  }
  .final-cta__chip--1 {
    top: 14%;
    left: 6%;
    font-size: 3rem;
    transform: rotate(-8deg);
  }
  .final-cta__chip--2 {
    top: 22%;
    right: 8%;
    font-size: 2.4rem;
    transform: rotate(7deg);
  }
  .final-cta__chip--3 {
    bottom: 18%;
    left: 10%;
    font-size: 2.7rem;
    transform: rotate(6deg);
  }
  .final-cta__chip--4 {
    bottom: 12%;
    right: 12%;
    font-size: 2.9rem;
    transform: rotate(-10deg);
  }
  .final-cta__chip--5 {
    top: 48%;
    left: 3%;
    font-size: 2.2rem;
    transform: rotate(4deg);
  }
  .final-cta__chip--6 {
    top: 44%;
    right: 4%;
    font-size: 2.2rem;
    transform: rotate(-5deg);
  }

  .final-cta__mascot {
    position: absolute;
    right: 4%;
    bottom: 6%;
    width: 4.5rem;
    opacity: 0.92;
  }
  .final-cta__mascot :global(.mascot) {
    max-width: 100%;
  }

  @media (max-width: 40rem) {
    .final-cta__chip {
      display: none;
    }
  }
  @media (max-width: 56rem) {
    .final-cta__mascot {
      display: none;
    }
  }
</style>
