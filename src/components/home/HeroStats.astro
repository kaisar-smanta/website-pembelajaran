---
import { topics } from '@/data/topics';
import { questions } from '@/data/questions';
import { applications } from '@/data/applications';
import { explorations } from '@/data/explorations';

export interface Stat {
  value: number;
  label: string;
}

interface Props {
  stats?: Stat[];
}

const computed: Stat[] = [
  { value: topics.length, label: 'topik materi' },
  { value: questions.length, label: 'soal latihan' },
  { value: applications.length, label: 'studi kasus nyata' },
  { value: explorations.length, label: 'eksplorasi interaktif' },
];

const { stats = computed } = Astro.props;
---

<ul class="stat-strip hero-stat-strip" role="list" aria-label="Ringkasan materi" data-hero-stats>
  {
    stats.map((stat) => (
      <li class="stat">
        <span class="stat-value" data-count={stat.value}>
          {stat.value}
        </span>
        <span class="stat-label">{stat.label}</span>
      </li>
    ))
  }
</ul>

<script>
  import { setupHeroStats } from '@/lib/hero-stats';

  setupHeroStats();
</script>

<style>
  .hero-stat-strip {
    margin-top: 1.2rem;
  }
  .hero-stat-strip .stat-value.is-counted {
    animation: count-pop var(--dur) var(--ease-out-soft) both;
  }
  .hero-stat-strip .stat:nth-child(2) .stat-value.is-counted {
    animation-delay: 60ms;
  }
  .hero-stat-strip .stat:nth-child(3) .stat-value.is-counted {
    animation-delay: 120ms;
  }
  .hero-stat-strip .stat:nth-child(4) .stat-value.is-counted {
    animation-delay: 180ms;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-stat-strip .stat-value.is-counted {
      animation: none;
    }
  }
  @media (max-width: 30rem) {
    .hero-stat-strip {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem 1.25rem;
    }
    .hero-stat-strip .stat {
      min-width: 0;
    }
  }
</style>
