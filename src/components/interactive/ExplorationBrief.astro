---
import type { Exploration } from '@/types/content';
import { renderInlineMarkdown } from '@/utils/markdown';

interface Props {
  exploration: Exploration;
  /** Tampilkan butir kesalahan umum. */
  showCautions?: boolean;
}
const { exploration, showCautions = false } = Astro.props;
const prompts = exploration.prompts;
const steps = prompts
  ? [
      { label: 'Prediksi', text: prompts.predict },
      { label: 'Amati', text: prompts.observe },
      { label: 'Jelaskan', text: prompts.explain },
    ]
  : [];
const hasContent = Boolean(exploration.goal) || steps.length > 0 || (showCautions && exploration.cautions?.length);
---

{
  hasContent && (
    <div class="brief">
      {exploration.goal && (
        <p class="brief-goal">
          <span class="brief-kicker">Misi kamu</span>
          <span set:html={renderInlineMarkdown(exploration.goal)} />
        </p>
      )}
      {steps.length > 0 && (
        <ol class="brief-steps">
          {steps.map((s, i) => (
            <li>
              <span class="brief-num" aria-hidden="true">{i + 1}</span>
              <span class="brief-body">
                <strong>{s.label}.</strong> <span set:html={renderInlineMarkdown(s.text)} />
              </span>
            </li>
          ))}
        </ol>
      )}
      {showCautions && exploration.cautions?.length ? (
        <details class="brief-cautions">
          <summary>Hati-hati, sering keliru</summary>
          <ul>
            {exploration.cautions.map((c) => (
              <li set:html={renderInlineMarkdown(c)} />
            ))}
          </ul>
        </details>
      ) : null}
    </div>
  )
}

<style>
  .brief {
    margin: 0.9rem 0 0.5rem;
    display: grid;
    gap: 0.7rem;
  }
  .brief-goal {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding: 0.7rem 0.9rem;
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 9%, var(--color-surface-2));
    border: 1px solid color-mix(in srgb, var(--accent, var(--color-primary)) 22%, var(--color-border));
    border-left: 4px solid color-mix(in srgb, var(--accent, var(--color-primary)) 80%, transparent);
    border-radius: var(--radius);
    font-size: 0.95rem;
  }
  .brief-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--accent, var(--color-primary)) 74%, var(--color-text));
  }
  .brief-kicker::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 22%, transparent);
  }
  .brief-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .brief-steps li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .brief-num {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 14%, var(--color-surface));
    color: color-mix(in srgb, var(--accent, var(--color-primary)) 72%, var(--color-text));
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
  }
  .brief-body :global(strong) {
    color: var(--color-text);
  }
  .brief-cautions {
    border: 1px solid color-mix(in srgb, var(--color-danger) 28%, var(--color-border));
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--color-danger) 6%, var(--color-surface));
  }
  .brief-cautions > summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.55rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--color-danger) 72%, var(--color-text));
    list-style: none;
  }
  .brief-cautions > summary::-webkit-details-marker {
    display: none;
  }
  .brief-cautions > summary::before {
    content: '';
    flex: none;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--dur) var(--ease-out-soft);
  }
  .brief-cautions[open] > summary::before {
    transform: rotate(45deg);
  }
  .brief-cautions ul {
    margin: 0;
    padding: 0 1rem 0.7rem 2rem;
    display: grid;
    gap: 0.3rem;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
</style>
