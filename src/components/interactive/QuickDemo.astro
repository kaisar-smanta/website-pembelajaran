---
import { getExploration } from '@/data/explorations';
import ExplorationSim from './ExplorationSim.astro';
import ExplorationBrief from './ExplorationBrief.astro';
import MathMascot from '@/components/content/MathMascot.astro';
import { url } from '@/utils/url';

interface Props {
  explorationId?: string;
  title?: string;
  prompt?: string;
}
const { explorationId = 'kuadrat-parameter', title, prompt } = Astro.props;
const exploration = getExploration(explorationId);
---

{
  exploration ? (
    <section class="quick-demo" aria-labelledby="quick-demo-title">
      <div class="quick-demo-head">
        <p class="eyebrow">Coba sekarang</p>
        <span class="quick-demo-live">
          <span class="live-dot" aria-hidden="true" />
          Interaktif
        </span>
      </div>
      <h3 id="quick-demo-title">{title ?? exploration.title}</h3>
      <p class="quick-demo-prompt">
        {prompt ?? 'Geser penggeser dan lihat grafiknya berubah seketika.'}
      </p>
      <ExplorationBrief exploration={exploration} showCautions />
      <ExplorationSim exploration={exploration} />
      <p class="quick-demo-more">
        <a class="btn btn-secondary btn-sm pop-on-hover" href={url('/eksplorasi')}>
          Jelajahi eksplorasi lainnya
        </a>
      </p>
    </section>
  ) : (
    <div class="callout callout-info quick-missing" role="note">
      <MathMascot size={5} state="oops" label="Maskot belum menemukan eksplorasi" />
      <p>Eksplorasi tidak ditemukan: {explorationId}</p>
    </div>
  )
}

<style>
  @keyframes live-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-algebra) 45%, transparent);
    }
    70% {
      box-shadow: 0 0 0 7px transparent;
    }
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .quick-demo {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--color-algebra) 10%, transparent),
        transparent 46%
      ),
      var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: clamp(1rem, 3vw, 1.5rem);
    border-top: 3px solid var(--color-algebra);
  }
  .quick-demo-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }
  .quick-demo-head .eyebrow {
    margin: 0;
    color: var(--color-algebra);
  }
  .quick-demo-live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-algebra);
  }
  .live-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-algebra) 20%, transparent);
    animation: live-pulse 2.4s var(--ease-out-soft) infinite;
  }
  .quick-demo-prompt {
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }
  .quick-demo-more {
    margin: auto 0 0;
  }
  .quick-missing {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1rem;
    text-align: center;
    background: var(--color-info-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .quick-missing p {
    margin: 0;
    color: var(--color-text-muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .live-dot {
      animation: none;
    }
  }
</style>
