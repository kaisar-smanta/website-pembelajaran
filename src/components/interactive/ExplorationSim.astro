---
import type { Exploration, ExplorationType } from '@/types/content';
import FunctionSlider from './FunctionSlider.astro';
import CompoundInterestSim from './CompoundInterestSim.astro';
import ProbabilitySim from './ProbabilitySim.astro';
import LinearRegressionSim from './LinearRegressionSim.astro';
import SequenceExplorer from './SequenceExplorer.astro';
import DistributionExplorer from './DistributionExplorer.astro';
import ConditionalProbSim from './ConditionalProbSim.astro';
import CircleExplorer from './CircleExplorer.astro';
import MatrixExplorer from './MatrixExplorer.astro';
import LinearSystemExplorer from './LinearSystemExplorer.astro';
import FunctionCompositionSim from './FunctionCompositionSim.astro';
import FunctionInverseSim from './FunctionInverseSim.astro';
import GeogebraEmbed from './GeogebraEmbed.astro';

interface Props {
  exploration: Exploration;
}
const { exploration } = Astro.props;

/**
 * Peta jenis eksplorasi ke komponennya. `satisfies Record<ExplorationType, …>`
 * memaksa setiap anggota `ExplorationType` terdaftar, sehingga menambah jenis
 * baru tanpa komponen menjadi galat tipe. Jenis yang belum punya komponen dan
 * `geogebra` diisi `null`.
 */
const SIM_COMPONENTS = {
  'function-slider': FunctionSlider,
  'compound-interest': CompoundInterestSim,
  probability: ProbabilitySim,
  'linear-regression': LinearRegressionSim,
  sequence: SequenceExplorer,
  distribution: DistributionExplorer,
  'conditional-probability': ConditionalProbSim,
  circle: CircleExplorer,
  matrix: MatrixExplorer,
  'linear-system': LinearSystemExplorer,
  'function-composition': FunctionCompositionSim,
  'function-inverse': FunctionInverseSim,
  polynomial: null,
  vector: null,
  conic: null,
  derivative: null,
  integral: null,
  'random-variable': null,
  geogebra: null,
} satisfies Record<ExplorationType, unknown>;

const SimComponent = SIM_COMPONENTS[exploration.type];
---
{
  exploration.type === 'geogebra' && exploration.url ? (
    <GeogebraEmbed url={exploration.url} title={exploration.title} />
  ) : SimComponent ? (
    <SimComponent exploration={exploration} />
  ) : null
}
