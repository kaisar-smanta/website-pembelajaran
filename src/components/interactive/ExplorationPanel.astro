---
import type { Exploration } from '@/types/content';
import ExplorationSim from './ExplorationSim.astro';
import ExplorationBrief from './ExplorationBrief.astro';
import ElementIcon from '@/components/content/ElementIcon.astro';
import { ELEMENTS } from '@/data/curriculum';
import { DIFFICULTY_LABELS, elementColor } from '@/data/display';
import { getTopic, topicSubject } from '@/data/topics';
import { url, topicUrl } from '@/utils/url';

interface Props {
  exploration: Exploration;
  index?: number;
}
const { exploration, index } = Astro.props;

const tags = (exploration.tags ?? []).slice(0, 3);

const element = exploration.element ? ELEMENTS[exploration.element] : undefined;
const accent = elementColor(exploration.element);
const topic = exploration.topicId ? getTopic(exploration.topicId) : undefined;
const topicHref = topic
  ? topicUrl(topic.grade, topic.element, topic.slug, topicSubject(topic))
  : undefined;
---

<article
  class="panel card"
  id={`ex-${exploration.id}`}
  style={`--accent:${accent}`}
  aria-labelledby={`ex-${exploration.id}-title`}
>
  <header class="panel-head">
    <div class="panel-heading">
      {
        index !== undefined && (
          <span class="panel-station">
            <span class="visually-hidden">Stasiun</span>
            <span aria-hidden="true">{index}</span>
          </span>
        )
      }
      {
        exploration.element && element && (
          <span class="icon-tile panel-icon" aria-hidden="true">
            <ElementIcon element={exploration.element} size={22} />
          </span>
        )
      }
      <div class="panel-heading-text">
        <h3 class="panel-title" id={`ex-${exploration.id}-title`}>{exploration.title}</h3>
        <div class="panel-badges">
          {exploration.grade && <span class="chip chip-grade">Kelas {exploration.grade}</span>}
          {element && <span class="chip">{element.short}</span>}
          {exploration.level && (
            <span class="chip chip-level">{DIFFICULTY_LABELS[exploration.level]}</span>
          )}
          {typeof exploration.estimatedMinutes === 'number' && (
            <span class="chip chip-time">±{exploration.estimatedMinutes} menit</span>
          )}
        </div>
      </div>
    </div>
    {topic && topicHref && (
      <a class="panel-topic" href={topicHref}>Materi: {topic.title}</a>
    )}
  </header>

  {
    tags.length > 0 && (
      <ul class="panel-tags" aria-label="Kata kunci">
        {tags.map((tag) => (
          <li class="panel-tag">{tag}</li>
        ))}
      </ul>
    )
  }

  <div class="panel-sim">
    <ExplorationSim exploration={exploration} />
  </div>

  <ExplorationBrief exploration={exploration} showCautions />

  <footer class="panel-foot">
    <button
      type="button"
      class="panel-anchor"
      data-copy-link={`${url('/eksplorasi')}#ex-${exploration.id}`}
      aria-label={`Salin tautan ke ${exploration.title}`}
    >
      Salin tautan
    </button>
    {topic && (
      <a class="panel-practice" href={url(`/latihan/${topic.slug}`)}>Latihan topik ini</a>
    )}
    <a class="panel-detail" href={url(`/eksplorasi/${exploration.id}`)}>Halaman eksplorasi</a>
    <a class="panel-top" href="#daftar-eksplorasi">Kembali ke daftar ↑</a>
  </footer>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    const original = btn.textContent ?? 'Salin tautan';
    btn.addEventListener('click', async () => {
      const value = btn.getAttribute('data-copy-link') ?? '';
      try {
        await navigator.clipboard.writeText(new URL(value, location.href).href);
        btn.textContent = 'Tersalin';
        btn.classList.add('is-copied');
      } catch {
        btn.textContent = 'Gagal menyalin';
      }
      window.setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('is-copied');
      }, 1600);
    });
  });
</script>

<style>
  .panel {
    scroll-margin-top: calc(var(--header-h) + 1rem);
    padding: 1.05rem 1.25rem 1.4rem;
    border-left: 4px solid var(--accent, var(--color-primary));
  }
  .panel-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .panel-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.75rem;
    min-width: 0;
  }
  .panel-station {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 999px;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: color-mix(in srgb, var(--accent, var(--color-primary)) 74%, var(--color-text));
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 13%, var(--color-surface-2));
    border: 1px solid color-mix(in srgb, var(--accent, var(--color-primary)) 30%, var(--color-border));
  }
  .panel-icon {
    flex: none;
  }
  .panel-heading-text {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .panel-title {
    margin: 0;
    font-size: 1.15rem;
  }
  .panel-badges {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: color-mix(in srgb, var(--accent) 70%, var(--color-text));
    background: color-mix(in srgb, var(--accent) 12%, var(--color-surface));
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--color-border));
  }
  .chip-grade {
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border-color: var(--color-border);
  }
  .chip-level {
    color: color-mix(in srgb, var(--color-primary) 72%, var(--color-text));
    background: color-mix(in srgb, var(--color-primary) 9%, var(--color-surface));
    border-color: color-mix(in srgb, var(--color-primary) 26%, var(--color-border));
  }
  .chip-time {
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border-color: var(--color-border);
  }
  .panel-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
  }
  .panel-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }
  .panel-topic {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    padding-block: 0.22rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .panel-topic:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .panel-sim {
    margin-top: 0.9rem;
  }
  .panel-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.1rem;
    margin-top: 0.85rem;
    font-size: 0.84rem;
  }
  .panel-foot a,
  .panel-foot button {
    display: inline-block;
    padding-block: 0.22rem;
    font: inherit;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .panel-foot a:hover,
  .panel-foot button:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .panel-foot button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  .panel-foot .is-copied {
    color: var(--color-success);
  }
  .panel-practice {
    font-weight: 600;
    color: color-mix(in srgb, var(--accent) 72%, var(--color-text)) !important;
  }
  .panel-top {
    margin-left: auto;
  }
  @media print {
    .panel {
      border-left-width: 2px;
    }
  }
</style>
