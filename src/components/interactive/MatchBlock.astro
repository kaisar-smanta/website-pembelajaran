---
import { renderMarkdown, renderInlineMarkdown } from '@/utils/markdown';
import { seededShuffle } from '@/lib/random';
import { url } from '@/utils/url';
import type { Block } from '@/types/content';
import './interactive-frame.css';

interface Props {
  block: Extract<Block, { kind: 'match' }>;
  storageId: string;
}
const { block, storageId } = Astro.props;
const introHtml = block.intro ? renderMarkdown(block.intro) : '';
const leftItems = block.pairs.map((pair, i) => ({ text: pair.left, index: i }));
const rightItems = seededShuffle(
  block.pairs.map((pair, i) => ({ text: pair.right, index: i })),
  storageId,
);
---

<figure class="itx match" data-match data-activity data-storage-id={storageId}>
  <div class="itx-head">
    <span class="itx-kicker">Pasangkan</span>
    <span class="itx-hint">Klik satu kartu kiri, lalu pasangannya di kanan.</span>
  </div>

  {introHtml && <div class="itx-prompt prose" set:html={introHtml} />}

  <div class="match-board">
    <div class="match-col">
      {leftItems.map((item) => (
        <button
          type="button"
          class="match-card"
          data-match-left
          data-index={String(item.index)}
          aria-pressed="false"
        >
          <span class="prose" set:html={renderInlineMarkdown(item.text)} />
        </button>
      ))}
    </div>
    <div class="match-col">
      {rightItems.map((item) => (
        <button
          type="button"
          class="match-card"
          data-match-right
          data-index={String(item.index)}
          aria-pressed="false"
        >
          <span class="prose" set:html={renderInlineMarkdown(item.text)} />
        </button>
      ))}
    </div>
  </div>

  <p class="itx-feedback" data-match-feedback role="status" aria-live="polite">0 dari {block.pairs.length} pasangan cocok.</p>

  <div class="itx-bar">
    <button type="button" class="btn btn-ghost btn-sm" data-match-reset hidden>Ulangi</button>
    <a class="itx-link no-print" href={url('/glosarium')}>Buka glosarium</a>
  </div>
</figure>

<style>
  .match-board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
  }
  .match-col {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .match-card {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: 0.92rem;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out-soft),
      background-color var(--dur-fast) var(--ease-out-soft),
      transform var(--dur-fast) var(--ease-out-soft);
  }
  .match-card:hover:not(:disabled) {
    border-color: var(--accent, var(--color-primary));
  }
  .match-card :global(> .prose > *:last-child),
  .match-card :global(.prose > *:last-child) {
    margin-bottom: 0;
  }
  .match-card.is-selected {
    border-color: var(--accent, var(--color-primary));
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 12%, var(--color-surface));
  }
  .match-card.is-matched {
    border-color: var(--color-success);
    background: var(--color-success-soft);
    cursor: default;
  }
  .match-card.is-wrong {
    border-color: var(--color-danger);
    background: var(--color-danger-soft);
    animation: match-shake 300ms var(--ease-out-soft);
  }
  .match-card.is-matched::after {
    content: ' ✓';
    color: var(--color-success);
    font-weight: 700;
  }
  .match-card.is-wrong::after {
    content: ' ✕';
    color: var(--color-danger);
    font-weight: 700;
  }
  @keyframes match-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-3px); }
    75% { transform: translateX(3px); }
  }
  .itx-feedback {
    margin: 0.85rem 0 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  @media (max-width: 34rem) {
    .match-board {
      gap: 0.5rem;
    }
    .match-card {
      padding: 0.5rem 0.55rem;
      font-size: 0.86rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .match-card.is-wrong {
      animation: none;
    }
  }
</style>

<script>
  import { emitInteraction } from '@/lib/interaction';
  import { clearCompletion, loadCompletions, recordCompletion, saveCompletions } from '@/lib/learner';
  import { safeStorage } from '@/lib/storage';

  function setupMatch(root: Element) {
    const lefts = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-match-left]'));
    const rights = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-match-right]'));
    const feedback = root.querySelector<HTMLElement>('[data-match-feedback]');
    const reset = root.querySelector<HTMLButtonElement>('[data-match-reset]');
    const total = lefts.length;
    if (!total) return;

    const id = root.getAttribute('data-storage-id') ?? '';
    const storage = safeStorage();
    let selected: HTMLButtonElement | null = null;
    const matched = new Set<string>();

    function updateFeedback() {
      if (feedback) {
        let text = `${matched.size} dari ${total} pasangan cocok.`;
        if (matched.size === total) text += ' Selesai! Semua pasangan cocok.';
        feedback.textContent = text;
      }
      if (matched.size === total && reset) reset.hidden = false;
      if (matched.size === total) {
        if (storage) saveCompletions(storage, recordCompletion(loadCompletions(storage), id));
        emitInteraction(id, 'match');
      }
    }

    function clearSelection() {
      if (selected) {
        selected.classList.remove('is-selected');
        selected.setAttribute('aria-pressed', 'false');
        selected = null;
      }
    }

    lefts.forEach((left) => {
      left.addEventListener('click', () => {
        if (left.classList.contains('is-matched')) return;
        if (selected === left) {
          clearSelection();
          return;
        }
        clearSelection();
        selected = left;
        left.classList.add('is-selected');
        left.setAttribute('aria-pressed', 'true');
      });
    });

    rights.forEach((right) => {
      right.addEventListener('click', () => {
        if (!selected || right.classList.contains('is-matched')) return;
        const leftIndex = selected.getAttribute('data-index');
        const rightIndex = right.getAttribute('data-index');
        if (leftIndex === rightIndex) {
          const left = selected;
          left.classList.add('is-matched');
          left.classList.remove('is-selected');
          left.setAttribute('aria-pressed', 'false');
          right.classList.add('is-matched');
          right.setAttribute('aria-pressed', 'false');
          matched.add(leftIndex ?? '');
          left.disabled = true;
          right.disabled = true;
          clearSelection();
          updateFeedback();
          if (feedback && matched.size < total) {
            feedback.textContent = `Tepat! ${matched.size} dari ${total} pasangan cocok.`;
          }
        } else {
          const wrongLeft = selected;
          right.classList.add('is-wrong');
          wrongLeft.classList.add('is-wrong');
          if (feedback) feedback.textContent = 'Pasangan itu belum cocok. Coba lagi.';
          setTimeout(() => {
            right.classList.remove('is-wrong');
            wrongLeft.classList.remove('is-wrong');
          }, 500);
        }
      });
    });

    reset?.addEventListener('click', () => {
      matched.clear();
      clearSelection();
      lefts.concat(rights).forEach((btn) => {
        btn.disabled = false;
        btn.classList.remove('is-matched', 'is-wrong', 'is-selected');
        btn.setAttribute('aria-pressed', 'false');
      });
      if (storage) saveCompletions(storage, clearCompletion(loadCompletions(storage), id));
      emitInteraction(id, 'match-reset');
      if (reset) reset.hidden = true;
      updateFeedback();
    });

    // Pulihkan keadaan selesai agar bilah kemajuan konsisten setelah muat ulang.
    if (storage && loadCompletions(storage)[id]) {
      lefts.forEach((left) => {
        const idx = left.getAttribute('data-index');
        const right = rights.find((r) => r.getAttribute('data-index') === idx);
        left.classList.add('is-matched');
        left.disabled = true;
        left.setAttribute('aria-pressed', 'false');
        if (right) {
          right.classList.add('is-matched');
          right.disabled = true;
          right.setAttribute('aria-pressed', 'false');
        }
        if (idx) matched.add(idx);
      });
    }

    updateFeedback();
  }

  document.querySelectorAll('[data-match]').forEach(setupMatch);
</script>
