---
import { renderMarkdown } from '@/utils/markdown';
import { url } from '@/utils/url';
import type { Block } from '@/types/content';
import './interactive-frame.css';

interface Props {
  block: Extract<Block, { kind: 'flip-cards' }>;
  storageId: string;
}
const { block, storageId } = Astro.props;
const introHtml = block.intro ? renderMarkdown(block.intro) : '';
---

<figure class="itx flip" data-flip data-activity data-storage-id={storageId}>
  <div class="itx-head">
    <span class="itx-kicker">Kartu istilah</span>
    <span class="itx-hint">Klik kartu untuk membalik dan melihat maknanya.</span>
  </div>

  {introHtml && <div class="itx-prompt prose" set:html={introHtml} />}

  <div class="flip-grid">
    {
      block.cards.map((card) => (
        <div class="flip-card">
          <button type="button" class="flip-btn" data-flip-btn aria-pressed="false">
            <span class="visually-hidden">Balik kartu</span>
            <span class="flip-face flip-front prose" set:html={renderMarkdown(card.front)} />
            <span class="flip-face flip-back prose" set:html={renderMarkdown(card.back)} />
          </button>
        </div>
      ))
    }
  </div>

  <p class="visually-hidden" data-flip-status role="status" aria-live="polite" />

  <div class="itx-bar">
    <button type="button" class="btn btn-ghost btn-sm" data-flip-reset>Tutup semua</button>
    <a class="itx-link no-print" href={url('/glosarium')}>Buka glosarium</a>
  </div>
</figure>

<style>
  .flip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.7rem;
  }
  .flip-btn {
    position: relative;
    display: block;
    width: 100%;
    min-height: 7rem;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out-soft),
      background-color var(--dur-fast) var(--ease-out-soft);
  }
  .flip-btn:hover {
    border-color: var(--accent, var(--color-primary));
  }
  .flip-face {
    display: block;
  }
  .flip-face :global(> *:last-child) {
    margin-bottom: 0;
  }
  .flip-front {
    font-weight: 700;
  }
  .flip-back {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--color-border-strong);
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }
  .flip-btn:not([aria-pressed='true']) .flip-back {
    display: none;
  }
  .flip-btn[aria-pressed='true'] {
    border-color: var(--color-success);
    background: var(--color-success-soft);
  }
</style>

<script>
  import { emitInteraction } from '@/lib/interaction';
  import {
    clearCompletion,
    loadCompletions,
    recordCompletion,
    saveCompletions,
  } from '@/lib/learner';
  import { safeStorage } from '@/lib/storage';

  function setupFlip(root: Element) {
    const id = root.getAttribute('data-storage-id') ?? '';
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-flip-btn]'));
    const reset = root.querySelector<HTMLButtonElement>('[data-flip-reset]');
    const status = root.querySelector<HTMLElement>('[data-flip-status]');
    const storage = safeStorage();
    const revealed = new Set<number>();

    function setPressed(index: number, pressed: boolean) {
      const btn = buttons[index];
      if (!btn) return;
      btn.setAttribute('aria-pressed', String(pressed));
      if (pressed) revealed.add(index);
      else revealed.delete(index);
    }

    function complete() {
      if (storage) saveCompletions(storage, recordCompletion(loadCompletions(storage), id));
      if (status) status.textContent = 'Selesai! Semua kartu sudah dibuka.';
    }

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-pressed') === 'true';
        setPressed(i, !open);
        if (!open) {
          if (buttons.length > 0 && revealed.size === buttons.length) complete();
          emitInteraction(id, 'flip');
        }
      });
    });

    reset?.addEventListener('click', () => {
      buttons.forEach((_, i) => setPressed(i, false));
      if (status) status.textContent = '';
      if (storage) saveCompletions(storage, clearCompletion(loadCompletions(storage), id));
      emitInteraction(id, 'flip-reset');
    });

    // Pulihkan keadaan selesai agar bilah kemajuan konsisten setelah muat ulang.
    if (storage && loadCompletions(storage)[id]) {
      buttons.forEach((_, i) => setPressed(i, true));
    }
  }

  document.querySelectorAll('[data-flip]').forEach(setupFlip);
</script>
