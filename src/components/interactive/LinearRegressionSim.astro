---
import './sim.css';
import type { Exploration } from '@/types/content';
import { renderMarkdown } from '@/utils/markdown';

interface Props {
  exploration: Exploration;
}
const { exploration } = Astro.props;

/** Sumber tunggal domain sumbu, dipakai markup dan skrip (lewat data-*). */
const domain = { xMin: -10, xMax: 10, yMin: -10, yMax: 10 };
const helpId = `reg-help-${exploration.id}`;
---

<figure
  class="sim reg-sim"
  data-reg
  data-exploration={exploration.id}
  data-x-min={domain.xMin}
  data-x-max={domain.xMax}
  data-y-min={domain.yMin}
  data-y-max={domain.yMax}
>
  <div class="sim-head">
    <h3>Diagram Pencar &amp; Regresi Linear</h3>
  </div>

  <p class="reg-help" id={helpId}>
    Klik atau ketuk pada bidang untuk menambah titik data, atau isi nilai x dan y pada
    formulir di bawah. Garis regresi, koefisien korelasi, dan koefisien determinasi
    dihitung otomatis menggunakan metode kuadrat terkecil.
  </p>

  <div class="reg-canvas">
    <svg
      viewBox="0 0 480 320"
      role="img"
      aria-label="Diagram pencar titik data dengan garis regresi kuadrat terkecil"
      aria-describedby={helpId}
      data-reg-plot></svg>
  </div>

  <div class="reg-legend" aria-label="Keterangan diagram">
    <span class="reg-legend-item">
      <span class="reg-swatch reg-swatch-line" aria-hidden="true"></span>Garis regresi kuadrat terkecil
    </span>
    <span class="reg-legend-item">
      <span class="reg-swatch reg-swatch-dot" aria-hidden="true"></span>Titik data
    </span>
    <span class="reg-legend-item">
      <span class="reg-swatch reg-swatch-res" aria-hidden="true"></span>Segmen galat (residual)
    </span>
  </div>

  <form class="reg-form" data-reg-form novalidate>
    <label class="reg-field">
      <span>Nilai x</span>
      <input
        type="number"
        min={domain.xMin}
        max={domain.xMax}
        step="0.5"
        value="0"
        inputmode="decimal"
        required
        data-reg-x
      />
    </label>
    <label class="reg-field">
      <span>Nilai y</span>
      <input
        type="number"
        min={domain.yMin}
        max={domain.yMax}
        step="0.5"
        value="0"
        inputmode="decimal"
        required
        data-reg-y
      />
    </label>
    <button type="submit" class="btn btn-secondary btn-sm">Tambah titik</button>
    <p class="reg-msg" data-reg-form-msg aria-live="polite"></p>
  </form>

  <div class="row reg-actions">
    <button type="button" class="btn btn-secondary btn-sm" data-reg-random>Tambah data acak</button>
    <button type="button" class="btn btn-secondary btn-sm" data-reg-remove>Hapus titik terakhir</button>
    <button type="button" class="btn btn-secondary btn-sm" data-reg-clear>Hapus semua titik</button>
    <span class="text-soft" data-reg-count>0 titik</span>
  </div>

  <label class="reg-toggle">
    <input type="checkbox" data-reg-residual />
    <span>Tampilkan galat (residual)</span>
  </label>

  <output class="sim-readout" data-reg-out aria-live="polite" aria-atomic="true"></output>

  <div class="reg-listwrap">
    <h3 class="reg-listtitle">Daftar titik</h3>
    <ul class="reg-list" data-reg-list aria-label="Daftar titik data"></ul>
  </div>

  <figcaption class="sim-caption" set:html={renderMarkdown(exploration.description)} />
</figure>

<style>
  .sim-head h3 {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
  }
  .reg-help {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    margin-top: 0;
  }
  .reg-canvas {
    max-width: 36rem;
    margin-inline: auto;
  }
  .reg-canvas svg {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-surface-2);
    border-radius: var(--radius);
    cursor: crosshair;
    touch-action: pan-y;
  }
  .reg-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    max-width: 36rem;
    margin: 0.5rem auto 0;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
  .reg-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .reg-swatch {
    display: inline-block;
    flex: none;
  }
  .reg-swatch-line {
    width: 1.4rem;
    height: 0;
    border-top: 2.4px solid var(--color-primary);
  }
  .reg-swatch-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--color-data);
  }
  .reg-swatch-res {
    width: 0;
    height: 0.95rem;
    border-left: 1.6px dashed var(--color-danger);
  }
  .reg-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.6rem;
    margin-top: 0.75rem;
  }
  .reg-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .reg-field input {
    width: 6.5rem;
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-weight: 500;
  }
  .reg-msg {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-danger);
  }
  .reg-msg:empty {
    display: none;
  }
  .reg-actions {
    flex-wrap: wrap;
    align-items: center;
    margin-top: 0.6rem;
  }
  .reg-toggle {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.6rem;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
  .reg-toggle input[type='checkbox'] {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    accent-color: var(--color-primary);
  }
  .sim-readout {
    display: block;
    margin-top: 0.75rem;
    padding: 0.5rem 0.7rem;
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
  }
  .reg-listwrap {
    margin-top: 0.75rem;
  }
  .reg-listtitle {
    margin: 0 0 0.4rem;
    font-size: 0.9rem;
  }
  .reg-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }
  .reg-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.3rem 0.2rem 0.6rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
  .reg-item button {
    min-height: 1.6rem;
    padding: 0.1rem 0.5rem;
    font-size: 0.78rem;
  }
  .reg-empty {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  @media (max-width: 420px) {
    .reg-field input {
      width: 100%;
    }
    .reg-field {
      flex: 1 1 7rem;
    }
    .reg-form button {
      flex: 1 1 auto;
    }
  }
</style>

<script>
  import {
    regression,
    generateRandomPoints,
    MAX_POINTS,
    RANDOM_BATCH_SIZE,
    type Domain,
  } from '../../lib/sim/regression';
  import { el, clear, linearScale, initWhenVisible } from '../../lib/dom';
  import { formatFixed } from '../../lib/format';

  interface Pt {
    x: number;
    y: number;
  }

  const MOVE_THRESHOLD_PX = 10;

  function setupReg(root: Element) {
    const svg = root.querySelector('[data-reg-plot]') as SVGSVGElement;
    const out = root.querySelector('[data-reg-out]') as HTMLOutputElement;
    const count = root.querySelector('[data-reg-count]') as HTMLElement;
    const form = root.querySelector('[data-reg-form]') as HTMLFormElement;
    const xInput = root.querySelector('[data-reg-x]') as HTMLInputElement;
    const yInput = root.querySelector('[data-reg-y]') as HTMLInputElement;
    const formMsg = root.querySelector('[data-reg-form-msg]') as HTMLElement;
    const residualToggle = root.querySelector('[data-reg-residual]') as HTMLInputElement;
    const list = root.querySelector('[data-reg-list]') as HTMLUListElement;
    const randomBtn = root.querySelector('[data-reg-random]') as HTMLButtonElement;
    const points: Pt[] = [];

    const domain: Domain = {
      xMin: Number(root.getAttribute('data-x-min') ?? -10),
      xMax: Number(root.getAttribute('data-x-max') ?? 10),
      yMin: Number(root.getAttribute('data-y-min') ?? -10),
      yMax: Number(root.getAttribute('data-y-max') ?? 10),
    };
    const { xMin, xMax, yMin, yMax } = domain;
    const W = 480;
    const H = 320;
    const pad = 34;

    const { sx, sy } = linearScale(domain, { width: W, height: H, pad });
    const ix = (px: number) => xMin + ((px - pad) / (W - 2 * pad)) * (xMax - xMin);
    const iy = (py: number) => yMin + ((H - pad - py) / (H - 2 * pad)) * (yMax - yMin);
    const inDomainX = (v: number) => Number.isFinite(v) && v >= xMin && v <= xMax;
    const inDomainY = (v: number) => Number.isFinite(v) && v >= yMin && v <= yMax;

    function renderList() {
      list.innerHTML = '';
      if (points.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'reg-empty';
        empty.textContent = 'Belum ada titik data. Tambahkan lewat bidang, formulir, atau data acak.';
        list.appendChild(empty);
        return;
      }
      points.forEach((p, i) => {
        const li = document.createElement('li');
        li.className = 'reg-item';
        const label = document.createElement('span');
        label.textContent = `(${formatFixed(p.x, 1)}, ${formatFixed(p.y, 1)})`;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn-secondary btn-sm';
        btn.textContent = 'Hapus';
        btn.setAttribute('aria-label', `Hapus titik (${formatFixed(p.x, 1)}, ${formatFixed(p.y, 1)})`);
        btn.addEventListener('click', () => {
          points.splice(i, 1);
          draw();
        });
        li.append(label, btn);
        list.appendChild(li);
      });
    }

    function draw() {
      clear(svg);

      for (let i = 0; i <= 8; i++) {
        const x = pad + (i / 8) * (W - 2 * pad);
        svg.appendChild(el('line', { x1: x, y1: pad, x2: x, y2: H - pad, stroke: 'var(--color-border)', 'stroke-width': 1 }));
      }
      for (let i = 0; i <= 6; i++) {
        const y = pad + (i / 6) * (H - 2 * pad);
        svg.appendChild(el('line', { x1: pad, y1: y, x2: W - pad, y2: y, stroke: 'var(--color-border)', 'stroke-width': 1 }));
      }
      svg.appendChild(el('line', { x1: sx(0), y1: pad, x2: sx(0), y2: H - pad, stroke: 'var(--color-text-soft)', 'stroke-width': 1.5 }));
      svg.appendChild(el('line', { x1: pad, y1: sy(0), x2: W - pad, y2: sy(0), stroke: 'var(--color-text-soft)', 'stroke-width': 1.5 }));

      const st = regression(points);
      const lineDefined = Number.isFinite(st.slope) && Number.isFinite(st.intercept);

      if (lineDefined) {
        const y1 = st.slope * xMin + st.intercept;
        const y2 = st.slope * xMax + st.intercept;
        svg.appendChild(el('line', {
          x1: sx(xMin),
          y1: sy(y1),
          x2: sx(xMax),
          y2: sy(y2),
          stroke: 'var(--color-primary)',
          'stroke-width': 2.4,
        }));

        if (residualToggle.checked) {
          for (const p of points) {
            const pred = st.slope * p.x + st.intercept;
            svg.appendChild(el('line', {
              x1: sx(p.x),
              y1: sy(p.y),
              x2: sx(p.x),
              y2: sy(pred),
              stroke: 'var(--color-danger)',
              'stroke-width': 1.6,
              'stroke-dasharray': '3 3',
              opacity: 0.85,
            }));
          }
        }
      }

      points.forEach((p) => {
        svg.appendChild(el('circle', { cx: sx(p.x), cy: sy(p.y), r: 4.5, fill: 'var(--color-data)' }));
      });

      count.textContent = `${points.length} / ${MAX_POINTS} titik`;
      randomBtn.disabled = points.length >= MAX_POINTS;
      svg.setAttribute('aria-label', `Diagram pencar dengan ${points.length} titik data dan garis regresi kuadrat terkecil`);

      if (st.diagnostic === 'insufficient') {
        out.textContent = 'Tambahkan minimal dua titik untuk menghitung garis regresi.';
      } else if (st.diagnostic === 'constant-x') {
        out.textContent = 'Nilai x harus beragam: tambahkan titik dengan nilai x berbeda agar garis regresi terdefinisi.';
      } else {
        const arah = st.slope > 0 ? 'positif' : st.slope < 0 ? 'negatif' : 'nol';
        const rTeks = Number.isNaN(st.r) ? '—' : formatFixed(st.r, 3);
        const r2Teks = Number.isNaN(st.r2) ? '—' : formatFixed(st.r2, 3);
        const dasar = `ŷ = ${formatFixed(st.slope, 3)}x ${st.intercept >= 0 ? '+' : '−'} ${formatFixed(Math.abs(st.intercept), 3)} · korelasi r = ${rTeks} · determinasi r² = ${r2Teks} (${arah}).`;
        const catatan = st.diagnostic === 'zero-y-variance'
          ? ' Semua nilai y sama sehingga korelasi tidak terdefinisi.'
          : ` Interpretasi: setiap kenaikan 1 satuan x, y berubah sekitar ${formatFixed(st.slope, 3)} satuan.`;
        out.textContent = dasar + catatan;
      }

      renderList();
    }

    function addPoint(x: number, y: number) {
      if (!inDomainX(x) || !inDomainY(y)) return false;
      if (points.length >= MAX_POINTS) return false;
      points.push({ x, y });
      draw();
      return true;
    }

    function addPointFromEvent(ev: { clientX: number; clientY: number }) {
      const rect = svg.getBoundingClientRect();
      const px = ((ev.clientX - rect.left) / rect.width) * W;
      const py = ((ev.clientY - rect.top) / rect.height) * H;
      const x = Math.max(xMin, Math.min(xMax, ix(px)));
      const y = Math.max(yMin, Math.min(yMax, iy(py)));
      addPoint(x, y);
    }

    let press: { x: number; y: number; id: number; moved: boolean } | null = null;

    svg.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      press = { x: e.clientX, y: e.clientY, id: e.pointerId, moved: false };
    });
    svg.addEventListener('pointermove', (e) => {
      if (!press || e.pointerId !== press.id) return;
      if (Math.hypot(e.clientX - press.x, e.clientY - press.y) > MOVE_THRESHOLD_PX) {
        press.moved = true;
      }
    });
    svg.addEventListener('pointercancel', () => {
      press = null;
    });
    svg.addEventListener('pointerup', (e) => {
      const p = press;
      press = null;
      if (!p || e.pointerId !== p.id || p.moved || e.button !== 0) return;
      addPointFromEvent(e);
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (points.length >= MAX_POINTS) {
        formMsg.textContent = `Maksimum ${MAX_POINTS} titik data tercapai. Hapus beberapa titik untuk menambah.`;
        return;
      }
      const x = Number(xInput.value);
      const y = Number(yInput.value);
      if (xInput.value.trim() === '' || yInput.value.trim() === '' || !inDomainX(x) || !inDomainY(y)) {
        formMsg.textContent = `Masukkan nilai x dan y berupa angka antara ${xMin} dan ${xMax}.`;
        return;
      }
      formMsg.textContent = '';
      addPoint(x, y);
      xInput.value = '';
      yInput.value = '';
      xInput.focus();
    });

    residualToggle.addEventListener('change', draw);

    root.querySelector('[data-reg-remove]')?.addEventListener('click', () => {
      points.pop();
      draw();
    });

    root.querySelector('[data-reg-clear]')?.addEventListener('click', () => {
      points.length = 0;
      draw();
    });

    randomBtn.addEventListener('click', () => {
      const room = MAX_POINTS - points.length;
      if (room <= 0) {
        formMsg.textContent = `Maksimum ${MAX_POINTS} titik data sudah tercapai.`;
        return;
      }
      const batch = Math.min(RANDOM_BATCH_SIZE, room);
      for (const p of generateRandomPoints(batch, domain)) points.push(p);
      draw();
    });

    draw();
  }

  initWhenVisible(document.querySelectorAll('[data-reg]'), setupReg);
</script>
