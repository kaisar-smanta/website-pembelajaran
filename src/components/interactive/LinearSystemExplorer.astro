---
import './sim.css';
import type { Exploration } from '@/types/content';
import { renderMarkdown } from '@/utils/markdown';

interface Props {
  exploration: Exploration;
}
const { exploration } = Astro.props;

const paramValue = (name: string, fallback: number): number => {
  const found = exploration.params?.find((p) => p.name === name);
  return found && Number.isFinite(found.value) ? found.value : fallback;
};

const a1 = paramValue('a1', 1);
const b1 = paramValue('b1', 1);
const c1 = paramValue('c1', 4);
const a2 = paramValue('a2', 1);
const b2 = paramValue('b2', -1);
const c2 = paramValue('c2', 0);
const initialAria = `Grafik dua garis dari sistem persamaan linear ${a1}x + ${b1}y = ${c1} dan ${a2}x + ${b2}y = ${c2}`;
---

<figure
  class="sim linear-system-sim"
  data-linear-system
  data-exploration={exploration.id}
  data-exploration-type={exploration.type}
>
  <p class="sim-hint">
    Ubah koefisien kedua persamaan. Amati kapan garis berpotongan di satu titik, sejajar, atau
    berimpit.
  </p>

  <div class="sim-fields">
    <label class="sim-field">
      <span>a₁ (koefisien x, pers. 1)</span>
      <input type="number" step="1" value={a1} data-field="a1" />
    </label>
    <label class="sim-field">
      <span>b₁ (koefisien y, pers. 1)</span>
      <input type="number" step="1" value={b1} data-field="b1" />
    </label>
    <label class="sim-field">
      <span>c₁ (konstanta pers. 1)</span>
      <input type="number" step="1" value={c1} data-field="c1" />
    </label>
    <label class="sim-field">
      <span>a₂ (koefisien x, pers. 2)</span>
      <input type="number" step="1" value={a2} data-field="a2" />
    </label>
    <label class="sim-field">
      <span>b₂ (koefisien y, pers. 2)</span>
      <input type="number" step="1" value={b2} data-field="b2" />
    </label>
    <label class="sim-field">
      <span>c₂ (konstanta pers. 2)</span>
      <input type="number" step="1" value={c2} data-field="c2" />
    </label>
  </div>

  <div class="sim-actions">
    <button type="button" class="btn btn-secondary btn-sm" data-linear-system-reset>Atur ulang</button>
  </div>

  <div class="sim-chart">
    <svg
      viewBox="0 0 480 360"
      role="img"
      aria-label={initialAria}
      data-chart></svg>
    <div class="legend sim-legend">
      <span class="l1">Garis 1</span>
      <span class="l2">Garis 2</span>
    </div>
  </div>

  <output class="sim-readout" data-readout aria-live="polite" aria-atomic="true"></output>

  <figcaption class="sim-caption" set:html={renderMarkdown(exploration.description)} />
</figure>

<style>
  .sim-hint {
    margin: 0 0 0.85rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .sim-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 0.75rem;
  }
  .sim-field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .sim-field input {
    padding: 0.45rem 0.55rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-weight: 500;
  }
  .sim-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }
  .sim-chart {
    max-width: 34rem;
    margin: 0.85rem auto 0;
  }
  .sim-chart svg {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-surface-2);
    border-radius: var(--radius);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0.4rem 0 0;
  }
  .legend .l1 {
    color: var(--color-primary);
  }
  .legend .l2 {
    color: var(--color-data);
  }
  .sim-readout {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.85rem;
  }
  .sim-readout :global(.sim-note) {
    margin: 0;
    padding: 0.5rem 0.7rem;
    border-left: 0.2rem solid var(--color-primary);
    background: color-mix(in srgb, var(--color-surface-2) 70%, transparent);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .linear-system-sim svg :global(*) {
    transition: opacity var(--dur) var(--ease-out-soft);
  }
  @media (max-width: 390px) {
    .sim-fields {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .linear-system-sim svg :global(*) {
      transition: none;
    }
  }
</style>

<script>
  import { solve2x2, lineYAt, lineXAt } from '../../lib/sim/linear-system';
  import { el, clear, linearScale } from '../../lib/dom';

  function setupLinearSystem(root: Element) {
    const inA1 = root.querySelector('[data-field="a1"]') as HTMLInputElement;
    const inB1 = root.querySelector('[data-field="b1"]') as HTMLInputElement;
    const inC1 = root.querySelector('[data-field="c1"]') as HTMLInputElement;
    const inA2 = root.querySelector('[data-field="a2"]') as HTMLInputElement;
    const inB2 = root.querySelector('[data-field="b2"]') as HTMLInputElement;
    const inC2 = root.querySelector('[data-field="c2"]') as HTMLInputElement;
    const readout = root.querySelector('[data-readout]') as HTMLOutputElement;
    const svg = root.querySelector('[data-chart]') as SVGSVGElement;
    const reset = root.querySelector('[data-linear-system-reset]') as HTMLButtonElement;

    const fmt = (v: number) =>
      new Intl.NumberFormat('id-ID', { maximumFractionDigits: 3 }).format(v);

    const W = 480;
    const H = 360;
    const pad = 36;
    const xMin = -10;
    const xMax = 10;
    const yMin = -10;
    const yMax = 10;
    const { sx, sy } = linearScale(
      { xMin, xMax, yMin, yMax },
      { width: W, height: H, pad },
    );

    const readValue = (input: HTMLInputElement, fallback: number): number => {
      const v = Number(input.value);
      return Number.isFinite(v) ? v : fallback;
    };

    function drawLine(a: number, b: number, c: number, color: string) {
      const hasB = Math.abs(b) > 1e-9;
      const hasA = Math.abs(a) > 1e-9;
      let x1: number;
      let y1: number;
      let x2: number;
      let y2: number;
      if (hasB) {
        x1 = xMin;
        y1 = lineYAt(a, b, c, xMin);
        x2 = xMax;
        y2 = lineYAt(a, b, c, xMax);
      } else if (hasA) {
        const xv = lineXAt(a, b, c, 0);
        x1 = xv;
        y1 = yMin;
        x2 = xv;
        y2 = yMax;
      } else {
        return;
      }
      svg.appendChild(
        el('line', {
          x1: sx(x1),
          y1: sy(y1),
          x2: sx(x2),
          y2: sy(y2),
          stroke: color,
          'stroke-width': 2.6,
          'stroke-linecap': 'round',
        }),
      );
    }

    function draw(a1: number, b1: number, c1: number, a2: number, b2: number, c2: number, sol: ReturnType<typeof solve2x2>) {
      clear(svg);

      for (let g = xMin; g <= xMax; g += 2) {
        svg.appendChild(
          el('line', { x1: sx(g), y1: sy(yMin), x2: sx(g), y2: sy(yMax), stroke: 'var(--color-border)', 'stroke-width': 1 }),
        );
      }
      for (let g = yMin; g <= yMax; g += 2) {
        svg.appendChild(
          el('line', { x1: sx(xMin), y1: sy(g), x2: sx(xMax), y2: sy(g), stroke: 'var(--color-border)', 'stroke-width': 1 }),
        );
      }

      svg.appendChild(el('line', { x1: sx(xMin), y1: sy(0), x2: sx(xMax), y2: sy(0), stroke: 'var(--color-text-soft)', 'stroke-width': 1.4 }));
      svg.appendChild(el('line', { x1: sx(0), y1: sy(yMin), x2: sx(0), y2: sy(yMax), stroke: 'var(--color-text-soft)', 'stroke-width': 1.4 }));

      drawLine(a1, b1, c1, 'var(--color-primary)');
      drawLine(a2, b2, c2, 'var(--color-data)');

      if (sol.kind === 'unique' && sol.x !== undefined && sol.y !== undefined) {
        if (sol.x >= xMin && sol.x <= xMax && sol.y >= yMin && sol.y <= yMax) {
          svg.appendChild(el('circle', { cx: sx(sol.x), cy: sy(sol.y), r: 5, fill: 'var(--color-warning)' }));
          const label = el('text', {
            x: Math.min(sx(sol.x) + 9, W - 92),
            y: sy(sol.y) - 9,
            fill: 'var(--color-text)',
            'font-size': 13,
            'font-weight': 600,
          });
          label.textContent = `(${fmt(sol.x)}, ${fmt(sol.y)})`;
          svg.appendChild(label);
        }
      }
    }

    function render() {
      const a1 = readValue(inA1, 1);
      const b1 = readValue(inB1, 1);
      const c1 = readValue(inC1, 4);
      const a2 = readValue(inA2, 1);
      const b2 = readValue(inB2, -1);
      const c2 = readValue(inC2, 0);

      const sol = solve2x2(a1, b1, c1, a2, b2, c2);
      const kindLabel =
        sol.kind === 'unique'
          ? 'Satu solusi'
          : sol.kind === 'infinite'
            ? 'Tak hingga solusi'
            : 'Tidak ada solusi';

      let note: string;
      if (sol.kind === 'unique') {
        note = 'Kedua garis berpotongan tepat di satu titik, sehingga sistem konsisten dan memiliki solusi tunggal.';
      } else if (sol.kind === 'infinite') {
        note = 'Determinan nol dan kedua garis berimpit, sehingga setiap titik pada garis adalah solusi.';
      } else {
        note = 'Determinan nol dan kedua garis sejajar (tidak berimpit), sehingga tidak ada titik yang memenuhi kedua persamaan.';
      }

      let html =
        `<div class="stat"><span>Banyak solusi</span><strong>${kindLabel}</strong></div>` +
        `<div class="stat"><span>Determinan det = a₁b₂ − a₂b₁</span><strong>${fmt(sol.det)}</strong></div>`;
      if (sol.kind === 'unique' && sol.x !== undefined && sol.y !== undefined) {
        html += `<div class="stat"><span>Penyelesaian (x, y)</span><strong>x = ${fmt(sol.x)}, y = ${fmt(sol.y)}</strong></div>`;
      }
      html += `<p class="sim-note">${note}</p>`;
      readout.innerHTML = html;

      const pointText =
        sol.kind === 'unique' && sol.x !== undefined && sol.y !== undefined
          ? `, titik potong (${fmt(sol.x)}, ${fmt(sol.y)})`
          : '';
      svg.setAttribute(
        'aria-label',
        `Grafik dua garis sistem persamaan linear. ${kindLabel}${pointText}.`,
      );

      draw(a1, b1, c1, a2, b2, c2, sol);
    }

    function resetInputs() {
      [inA1, inB1, inC1, inA2, inB2, inC2].forEach((input) => {
        input.value = input.defaultValue;
      });
      render();
    }

    [inA1, inB1, inC1, inA2, inB2, inC2].forEach((input) => input.addEventListener('input', render));
    reset.addEventListener('click', resetInputs);
    render();
  }

  document.querySelectorAll('[data-linear-system]').forEach(setupLinearSystem);
</script>
