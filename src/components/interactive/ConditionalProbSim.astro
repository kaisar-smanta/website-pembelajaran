---
import './sim.css';
import type { Exploration } from '@/types/content';
import { renderMarkdown } from '@/utils/markdown';

interface Props {
  exploration: Exploration;
}
const { exploration } = Astro.props;
const uid = exploration.id;
---

<figure class="sim cond-sim" data-condsim data-exploration={exploration.id}>
  <div class="sim-head">
    <h3>Simulasi Peluang Bersyarat</h3>
  </div>

  <div class="sim-fields">
    <div class="sim-field">
      <div class="sim-field-head">
        <label for={`${uid}-a`}>Peluang kejadian A, P(A)</label>
        <output class="sim-num" for={`${uid}-a`} data-out="a"></output>
      </div>
      <input
        id={`${uid}-a`}
        type="range"
        min="0"
        max="1"
        step="0.01"
        value="0.5"
        data-field="a"
        aria-label="Peluang kejadian A"
        aria-describedby={`${uid}-readout`}
      />
    </div>

    <div class="sim-field">
      <div class="sim-field-head">
        <label for={`${uid}-ba`}>Peluang B jika A terjadi, P(B|A)</label>
        <output class="sim-num" for={`${uid}-ba`} data-out="ba"></output>
      </div>
      <input
        id={`${uid}-ba`}
        type="range"
        min="0"
        max="1"
        step="0.01"
        value="0.5"
        data-field="ba"
        aria-label="Peluang B terjadi dengan syarat A terjadi"
        aria-describedby={`${uid}-readout`}
      />
    </div>

    <div class="sim-field">
      <div class="sim-field-head">
        <label for={`${uid}-bac`}>Peluang B jika A komplemen, P(B|A<sup>c</sup>)</label>
        <output class="sim-num" for={`${uid}-bac`} data-out="bac"></output>
      </div>
      <input
        id={`${uid}-bac`}
        type="range"
        min="0"
        max="1"
        step="0.01"
        value="0.5"
        data-field="bac"
        aria-label="Peluang B terjadi dengan syarat A komplemen terjadi"
        aria-describedby={`${uid}-readout`}
      />
    </div>
  </div>

  <div class="sim-actions">
    <button type="button" class="btn btn-secondary btn-sm" data-cond-reset>Atur ulang</button>
  </div>

  <div class="sim-summary">
    <div class="stat"><span>P(A &cap; B)</span><strong data-out="pAB"></strong></div>
    <div class="stat"><span>P(A<sup>c</sup> &cap; B)</span><strong data-out="pAcB"></strong></div>
    <div class="stat"><span>P(B)</span><strong data-out="pB"></strong></div>
  </div>

  <div class="table-scroll">
    <table class="cond-table">
      <caption>Tabel dua arah peluang kejadian A dan B</caption>
      <thead>
        <tr>
          <th scope="col">Kejadian</th>
          <th scope="col">B</th>
          <th scope="col">B<sup>c</sup></th>
          <th scope="col">Total</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">A</th>
          <td data-cell="aB"></td>
          <td data-cell="aBc"></td>
          <td data-cell="aTotal"></td>
        </tr>
        <tr>
          <th scope="row">A<sup>c</sup></th>
          <td data-cell="acB"></td>
          <td data-cell="acBc"></td>
          <td data-cell="acTotal"></td>
        </tr>
        <tr class="total-row">
          <th scope="row">Total</th>
          <td data-cell="bTotal"></td>
          <td data-cell="bcTotal"></td>
          <td data-cell="grandTotal"></td>
        </tr>
      </tbody>
    </table>
  </div>

  <div class="cond-compare">
    <div class="cond-card">
      <span class="cond-card-label">P(A|B)</span>
      <strong data-out="aGivenB"></strong>
      <span class="cond-card-note">peluang A jika B sudah terjadi</span>
    </div>
    <div class="cond-card is-b">
      <span class="cond-card-label">P(B|A)</span>
      <strong data-out="bGivenA"></strong>
      <span class="cond-card-note">peluang B jika A sudah terjadi</span>
    </div>
  </div>

  <p class="cond-verdict" data-out="verdict"></p>

  <div class="cond-bayes">
    <p class="cond-bayes-title">Rumus Bayes</p>
    <p class="cond-bayes-eq" data-out="bayes"></p>
  </div>

  <p
    id={`${uid}-readout`}
    class="sim-readout"
    data-out="readout"
    aria-live="polite"
    aria-atomic="true"
  ></p>

  <figcaption class="sim-caption" set:html={renderMarkdown(exploration.description)} />
</figure>

<style>
  .sim-head h3 {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
  }
  .sim-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0.75rem;
  }
  .sim-field {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .sim-field-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .sim-field-head label {
    cursor: pointer;
  }
  .sim-num {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-primary);
    white-space: nowrap;
  }
  .sim-field input[type='range'] {
    width: 100%;
    margin: 0.15rem 0 0;
    accent-color: var(--color-primary);
    cursor: pointer;
  }
  .sim-actions {
    margin-top: 0.65rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sim-summary {
    margin: 0.85rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: 0.4rem;
  }
  .sim-summary .stat {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0.7rem;
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    font-size: 0.92rem;
  }
  .sim-summary .stat strong {
    font-family: var(--font-mono);
    color: var(--color-primary);
  }
  .table-scroll {
    overflow-x: auto;
    margin-top: 0.5rem;
  }
  table.cond-table {
    width: 100%;
    min-width: 20rem;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  table.cond-table caption {
    text-align: left;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding-bottom: 0.35rem;
  }
  table.cond-table th,
  table.cond-table td {
    border: 1px solid var(--color-border);
    padding: 0.4rem 0.6rem;
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  table.cond-table thead th,
  table.cond-table tbody th {
    background: var(--color-surface-2);
    font-weight: 700;
  }
  table.cond-table th:first-child {
    text-align: left;
  }
  table.cond-table tr td:last-child,
  table.cond-table tr th:last-child {
    background: color-mix(in srgb, var(--color-surface-2) 70%, transparent);
  }
  table.cond-table tr.total-row th,
  table.cond-table tr.total-row td {
    border-top: 2px solid var(--color-border-strong);
  }
  .cond-compare {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: 0.6rem;
    margin: 0.9rem 0 0;
  }
  .cond-card {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.75rem;
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius);
  }
  .cond-card.is-b {
    border-left-color: var(--color-data);
  }
  .cond-card-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }
  .cond-card strong {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    color: var(--color-primary);
    transition: color var(--dur) var(--ease-out-soft);
  }
  .cond-card.is-b strong {
    color: var(--color-data);
  }
  .cond-card-note {
    font-size: 0.78rem;
    color: var(--color-text-soft);
  }
  .cond-verdict {
    margin: 0.6rem 0 0;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
  .cond-bayes {
    margin-top: 0.85rem;
    padding: 0.65rem 0.8rem;
    background: color-mix(in srgb, var(--color-primary) 8%, var(--color-surface));
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .cond-bayes-title {
    margin: 0 0 0.25rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .cond-bayes-eq {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text);
    overflow-x: auto;
    white-space: nowrap;
  }
  .sim-readout {
    margin: 0.85rem 0 0;
    padding: 0.55rem 0.8rem;
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--color-text);
    transition: background var(--dur) var(--ease-out-soft);
  }
  @media (max-width: 430px) {
    .sim {
      padding: 0.8rem;
    }
    .sim-fields {
      gap: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cond-card strong,
    .sim-readout {
      transition: none;
    }
  }
</style>

<script>
  import { computeConditional } from '../../lib/sim/conditional';
  import { formatPercent } from '../../lib/format';
  import { initWhenVisible } from '../../lib/dom';

  const DEFAULTS = { a: '0.5', ba: '0.5', bac: '0.5' };

  function setupConditional(root: Element) {
    const fieldA = root.querySelector('[data-field="a"]') as HTMLInputElement;
    const fieldBA = root.querySelector('[data-field="ba"]') as HTMLInputElement;
    const fieldBAc = root.querySelector('[data-field="bac"]') as HTMLInputElement;
    const reset = root.querySelector('[data-cond-reset]') as HTMLButtonElement | null;

    const outA = root.querySelector('[data-out="a"]') as HTMLOutputElement;
    const outBA = root.querySelector('[data-out="ba"]') as HTMLOutputElement;
    const outBAc = root.querySelector('[data-out="bac"]') as HTMLOutputElement;
    const outPAB = root.querySelector('[data-out="pAB"]') as HTMLElement;
    const outPAcB = root.querySelector('[data-out="pAcB"]') as HTMLElement;
    const outPB = root.querySelector('[data-out="pB"]') as HTMLElement;
    const outAGivenB = root.querySelector('[data-out="aGivenB"]') as HTMLElement;
    const outBGivenA = root.querySelector('[data-out="bGivenA"]') as HTMLElement;
    const outVerdict = root.querySelector('[data-out="verdict"]') as HTMLElement;
    const outBayes = root.querySelector('[data-out="bayes"]') as HTMLElement;
    const outReadout = root.querySelector('[data-out="readout"]') as HTMLElement;

    const cellAB = root.querySelector('[data-cell="aB"]') as HTMLTableCellElement;
    const cellABc = root.querySelector('[data-cell="aBc"]') as HTMLTableCellElement;
    const cellATotal = root.querySelector('[data-cell="aTotal"]') as HTMLTableCellElement;
    const cellAcB = root.querySelector('[data-cell="acB"]') as HTMLTableCellElement;
    const cellAcBc = root.querySelector('[data-cell="acBc"]') as HTMLTableCellElement;
    const cellAcTotal = root.querySelector('[data-cell="acTotal"]') as HTMLTableCellElement;
    const cellBTotal = root.querySelector('[data-cell="bTotal"]') as HTMLTableCellElement;
    const cellBcTotal = root.querySelector('[data-cell="bcTotal"]') as HTMLTableCellElement;
    const cellGrand = root.querySelector('[data-cell="grandTotal"]') as HTMLTableCellElement;

    function render() {
      const { pA, pBA, pBAc, pAc, pAB, pAcB, pB, pBc, pABc, pAcBc, pAGivenB, pBGivenA, verdict } =
        computeConditional(Number(fieldA.value), Number(fieldBA.value), Number(fieldBAc.value));

      outA.textContent = formatPercent(pA);
      outBA.textContent = formatPercent(pBA);
      outBAc.textContent = formatPercent(pBAc);

      outPAB.textContent = formatPercent(pAB);
      outPAcB.textContent = formatPercent(pAcB);
      outPB.textContent = formatPercent(pB);

      cellAB.textContent = formatPercent(pAB);
      cellABc.textContent = formatPercent(pABc);
      cellATotal.textContent = formatPercent(pA);
      cellAcB.textContent = formatPercent(pAcB);
      cellAcBc.textContent = formatPercent(pAcBc);
      cellAcTotal.textContent = formatPercent(pAc);
      cellBTotal.textContent = formatPercent(pB);
      cellBcTotal.textContent = formatPercent(pBc);
      cellGrand.textContent = formatPercent(1);

      outBGivenA.textContent = formatPercent(pBGivenA);
      outAGivenB.textContent = pAGivenB === undefined ? 'tidak terdefinisi' : formatPercent(pAGivenB);

      if (verdict === 'undefined') {
        outVerdict.textContent =
          'P(A|B) tidak dapat dihitung karena P(B) = 0. Geser slider hingga P(B) > 0 untuk menghitungnya.';
      } else if (verdict === 'similar') {
        outVerdict.textContent = `Pada nilai ini P(A|B) dan P(B|A) hampir sama, yaitu sekitar ${formatPercent(pAGivenB ?? 0)}. Ubah slider untuk melihat bahwa keduanya dapat berbeda.`;
      } else {
        outVerdict.textContent = `P(A|B) = ${formatPercent(pAGivenB ?? 0)} sedangkan P(B|A) = ${formatPercent(pBA)}. Keduanya berbeda, jadi arah syarat pada peluang bersyarat sangat menentukan.`;
      }

      if (pAGivenB === undefined) {
        outBayes.textContent = `P(A|B) = P(A) × P(B|A) / P(B) = (${formatPercent(pA)} × ${formatPercent(pBA)}) / ${formatPercent(pB)} tidak terdefinisi karena P(B) = 0`;
      } else {
        outBayes.textContent = `P(A|B) = P(A) × P(B|A) / P(B) = (${formatPercent(pA)} × ${formatPercent(pBA)}) / ${formatPercent(pB)} = ${formatPercent(pAGivenB)}`;
      }

      if (pAGivenB === undefined) {
        outReadout.textContent = `Dengan P(A) = ${formatPercent(pA)}, P(B|A) = ${formatPercent(pBA)}, dan P(B|A komplemen) = ${formatPercent(pBAc)}, diperoleh P(B) = ${formatPercent(pB)} sehingga P(A|B) tidak terdefinisi. Naikkan P(B|A) atau P(B|A komplemen) agar B mungkin terjadi.`;
      } else {
        outReadout.textContent = `Dengan P(A) = ${formatPercent(pA)}, P(B|A) = ${formatPercent(pBA)}, dan P(B|A komplemen) = ${formatPercent(pBAc)}, diperoleh P(B) = ${formatPercent(pB)} sehingga P(A|B) = ${formatPercent(pAGivenB)}, sedangkan P(B|A) = ${formatPercent(pBA)} (${verdict === 'similar' ? 'hampir sama' : 'berbeda'}).`;
      }
    }

    [fieldA, fieldBA, fieldBAc].forEach((input) => input.addEventListener('input', render));

    reset?.addEventListener('click', () => {
      fieldA.value = DEFAULTS.a;
      fieldBA.value = DEFAULTS.ba;
      fieldBAc.value = DEFAULTS.bac;
      render();
      fieldA.focus();
    });

    render();
  }

  initWhenVisible(document.querySelectorAll('[data-condsim]'), setupConditional);
</script>
