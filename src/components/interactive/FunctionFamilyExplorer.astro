---
import './sim.css';
import type { Exploration } from '@/types/content';
import { renderMarkdown } from '@/utils/markdown';

interface Props {
  exploration: Exploration;
}
const { exploration } = Astro.props;
---

<figure class="sim ff-sim" data-function-family data-exploration={exploration.id}>
  <div class="sim-head">
    <h3>Keluarga Fungsi Rasional: Lubang dan Asimtot</h3>
  </div>

  <p
    class="sim-hint"
    set:html={renderMarkdown(
      'Geser $a$ dan $b$ pada $f(x)=\\dfrac{x^{2}-a^{2}}{(x-a)(x-b)}$. Cari titik **lubang** (diskontinuitas terhapus) dan **asimtot tegak** di $x=b$.',
    )}
  />

  <div class="sim-fields">
    <label class="sim-field">
      <span>Parameter a <output data-ff-value="a">2</output></span>
      <input type="range" min="-4" max="4" step="1" value="2" data-ff-field="a" aria-label="Parameter a" />
    </label>
    <label class="sim-field">
      <span>Parameter b <output data-ff-value="b">3</output></span>
      <input type="range" min="-4" max="4" step="1" value="3" data-ff-field="b" aria-label="Parameter b" />
    </label>
  </div>

  <div class="sim-actions">
    <button type="button" class="btn btn-secondary btn-sm" data-ff-reset>Atur ulang</button>
  </div>

  <div class="sim-chart">
    <svg
      viewBox="0 0 480 340"
      role="img"
      aria-label="Grafik fungsi rasional dengan penanda lubang dan asimtot"
      data-ff-plot></svg>
    <div class="sim-legend" aria-hidden="true">
      <span class="l1">f(x)</span>
      <span class="l2">asimtot</span>
      <span class="l3">lubang</span>
    </div>
  </div>

  <output class="sim-readout" data-ff-readout aria-live="polite" aria-atomic="true"></output>

  <figcaption class="sim-caption" set:html={renderMarkdown(exploration.description)} />
</figure>

<style>
  .sim-fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0.75rem;
  }
  .sim-actions {
    margin-top: 0.7rem;
  }
  .sim-chart {
    max-width: 34rem;
    margin: 0.85rem auto 0;
  }
  .sim-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0.4rem 0 0;
  }
  .sim-legend .l1 {
    color: var(--color-primary);
  }
  .sim-legend .l2 {
    color: var(--color-warning);
  }
  .sim-legend .l3 {
    color: var(--color-data);
  }
  .sim-readout :global(.stat) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0.7rem;
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
  }
  .sim-readout :global(.stat strong) {
    font-family: var(--font-mono);
    color: var(--color-primary);
    text-align: right;
    overflow-wrap: anywhere;
  }
</style>

<script>
  import {
    evaluate,
    analyze,
    sampleFunctionFamily,
    describeFunctionFamily,
  } from '../../lib/sim/function-family';
  import { el, clear, linearScale, polyline, initWhenVisible } from '../../lib/dom';
  import { formatPlain } from '../../lib/format';

  function setupFunctionFamily(root: Element) {
    const aInput = root.querySelector('[data-ff-field="a"]') as HTMLInputElement;
    const bInput = root.querySelector('[data-ff-field="b"]') as HTMLInputElement;
    const aOutput = root.querySelector('[data-ff-value="a"]') as HTMLOutputElement;
    const bOutput = root.querySelector('[data-ff-value="b"]') as HTMLOutputElement;
    const svg = root.querySelector('[data-ff-plot]') as SVGSVGElement;
    const readout = root.querySelector('[data-ff-readout]') as HTMLElement;
    const reset = root.querySelector('[data-ff-reset]') as HTMLButtonElement;

    const X_MIN = -6;
    const X_MAX = 6;
    const Y_MIN = -6;
    const Y_MAX = 6;
    const W = 480;
    const H = 340;
    const pad = 34;

    const { sx, sy } = linearScale(
      { xMin: X_MIN, xMax: X_MAX, yMin: Y_MIN, yMax: Y_MAX },
      { width: W, height: H, pad },
    );

    function drawGrid() {
      for (let i = 0; i <= 6; i++) {
        const x = pad + (i / 6) * (W - 2 * pad);
        const y = pad + (i / 6) * (H - 2 * pad);
        svg.appendChild(el('line', { x1: x, y1: pad, x2: x, y2: H - pad, stroke: 'var(--color-border)', 'stroke-width': 1 }));
        svg.appendChild(el('line', { x1: pad, y1: y, x2: W - pad, y2: y, stroke: 'var(--color-border)', 'stroke-width': 1 }));
      }
      svg.appendChild(el('line', { x1: pad, y1: sy(0), x2: W - pad, y2: sy(0), stroke: 'var(--color-text-soft)', 'stroke-width': 1.6 }));
      svg.appendChild(el('line', { x1: sx(0), y1: pad, x2: sx(0), y2: H - pad, stroke: 'var(--color-text-soft)', 'stroke-width': 1.6 }));
    }

    function draw(a: number, b: number) {
      clear(svg);
      drawGrid();

      const info = analyze(a, b);

      // Asimtot tegak.
      if (info.verticalAsymptote !== null && info.verticalAsymptote >= X_MIN && info.verticalAsymptote <= X_MAX) {
        svg.appendChild(
          el('line', {
            x1: sx(info.verticalAsymptote),
            y1: pad,
            x2: sx(info.verticalAsymptote),
            y2: H - pad,
            stroke: 'var(--color-warning)',
            'stroke-width': 1.6,
            'stroke-dasharray': '6 4',
          }),
        );
      }
      // Asimtot datar y = 1.
      if (info.horizontalAsymptote >= Y_MIN && info.horizontalAsymptote <= Y_MAX) {
        svg.appendChild(
          el('line', {
            x1: pad,
            y1: sy(info.horizontalAsymptote),
            x2: W - pad,
            y2: sy(info.horizontalAsymptote),
            stroke: 'var(--color-warning)',
            'stroke-width': 1.6,
            'stroke-dasharray': '6 4',
          }),
        );
      }

      // Kurva: putuskan di titik lubang/kutub.
      const points: Array<[number, number] | null> = sampleFunctionFamily(a, b, X_MIN, X_MAX, 300).map(
        (p) => {
          if (p.kind !== 'value' || p.y === null) return null;
          if (p.y < Y_MIN - 8 || p.y > Y_MAX + 8) return null;
          return [sx(p.x), sy(p.y)] as [number, number];
        },
      );
      svg.appendChild(
        el('path', {
          d: polyline(points),
          fill: 'none',
          stroke: 'var(--color-primary)',
          'stroke-width': 2.6,
          'stroke-linecap': 'round',
        }),
      );

      // Penanda lubang.
      if (info.hole && info.hole.x >= X_MIN && info.hole.x <= X_MAX && info.hole.y >= Y_MIN && info.hole.y <= Y_MAX) {
        svg.appendChild(
          el('circle', {
            cx: sx(info.hole.x),
            cy: sy(info.hole.y),
            r: 5.5,
            fill: 'var(--color-surface-2)',
            stroke: 'var(--color-data)',
            'stroke-width': 2.4,
          }),
        );
      }
    }

    function stat(label: string, text: string): string {
      return `<div class="stat"><span>${label}</span><strong>${text}</strong></div>`;
    }

    function render() {
      const a = Number(aInput.value);
      const b = Number(bInput.value);
      aOutput.textContent = formatPlain(a);
      bOutput.textContent = formatPlain(b);

      const info = analyze(a, b);
      draw(a, b);

      const holeText = info.hole
        ? `(${formatPlain(info.hole.x)}, ${formatPlain(info.hole.y)})`
        : 'tidak ada (a = b)';
      const verticalText =
        info.verticalAsymptote !== null ? formatPlain(info.verticalAsymptote) : 'tidak ada';

      readout.innerHTML =
        stat('Bentuk asli', '(x² − a²) / ((x − a)(x − b))') +
        stat('Setelah disederhanakan', '(x + a) / (x − b)') +
        stat('Lubang (diskontinuitas terhapus)', holeText) +
        stat('Asimtot tegak', `x = ${verticalText}`) +
        stat('Asimtot datar', `y = ${formatPlain(info.horizontalAsymptote)}`) +
        stat('Sifat grafik', describeFunctionFamily(info));

      const sample = evaluate(0, a, b);
      svg.setAttribute(
        'aria-label',
        `Grafik f(x) = (x² − ${a}²) / ((x − ${a})(x − ${b})); ${describeFunctionFamily(info)}; f(0) = ${
          sample.y === null ? 'tak terdefinisi' : formatPlain(sample.y)
        }`,
      );
    }

    [aInput, bInput].forEach((input) => input.addEventListener('input', render));
    reset.addEventListener('click', () => {
      aInput.value = '2';
      bInput.value = '3';
      render();
    });

    render();
  }

  initWhenVisible(document.querySelectorAll('[data-function-family]'), setupFunctionFamily);
</script>
