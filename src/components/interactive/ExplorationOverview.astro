---
import type { Difficulty, ElementId, Exploration, Grade } from '@/types/content';
import { ELEMENTS, ALL_ELEMENT_ORDER } from '@/data/curriculum';
import type { GradeMeta } from '@/data/curriculum';
import { DIFFICULTY_LABELS, DIFFICULTY_ORDER } from '@/lib/difficulty';
import ExplorationPreviewCard from '@/components/content/ExplorationPreviewCard.astro';
import MathMascot from '@/components/content/MathMascot.astro';
import { site } from '@/data/site';

interface Props {
  groups: Array<{ grade: Grade; meta: GradeMeta; items: Exploration[] }>;
  total?: number;
}
const { groups, total } = Astro.props;

const totalCount = total ?? groups.reduce((sum, g) => sum + g.items.length, 0);
const allItems = groups.flatMap((g) => g.items);

const elementChips: Array<{ id: ElementId; label: string; count: number }> = ALL_ELEMENT_ORDER.map(
  (id) => ({
    id,
    label: ELEMENTS[id].short,
    count: allItems.filter((item) => item.element === id).length,
  }),
);
const levelChips: Array<{ id: Difficulty; label: string; count: number }> = DIFFICULTY_ORDER.map(
  (level) => ({
    id: level,
    label: DIFFICULTY_LABELS[level],
    count: allItems.filter((item) => item.level === level).length,
  }),
);

const searchText = (item: Exploration) =>
  [item.title, item.description, ...(item.tags ?? [])].join(' ').toLowerCase();

const lead = 'Ubah nilainya, amati apa yang berubah, lalu temukan polanya sendiri. Saring menurut kelas, elemen, tingkat, atau kata kunci untuk memilih eksplorasi yang paling pas.';
---

<section class="ex-overview" data-ex-overview aria-labelledby="ex-overview-title">
  <div class="section-heading reveal" data-reveal>
    <p class="eyebrow-badge">Peta eksplorasi</p>
    <h2 id="ex-overview-title">Jelajahi laboratorium matematika</h2>
    <p class="text-muted">{lead}</p>
  </div>

  <details class="filter-panel filter-panel--plain" data-filter-panel open>
    <summary class="filter-panel__summary">
      <span class="filter-panel__summary-label">Saring</span>
      <span class="filter-panel__count" data-filter-summary-count hidden></span>
    </summary>
    <div class="filter-panel__body">
    <div class="ex-filter" data-ex-chips="grade" role="group" aria-label="Saring menurut kelas">
      <span class="ex-filter-label">Kelas</span>
      <div class="ex-chip-row">
        <button type="button" class="chip ex-chip is-active" data-ex-filter="all" aria-pressed="true">
          Semua
          <span class="chip__count ex-chip-count">{totalCount}</span>
        </button>
        {
          groups.map((g) => (
            <button type="button" class="chip ex-chip" data-ex-filter={g.grade} aria-pressed="false">
              {g.meta.name}
              <span class="chip__count ex-chip-count">{g.items.length}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="ex-filter" data-ex-chips="element" role="group" aria-label="Saring menurut elemen">
      <span class="ex-filter-label">Elemen</span>
      <div class="ex-chip-row">
        <button type="button" class="chip ex-chip is-active" data-ex-filter="all" aria-pressed="true">
          Semua
          <span class="chip__count ex-chip-count">{totalCount}</span>
        </button>
        {
          elementChips.map((c) => (
            <button type="button" class="chip ex-chip" data-ex-filter={c.id} aria-pressed="false">
              {c.label}
              <span class="chip__count ex-chip-count">{c.count}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="ex-filter" data-ex-chips="level" role="group" aria-label="Saring menurut tingkat kesulitan">
      <span class="ex-filter-label">Tingkat</span>
      <div class="ex-chip-row">
        <button type="button" class="chip ex-chip is-active" data-ex-filter="all" aria-pressed="true">
          Semua
          <span class="chip__count ex-chip-count">{totalCount}</span>
        </button>
        {
          levelChips.map((c) => (
            <button type="button" class="chip ex-chip" data-ex-filter={c.id} aria-pressed="false">
              {c.label}
              <span class="chip__count ex-chip-count">{c.count}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="ex-search">
      <label class="visually-hidden" for="ex-search-input">Cari eksplorasi</label>
      <input
        id="ex-search-input"
        type="search"
        class="ex-search-input"
        data-ex-search-input
        placeholder="Cari judul, deskripsi, atau kata kunci"
        autocomplete="off"
      />
    </div>

    <div class="ex-filter-reset">
      <button type="button" class="btn btn-secondary btn-sm" data-ex-reset>Atur ulang</button>
    </div>
    </div>
  </details>

  <p class="ex-result" data-ex-result aria-live="polite">Menampilkan {totalCount} eksplorasi</p>

  <div class="grid grid-3 ex-grid">
    {
      groups.map((g) => (
        <>
          <p class="ex-group-label eyebrow-badge" data-ex-group={g.grade}>
            {g.meta.name}
          </p>
          {g.items.map((item, i) => (
            <div
              class="ex-item"
              data-ex-item
              data-ex-grade={g.grade}
              data-ex-element={item.element}
              data-ex-level={item.level}
              data-ex-search={searchText(item)}
            >
              <ExplorationPreviewCard exploration={item} href={`#ex-${item.id}`} delay={i * 70} />
            </div>
          ))}
        </>
      ))
    }
  </div>

  <p class="ex-empty" data-ex-empty hidden>
    <MathMascot size={6} state="oops" label={`${site.mascot.name} tidak menemukan eksplorasi`} />
    Tidak ada eksplorasi yang cocok dengan saringan ini. Coba ubah kata kunci atau pilih saringan lain.
  </p>
</section>

<script>
  import { matchesAny, normalizeText } from '@/lib/filter';
  import { setupFilterPage, collapseFiltersOnMobile } from '@/lib/filter-dom';

  const root = document.querySelector<HTMLElement>('[data-ex-overview]');

  if (root) {
    const chipGroups = Array.from(root.querySelectorAll<HTMLElement>('[data-ex-chips]'));
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-ex-item]'));

    if (chipGroups.length && items.length) {
      const searchInput = document.querySelector<HTMLInputElement>('[data-ex-search-input]');
      const result = document.querySelector<HTMLElement>('[data-ex-result]');
      const empty = document.querySelector<HTMLElement>('[data-ex-empty]');
      const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-ex-panel]'));
      const labels = Array.from(document.querySelectorAll<HTMLElement>('[data-ex-group]'));
      const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-ex-section]'));

      const selected = (value: string | undefined): Set<string> =>
        value && value !== 'all' ? new Set([value]) : new Set();

      const matches = (
        el: HTMLElement,
        values: Record<string, string>,
        query: string,
      ): boolean =>
        matchesAny(selected(values.grade), [el.getAttribute('data-ex-grade') ?? '']) &&
        matchesAny(selected(values.element), [el.getAttribute('data-ex-element') ?? '']) &&
        matchesAny(selected(values.level), [el.getAttribute('data-ex-level') ?? '']) &&
        (query === '' || normalizeText(el.getAttribute('data-ex-search') ?? '').includes(query));

      try {
        root.classList.add('js-ready');

        const page = setupFilterPage({
          groups: chipGroups.map((group) => ({
            key: group.getAttribute('data-ex-chips') ?? '',
            group,
            chipSelector: '[data-ex-filter]',
            valueAttr: 'data-ex-filter',
            activeClass: 'is-active',
            allValue: 'all',
          })),
          searchInput,
          queryKey: 'q',
          syncUrl: true,
          apply: (values, query) => {
            const q = normalizeText(query);
            const visibleByGrade: Record<string, number> = {};
            let count = 0;

            for (const item of items) {
              const show = matches(item, values, q);
              item.hidden = !show;
              if (show) {
                count += 1;
                const grade = item.getAttribute('data-ex-grade') ?? '';
                visibleByGrade[grade] = (visibleByGrade[grade] ?? 0) + 1;
                item.querySelector('.reveal')?.classList.add('is-visible');
              }
            }

            for (const panel of panels) {
              const show = matches(panel, values, q);
              panel.hidden = !show;
              if (show) panel.classList.add('is-visible');
            }

            for (const section of sections) {
              let any = false;
              const sectionPanels = section.querySelectorAll<HTMLElement>('[data-ex-panel]');
              for (const panel of sectionPanels) {
                if (!panel.hidden) {
                  any = true;
                  break;
                }
              }
              section.hidden = !any;
            }

            for (const label of labels) {
              const grade = label.getAttribute('data-ex-group') ?? '';
              label.hidden = !visibleByGrade[grade];
            }

            if (empty) empty.hidden = count !== 0;
            if (result) result.textContent = `Menampilkan ${count} eksplorasi`;
          },
        });

        root
          .querySelector<HTMLButtonElement>('[data-ex-reset]')
          ?.addEventListener('click', () => page.reset());

        collapseFiltersOnMobile(root);
      } catch {
        root.classList.remove('js-ready');
      }
    }
  }
</script>

<style>
  .ex-overview {
    margin-block: 0.5rem 2rem;
  }
  .ex-overview .section-heading {
    margin-bottom: 1.25rem;
  }

  .filter-panel {
    margin-bottom: 1.1rem;
  }
  .filter-panel__body {
    gap: 0.85rem;
  }
  .ex-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.75rem;
    min-width: 0;
  }
  .ex-filter-label {
    flex: none;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .ex-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-width: 0;
  }

  .ex-search {
    min-width: 0;
    max-width: 22rem;
  }
  .ex-filter-reset {
    display: flex;
    justify-content: flex-start;
  }
  .ex-search-input {
    width: 100%;
    appearance: none;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    border-radius: var(--radius-pill);
    padding: 0.5rem 1rem;
    font: inherit;
    font-size: 0.92rem;
    line-height: 1.3;
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .ex-search-input:focus-visible {
    outline-offset: 2px;
    border-color: var(--color-primary);
  }

  .ex-result {
    margin: 0 0 1.25rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .ex-group-label {
    grid-column: 1 / -1;
    margin: 0.35rem 0 -0.35rem;
    justify-self: start;
    border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
    background: color-mix(in srgb, var(--color-primary) 9%, var(--color-surface));
    color: color-mix(in srgb, var(--color-primary) 68%, var(--color-text));
  }
  .ex-grid > .ex-group-label:first-child {
    margin-top: 0;
  }

  .ex-item {
    display: flex;
  }
  .ex-item > :global(.exploration-card) {
    flex: 1;
    width: 100%;
  }

  .ex-empty {
    margin: 1.5rem 0 0;
    padding: 1rem 1.15rem;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    font-size: 0.92rem;
    text-align: center;
  }
  .ex-empty :global(.mascot) {
    margin-inline: auto;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 30rem) {
    .ex-chip-row {
      gap: 0.4rem;
    }
    .ex-chip {
      padding: 0.42rem 0.75rem;
      font-size: 0.85rem;
    }
    .ex-filter {
      align-items: flex-start;
    }
  }

  @media print {
    .ex-empty {
      display: none !important;
    }
  }
</style>
