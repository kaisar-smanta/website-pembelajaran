---
interface Props {
  height?: string | number;
  label?: string;
}
const { height = '15rem', label = 'Menyiapkan simulasi…' } = Astro.props;
const minHeight = typeof height === 'number' ? `${height}px` : height;
---

<div
  class="sim-skeleton"
  data-sim-skeleton
  aria-hidden="true"
  style={`--sim-skeleton-h:${minHeight}`}
>
  <span class="sim-skeleton-shimmer shimmer" aria-hidden="true"></span>
  <span class="sim-skeleton-bar shimmer" aria-hidden="true"></span>
  <span class="sim-skeleton-bar sim-skeleton-bar--wide shimmer" aria-hidden="true"></span>
  <span class="sim-skeleton-bar sim-skeleton-bar--short shimmer" aria-hidden="true"></span>
  <span class="sim-skeleton-label">{label}</span>
</div>

<style>
  .sim-skeleton {
    position: absolute;
    inset: 0;
    z-index: var(--z-raised);
    display: grid;
    place-items: center;
    align-content: center;
    gap: 0.75rem;
    min-height: var(--sim-skeleton-h, 15rem);
    padding: 1.5rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .sim-skeleton-shimmer {
    position: absolute;
    inset: 0;
  }
  .sim-skeleton-bar {
    position: relative;
    z-index: 1;
    width: min(70%, 22rem);
    max-width: 100%;
    height: 0.9rem;
    border-radius: var(--radius-pill);
    opacity: 0.85;
  }
  .sim-skeleton-bar--wide {
    width: min(90%, 30rem);
    height: 6.5rem;
    border-radius: var(--radius-lg);
  }
  .sim-skeleton-bar--short {
    width: min(45%, 14rem);
  }
  .sim-skeleton-label {
    position: relative;
    z-index: 1;
    margin-top: 0.35rem;
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface) 84%, transparent);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
  }
  @media (scripting: none) {
    .sim-skeleton {
      display: none;
    }
  }
  @media print {
    .sim-skeleton {
      display: none;
    }
  }
</style>
