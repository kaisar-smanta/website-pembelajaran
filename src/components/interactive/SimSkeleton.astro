---
interface Props {
  height?: string | number;
  label?: string;
}
const { height = '15rem', label = 'Menyiapkan simulasi…' } = Astro.props;
const minHeight = typeof height === 'number' ? `${height}px` : height;
---

<div
  class="sim-skeleton"
  data-sim-skeleton
  aria-hidden="true"
  style={`--sim-skeleton-h:${minHeight}`}
>
  <span class="sim-skeleton-shimmer" aria-hidden="true"></span>
  <span class="sim-skeleton-label">{label}</span>
</div>

<style>
  .sim-skeleton {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: grid;
    place-items: center;
    min-height: var(--sim-skeleton-h, 15rem);
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .sim-skeleton-shimmer {
    position: absolute;
    inset: 0;
    background: var(--color-surface-2);
  }
  .sim-skeleton-label {
    position: relative;
    z-index: 1;
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-surface) 84%, transparent);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 600;
  }
  @keyframes sim-skeleton-shimmer {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: -200% 0;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .sim-skeleton-shimmer {
      background: linear-gradient(
        100deg,
        var(--color-surface-2) 30%,
        color-mix(in srgb, var(--color-primary) 16%, var(--color-surface-2)) 50%,
        var(--color-surface-2) 70%
      );
      background-size: 200% 100%;
      animation: sim-skeleton-shimmer 2.4s linear infinite;
    }
  }
  @media (scripting: none) {
    .sim-skeleton {
      display: none;
    }
  }
  @media print {
    .sim-skeleton {
      display: none;
    }
  }
</style>
