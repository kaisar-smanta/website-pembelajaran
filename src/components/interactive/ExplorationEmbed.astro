---
import { getExploration } from '@/data/explorations';
import ExplorationSim from './ExplorationSim.astro';
import ExplorationBrief from './ExplorationBrief.astro';
import MathMascot from '@/components/content/MathMascot.astro';
import { url } from '@/utils/url';

interface Props {
  explorationId: string;
}
const { explorationId } = Astro.props;
const exploration = getExploration(explorationId);
---

{
  exploration ? (
    <section class="exploration-embed" aria-label={`Eksplorasi: ${exploration.title}`}>
      <div class="exploration-head">
        <h3 class="exploration-title">{exploration.title}</h3>
        <a class="exploration-link" href={`${url('/eksplorasi')}#ex-${exploration.id}`}>
          Buka di pusat eksplorasi
        </a>
      </div>
      <ExplorationBrief exploration={exploration} showCautions />
      <ExplorationSim exploration={exploration} />
    </section>
  ) : (
    <div class="callout callout-info embed-missing" role="note">
      <MathMascot size={5} state="oops" label="Maskot belum menemukan eksplorasi" />
      <p>Eksplorasi tidak ditemukan: {explorationId}</p>
    </div>
  )
}

<style>
  .exploration-embed {
    margin: 1.25rem 0;
  }
  .exploration-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }
  .exploration-title {
    font-size: 1.05rem;
    margin: 0;
  }
  .exploration-link {
    display: inline-block;
    padding-block: 0.22rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .exploration-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .embed-missing {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 1rem;
    text-align: center;
    background: var(--color-info-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .embed-missing p {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>
