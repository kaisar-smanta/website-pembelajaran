---
import type { Exploration, ExplorationParam } from '@/types/content';
import { renderMarkdown } from '@/utils/markdown';

interface Props {
  exploration: Exploration;
}
const { exploration } = Astro.props;
const formula = exploration.formula ?? 'exponential';

const defaults: Record<string, ExplorationParam[]> = {
  quadratic: [
    { name: 'a', label: 'a', min: -3, max: 3, step: 0.1, value: 1 },
    { name: 'b', label: 'b', min: -6, max: 6, step: 0.5, value: 0 },
    { name: 'c', label: 'c', min: -6, max: 6, step: 0.5, value: -4 },
  ],
  exponential: [
    { name: 'a', label: 'a', min: 0.5, max: 4, step: 0.5, value: 1 },
    { name: 'b', label: 'b', min: 0.25, max: 3, step: 0.05, value: 2 },
  ],
  sine: [
    { name: 'a', label: 'a', min: 0.5, max: 3, step: 0.1, value: 1 },
    { name: 'k', label: 'k', min: 0.5, max: 3, step: 0.1, value: 1 },
  ],
  transform: [
    { name: 'a', label: 'a', min: -2, max: 2, step: 0.1, value: 1 },
    { name: 'h', label: 'h', min: -4, max: 4, step: 0.5, value: 0 },
    { name: 'k', label: 'k', min: -6, max: 6, step: 0.5, value: 0 },
  ],
};

const presets: Record<string, { label: string; values: Record<string, number> }[]> = {
  exponential: [
    { label: 'b > 1', values: { b: 2 } },
    { label: 'b = 1', values: { b: 1 } },
    { label: '0 < b < 1', values: { b: 0.5 } },
  ],
  quadratic: [
    { label: 'a > 0', values: { a: 1, b: 0, c: -4 } },
    { label: 'a < 0', values: { a: -1, b: 0, c: 4 } },
    { label: 'a = 0', values: { a: 0, b: 1, c: 0 } },
  ],
  sine: [
    { label: 'a = 1, k = 1', values: { a: 1, k: 1 } },
    { label: 'a = 2, k = 1', values: { a: 2, k: 1 } },
    { label: 'a = 1, k = 2', values: { a: 1, k: 2 } },
  ],
  transform: [
    { label: 'identitas', values: { a: 1, h: 0, k: 0 } },
    { label: 'cermin', values: { a: -1, h: 0, k: 0 } },
    { label: 'geser', values: { a: 1, h: 2, k: -3 } },
  ],
};

const params = exploration.params && exploration.params.length ? exploration.params : defaults[formula];
const paramNames = new Set(params.map((p) => p.name));
const formulaPresets = (presets[formula] ?? [])
  .map((preset) => ({
    label: preset.label,
    values: Object.fromEntries(Object.entries(preset.values).filter(([name]) => paramNames.has(name))),
  }))
  .filter((preset) => Object.keys(preset.values).length > 0);
const formLabel: Record<string, string> = {
  quadratic: 'f(x) = ax² + bx + c',
  exponential: 'f(x) = a · bˣ',
  sine: 'f(x) = a · sin(kx)',
  transform: 'y = a·(x − h)² + k',
};
const readoutId = `sim-readout-${exploration.id}`;
const initialAria = `Grafik ${formLabel[formula]} dengan ${params.map((p) => `${p.name} = ${p.value}`).join(', ')}`;
---

<figure
  class="sim"
  data-fn-plot
  data-formula={formula}
  data-formula-label={formLabel[formula]}
  data-params={JSON.stringify(params.map((p) => ({ name: p.name, value: p.value })))}
>
  <div class="sim-formula" aria-hidden="true">{formLabel[formula]}</div>
  <div class="sim-canvas">
    <svg viewBox="0 0 480 300" role="img" aria-label={initialAria} data-plot></svg>
  </div>
  <div class="sim-controls">
    {
      params.map((p) => (
        <label class="sim-control">
          <span class="sim-control-label">
            <span aria-hidden="true">{p.label}</span>
            <span class="visually-hidden">{p.label}</span>
            <output data-output={p.name}>{p.value}</output>
          </span>
          <input
            type="range"
            min={p.min}
            max={p.max}
            step={p.step}
            value={p.value}
            data-param={p.name}
            aria-label={`Ubah ${p.label}`}
            aria-describedby={readoutId}
          />
        </label>
      ))
    }
  </div>
  <div class="sim-bar">
    {
      formulaPresets.length ? (
        <div class="sim-presets" role="group" aria-label="Preset parameter">
          {formulaPresets.map((preset) => (
            <button
              type="button"
              data-preset={JSON.stringify(preset.values)}
              aria-label={`${preset.label} (${Object.entries(preset.values)
                .map(([name, value]) => `${name} = ${value}`)
                .join(', ')})`}
            >
              {preset.label}
            </button>
          ))}
        </div>
      ) : null
    }
    <button type="button" class="sim-reset" data-reset>Atur ulang</button>
  </div>
  <output id={readoutId} class="sim-readout" data-readout aria-live="polite" aria-atomic="true"></output>
  <figcaption class="sim-caption" set:html={renderMarkdown(exploration.description)} />
</figure>

<style>
  .sim {
    margin: 1.25rem 0;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .sim-formula {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--color-text-muted);
  }
  .sim-canvas {
    background: var(--color-surface-2);
    border-radius: var(--radius);
    overflow: hidden;
    max-width: 36rem;
    margin-inline: auto;
  }
  .sim-canvas svg {
    display: block;
    width: 100%;
    height: auto;
    touch-action: none;
  }
  .sim-controls {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.5rem 1.25rem;
    margin-top: 0.85rem;
  }
  .sim-control-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin-bottom: 0.15rem;
  }
  .sim-control output {
    color: var(--color-primary);
    font-family: var(--font-mono);
  }
  input[type='range'] {
    width: 100%;
    accent-color: var(--color-primary);
  }
  .sim-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }
  .sim-presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .sim-presets button,
  .sim-reset {
    font: inherit;
    font-size: 0.82rem;
    padding: 0.32rem 0.65rem;
    background: var(--color-surface-2);
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      background var(--dur) var(--ease-out-soft),
      border-color var(--dur) var(--ease-out-soft),
      color var(--dur) var(--ease-out-soft);
  }
  .sim-presets button:hover,
  .sim-reset:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .sim-presets button:focus-visible,
  .sim-reset:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .sim-reset {
    margin-left: auto;
    font-weight: 600;
  }
  .sim-readout {
    display: block;
    margin-top: 0.75rem;
    padding: 0.5rem 0.7rem;
    background: var(--color-surface-2);
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
  }
  .sim-caption {
    margin-top: 0.6rem;
    font-size: 0.86rem;
    color: var(--color-text-muted);
  }
  .sim-caption :global(> *:last-child) {
    margin-bottom: 0;
  }
  @media (max-width: 390px) {
    .sim-bar {
      gap: 0.4rem;
    }
    .sim-presets {
      width: 100%;
    }
    .sim-reset {
      margin-left: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sim-presets button,
    .sim-reset {
      transition: none;
    }
  }
</style>

<script>
  import { evalFormula, mapFor, describe } from '../../lib/sim/function-slider';
  import type { Formula } from '../../lib/sim/function-slider';

  type Params = { name: string; value: number };

  function setup(root: Element) {
    const svg = root.querySelector('[data-plot]') as SVGSVGElement;
    const formula = (root.getAttribute('data-formula') ?? 'exponential') as Formula;
    const formulaLabel = root.getAttribute('data-formula-label') ?? '';
    const initial: Params[] = JSON.parse(root.getAttribute('data-params') ?? '[]');
    const outputs = root.querySelectorAll('[data-output]');
    const readout = root.querySelector('[data-readout]') as HTMLOutputElement;
    const inputs = root.querySelectorAll('[data-param]');
    const resetButton = root.querySelector('[data-reset]');
    const presetButtons = root.querySelectorAll('[data-preset]');

    const state: Record<string, number> = {};
    initial.forEach((p) => (state[p.name] = p.value));

    const W = 480;
    const H = 300;
    const pad = 34;

    function fmt(n: number): string {
      if (Number.isInteger(n)) return String(n);
      return String(Number(n.toFixed(2)));
    }

    const svgNS = 'http://www.w3.org/2000/svg';
    function el(name: string, attrs: Record<string, string | number>) {
      const node = document.createElementNS(svgNS, name);
      for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
      return node;
    }

    function draw() {
      const { xMin, xMax, yMin, yMax } = mapFor(formula);
      const sx = (x: number) => pad + ((x - xMin) / (xMax - xMin)) * (W - 2 * pad);
      const sy = (y: number) => H - pad - ((y - yMin) / (yMax - yMin)) * (H - 2 * pad);

      while (svg.firstChild) svg.removeChild(svg.firstChild);

      const gridColor = 'var(--color-border)';
      const axisColor = 'var(--color-text-soft)';

      for (let i = 0; i <= 8; i++) {
        const x = pad + (i / 8) * (W - 2 * pad);
        svg.appendChild(el('line', { x1: x, y1: pad, x2: x, y2: H - pad, stroke: gridColor, 'stroke-width': 1 }));
      }
      for (let i = 0; i <= 6; i++) {
        const y = pad + (i / 6) * (H - 2 * pad);
        svg.appendChild(el('line', { x1: pad, y1: y, x2: W - pad, y2: y, stroke: gridColor, 'stroke-width': 1 }));
      }

      if (yMin <= 0 && yMax >= 0) {
        svg.appendChild(el('line', { x1: pad, y1: sy(0), x2: W - pad, y2: sy(0), stroke: axisColor, 'stroke-width': 1.6 }));
      }
      if (xMin <= 0 && xMax >= 0) {
        svg.appendChild(el('line', { x1: sx(0), y1: pad, x2: sx(0), y2: H - pad, stroke: axisColor, 'stroke-width': 1.6 }));
      }

      const path = el('path', {
        fill: 'none',
        stroke: 'var(--color-primary)',
        'stroke-width': 2.6,
        'stroke-linecap': 'round',
        'stroke-linejoin': 'round',
      });
      let d = '';
      let started = false;
      const steps = 480;
      for (let i = 0; i <= steps; i++) {
        const x = xMin + (i / steps) * (xMax - xMin);
        const y = evalFormula(formula, state, x);
        if (!isFinite(y) || y < yMin - 200 || y > yMax + 200) {
          started = false;
          continue;
        }
        const px = sx(x);
        const py = sy(y);
        if (py < -2000 || py > 2000) {
          started = false;
          continue;
        }
        d += `${started ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)} `;
        started = true;
      }
      path.setAttribute('d', d);
      svg.appendChild(path);

      const info = describe(formula, state);
      if (info.vertex && info.vertex.y >= yMin && info.vertex.y <= yMax) {
        const r = formula === 'transform' ? 5 : 4.5;
        svg.appendChild(el('circle', { cx: sx(info.vertex.x), cy: sy(info.vertex.y), r, fill: 'var(--color-warning)' }));
      }
    }

    function updateReadout() {
      readout.textContent = describe(formula, state).text;
    }

    function updateAria() {
      const parts = initial.map((p) => `${p.name} = ${fmt(state[p.name] ?? p.value)}`);
      svg.setAttribute('aria-label', `Grafik ${formulaLabel} dengan ${parts.join(', ')}`);
    }

    function setParam(name: string, value: number) {
      state[name] = value;
      inputs.forEach((input) => {
        if (input.getAttribute('data-param') === name) (input as HTMLInputElement).value = String(value);
      });
      outputs.forEach((o) => {
        if (o.getAttribute('data-output') === name) o.textContent = String(value);
      });
    }

    function sync() {
      draw();
      updateReadout();
      updateAria();
    }

    inputs.forEach((input) => {
      input.addEventListener('input', () => {
        const name = input.getAttribute('data-param') as string;
        setParam(name, Number((input as HTMLInputElement).value));
        sync();
      });
    });

    presetButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const raw = button.getAttribute('data-preset');
        if (!raw) return;
        const values = JSON.parse(raw) as Record<string, number>;
        Object.entries(values).forEach(([name, value]) => setParam(name, value));
        sync();
      });
    });

    resetButton?.addEventListener('click', () => {
      initial.forEach((p) => setParam(p.name, p.value));
      sync();
    });

    sync();
  }

  document.querySelectorAll('[data-fn-plot]').forEach(setup);
</script>
