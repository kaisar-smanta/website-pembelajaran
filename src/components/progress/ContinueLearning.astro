---
import { topics as allTopics, topicSubject } from '@/data/topics';
import { questionsByTopic } from '@/data/questions';
import { ELEMENTS, GRADES, SUBJECTS } from '@/data/curriculum';
import { url, topicUrl } from '@/utils/url';
import type { Grade, SubjectId } from '@/types/content';
import {
  buildOverview,
  suggestedStart,
  type TopicEntry,
} from '@/lib/progress-overview';

interface Props {
  /** Batasi saran pada mata pelajaran tertentu. */
  subject?: SubjectId;
  /** Batasi saran pada kelas tertentu. */
  grade?: Grade;
  /** Jumlah maksimum topik yang disarankan. */
  limit?: number;
}

const { subject, grade, limit = 4 } = Astro.props;

const picked = allTopics.filter((topic) => {
  if (subject && topicSubject(topic) !== subject) return false;
  if (grade && topic.grade !== grade) return false;
  return true;
});

const entries: TopicEntry[] = picked.map((topic) => {
  const owner = topicSubject(topic);
  let predictions = 0;
  let reflections = 0;
  for (const section of topic.sections) {
    for (const block of section.blocks ?? []) {
      if (block.kind === 'prediction') predictions += 1;
      else if (block.kind === 'reflection') reflections += 1;
    }
  }
  return {
    id: topic.id,
    slug: topic.slug,
    title: topic.title,
    grade: topic.grade,
    gradeName: GRADES[topic.grade].name,
    element: topic.element,
    elementName: ELEMENTS[topic.element].name,
    subject: owner,
    subjectName: SUBJECTS[owner].name,
    questionIds: questionsByTopic(topic.id).map((question) => question.id),
    predictions,
    reflections,
    practiceHref: url(`/latihan/${topic.slug}`),
    materialHref: topicUrl(topic.grade, topic.element, topic.slug, owner),
    prerequisites: topic.prerequisites ?? [],
  };
});

const serverOverview = buildOverview(entries, {}, {}, {});
const serverSuggestions = suggestedStart(serverOverview, limit);
const entriesJson = JSON.stringify(entries).replace(/</g, '\\u003c');
---

<section
  class="continue-learning no-print"
  data-continue-learning
  data-cl-limit={limit}
  aria-labelledby="continue-learning-title"
>
  <div class="container">
    <div class="cl-card card reveal">
      <div class="cl-head">
        <div class="cl-heading">
          <p class="eyebrow-badge" data-cl-eyebrow>Mulai</p>
          <h2 id="continue-learning-title" data-cl-title>Mulai dari sini</h2>
          <p class="cl-lead text-muted" data-cl-lead>
            Pilih salah satu titik awal berikut sesuai urutan kelas dan prasyaratnya, atau lihat
            peta pembelajaran untuk merencanakan urutanmu.
          </p>
        </div>
        <a class="btn btn-secondary btn-sm" href={url('/peta-pembelajaran')}>Peta pembelajaran</a>
      </div>

      <ol class="cl-list" data-cl-list>
        {
          serverSuggestions.map((topic) => (
            <li class:list={['cl-item', `accent-${topic.element}`]}>
              <div class="cl-main">
                <a class="cl-title" href={topic.practiceHref}>{topic.title}</a>
                <span class="cl-meta">
                  {topic.gradeName}
                  {' · '}
                  {topic.elementName}
                </span>
              </div>
              <a class="btn btn-secondary btn-sm" href={topic.materialHref}>Baca materi</a>
            </li>
          ))
        }
      </ol>

      {
        serverSuggestions.length === 0 && (
          <p class="cl-empty text-muted">
            Belum ada topik yang siap disarankan di sini. Jelajahi{' '}
            <a href={url('/peta-pembelajaran')}>peta pembelajaran</a> untuk melihat urutan materi.
          </p>
        )
      }
    </div>
  </div>

  <script type="application/json" data-cl-data is:inline set:html={entriesJson}></script>
</section>

<style>
  .continue-learning {
    padding-block: clamp(1.25rem, 3vw, 2rem);
  }
  .cl-card {
    display: grid;
    gap: 1rem;
    padding: clamp(1.1rem, 3vw, 1.6rem);
    border-top: 3px solid var(--color-primary);
  }
  .cl-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
  }
  .cl-heading {
    min-width: 0;
  }
  .cl-heading h2 {
    margin: 0.15rem 0 0.3rem;
  }
  .cl-lead {
    margin: 0;
    max-width: 64ch;
    font-size: 0.95rem;
  }
  .cl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .cl-empty {
    margin: 0;
    font-size: 0.92rem;
  }
  .continue-learning :global(.cl-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem 1rem;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--accent, var(--color-primary));
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .continue-learning :global(.cl-main) {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .continue-learning :global(.cl-title) {
    font-weight: 700;
    font-size: 1.02rem;
    text-decoration: none;
  }
  .continue-learning :global(.cl-title:hover) {
    text-decoration: underline;
  }
  .continue-learning :global(.cl-meta) {
    font-size: 0.84rem;
    color: var(--color-text-muted);
  }
</style>

<script>
  import { loadProgress } from '@/lib/progress';
  import { loadPredictions, loadReflections } from '@/lib/learner';
  import { safeStorage } from '@/lib/storage';
  import {
    buildOverview,
    continueLearning,
    suggestedStart,
    type SiteOverview,
    type TopicEntry,
    type TopicOverview,
  } from '@/lib/progress-overview';

  function boot() {
    const root = document.querySelector<HTMLElement>('[data-continue-learning]');
    if (!root) return;

    const dataEl = root.querySelector<HTMLScriptElement>('[data-cl-data]');
    let entries: TopicEntry[] = [];
    try {
      const parsed: unknown = dataEl ? JSON.parse(dataEl.textContent ?? '[]') : [];
      if (Array.isArray(parsed)) entries = parsed as TopicEntry[];
    } catch {
      entries = [];
    }

    const limit = Number(root.getAttribute('data-cl-limit')) || 4;
    const titleEl = root.querySelector<HTMLElement>('[data-cl-title]');
    const eyebrowEl = root.querySelector<HTMLElement>('[data-cl-eyebrow]');
    const leadEl = root.querySelector<HTMLElement>('[data-cl-lead]');
    const list = root.querySelector<HTMLOListElement>('[data-cl-list]');
    if (!list) return;
    if (!list) return;

    function renderItem(topic: TopicOverview, withProgress: boolean): HTMLLIElement {
      const item = document.createElement('li');
      item.className = `cl-item accent-${topic.element}`;

      const main = document.createElement('div');
      main.className = 'cl-main';

      const link = document.createElement('a');
      link.className = 'cl-title';
      link.href = topic.practiceHref;
      link.textContent = topic.title;

      const meta = document.createElement('span');
      meta.className = 'cl-meta';
      const parts = [topic.gradeName, topic.elementName];
      if (withProgress && topic.total > 0) {
        const pct = Math.round((topic.answered / topic.total) * 100);
        parts.push(`${topic.answered}/${topic.total} soal (${pct}%)`);
      }
      meta.textContent = parts.join(' · ');

      main.append(link, meta);

      const material = document.createElement('a');
      material.className = 'btn btn-secondary btn-sm';
      material.href = topic.materialHref;
      material.textContent = 'Baca materi';

      item.append(main, material);
      return item;
    }

    function render() {
      if (!list) return;
      const storage = safeStorage();
      const overview: SiteOverview = buildOverview(
        entries,
        loadProgress(storage),
        loadPredictions(storage),
        loadReflections(storage),
      );

      const continuing = continueLearning(overview, limit);
      const suggestions = suggestedStart(overview, limit);

      if (continuing.length > 0) {
        if (eyebrowEl) eyebrowEl.textContent = 'Lanjutkan';
        if (titleEl) titleEl.textContent = 'Lanjutkan belajar';
        if (leadEl) {
          leadEl.textContent =
            'Topik yang sudah kamu buka tetapi belum tuntas, diurutkan dari aktivitas terakhir.';
        }
        list.replaceChildren(...continuing.map((topic) => renderItem(topic, true)));
      } else if (suggestions.length > 0) {
        if (eyebrowEl) eyebrowEl.textContent = 'Mulai';
        if (titleEl) titleEl.textContent = 'Mulai dari sini';
        if (leadEl) {
          leadEl.textContent =
            'Pilih salah satu titik awal berikut sesuai urutan kelas dan prasyaratnya.';
        }
        list.replaceChildren(...suggestions.map((topic) => renderItem(topic, false)));
      }
    }

    render();
    window.addEventListener('mtk:progress', render);
    window.addEventListener('mtk:interaction', render);
    window.addEventListener('pageshow', render);
    window.addEventListener('storage', render);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
