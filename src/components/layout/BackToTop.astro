---
const label = 'Kembali ke atas';
---

<button type="button" class="back-to-top no-print" data-back-to-top aria-label={label}>
  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5" />
    <path d="m5 12 7-7 7 7" />
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    right: clamp(1rem, 4vw, 1.75rem);
    bottom: calc(clamp(1rem, 4vw, 1.75rem) + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-fab);
    display: grid;
    place-items: center;
    width: 2.85rem;
    height: 2.85rem;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-primary);
    box-shadow: var(--shadow);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(0.6rem);
    transition:
      opacity var(--dur) var(--ease-out-soft),
      transform var(--dur) var(--ease-out-soft),
      visibility var(--dur),
      background-color var(--dur-fast),
      color var(--dur-fast);
  }
  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }
  /* Sembunyikan saat kontrol interaktif (isian/filter) ada di layar agar tidak
     menutupi pilihan jawaban atau panel saringan. */
  .back-to-top.is-obscured {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .back-to-top:hover {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  .back-to-top:focus-visible {
    outline-offset: 3px;
  }
  @media (max-width: 48rem) {
    .back-to-top {
      bottom: calc(4.25rem + env(safe-area-inset-bottom, 0px));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>

<script>
  import { setupBackToTop } from '@/lib/back-to-top';

  setupBackToTop();

  // Jauhkan tombol dari kontrol interaktif: sembunyikan selama isian atau
  // panel saringan terlihat di layar.
  const fab = document.querySelector<HTMLElement>('[data-back-to-top]');
  if (fab) {
    const targets = Array.from(
      document.querySelectorAll<HTMLElement>('input, textarea, select, .filter-panel'),
    );
    if (targets.length && 'IntersectionObserver' in window) {
      const visible = new WeakSet<Element>();
      const sync = () =>
        fab.classList.toggle('is-obscured', targets.some((el) => visible.has(el)));
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) visible.add(entry.target);
            else visible.delete(entry.target);
          });
          sync();
        },
        { threshold: 0 },
      );
      targets.forEach((el) => observer.observe(el));
    }
  }
</script>
