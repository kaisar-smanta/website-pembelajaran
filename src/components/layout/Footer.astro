---
import { footerNav } from '@/data/nav';
import { site } from '@/data/site';
import { url } from '@/utils/url';
const year = new Date().getFullYear();
---

<footer class="site-footer no-print">
  <div class="container footer-inner">
    <div class="footer-brand">
      <div class="brand-line">
        <span class="brand-logo">
          <img src={url(site.school.logo)} alt={site.school.logoAlt} width="30" height="30" loading="lazy" />
        </span>
        <strong>{site.name}</strong>
      </div>
      <p class="text-muted">
        Pusat pembelajaran matematika SMA berbahasa Indonesia untuk Matematika (Fase E–F) dan
        Matematika Tingkat Lanjut (pilihan Fase F). Susunan materi merupakan tafsir instruksional
        atas Capaian Pembelajaran Kepka BSKAP Kemendikdasmen No. 046/H/KR/2025, bukan salinan resmi
        dokumen kurikulum.
      </p>
      <p class="credit-line">
        <a href={url('/tentang')}>Tentang penyusun &amp; kredit</a>
        <span aria-hidden="true"> · </span>
        <a href={site.school.url} target="_blank" rel="noopener noreferrer">
          {site.school.name} <span aria-hidden="true">↗</span>
        </a>
      </p>
    </div>

    {
      footerNav.map((group) => (
        <nav class="footer-col" aria-label={group.heading}>
          <h2 class="footer-heading">{group.heading}</h2>
          <ul>
            {group.items.map((item) =>
              item.href ? (
                <li>
                  <a href={url(item.href)}>{item.label}</a>
                </li>
              ) : null,
            )}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="container footer-bottom">
    <p>
      &copy; {year} {site.name}. Sumber belajar bebas untuk keperluan pendidikan.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    margin-top: 3rem;
    padding-top: 2.5rem;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: minmax(15rem, 1.6fr) repeat(auto-fit, minmax(9rem, 1fr));
    gap: 2rem;
    padding-bottom: 2rem;
  }
  .footer-brand p {
    max-width: 34rem;
    font-size: 0.92rem;
  }
  .brand-line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }
  .brand-logo {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0.18rem;
    border-radius: 8px;
    background: #fff;
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  .brand-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 5px;
  }
  .credit-line {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .credit-line a {
    display: inline-block;
    padding-block: 0.2rem;
    color: var(--color-primary);
    text-decoration: none;
    word-break: break-word;
  }
  .credit-line a:hover {
    text-decoration: underline;
  }
  .footer-heading {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-soft);
    margin-bottom: 0.6rem;
  }
  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }
  .footer-col a {
    display: inline-block;
    padding-block: 0.2rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .footer-col a:hover {
    color: var(--color-primary);
  }
  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-block: 1rem;
    font-size: 0.85rem;
    color: var(--color-text-soft);
  }
  .footer-bottom p {
    margin: 0;
  }
  @media (max-width: 40rem) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
    }
    .footer-brand {
      grid-column: 1 / -1;
    }
  }
</style>
