---
const label = 'Ganti tema terang/gelap';
---

<button
  class="theme-toggle no-print"
  type="button"
  aria-label={label}
  title={label}
  aria-pressed="false"
  data-theme-toggle
>
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>
<span class="visually-hidden" role="status" aria-live="polite" data-theme-status></span>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      transform var(--dur) var(--ease-bounce),
      color var(--dur-fast),
      border-color var(--dur-fast);
  }
  .theme-toggle:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    transform: rotate(12deg);
  }
  .theme-toggle:active {
    transform: rotate(12deg) scale(0.94);
  }
  .theme-toggle svg {
    transition: transform var(--dur) var(--ease-out-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle:hover,
    .theme-toggle:active {
      transform: none;
    }
  }
  .icon-moon {
    display: none;
  }
  :global([data-theme='dark']) .icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .icon-moon {
    display: block;
  }
</style>

<script>
  const btn = document.querySelector('[data-theme-toggle]');
  const status = document.querySelector('[data-theme-status]');
  const root = document.documentElement;

  const isDark = () => root.getAttribute('data-theme') === 'dark';

  // Selaraskan status tombol dengan tema yang sudah dipasang skrip awal
  // (BaseLayout) tanpa mengumumkannya, agar pembaca layar tidak berisik saat
  // halaman baru dimuat.
  const syncPressed = () => {
    btn?.setAttribute('aria-pressed', String(isDark()));
  };

  syncPressed();

  btn?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* ignore */
    }
    syncPressed();
    if (status) status.textContent = next === 'dark' ? 'Tema gelap aktif' : 'Tema terang aktif';
  });
</script>
