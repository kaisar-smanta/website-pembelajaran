---
import { mainNav, type NavItem } from '@/data/nav';
import { site } from '@/data/site';
import { url } from '@/utils/url';
import ThemeToggle from '@/components/layout/ThemeToggle.astro';

const current = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
function isActive(href?: string): boolean {
  if (!href) return false;
  const clean = href.replace(/\/$/, '');
  return current === clean || current.startsWith(clean + '/');
}
function isCurrent(href?: string): boolean {
  if (!href) return false;
  return current === href.replace(/\/$/, '');
}
function itemActive(item: NavItem): boolean {
  return isActive(item.href) || (item.children?.some((child) => isActive(child.href)) ?? false);
}
---

<header class="site-header no-print">
  <div class="header-inner container">
    <a class="brand" href={url('/')} aria-label={`Beranda ${site.name}`}>
      <span class="brand-logo">
        <img src={url(site.school.logo)} alt={site.school.logoAlt} width="36" height="36" />
      </span>
      <span class="brand-text">
        <strong>{site.name}</strong>
        <small>{site.tagline}</small>
      </span>
    </a>

    <button
      class="mobile-nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Buka menu navigasi"
      data-mobile-toggle
    >
      <span class="bars" aria-hidden="true"></span>
      <span>Menu</span>
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Navigasi utama" data-primary-nav>
      <ul>
        {
          mainNav.map((item, index) => (
            <li data-nav-item>
              {item.children?.length ? (
                <>
                  {item.href ? (
                    <div class="nav-parent">
                      <a
                        href={url(item.href)}
                        aria-current={isCurrent(item.href) ? 'page' : undefined}
                        class={itemActive(item) ? 'nav-link active' : 'nav-link'}
                      >
                        {item.label}
                      </a>
                      <button
                        type="button"
                        class={itemActive(item) ? 'nav-trigger active' : 'nav-trigger'}
                        aria-expanded="false"
                        aria-haspopup="true"
                        aria-controls={`submenu-${index}`}
                        aria-label={`Buka submenu ${item.label}`}
                        data-nav-trigger
                      >
                        <svg
                          class="chevron"
                          width="12"
                          height="12"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          aria-hidden="true"
                        >
                          <path d="m6 9 6 6 6-6" />
                        </svg>
                      </button>
                    </div>
                  ) : (
                    <>
                      <span class="nav-group-label">{item.label}</span>
                      <button
                        type="button"
                        class={itemActive(item) ? 'nav-trigger nav-trigger--text active' : 'nav-trigger nav-trigger--text'}
                        aria-expanded="false"
                        aria-haspopup="true"
                        aria-controls={`submenu-${index}`}
                        data-nav-trigger
                      >
                        {item.label}
                        <svg
                          class="chevron"
                          width="12"
                          height="12"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2.5"
                          aria-hidden="true"
                        >
                          <path d="m6 9 6 6 6-6" />
                        </svg>
                      </button>
                    </>
                  )}
                  <ul class="submenu" id={`submenu-${index}`} aria-label={item.label}>
                    {item.children.map((child) =>
                      child.href ? (
                        <li>
                          <a
                            href={url(child.href)}
                            aria-current={isActive(child.href) ? 'page' : undefined}
                            class={isActive(child.href) ? 'active' : ''}
                          >
                            {child.label}
                          </a>
                        </li>
                      ) : null,
                    )}
                  </ul>
                </>
              ) : (
                <a
                  href={url(item.href ?? '/')}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class={isActive(item.href) ? 'active' : ''}
                >
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="search-link" href={url('/cari')} aria-label="Cari materi">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="search-label">Cari</span>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 97%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--color-border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: var(--header-h);
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-text);
    margin-right: auto;
  }
  .brand-logo {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0.2rem;
    border-radius: 10px;
    background: #fff;
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition: transform var(--dur) var(--ease-bounce);
  }
  .brand-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: 6px;
  }
  .brand:hover .brand-logo,
  .brand:focus-visible .brand-logo {
    transform: rotate(-4deg) scale(1.05);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .brand-text strong {
    font-family: var(--font-serif);
    font-size: 1.05rem;
  }
  .brand-text small {
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }
  .mobile-nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.4rem;
    min-width: 2.6rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.45rem 0.7rem;
    font: inherit;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 1.05rem;
    height: 2px;
    background: currentColor;
    content: '';
    position: relative;
  }
  .bars::before {
    top: -5px;
  }
  .bars::after {
    top: 3px;
  }
  .primary-nav > ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
  }
  .primary-nav > ul > li {
    position: relative;
  }
  .nav-parent {
    display: inline-flex;
    align-items: stretch;
    border-radius: var(--radius-sm);
  }
  .primary-nav .nav-parent > a {
    padding-right: 0.15rem;
  }
  .primary-nav .nav-parent > .nav-trigger {
    padding-left: 0.15rem;
    padding-right: 0.4rem;
  }
  .nav-parent > .nav-trigger::after {
    display: none;
  }
  .nav-parent:hover > a,
  .nav-parent:focus-within > a {
    color: var(--color-text);
    background: var(--color-surface-2);
  }
  .primary-nav a,
  .primary-nav .nav-trigger {
    position: relative;
    display: block;
    padding: 0.4rem 0.4rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.83rem;
    font-weight: 600;
    white-space: nowrap;
    transition:
      color var(--dur-fast),
      background-color var(--dur-fast);
  }
  .primary-nav .nav-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    min-height: 1.5rem;
    gap: 0.3rem;
    background: none;
    border: 0;
    font-family: inherit;
    line-height: inherit;
    cursor: pointer;
  }
  .nav-trigger .chevron {
    transition: transform var(--dur) var(--ease-out-soft);
  }
  .primary-nav li[data-open='true'] .nav-trigger .chevron {
    transform: rotate(180deg);
  }
  .nav-group-label {
    display: none;
  }
  .primary-nav a::after,
  .primary-nav .nav-trigger::after {
    content: '';
    position: absolute;
    left: 0.55rem;
    right: 0.55rem;
    bottom: 0.15rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease-out-soft);
  }
  .primary-nav a:hover,
  .primary-nav .nav-trigger:hover {
    color: var(--color-text);
    background: var(--color-surface-2);
  }
  .primary-nav a:hover::after,
  .primary-nav a:focus-visible::after,
  .primary-nav .nav-trigger:hover::after,
  .primary-nav .nav-trigger:focus-visible::after {
    transform: scaleX(1);
  }
  .primary-nav a.active,
  .primary-nav .nav-trigger.active {
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }
  .primary-nav a.active::after,
  .primary-nav .nav-trigger.active::after {
    transform: scaleX(1);
  }
  .primary-nav a:focus-visible,
  .primary-nav .nav-trigger:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
  .primary-nav .submenu {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 60;
    min-width: 10rem;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    display: none;
    flex-direction: column;
    gap: 0.1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: 0 14px 30px -14px color-mix(in srgb, #000 40%, transparent);
  }
  .primary-nav li[data-open='true'] > .submenu {
    display: flex;
  }
  .primary-nav .submenu a {
    display: block;
    padding: 0.45rem 0.6rem;
  }
  .primary-nav .submenu a::after {
    display: none;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .search-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.4rem;
    gap: 0.3rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .search-link:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }
  @media (max-width: 79.99rem) {
    .header-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      grid-template-rows: auto;
      gap: 0.5rem;
    }
    .brand {
      grid-row: 1;
      grid-column: 1;
      min-width: 0;
      margin-right: 0;
    }
    .brand-text {
      min-width: 0;
    }
    .brand-text strong {
      font-size: 1rem;
      line-height: 1.15;
    }
    .brand-text small {
      display: none;
    }
    .header-actions {
      grid-row: 1;
      grid-column: 2;
    }
    .mobile-nav-toggle {
      grid-row: 1;
      grid-column: 3;
      display: inline-flex;
      padding: 0.4rem 0.55rem;
    }
    .primary-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 60;
      display: none;
      max-height: calc(100vh - var(--header-h));
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      padding: 0.5rem clamp(1rem, 4vw, 2rem) 1rem;
      background: var(--color-surface);
      border-bottom: 1px solid var(--color-border);
      box-shadow: var(--shadow-lg);
      overscroll-behavior: contain;
    }
    .primary-nav[data-open='true'] {
      display: block;
    }
    .primary-nav > ul {
      flex-direction: column;
      gap: 0;
      padding-bottom: 0.25rem;
    }
    .primary-nav a {
      padding: 0.65rem 0.5rem;
      font-size: 1rem;
    }
    .primary-nav .nav-trigger {
      display: none;
    }
    .primary-nav .nav-parent {
      display: block;
    }
    .primary-nav .nav-parent > a {
      padding-right: 0.5rem;
    }
    .nav-group-label {
      display: block;
      padding: 0.7rem 0.5rem 0.3rem;
      font-size: 0.78rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--color-text-soft);
    }
    .primary-nav .submenu {
      position: static;
      display: flex;
      min-width: 0;
      padding: 0 0 0.3rem 0.9rem;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }
    .search-label {
      display: none;
    }
    :global(body.nav-open) {
      overflow: hidden;
    }
  }
  @media (max-width: 23rem) {
    .brand-text small {
      display: none;
    }
    .mobile-nav-toggle > span:not(.bars) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand:hover .brand-logo,
    .brand:focus-visible .brand-logo {
      transform: none;
    }
    .primary-nav a::after,
    .primary-nav .nav-trigger::after,
    .nav-trigger .chevron {
      transition: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const nav = document.querySelector('[data-primary-nav]');
  const header = toggle?.closest('.site-header') || nav?.closest('.site-header');

  function isOpen() {
    return nav?.getAttribute('data-open') === 'true';
  }

  function setOpen(open: boolean) {
    const wasOpen = isOpen();
    nav?.setAttribute('data-open', String(open));
    document.body.classList.toggle('nav-open', open);
    if (!toggle) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');

    if (open && !wasOpen) {
      window.requestAnimationFrame(() => {
        nav?.querySelector<HTMLElement>('a, button')?.focus();
      });
    } else if (!open && wasOpen && nav?.contains(document.activeElement)) {
      toggle.focus();
    }
  }

  toggle?.addEventListener('click', () => {
    setOpen(!isOpen());
  });

  const desktopQuery = window.matchMedia('(min-width: 64rem)');
  desktopQuery.addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });

  const dropdownItems = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-item]'));

  function setDropdown(item: HTMLElement, open: boolean) {
    item.setAttribute('data-open', String(open));
    item.querySelector<HTMLButtonElement>('[data-nav-trigger]')?.setAttribute('aria-expanded', String(open));
  }

  function closeDropdowns(except?: Element | null) {
    dropdownItems.forEach((item) => {
      if (item !== except && item.getAttribute('data-open') === 'true') setDropdown(item, false);
    });
  }

  dropdownItems.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('[data-nav-trigger]');
    if (!trigger) return;

    trigger.addEventListener('click', (event) => {
      event.stopPropagation();
      const open = item.getAttribute('data-open') === 'true';
      closeDropdowns(item);
      setDropdown(item, !open);
    });

    item.addEventListener('mouseenter', () => {
      closeDropdowns(item);
      setDropdown(item, true);
    });

    item.addEventListener('mouseleave', () => {
      if (!item.contains(document.activeElement)) setDropdown(item, false);
    });

    item.addEventListener('focusin', () => {
      closeDropdowns(item);
      setDropdown(item, true);
    });

    item.addEventListener('focusout', () => {
      window.requestAnimationFrame(() => {
        if (!item.contains(document.activeElement)) setDropdown(item, false);
      });
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    const openItem = dropdownItems.find((item) => item.getAttribute('data-open') === 'true');
    if (openItem) {
      setDropdown(openItem, false);
      openItem.querySelector<HTMLButtonElement>('[data-nav-trigger]')?.focus();
      return;
    }

    if (!isOpen()) return;
    setOpen(false);
    toggle?.focus();
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    dropdownItems.forEach((item) => {
      if (item.getAttribute('data-open') === 'true' && !item.contains(target)) {
        setDropdown(item, false);
      }
    });

    if (!isOpen()) return;
    if (header && header.contains(target)) return;
    setOpen(false);
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
