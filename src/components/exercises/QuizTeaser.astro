---
import type { Question } from '@/types/content';
import { getQuestion, questions } from '@/data/questions';
import { renderMarkdown } from '@/utils/markdown';
import { url } from '@/utils/url';
import { seededShuffle } from '@/lib/random';

interface Props {
  questionIds?: string[];
}
const { questionIds } = Astro.props;

function isQuizReady(q: Question | undefined): q is Question {
  return Boolean(q && q.type === 'multiple-choice' && q.options && q.options.length > 0);
}

const preferredCategories = new Set(['cepat', 'konsep']);
const preferredDifficulties = new Set(['dasar', 'cakap']);

function rank(q: Question): number {
  let score = 0;
  if (q.category && preferredCategories.has(q.category)) score += 2;
  if (preferredDifficulties.has(q.difficulty)) score += 1;
  return score;
}

const selected: Question[] =
  questionIds && questionIds.length
    ? questionIds
        .map((id) => getQuestion(id))
        .filter(isQuizReady)
        .slice(0, 5)
    : questions
        .map((q, i) => ({ q, i }))
        .filter((entry) => isQuizReady(entry.q))
        .sort((a, b) => rank(b.q) - rank(a.q) || a.i - b.i)
        .slice(0, 5)
        .map((entry) => entry.q);

const quizData = selected.map((q) => ({
  id: q.id,
  difficulty: q.difficulty,
  promptHtml: renderMarkdown(q.prompt),
  // Urutan tampil opsi diacak deterministik per id soal untuk mengurangi bias
  // posisi jawaban; pasangan key-teks tetap utuh sehingga penilaian aman.
  options: seededShuffle(q.options ?? [], `opsi-${q.id}`).map((o) => ({
    key: o.key,
    textHtml: renderMarkdown(o.text),
  })),
  answer: q.answer,
  explanationHtml: q.explanation ? renderMarkdown(q.explanation) : '',
}));

const first = quizData[0];
---

<section class="quiz-teaser" aria-labelledby="quiz-teaser-title">
  <p class="eyebrow">Kuis kilat</p>
  <h3 id="quiz-teaser-title">Uji pemahamanmu</h3>
  <p class="quiz-intro text-muted">
    Jawab satu soal, langsung tahu benar atau belum, lengkap dengan pembahasannya.
  </p>

  <div class="quiz-main">
  {
    first ? (
      <div
        class="quiz-box paper-grid"
        data-quiz
        data-question-id={first.id}
        data-questions={JSON.stringify(quizData)}
      >
        <span class="quiz-burst" aria-hidden="true" />
        <p class="quiz-position text-muted" data-quiz-position>
          Soal 1 dari {quizData.length}
        </p>
        <div class="quiz-prompt prose" data-quiz-prompt set:html={first.promptHtml} />
        <div class="quiz-options" data-quiz-options>
          {first.options.map((opt) => (
            <button type="button" class="quiz-option" data-key={opt.key}>
              <span class="quiz-key" aria-hidden="true">
                {opt.key}
              </span>
              <span class="quiz-option-text" set:html={opt.textHtml} />
            </button>
          ))}
        </div>
        <div class="quiz-feedback" data-feedback role="status" aria-live="polite" />
        <button type="button" class="btn btn-primary btn-sm pop-on-hover" data-next hidden>
          Lanjut, soal berikutnya
        </button>
        <div class="quiz-complete" data-complete hidden>
          <p class="quiz-complete-title">Kuis selesai!</p>
          <p class="quiz-complete-score" data-complete-score />
          <button type="button" class="btn btn-primary btn-sm" data-restart>
            Ulangi kuis
          </button>
        </div>
      </div>
    ) : (
      <div class="callout callout-info" role="note">
        Belum ada soal kuis yang tersedia.
      </div>
    )
  }

  <p class="quiz-score" aria-live="polite">
    <span class="marker quiz-streak-value" data-streak>0</span>
    <span>Rentetan kuis tersimpan: benar berturut-turut</span>
  </p>
  <p class="quiz-reward" data-reward role="status" aria-live="polite" hidden>
    <span class="quiz-reward-text" data-reward-text />
    <span class="quiz-confetti" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </span>
  </p>
  </div>
  <p class="quiz-more">
    <a class="btn btn-secondary btn-sm" href={url('/latihan')}>Latihan lengkap</a>
  </p>
</section>

<style>
  .quiz-teaser {
    height: 100%;
    display: flex;
    flex-direction: column;
    background:
      radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--color-primary) 8%, transparent),
        transparent 44%
      ),
      var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    padding: clamp(1rem, 3vw, 1.5rem);
    border-top: 3px solid var(--color-primary);
  }
  .quiz-intro {
    margin-bottom: 0.75rem;
  }
  .quiz-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .quiz-more {
    margin: auto 0 0;
    padding-top: 0.75rem;
  }
  .quiz-box {
    position: relative;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background-color: var(--color-bg);
    padding: 1rem;
    margin-bottom: 0.75rem;
  }
  .quiz-prompt {
    margin-bottom: 0.5rem;
  }
  .quiz-prompt :global(> *:last-child) {
    margin-bottom: 0;
  }
  .quiz-position {
    margin: 0 0 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  .quiz-options {
    display: grid;
    gap: 0.5rem;
  }
  .quiz-options :global(.quiz-option) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    text-align: left;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
    transition:
      border-color var(--dur-fast),
      background-color var(--dur-fast),
      box-shadow var(--dur-fast),
      transform var(--dur-fast);
  }
  .quiz-options :global(.quiz-option:hover) {
    border-color: var(--color-primary);
  }
  .quiz-options :global(.quiz-option:active) {
    transform: scale(0.985);
  }
  .quiz-options :global(.quiz-option.is-chosen) {
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 35%, transparent);
  }
  .quiz-options :global(.quiz-option.is-correct) {
    border-color: var(--color-success);
    background: var(--color-success-soft);
  }
  .quiz-options :global(.quiz-option.is-wrong) {
    border-color: var(--color-danger);
    background: var(--color-danger-soft);
  }
  .quiz-options :global(.quiz-option.is-correct::after) {
    content: '✓';
    margin-left: auto;
    color: var(--color-success);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1;
  }
  .quiz-options :global(.quiz-option.is-wrong::after) {
    content: '✕';
    margin-left: auto;
    color: var(--color-danger);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1;
  }
  .quiz-options :global(.quiz-key) {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--color-surface-2);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .quiz-options :global(.quiz-option.is-correct .quiz-key) {
    background: var(--color-success);
    color: var(--color-on-accent);
  }
  .quiz-options :global(.quiz-option.is-wrong .quiz-key) {
    background: var(--color-danger);
    color: var(--color-on-accent);
  }
  .quiz-feedback {
    margin: 0.75rem 0;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
  }
  .quiz-feedback:empty {
    display: none;
  }
  .quiz-feedback.is-ok {
    background: var(--color-success-soft);
    color: var(--color-success);
  }
  .quiz-feedback.is-no {
    background: var(--color-danger-soft);
    color: var(--color-danger);
  }
  .quiz-feedback :global(> *:last-child) {
    margin-bottom: 0;
  }
  .quiz-complete {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    margin-top: 0.75rem;
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-success) 40%, var(--color-border));
    border-radius: var(--radius);
    background: var(--color-success-soft);
  }
  .quiz-complete[hidden] {
    display: none;
  }
  .quiz-complete-title {
    margin: 0;
    font-weight: 700;
    color: var(--color-success);
  }
  .quiz-complete-score {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text);
  }
  .quiz-score {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    margin: 0.75rem 0 0.5rem;
    padding: 0.32rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  .quiz-score [data-streak] {
    color: var(--color-primary);
    font-weight: 800;
    font-size: 1.02rem;
    font-variant-numeric: tabular-nums;
    display: inline-block;
    min-width: 1.1ch;
    text-align: center;
  }
  .quiz-reward {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    margin: 0 0 0.5rem;
    padding: 0.34rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--color-success) 42%, var(--color-border));
    border-radius: var(--radius-pill);
    background: var(--color-success-soft);
    color: var(--color-success);
    font-size: 0.88rem;
    font-weight: 700;
  }
  .quiz-reward[hidden] {
    display: none;
  }
  .quiz-reward.is-pop {
    animation: pop-in var(--dur) var(--ease-bounce) both;
  }
  .quiz-reward.is-soft {
    border-color: var(--color-border);
    background: var(--color-surface-2);
    color: var(--color-text-muted);
  }
  .quiz-confetti {
    display: inline-flex;
    gap: 0.16rem;
  }
  .quiz-confetti span {
    width: 0.32rem;
    height: 0.32rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
  }
  .quiz-confetti span:nth-child(1) {
    color: var(--color-primary);
  }
  .quiz-confetti span:nth-child(2) {
    color: var(--color-algebra);
  }
  .quiz-confetti span:nth-child(3) {
    color: var(--color-geometry);
  }
  .quiz-confetti span:nth-child(4) {
    color: var(--color-data);
  }
  .quiz-reward.is-pop .quiz-confetti span {
    animation: confetti-pop 560ms var(--ease-bounce) both;
  }
  .quiz-reward.is-pop .quiz-confetti span:nth-child(2) {
    animation-delay: 70ms;
  }
  .quiz-reward.is-pop .quiz-confetti span:nth-child(3) {
    animation-delay: 140ms;
  }
  .quiz-reward.is-pop .quiz-confetti span:nth-child(4) {
    animation-delay: 210ms;
  }
  .quiz-teaser a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
  }
  .quiz-burst {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid var(--color-success);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .quiz-options :global(.quiz-option:active) {
      transform: none;
    }
    .quiz-reward.is-pop,
    .quiz-reward.is-pop .quiz-confetti span {
      animation: none;
    }
  }
</style>

<script>
  import { seededShuffle } from '@/lib/random';
    import { combineSeed } from '@/lib/random';
  import {
    sessionSeed,
    loadQuizStreak,
    saveQuizStreak,
    recordProgress,
  } from '@/lib/quiz-client';

  (() => {
    try {
      const boxes = document.querySelectorAll<HTMLElement>('[data-quiz]');
      boxes.forEach((box) => {
        type QuizOption = { key: string; textHtml?: string };
        type QuizItem = {
          id: string;
          answer: string;
          promptHtml?: string;
          explanationHtml?: string;
          options?: QuizOption[];
        };
        let quiz: QuizItem[] = [];
        try {
          quiz = JSON.parse(box.getAttribute('data-questions') || '[]');
        } catch (err) {
          quiz = [];
        }
        if (!Array.isArray(quiz) || quiz.length === 0) return;

        const scope = (box.closest('.quiz-teaser') as HTMLElement | null) || box;
        const promptEl = box.querySelector<HTMLElement>('[data-quiz-prompt]');
        const positionEl = box.querySelector<HTMLElement>('[data-quiz-position]');
        const optionsEl = box.querySelector<HTMLElement>('[data-quiz-options]');
        const feedbackEl = box.querySelector<HTMLElement>('[data-feedback]');
        const nextBtn = box.querySelector<HTMLElement>('[data-next]');
        const streakEl = scope.querySelector<HTMLElement>('[data-streak]');
        const rewardEl = scope.querySelector<HTMLElement>('[data-reward]');
        const rewardTextEl = scope.querySelector<HTMLElement>('[data-reward-text]');
        const completeEl = box.querySelector<HTMLElement>('[data-complete]');
        const completeScoreEl = box.querySelector<HTMLElement>('[data-complete-score]');
        const restartBtn = box.querySelector<HTMLButtonElement>('[data-restart]');
        const promptWrap = box.querySelector<HTMLElement>('.quiz-prompt');
        let burst = box.querySelector<HTMLElement>('.quiz-burst');

        let index = 0;
        let answered = false;
        let streak = loadQuizStreak();
        let correctCount = 0;
        let answeredCount = 0;

        if (streakEl) streakEl.textContent = String(streak);

        let reduceMotion = false;
        try {
          reduceMotion =
            typeof window.matchMedia === 'function' &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        } catch (err) {
          reduceMotion = false;
        }

        function rewardMessage(n: number) {
          if (n <= 1) return 'Tepat sekali. Lanjut ke soal berikutnya.';
          if (n === 2) return 'Dua benar berturut-turut.';
          if (n === 3) return 'Tiga benar berturut-turut. Lanjutkan.';
          if (n === 4) return 'Empat benar berturut-turut. Bagus.';
          return n + ' benar berturut-turut. Teruskan.';
        }

        function hideReward() {
          if (!rewardEl) return;
          rewardEl.hidden = true;
          rewardEl.classList.remove('is-pop', 'is-soft');
        }

        function showReward(n: number) {
          if (!rewardEl) return;
          rewardEl.hidden = false;
          rewardEl.classList.remove('is-soft');
          if (rewardTextEl) rewardTextEl.textContent = rewardMessage(n);
          if (!reduceMotion) {
            rewardEl.classList.remove('is-pop');
            void rewardEl.offsetWidth;
            rewardEl.classList.add('is-pop');
          }
        }

        function softenReward() {
          if (!rewardEl) return;
          rewardEl.hidden = false;
          rewardEl.classList.remove('is-pop');
          rewardEl.classList.add('is-soft');
          if (rewardTextEl) {
            rewardTextEl.textContent = 'Belum tepat. Coba soal berikutnya.';
          }
        }

        function render() {
          const q = quiz[index];
          if (!q) return;
          box.setAttribute('data-question-id', q.id);
          answered = false;
          hideReward();
          if (completeEl) completeEl.hidden = true;
          if (promptWrap) promptWrap.hidden = false;
          if (optionsEl) optionsEl.hidden = false;
          if (feedbackEl) {
            feedbackEl.className = 'quiz-feedback';
            feedbackEl.innerHTML = '';
          }
          if (nextBtn) {
            nextBtn.hidden = true;
            nextBtn.textContent =
              index === quiz.length - 1 ? 'Lihat hasil' : 'Lanjut, soal berikutnya';
          }
          if (promptEl) promptEl.innerHTML = q.promptHtml || '';
          if (positionEl) {
            positionEl.hidden = false;
            positionEl.textContent = `Soal ${index + 1} dari ${quiz.length}`;
          }
          if (optionsEl) {
            optionsEl.querySelectorAll('.quiz-option').forEach((el) => {
              el.removeAttribute('aria-disabled');
            });
            optionsEl.innerHTML = '';
            // Urutan opsi diacak ulang dengan benih sesi agar bias posisi tidak tetap.
            const ordered = seededShuffle(q.options || [], combineSeed(sessionSeed(), q.id));
            ordered.forEach((opt) => {
              const btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'quiz-option';
              btn.setAttribute('data-key', opt.key);
              btn.innerHTML =
                '<span class="quiz-key" aria-hidden="true">' +
                opt.key +
                '</span><span class="quiz-option-text">' +
                (opt.textHtml || '') +
                '</span>';
              btn.addEventListener('click', () => choose(btn, opt.key));
              optionsEl.appendChild(btn);
            });
          }
        }

        function showComplete() {
          if (promptWrap) promptWrap.hidden = true;
          if (optionsEl) optionsEl.hidden = true;
          if (positionEl) positionEl.hidden = true;
          if (feedbackEl) {
            feedbackEl.className = 'quiz-feedback';
            feedbackEl.innerHTML = '';
          }
          if (nextBtn) nextBtn.hidden = true;
          hideReward();
          if (completeEl) completeEl.hidden = false;
          if (completeScoreEl) {
            const pct = answeredCount ? Math.round((correctCount / answeredCount) * 100) : 0;
            completeScoreEl.textContent = `Kamu benar ${correctCount} dari ${answeredCount} soal (ketepatan ${pct}%).`;
          }
        }

        function choose(btn: HTMLElement, key: string) {
          if (answered) return;
          answered = true;
          const q = quiz[index];
          if (!q) return;
          const isCorrect = key === q.answer;

          if (optionsEl) {
            optionsEl.querySelectorAll('.quiz-option').forEach((el) => {
              el.setAttribute('aria-disabled', 'true');
              const k = el.getAttribute('data-key');
              if (k === q.answer) el.classList.add('is-correct');
              if (k === key && !isCorrect) el.classList.add('is-wrong');
            });
          }
          btn.classList.add('is-chosen');
          if (!reduceMotion) {
            btn.classList.add(isCorrect ? 'settle-pop' : 'nudge');
          }

          if (feedbackEl) {
            feedbackEl.className = 'quiz-feedback ' + (isCorrect ? 'is-ok' : 'is-no');
            feedbackEl.innerHTML =
              (isCorrect ? '<strong>Benar!</strong> ' : '<strong>Belum tepat.</strong> ') +
              (q.explanationHtml || '');
          }
          if (nextBtn) {
            nextBtn.hidden = false;
            if (typeof nextBtn.focus === 'function') nextBtn.focus();
          }

          recordProgress(q.id, isCorrect);
          answeredCount += 1;
          if (isCorrect) correctCount += 1;

          if (isCorrect) {
            streak += 1;
            if (burst && !reduceMotion) {
              burst.classList.remove('burst-ring');
              void burst.offsetWidth;
              burst.classList.add('burst-ring');
            }
            showReward(streak);
          } else {
            streak = 0;
            softenReward();
          }
          saveQuizStreak(streak);
          if (streakEl) {
            streakEl.textContent = String(streak);
            if (isCorrect && !reduceMotion) {
              streakEl.classList.remove('streak-pop');
              void streakEl.offsetWidth;
              streakEl.classList.add('streak-pop');
            }
          }
        }

        if (nextBtn) {
          nextBtn.addEventListener('click', () => {
            if (index === quiz.length - 1) {
              showComplete();
              return;
            }
            index += 1;
            render();
          });
        }

        if (restartBtn) {
          restartBtn.addEventListener('click', () => {
            index = 0;
            correctCount = 0;
            answeredCount = 0;
            streak = 0;
            saveQuizStreak(0);
            if (streakEl) streakEl.textContent = '0';
            render();
          });
        }

        if (!burst) {
          burst = document.createElement('span');
          burst.className = 'quiz-burst';
          burst.setAttribute('aria-hidden', 'true');
          box.appendChild(burst);
        }

        render();
      });
    } catch (err) {
      /* biarkan konten hasil server tetap tampil */
    }
  })();
</script>
