---
import type { Question } from '@/types/content';
import { renderMarkdown } from '@/utils/markdown';
import { getTopic, topicSubject } from '@/data/topics';
import { topicUrl } from '@/utils/url';

interface Props {
  question: Question;
  index: number;
  number?: number;
  showTopic?: boolean;
}
const { question, index, number, showTopic = false } = Astro.props;
const promptHtml = renderMarkdown(question.prompt);
const explanationHtml = question.explanation ? renderMarkdown(question.explanation) : '';
const topic = getTopic(question.topicId);
const levelLabel = { dasar: 'Dasar', cakap: 'Cakap', mahir: 'Mahir' }[question.difficulty];
---

<article
  class="question-card"
  data-question
  data-question-id={question.id}
  data-type={question.type}
  data-answer={question.answer}
  data-accepted={JSON.stringify(question.acceptedAnswers ?? [])}
>
  <header class="q-head">
    <span class="q-number" aria-hidden="true">{number ?? index + 1}</span>
    <span class={`badge badge-${question.difficulty}`}>{levelLabel}</span>
    {
      showTopic && topic && (
        <a class="q-topic" href={topicUrl(topic.grade, topic.element, topic.slug, topicSubject(topic))}>
          {topic.title}
        </a>
      )
    }
  </header>

  <div class="q-prompt prose" set:html={promptHtml} />

  {
    question.type === 'multiple-choice' && question.options && (
      <div role="radiogroup" aria-label="Pilihan jawaban">
        <ul class="q-options" role="list">
          {question.options.map((opt) => (
            <li>
              <button
                type="button"
                class="q-option"
                role="radio"
                aria-checked="false"
                data-key={opt.key}
              >
                <span class="q-key" aria-hidden="true">{opt.key}</span>
                <span class="q-option-text" set:html={renderMarkdown(opt.text)} />
              </button>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    question.type === 'short-answer' && (
      <div class="q-short">
        <label class="visually-hidden" for={`answer-${question.id}`}>
          Jawaban singkat
        </label>
        <input
          id={`answer-${question.id}`}
          type="text"
          class="q-input"
          data-short-input
          placeholder="Tulis jawabanmu…"
          autocomplete="off"
        />
        <button type="button" class="btn btn-primary btn-sm" data-short-check>
          Periksa
        </button>
      </div>
    )
  }

  {
    question.type === 'open-response' && (
      <div class="q-open">
        <label class="visually-hidden" for={`open-${question.id}`}>
          Jawaban uraian
        </label>
        <textarea
          id={`open-${question.id}`}
          class="q-textarea"
          data-open-input
          rows="4"
          placeholder="Tulis jawaban dan alasanmu di sini…"
        />
        <button type="button" class="btn btn-secondary btn-sm" data-open-reveal>
          Lihat contoh jawaban
        </button>
      </div>
    )
  }

  <p class="q-feedback" data-feedback role="status" aria-live="polite" hidden></p>

  <button type="button" class="btn btn-ghost btn-sm q-reset" data-reset hidden>Coba lagi</button>

  {
    question.hints?.length ? (
      <details class="q-hints">
        <summary>Petunjuk</summary>
        <ul>
          {question.hints.map((h) => (
            <li set:html={renderMarkdown(h)} />
          ))}
        </ul>
      </details>
    ) : null
  }

  <div class="q-explanation prose" data-explanation hidden set:html={explanationHtml} />

  <div class="q-model prose" data-model hidden set:html={renderMarkdown(question.answer)} />
</article>

<style>
  .question-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.1rem 1.2rem;
    margin-bottom: 1rem;
  }
  .q-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .q-number {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .q-topic {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--color-text-soft);
  }
  .q-prompt {
    font-size: 1.02rem;
  }
  .q-prompt :global(> *:last-child) {
    margin-bottom: 0.5rem;
  }
  .q-options {
    list-style: none;
    margin: 0.5rem 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .q-option {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    text-align: left;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }
  .q-option:hover {
    border-color: var(--color-primary);
  }
  .q-key {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--color-surface-2);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .q-option.correct {
    border-color: var(--color-success);
    background: var(--color-success-soft);
  }
  .q-option.correct .q-key {
    background: var(--color-success);
    color: var(--color-on-accent);
  }
  .q-option.incorrect {
    border-color: var(--color-danger);
    background: var(--color-danger-soft);
  }
  .q-option.incorrect .q-key {
    background: var(--color-danger);
    color: var(--color-on-accent);
  }
  .q-short {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0;
  }
  .q-input,
  .q-textarea {
    flex: 1 1 12rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }
  .q-textarea {
    width: 100%;
    resize: vertical;
    font-family: var(--font-sans);
  }
  .q-open {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .q-feedback {
    margin: 0.5rem 0;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
  .q-feedback.ok {
    background: var(--color-success-soft);
    color: var(--color-success);
  }
  .q-feedback.no {
    background: var(--color-danger-soft);
    color: var(--color-danger);
  }
  .q-feedback.info {
    background: var(--color-info-soft);
    color: var(--color-primary);
  }
  .q-reset {
    margin: 0.25rem 0 0.5rem;
  }
  .q-hints {
    margin: 0.5rem 0;
    font-size: 0.92rem;
  }
  .q-hints summary {
    cursor: pointer;
    color: var(--color-primary);
    font-weight: 600;
  }
  .q-explanation,
  .q-model {
    margin-top: 0.75rem;
    padding: 0.75rem 0.9rem;
    background: var(--color-surface-2);
    border-radius: var(--radius);
    font-size: 0.95rem;
  }
  .q-model {
    border-left: 4px solid var(--color-primary);
  }
  .q-explanation :global(> *:last-child),
  .q-model :global(> *:last-child) {
    margin-bottom: 0;
  }
</style>

<script>
  import {
    loadProgress,
    saveProgress,
    recordAttempt,
    clearAttempt,
    type Attempt,
    type AttemptState,
  } from '@/lib/progress';

  function normalize(value: string): string {
    return value
      .toLowerCase()
      .replace(/\s+/g, '')
      .replace(/[\\{}]/g, '')
      .replace(/[·×*]/g, '')
      .replace(/²/g, '^2')
      .replace(/³/g, '^3')
      .replace(/√/g, '√');
  }

  function record(
    root: Element,
    isCorrect: boolean,
    state: AttemptState & { graded?: boolean } = {},
  ) {
    const questionId = root.getAttribute('data-question-id');
    if (!questionId) return;
    try {
      const storage = window.localStorage;
      const map = loadProgress(storage);
      saveProgress(
        storage,
        recordAttempt(map, questionId, isCorrect, Date.now(), state.graded ?? true, state),
      );
    } catch {
      /* ignore */
    }
    window.dispatchEvent(
      new CustomEvent('mtk:progress', {
        detail: { questionId, correct: isCorrect, graded: state.graded ?? true },
      }),
    );
  }

  function clearQuestion(root: Element) {
    const questionId = root.getAttribute('data-question-id');
    if (!questionId) return;
    try {
      const storage = window.localStorage;
      const map = loadProgress(storage);
      saveProgress(storage, clearAttempt(map, questionId));
    } catch {
      /* ignore */
    }
    window.dispatchEvent(
      new CustomEvent('mtk:progress', { detail: { questionId, cleared: true } }),
    );
  }

  function setupQuestion(root: Element) {
    const type = root.getAttribute('data-type');
    const answer = (root.getAttribute('data-answer') ?? '').trim();
    const accepted: string[] = JSON.parse(root.getAttribute('data-accepted') ?? '[]');
    const feedback = root.querySelector('[data-feedback]') as HTMLElement;
    const explanation = root.querySelector('[data-explanation]') as HTMLElement;
    const reset = root.querySelector('[data-reset]') as HTMLButtonElement | null;

    // Pulihkan percobaan yang tersimpan agar soal yang sudah dikerjakan tidak
    // tampak sama dengan soal yang belum dikerjakan setelah halaman dimuat ulang.
    let attempt: Attempt | undefined;
    try {
      const id = root.getAttribute('data-question-id');
      attempt = id ? loadProgress(window.localStorage)[id] : undefined;
    } catch {
      attempt = undefined;
    }

    function showFeedback(kind: 'ok' | 'no' | 'info', text: string) {
      feedback.hidden = false;
      feedback.className = `q-feedback ${kind}`;
      feedback.textContent = text;
    }

    function showReset() {
      if (reset) reset.hidden = false;
    }

    function resetQuestion() {
      root.querySelectorAll('[data-key]').forEach((o) => {
        o.classList.remove('correct', 'incorrect');
        o.setAttribute('aria-checked', 'false');
        (o as HTMLButtonElement).disabled = false;
      });
      const input = root.querySelector('[data-short-input]') as HTMLInputElement | null;
      if (input) {
        input.value = '';
        input.disabled = false;
      }
      const openInput = root.querySelector('[data-open-input]') as HTMLTextAreaElement | null;
      if (openInput) openInput.value = '';
      const model = root.querySelector('[data-model]') as HTMLElement | null;
      if (model) model.hidden = true;
      const reveal = root.querySelector('[data-open-reveal]') as HTMLButtonElement | null;
      if (reveal) reveal.textContent = 'Lihat contoh jawaban';
      feedback.hidden = true;
      feedback.className = 'q-feedback';
      feedback.textContent = '';
      explanation.hidden = true;
      if (reset) reset.hidden = true;
      // Hapus percobaan tersimpan agar hitungan "dikerjakan" tidak menghitung
      // soal yang sudah dikembalikan ke keadaan belum dijawab.
      clearQuestion(root);
    }

    if (type === 'multiple-choice') {
      const options = root.querySelectorAll('[data-key]');
      const apply = (key: string | null) => {
        const isCorrect = key !== null && key === answer;
        options.forEach((o) => {
          const k = o.getAttribute('data-key');
          o.classList.remove('correct', 'incorrect');
          if (k === answer) o.classList.add('correct');
          else if (key !== null && k === key && !isCorrect) o.classList.add('incorrect');
          (o as HTMLButtonElement).setAttribute('aria-checked', String(key !== null && k === key));
        });
        return isCorrect;
      };
      const reveal = () => {
        explanation.hidden = false;
        showReset();
      };
      options.forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-key');
          const isCorrect = apply(key);
          showFeedback(
            isCorrect ? 'ok' : 'no',
            isCorrect ? 'Tepat!' : 'Belum tepat. Perhatikan pilihan yang benar.',
          );
          reveal();
          record(root, isCorrect, { selected: key ?? undefined });
        });
      });
      if (attempt) {
        apply(attempt.selected ?? (attempt.correct ? answer : null));
        showFeedback(
          attempt.correct ? 'ok' : 'no',
          attempt.correct ? 'Tepat!' : 'Belum tepat. Perhatikan pilihan yang benar.',
        );
        reveal();
      }
    }

    if (type === 'short-answer') {
      const input = root.querySelector('[data-short-input]') as HTMLInputElement;
      const check = root.querySelector('[data-short-check]') as HTMLButtonElement;
      const run = () => {
        const value = normalize(input.value);
        if (!value) {
          showFeedback('info', 'Tulis jawabanmu terlebih dahulu.');
          return;
        }
        const pool = [answer, ...accepted].map(normalize);
        const isCorrect = pool.includes(value);
        if (isCorrect) {
          showFeedback('ok', 'Benar!');
        } else {
          showFeedback('no', 'Belum tepat, coba periksa langkahmu.');
        }
        explanation.hidden = false;
        showReset();
        record(root, isCorrect, { input: input.value });
      };
      check.addEventListener('click', run);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') run();
      });
      if (attempt) {
        if (attempt.input !== undefined) input.value = attempt.input;
        showFeedback(
          attempt.correct ? 'ok' : 'no',
          attempt.correct ? 'Benar!' : 'Belum tepat, coba periksa langkahmu.',
        );
        explanation.hidden = false;
        showReset();
      }
    }

    if (type === 'open-response') {
      const reveal = root.querySelector('[data-open-reveal]') as HTMLButtonElement;
      const model = root.querySelector('[data-model]') as HTMLElement;
      const openInput = root.querySelector('[data-open-input]') as HTMLTextAreaElement | null;
      reveal.addEventListener('click', () => {
        model.hidden = !model.hidden;
        reveal.textContent = model.hidden ? 'Lihat contoh jawaban' : 'Sembunyikan contoh jawaban';
        if (!model.hidden) {
          showReset();
          // Soal uraian tidak dinilai otomatis; tandai "dikerjakan" tanpa
          // memengaruhi ketepatan begitu siswa membuka pembahasan.
          record(root, true, {
            graded: false,
            revealed: true,
            input: openInput ? openInput.value : undefined,
          });
        }
      });
      if (attempt) {
        if (openInput && attempt.input !== undefined) openInput.value = attempt.input;
        model.hidden = false;
        reveal.textContent = 'Sembunyikan contoh jawaban';
        showReset();
      }
    }

    if (reset) reset.addEventListener('click', resetQuestion);
  }

  document.querySelectorAll('[data-question]').forEach(setupQuestion);
</script>
