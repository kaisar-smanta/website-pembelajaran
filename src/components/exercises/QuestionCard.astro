---
import type { Question } from '@/types/content';
import { renderMarkdown } from '@/utils/markdown';
import { getTopic } from '@/data/topics';
import { topicUrl } from '@/utils/url';

interface Props {
  question: Question;
  index: number;
  showTopic?: boolean;
}
const { question, index, showTopic = false } = Astro.props;
const promptHtml = renderMarkdown(question.prompt);
const explanationHtml = question.explanation ? renderMarkdown(question.explanation) : '';
const topic = getTopic(question.topicId);
const levelLabel = { dasar: 'Dasar', cakap: 'Cakap', mahir: 'Mahir' }[question.difficulty];
---

<article
  class="question-card"
  data-question
  data-type={question.type}
  data-answer={question.answer}
  data-accepted={JSON.stringify(question.acceptedAnswers ?? [])}
>
  <header class="q-head">
    <span class="q-number" aria-hidden="true">{index + 1}</span>
    <span class={`badge badge-${question.difficulty}`}>{levelLabel}</span>
    {
      showTopic && topic && (
        <a class="q-topic" href={topicUrl(topic.grade, topic.element, topic.slug)}>
          {topic.title}
        </a>
      )
    }
  </header>

  <div class="q-prompt prose" set:html={promptHtml} />

  {
    question.type === 'multiple-choice' && question.options && (
      <ul class="q-options" role="list">
        {question.options.map((opt) => (
          <li>
            <button type="button" class="q-option" data-key={opt.key}>
              <span class="q-key" aria-hidden="true">{opt.key}</span>
              <span class="q-option-text" set:html={renderMarkdown(opt.text)} />
            </button>
          </li>
        ))}
      </ul>
    )
  }

  {
    question.type === 'short-answer' && (
      <div class="q-short">
        <label class="visually-hidden" for={`answer-${question.id}`}>
          Jawaban singkat
        </label>
        <input
          id={`answer-${question.id}`}
          type="text"
          class="q-input"
          data-short-input
          placeholder="Tulis jawabanmu…"
          autocomplete="off"
        />
        <button type="button" class="btn btn-primary btn-sm" data-short-check>
          Periksa
        </button>
      </div>
    )
  }

  {
    question.type === 'open-response' && (
      <div class="q-open">
        <label class="visually-hidden" for={`open-${question.id}`}>
          Jawaban uraian
        </label>
        <textarea
          id={`open-${question.id}`}
          class="q-textarea"
          rows="4"
          placeholder="Tulis jawaban dan alasanmu di sini…"
        />
        <button type="button" class="btn btn-secondary btn-sm" data-open-reveal>
          Lihat contoh jawaban
        </button>
      </div>
    )
  }

  <p class="q-feedback" data-feedback role="status" aria-live="polite" hidden></p>

  {
    question.hints?.length ? (
      <details class="q-hints">
        <summary>Petunjuk</summary>
        <ul>
          {question.hints.map((h) => (
            <li set:html={renderMarkdown(h)} />
          ))}
        </ul>
      </details>
    ) : null
  }

  <div class="q-explanation prose" data-explanation hidden set:html={explanationHtml} />

  <div class="q-model prose" data-model hidden set:html={renderMarkdown(question.answer)} />
</article>

<style>
  .question-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.1rem 1.2rem;
    margin-bottom: 1rem;
  }
  .q-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .q-number {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .q-topic {
    margin-left: auto;
    font-size: 0.8rem;
    color: var(--color-text-soft);
  }
  .q-prompt {
    font-size: 1.02rem;
  }
  .q-prompt :global(> *:last-child) {
    margin-bottom: 0.5rem;
  }
  .q-options {
    list-style: none;
    margin: 0.5rem 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .q-option {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    text-align: left;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }
  .q-option:hover {
    border-color: var(--color-primary);
  }
  .q-key {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--color-surface-2);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .q-option.correct {
    border-color: var(--color-success);
    background: var(--color-success-soft);
  }
  .q-option.correct .q-key {
    background: var(--color-success);
    color: #fff;
  }
  .q-option.incorrect {
    border-color: var(--color-danger);
    background: var(--color-danger-soft);
  }
  .q-option.incorrect .q-key {
    background: var(--color-danger);
    color: #fff;
  }
  .q-short {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0;
  }
  .q-input,
  .q-textarea {
    flex: 1 1 12rem;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }
  .q-textarea {
    width: 100%;
    resize: vertical;
    font-family: var(--font-sans);
  }
  .q-open {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }
  .q-feedback {
    margin: 0.5rem 0;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
  .q-feedback.ok {
    background: var(--color-success-soft);
    color: var(--color-success);
  }
  .q-feedback.no {
    background: var(--color-danger-soft);
    color: var(--color-danger);
  }
  .q-feedback.info {
    background: var(--color-info-soft);
    color: var(--color-primary);
  }
  .q-hints {
    margin: 0.5rem 0;
    font-size: 0.92rem;
  }
  .q-hints summary {
    cursor: pointer;
    color: var(--color-primary);
    font-weight: 600;
  }
  .q-explanation,
  .q-model {
    margin-top: 0.75rem;
    padding: 0.75rem 0.9rem;
    background: var(--color-surface-2);
    border-radius: var(--radius);
    font-size: 0.95rem;
  }
  .q-model {
    border-left: 4px solid var(--color-primary);
  }
  .q-explanation :global(> *:last-child),
  .q-model :global(> *:last-child) {
    margin-bottom: 0;
  }
</style>

<script>
  function normalize(value: string): string {
    return value
      .toLowerCase()
      .replace(/\s+/g, '')
      .replace(/[\\{}]/g, '')
      .replace(/[·×*]/g, '')
      .replace(/²/g, '^2')
      .replace(/³/g, '^3')
      .replace(/√/g, '√');
  }

  function setupQuestion(root: Element) {
    const type = root.getAttribute('data-type');
    const answer = (root.getAttribute('data-answer') ?? '').trim();
    const accepted: string[] = JSON.parse(root.getAttribute('data-accepted') ?? '[]');
    const feedback = root.querySelector('[data-feedback]') as HTMLElement;
    const explanation = root.querySelector('[data-explanation]') as HTMLElement;

    function showFeedback(kind: 'ok' | 'no' | 'info', text: string) {
      feedback.hidden = false;
      feedback.className = `q-feedback ${kind}`;
      feedback.textContent = text;
    }

    if (type === 'multiple-choice') {
      const options = root.querySelectorAll('[data-key]');
      options.forEach((btn) => {
        btn.addEventListener('click', () => {
          const key = btn.getAttribute('data-key');
          const isCorrect = key === answer;
          options.forEach((o) => {
            const k = o.getAttribute('data-key');
            o.classList.remove('correct', 'incorrect');
            if (k === answer) o.classList.add('correct');
            else if (k === key && !isCorrect) o.classList.add('incorrect');
            (o as HTMLButtonElement).setAttribute('aria-pressed', String(k === key));
          });
          showFeedback(isCorrect ? 'ok' : 'no', isCorrect ? 'Tepat!' : 'Belum tepat. Perhatikan pilihan yang benar.');
          explanation.hidden = false;
        });
      });
    }

    if (type === 'short-answer') {
      const input = root.querySelector('[data-short-input]') as HTMLInputElement;
      const check = root.querySelector('[data-short-check]') as HTMLButtonElement;
      const run = () => {
        const value = normalize(input.value);
        if (!value) {
          showFeedback('info', 'Tulis jawabanmu terlebih dahulu.');
          return;
        }
        const pool = [answer, ...accepted].map(normalize);
        if (pool.includes(value)) {
          showFeedback('ok', 'Benar!');
        } else {
          showFeedback('no', 'Belum tepat, coba periksa langkahmu.');
        }
        explanation.hidden = false;
      };
      check.addEventListener('click', run);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') run();
      });
    }

    if (type === 'open-response') {
      const reveal = root.querySelector('[data-open-reveal]') as HTMLButtonElement;
      const model = root.querySelector('[data-model]') as HTMLElement;
      reveal.addEventListener('click', () => {
        model.hidden = !model.hidden;
        reveal.textContent = model.hidden ? 'Lihat contoh jawaban' : 'Sembunyikan contoh jawaban';
      });
    }
  }

  document.querySelectorAll('[data-question]').forEach(setupQuestion);
</script>
