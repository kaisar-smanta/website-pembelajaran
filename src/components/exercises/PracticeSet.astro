---
import type { Difficulty, Question } from '@/types/content';
import { getQuestion, questionsByTopicAndDifficulty } from '@/data/questions';
import { site } from '@/data/site';
import MathMascot from '@/components/content/MathMascot.astro';
import QuestionCard from './QuestionCard.astro';

interface Props {
  /** Id topik pemilik soal; menarik bank soal topik ini. */
  topicId?: string;
  /** Tingkat kesulitan yang ditampilkan. */
  level: Difficulty;
  /** Bila diisi, pakai daftar soal eksplisit alih-alih seluruh bank tingkat ini. */
  questionIds?: string[];
  /** `quick` untuk cek pemahaman singkat di tengah materi. */
  variant?: 'practice' | 'quick';
  /** Awalan id unik instance (mis. id bagian) agar tidak bertabrakan antar sisipan. */
  idPrefix?: string;
}

const { topicId, level, questionIds, variant = 'practice', idPrefix = '' } = Astro.props;
const isQuick = variant === 'quick';

let questions: Question[];
if (questionIds?.length) {
  questions = questionIds
    .map((id) => getQuestion(id))
    .filter((q): q is Question => q !== undefined);
} else {
  questions = topicId ? questionsByTopicAndDifficulty(topicId, level) : [];
}
---

{
  questions.length > 0 && (
    <div class:list={['practice-embed', isQuick && 'practice-embed-quick']}>
      <p class="practice-lead">
        {isQuick
          ? 'Cek cepat: jawab dulu untuk memastikan kamu mengikuti. Pembahasan langsung terbuka.'
          : 'Kerjakan langsung di sini. Jawaban dan pembahasannya diperiksa otomatis.'}
      </p>
      <div class="practice-list">
        {questions.map((question, i) => (
          <QuestionCard
            question={question}
            index={i}
            idPrefix={idPrefix ? `${idPrefix}-${i}` : ''}
          />
        ))}
      </div>
    </div>
  )
}

{
  questions.length === 0 && (
    <p class="practice-empty">
      <MathMascot
        size={6}
        state="oops"
        label={`${site.mascot.name} belum menemukan soal pada tingkat ini`}
      />
      <span>
        Belum ada soal pada tingkat ini untuk topik tersebut. Soal akan ditambahkan menyusul.
      </span>
    </p>
  )
}

<style>
  .practice-embed {
    margin: 0.5rem 0 1.1rem;
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--sec) 24%, var(--color-border));
    border-left: 3px solid color-mix(in srgb, var(--sec) 70%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--sec) 6%, var(--color-surface));
  }
  .practice-embed-quick {
    border-style: dashed;
    background: color-mix(in srgb, var(--sec) 4%, var(--color-surface));
  }
  .practice-lead {
    margin: 0 0 0.85rem;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }
  .practice-list {
    display: grid;
    gap: 0.9rem;
  }
  .practice-list :global(.question-card) {
    margin-bottom: 0;
  }
  .practice-empty {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    margin: 0.5rem 0 1.1rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-style: italic;
    text-align: center;
  }
  .practice-empty :global(.mascot) {
    margin-inline: auto;
  }
</style>
